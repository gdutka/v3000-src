[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = SmmPlatform
  FILE_GUID                      = e4d932f4-31c9-4075-8fa3-4030f7eb767a
  MODULE_TYPE                    = DXE_SMM_DRIVER
  PI_SPECIFICATION_VERSION       = 0x0001000A
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = SmmPlatformEntryPoint

[Sources]
  SmmPlatform.c
  S5Wakeup.c
  SaveResFuncs.c
  CapsuleWakeup.c
  HGfuncs.c

[Packages]
  $(CHIPSET_PKG)/$(CHIPSET_PKG).dec
  InsydeModulePkg/InsydeModulePkg.dec
  InsydeOemServicesPkg/InsydeOemServicesPkg.dec
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  AgesaModulePkg/AgesaCommonModulePkg.dec
  AgesaModulePkg/AgesaModuleFchPkg.dec
  AgesaPkg/AgesaPkg.dec
  $(PROJECT_PKG)/Project.dec
  AmdCpmPkg/AmdCpmPkg.dec
  AmdCpmPkg/Addendum/Oem/$(PLATFORM_NAME)/AmdCpmOemPkg.dec
  SmmSupervisorPkg/SmmSupervisorPkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  PostCodeLib
  PciExpressLib
  SmmChipsetSvcLib
  SmmOemSvcKernelLibDefault
  BaseOemSvcKernelLib
  PcdLib
  CmosLib
  VariableLib
  ProcessPendingCapsuleLib
  AmdPbsConfigLib
  H2OLib
  SynchronizationLib
  ReportStatusCodeLib
  
[Guids]
  gSecureFlashInfoGuid
  gSystemConfigurationGuid

[Protocols]
  gEfiSmmSxDispatch2ProtocolGuid
  gFchSmmSxDispatch2ProtocolGuid
  gEfiSmmSwDispatch2ProtocolGuid
  gEfiSmmPowerButtonDispatch2ProtocolGuid

  gAcpiEnableCallbackStartProtocolGuid
  gAcpiDisableCallbackStartProtocolGuid
  gAcpiRestoreCallbackStartProtocolGuid
  gAcpiRestoreCallbackDoneProtocolGuid
  gAmdCapsuleSmmHookProtocolGuid
  gEfiHgNvsAreaProtocolGuid

!if $(REDUCED_HARDWARE_SUPPORT) == YES
  gEdkiiSmmExitBootServicesProtocolGuid
!endif

[Pcd]
  gAmdCpmPkgTokenSpaceGuid.PcdReduceHardwareSupport
  gChipsetPkgTokenSpaceGuid.PcdH2OLegacyFreeSupported
  gChipsetPkgTokenSpaceGuid.PcdH2OLegacyFreeTiSupport
  gChipsetPkgTokenSpaceGuid.PcdH2OSecureFlashWakeFromS3Time
  gAmdCpmPkgTokenSpaceGuid.PcdReduceHardwareEnable
  gChipsetPkgTokenSpaceGuid.PcdH2OCrbOnlySupported
  gSmmSupervisorPkgTokenSpaceGuid.PcdSmmIsolationEnable
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdAmdFchCfgAcpiPm1EvtBlkAddr
  gEfiMdeModulePkgTokenSpaceGuid.PcdProgressCodeS3SuspendStart
  gEfiMdeModulePkgTokenSpaceGuid.PcdProgressCodeS3SuspendEnd

[FeaturePcd]
  gChipsetPkgTokenSpaceGuid.PcdNvidiaOptimusSupported
  gChipsetPkgTokenSpaceGuid.PcdHgNvidiaDdsFeatureSupport

[Depex]
  gEfiSmmPowerButtonDispatch2ProtocolGuid AND
  gEfiSmmSxDispatch2ProtocolGuid AND
  gEfiSmmSwDispatch2ProtocolGuid AND
  gEfiSmmVariableProtocolGuid

