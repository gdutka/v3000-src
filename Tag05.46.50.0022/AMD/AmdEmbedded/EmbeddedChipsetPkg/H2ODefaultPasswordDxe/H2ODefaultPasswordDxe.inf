[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = H2ODefaultPasswordDxe
  FILE_GUID                      = D55EDE63-5CE1-44BB-BE99-12BDEF8D172E
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = H2ODefaultPasswordDxeEntry

#
# The following information is for reference only and not required by the build tools.
#
#  VALID_ARCHITECTURES           = IA32 X64
#

[Sources]
  H2ODefaultPasswordDxe.c
  H2ODefaultPasswordDxeStrings.uni

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  InsydeModulePkg/InsydeModulePkg.dec
  $(CHIPSET_PKG)/$(CHIPSET_PKG).dec
  
[LibraryClasses]
  BaseMemoryLib
  DebugLib
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  UefiLib
  VariableLib
  H2OLib
  HiiLib

[Guids]
  
[Protocols]
  gEfiSysPasswordServiceProtocolGuid
  gEdkiiVariableLockProtocolGuid
  gH2ODialogProtocolGuid
  gEndOfBdsBootSelectionProtocolGuid

[Pcd]
  gInsydeTokenSpaceGuid.PcdDefaultSysPasswordMaxLength
  gInsydeTokenSpaceGuid.PcdSecureSysPasswordSupported
  gChipsetPkgTokenSpaceGuid.PcdH2ODefaultSupervisorPwSupported
  gChipsetPkgTokenSpaceGuid.PcdH2ODefaultSecureBootPwSupported
  gChipsetPkgTokenSpaceGuid.PcdH2ODefaultSupervisorPwString
  
[Depex]
  TRUE
