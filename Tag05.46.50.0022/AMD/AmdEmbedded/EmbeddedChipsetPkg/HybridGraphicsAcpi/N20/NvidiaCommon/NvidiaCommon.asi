//
// ASL code common define about device
//
#define PCI_SCOPE                             \_SB.PCI0
#define IGPU_SCOPE                            PCI_SCOPE.GP17
#define EC_SCOPE                              PCI_SCOPE.LPC0.EC
#define NVIDIA_VID                            0x10DE

//
// nVIDIA GPS and Ventura feature usage define
//
#define CPU0_SCOPE                            \_SB.PLTF.C000
#define CPU1_SCOPE                            \_SB.PLTF.C001
#define CPU2_SCOPE                            \_SB.PLTF.C002
