[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = GenImageSlotHeader_1
  FILE_GUID                      = 53919E7A-CDFC-425B-8698-2B78583227AB
  MODULE_TYPE                    = USER_DEFINED
  VERSION_STRING                 = 0.1

  MODULE_AUTORUN_TOOL            = $(BIN_DIR)\$(BASE_NAME)
  AUTORUN_PARAM                  = $(BUILD_DIR)\FV\ImageSlotHeader_1.fv

[Sources]
  GenImageSlotHeader_1.c
  GenImageSlotHeader.h
  Fletcher32.c

[Packages]
  MdePkg/MdePkg.dec
  $(CHIPSET_PKG)/$(CHIPSET_PKG).dec
  AmdPspFeaturePkg/AmdPspFeaturePkg.dec
  InsydeModulePkg/InsydeModulePkg.dec

[LibraryClasses]
  DebugLib
  PrintLib
  BaseMemoryLib

[Ppis]

[Protocols]

[Guids]

[Pcd]
  gAmdPspFeaturePkgTokenSpaceGuid.PcdFlashAbImageSlot1Priority
  gAmdPspFeaturePkgTokenSpaceGuid.PcdFlashAbImageSlotUpdateRetries
  gAmdPspFeaturePkgTokenSpaceGuid.PcdFlashAbImageSlotGlitchRetry
  gAmdPspFeaturePkgTokenSpaceGuid.PcdFlashAbImageSlot1Base
  gInsydeTokenSpaceGuid.PcdFlashAreaBaseAddress

[BuildOptions]
  MSFT:*_*_IA32_DLINK_FLAGS == /out:"$(BIN_DIR)\$(BASE_NAME).exe" /base:0x10000000 /NOLOGO /SUBSYSTEM:CONSOLE /NODEFAULTLIB /IGNORE:4086 /MAP /OPT:REF /DEBUG /MACHINE:I386 /LTCG Kernel32.lib libcmtd.lib libvcruntimed.lib libucrtd.lib Advapi32.lib
  MSFT:*_*_*_CC_FLAGS = /wd4996 /D PLATFORM_NAME=$(PLATFORM_NAME)
