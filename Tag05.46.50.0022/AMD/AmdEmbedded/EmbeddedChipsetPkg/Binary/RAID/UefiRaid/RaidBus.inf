[defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = RAIDXpert2_F50_0x00
  FILE_GUID                      = AFD69E65-1CB3-472C-BE63-0C98A2C0665C
  MODULE_TYPE                    = UEFI_DRIVER
  VERSION_STRING                 = 1.0
  BINARY_VERSION                 = 9.03.00.63

[Binaries]
