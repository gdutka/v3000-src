  gChipsetPkgTokenSpaceGuid.PcdHgDgpuPwrEnableActive|FALSE|BOOLEAN|0x20000215
  gChipsetPkgTokenSpaceGuid.PcdHgDgpuPwrOnGpioNo|0x8E|UINT16|0x20000216
  gChipsetPkgTokenSpaceGuid.PcdHgDgpuPwrOnActive|TRUE|BOOLEAN|0x20000217
  gChipsetPkgTokenSpaceGuid.PcdHgDgpuPwrGoodGpioNo|0x8F|UINT16|0x20000218
  gChipsetPkgTokenSpaceGuid.PcdHgDgpuPwrGoodActive|TRUE|BOOLEAN|0x20000219
  gChipsetPkgTokenSpaceGuid.PcdHgDgpuPwrGoodExist|FALSE|BOOLEAN|0x2000021a
  gChipsetPkgTokenSpaceGuid.PcdDelayAfterReset|100000|UINT32|0x2000021b
  gChipsetPkgTokenSpaceGuid.PcdDelayAfterPwrEnable|7000|UINT32|0x2000021c
