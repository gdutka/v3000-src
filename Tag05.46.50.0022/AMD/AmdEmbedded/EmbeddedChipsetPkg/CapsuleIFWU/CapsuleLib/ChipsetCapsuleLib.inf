[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = ChipsetCapsuleLib
  FILE_GUID                      = ED33C5FD-B1B5-C5AD-A3CC-5BE7D1F9B2A9
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = ChipsetCapsuleLib|DXE_DRIVER DXE_RUNTIME_DRIVER UEFI_APPLICATION


#
# The following information is for reference only and not required by the build tools.
#
#  VALID_ARCHITECTURES           = IA32 X64 EBC
#

[Sources]
  ChipsetCapsuleLib.c

#[-start-190613-IB16990069-add]#
[Sources.IA32]
  Ia32/CallSmmIhisi.nasm

[Sources.X64]
  X64/CallSmmIhisi.nasm

[Sources.Arm, Sources.AArch64]
  Arm/CallSmmIhisi.c
#[-end-190613-IB16990069-add]#

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  InsydeModulePkg/InsydeModulePkg.dec
  $(CHIPSET_PKG)/$(CHIPSET_PKG).dec
  SioDummyPkg/SioDummyPkg.dec

[LibraryClasses]
  UefiLib
  BaseMemoryLib
  DebugLib
  MemoryAllocationLib
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  FlashRegionLib
  FlashDevicesLib
  PrintLib
  FwUpdateLib
  VariableLib

[Pcd]
  gInsydeTokenSpaceGuid.PcdFlashAreaSize
  gChipsetPkgTokenSpaceGuid.PcdWindowsEcFirmwareCapsuleGuid


[FixedPcd]
  gInsydeTokenSpaceGuid.PcdFirmwareResourceMaximum
#[-start-190613-IB16990069-add]#
  gInsydeTokenSpaceGuid.PcdSoftwareSmiPort
#[-end-190613-IB16990069-add]#

[Guids]
  gEfiSystemResourceTableGuid
  gH2OFlashMapRegionFtwBackupGuid

[Protocols]
  gEfiFirmwareManagementProtocolGuid

