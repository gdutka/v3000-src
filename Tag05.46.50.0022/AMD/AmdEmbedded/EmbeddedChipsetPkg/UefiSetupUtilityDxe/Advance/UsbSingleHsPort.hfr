      oneof
        varid       = SystemConfig.Usb2Port[PORT_INDEX],
        prompt      = STRING_TOKEN(CONCATENATE3(STR_USB_HS_PORT,PORT_INDEX,_PROMPT)),
        help        = STRING_TOKEN(CONCATENATE3(STR_USB_HS_PORT,PORT_INDEX,_HELP)),
#ifndef ENABLED_ONLY
        option text = STRING_TOKEN(STR_DISABLED_TEXT), value = 0, flags = 0;
#endif
        option text = STRING_TOKEN(STR_ENABLED_TEXT),  value = 1, flags = DEFAULT;
      endoneof;