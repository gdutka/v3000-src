//      oneof
//        varid       = SystemConfig.SataControllr0Port7Power,
//        prompt      = STRING_TOKEN(STR_SATA_PORT7_ENABLE_DISABLE_STRING),
//        help        = STRING_TOKEN(STR_SATA_PORT7_ENABLE_DISABLE_HELP),
//        option text = STRING_TOKEN(STR_DISABLED_TEXT), value = 0, flags = 0;
