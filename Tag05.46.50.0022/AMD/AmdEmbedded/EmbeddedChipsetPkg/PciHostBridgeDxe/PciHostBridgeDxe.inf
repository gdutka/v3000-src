[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = PciHostBridge
  FILE_GUID                      = 2383608E-C6D0-4e3e-858D-45DFAC3543D5
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0

  ENTRY_POINT                    = InitializePciHostBridge

[Packages]
  MdePkg/MdePkg.dec
  PcAtChipsetPkg/PcAtChipsetPkg.dec
  InsydeModulePkg/InsydeModulePkg.dec
  $(CHIPSET_PKG)/$(CHIPSET_PKG).dec
  AgesaModulePkg/AgesaCommonModulePkg.dec
  AgesaPkg/AgesaPkg.dec
#>>EnableAbove4GBMmio++
  $(PROJECT_PKG)/Project.dec
#<<EnableAbove4GBMmio++
  MdeModulePkg/MdeModulePkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  DxeServicesTableLib
  UefiLib
  MemoryAllocationLib
  BaseMemoryLib
  BaseLib
  DebugLib
  DevicePathLib
  IoLib
  PciLib
  UefiRuntimeServicesTableLib
  HobLib
  S3BootScriptLib
  FabricResourceManagerLib
#>>EnableAbove4GBMmio++
  PcdLib
#<<EnableAbove4GBMmio++

[Sources]
  PciHostBridge.c
  PciRootBridgeIo.c
  PciHostBridge.h
  IoFifo.h

[Sources.IA32]
  Ia32/IoFifo.asm

[Sources.X64]
  X64/IoFifo.asm

[Guids]
  gMemoryCeilingVariableGuid
  
[Protocols]
  gEfiPciHostBridgeResourceAllocationProtocolGuid
  gEfiPciRootBridgeIoProtocolGuid
  gEfiMetronomeArchProtocolGuid
  gEfiDevicePathProtocolGuid
  gAmdApcbDxeServiceProtocolGuid
#>>EnableAbove4GBMmio++
  gEfiGlobalNvsAreaProtocolGuid
#<<EnableAbove4GBMmio++
  gEdkiiIoMmuProtocolGuid

[Pcd]
  gEfiMdePkgTokenSpaceGuid.PcdPciExpressBaseAddress
  gChipsetPkgTokenSpaceGuid.PcdH2OPciExpressSize
  gPcAtChipsetPkgTokenSpaceGuid.PcdIoApicBaseAddress
  gInsydeTokenSpaceGuid.PcdFlashAreaBaseAddress
  gInsydeTokenSpaceGuid.PcdFlashAreaSize
  gInsydeTokenSpaceGuid.PcdH2ODdtSupported
#>>EnableAbove4GBMmio++
  gChipsetPkgTokenSpaceGuid.PcdH2OMmioMem64Enable
#<<EnableAbove4GBMmio++

[depex]
  gEfiMetronomeArchProtocolGuid AND
  gAmdApcbDxeServiceProtocolGuid
