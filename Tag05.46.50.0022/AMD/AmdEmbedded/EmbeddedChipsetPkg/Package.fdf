    SECTION RAW = $(CHIPSET_PKG)/Binary/SLP20Pubkey/SLP20Pubkey.bin
  }
FILE FREEFORM = PCD (gChipsetPkgTokenSpaceGuid.PcdH2OSlpP20MarkerFile) {
    SECTION RAW = $(CHIPSET_PKG)/Binary/SLP20Marker/SLP20Marker.bin
  }
#
# OA3.0 supported
#
FILE FREEFORM = PCD (gChipsetPkgTokenSpaceGuid.PcdH2OOa30MsdmDataFile) {
