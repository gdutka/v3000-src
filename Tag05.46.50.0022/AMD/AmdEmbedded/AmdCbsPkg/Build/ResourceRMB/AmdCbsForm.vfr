 *
 *******************************************************************************
 */
#include <Guid/HiiPlatformSetupFormset.h>
#include "AmdCbsFormID.h"
#include <Guid/AmdCbsConfig.h>
#include "AmdCbsVariable.h"

#define EFI_AMD_CBS_CLASS 0x55

formset
  guid      = FORMSET_ID_GUID_AMD_CBS,
  title     = STRING_TOKEN(AMD_CBS_STR_CBS_ROOT_SECTION),
  help      = STRING_TOKEN(AMD_CBS_STR_CBS_ROOT_SECTION_HELP),
  class     = EFI_AMD_CBS_CLASS, subclass = 0,

  varstore CBS_CONFIG,                        // This is the data structure type
    varid = CBS_CONFIGURATION_VARSTORE_ID,    // Optional VarStore ID
    name  = AmdSetup,                         // Define referenced name in vfr
    guid  = CBS_SYSTEM_CONFIGURATION_GUID;    // GUID of this buffer storage
  //
  // form - CBS_ROOT
  //
  form

    formid        = SETUP_CBS_ROOT_LABLE,

    title         = STRING_TOKEN (AMD_CBS_STR_CBS_ROOT_SECTION);

    subtitle text = STRING_TOKEN (AMD_CBS_STR_CBS_ROOT_SECTION);
    subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

    text
      help         = STRING_TOKEN (AMD_CBS_STR_BLANK),
      text         = STRING_TOKEN (AMD_CBS_STR_REVISION_STRING),
      text         = STRING_TOKEN (AMD_CBS_STR_REVISION_VALUE);
    subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

    goto SETUP_CPU_COMMON_OPTIONS_LABLE,
      prompt      = STRING_TOKEN (AMD_CBS_STR_CPU_COMMON_OPTIONS_SECTION),
      help        = STRING_TOKEN (AMD_CBS_STR_CPU_COMMON_OPTIONS_SECTION);

    goto SETUP_DF_COMMON_OPTIONS_LABLE,
      prompt      = STRING_TOKEN (AMD_CBS_STR_DF_COMMON_OPTIONS_SECTION),
      help        = STRING_TOKEN (AMD_CBS_STR_DF_COMMON_OPTIONS_SECTION);

    goto SETUP_UMC_COMMON_OPTIONS_LABLE,
      prompt      = STRING_TOKEN (AMD_CBS_STR_UMC_COMMON_OPTIONS_SECTION),
      help        = STRING_TOKEN (AMD_CBS_STR_UMC_COMMON_OPTIONS_SECTION);

    goto SETUP_NBIO_COMMON_OPTIONS_LABLE,
      prompt      = STRING_TOKEN (AMD_CBS_STR_NBIO_COMMON_OPTIONS_SECTION),
      help        = STRING_TOKEN (AMD_CBS_STR_NBIO_COMMON_OPTIONS_SECTION);

    goto SETUP_FCH_COMMON_OPTIONS_LABLE,
      prompt      = STRING_TOKEN (AMD_CBS_STR_FCH_COMMON_OPTIONS_SECTION),
      help        = STRING_TOKEN (AMD_CBS_STR_FCH_COMMON_OPTIONS_SECTION);

    goto SETUP_SMU_COMMON_OPTIONS_LABLE,
      prompt      = STRING_TOKEN (AMD_CBS_STR_SMU_COMMON_OPTIONS_SECTION),
      help        = STRING_TOKEN (AMD_CBS_STR_SMU_COMMON_OPTIONS_SECTION);

    goto SETUP_SOC_MISCELLANEOUS_CONTROL_LABLE,
      prompt      = STRING_TOKEN (AMD_CBS_STR_SOC_MISCELLANEOUS_CONTROL_SECTION),
      help        = STRING_TOKEN (AMD_CBS_STR_SOC_MISCELLANEOUS_CONTROL_SECTION);

    goto SETUP_PROM21_CHIPSET_COMMON_OPTIONS_LABLE,
      prompt      = STRING_TOKEN (AMD_CBS_STR_PROM21_CHIPSET_COMMON_OPTIONS_SECTION),
      help        = STRING_TOKEN (AMD_CBS_STR_PROM21_CHIPSET_COMMON_OPTIONS_SECTION);

    // Display Condition: CbsComboFlag = 255
    suppressif NOT ideqval CBS_CONFIG.CbsComboFlag == 255;
      // Combo CBS
      // No help string
      numeric
        varid       = CBS_CONFIG.CbsComboFlag,
        prompt      = STRING_TOKEN (AMD_CBS_STR_COMBO_CBS),
        help        = STRING_TOKEN (AMD_CBS_STR_COMBO_CBS_HELP),
        flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
        minimum     = 0x00,
        maximum     = 0xff,
        step        = 0,
        default     = 254,
      endnumeric;
    endif;

  endform;


    //
    // form - CPU Common Options
    //
    form

      formid        = SETUP_CPU_COMMON_OPTIONS_LABLE,

      title         = STRING_TOKEN (AMD_CBS_STR_CPU_COMMON_OPTIONS_SECTION);

      subtitle text = STRING_TOKEN (AMD_CBS_STR_CPU_COMMON_OPTIONS_SECTION);
      subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

      // Display Condition: CbsComboFlag=0
      suppressif NOT ideqval CBS_CONFIG.CbsComboFlag == 0;
        goto SETUP_PERFORMANCE_LABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_PERFORMANCE_SECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_PERFORMANCE_SECTION);
      endif;

      goto SETUP_PREFETCHER_SETTINGS_LABLE,
        prompt      = STRING_TOKEN (AMD_CBS_STR_PREFETCHER_SETTINGS_SECTION),
        help        = STRING_TOKEN (AMD_CBS_STR_PREFETCHER_SETTINGS_SECTION);

      goto SETUP_CORE_WATCHDOG_LABLE,
        prompt      = STRING_TOKEN (AMD_CBS_STR_CORE_WATCHDOG_SECTION),
        help        = STRING_TOKEN (AMD_CBS_STR_CORE_WATCHDOG_SECTION);

      goto SETUP_CCD_CORE_THREAD_ENABLEMENT_LABLE,
        prompt      = STRING_TOKEN (AMD_CBS_STR_CCD_CORE_THREAD_ENABLEMENT_SECTION),
        help        = STRING_TOKEN (AMD_CBS_STR_CCD_CORE_THREAD_ENABLEMENT_SECTION);

      text
        help        = STRING_TOKEN (AMD_CBS_STR_BLANK),
        text        = STRING_TOKEN (AMD_CBS_STR_BLANK);

      // RedirectForReturnDis
      // From a workaround for GCC/C000005 issue for XV Core on CZ A0, setting MSRC001_1029 Decode Configuration (DE_CFG) bit 14 [DecfgNoRdrctForReturns] to 1
      oneof
        varid       = CBS_CONFIG.CbsCmnCpuGenWA05,
        prompt      = STRING_TOKEN (AMD_CBS_STR_REDIRECTFORRETURNDIS),
        help        = STRING_TOKEN (AMD_CBS_STR_REDIRECTFORRETURNDIS_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_1),               value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_0),               value = 0,    flags = 0 | RESET_REQUIRED;
      endoneof;

      // Core Performance Boost
      // Disable CPB
      oneof
        varid       = CBS_CONFIG.CbsCmnCpuCpb,
        prompt      = STRING_TOKEN (AMD_CBS_STR_CORE_PERFORMANCE_BOOST),
        help        = STRING_TOKEN (AMD_CBS_STR_CORE_PERFORMANCE_BOOST_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 1,    flags = DEFAULT | RESET_REQUIRED;
      endoneof;

      // Global C-state Control
      // Controls IO based C-state generation and DF C-states.\nThere is another DF Cstate option which will be synchronized with this option if DF Cstate option is auto.
      oneof
        varid       = CBS_CONFIG.CbsCmnCpuGlobalCstateCtrl,
        prompt      = STRING_TOKEN (AMD_CBS_STR_GLOBAL_C_STATE_CONTROL),
        help        = STRING_TOKEN (AMD_CBS_STR_GLOBAL_C_STATE_CONTROL_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 3,    flags = DEFAULT | RESET_REQUIRED;
      endoneof;

      // Display Condition: CbsCmnCpuOpcacheGrayoutFlag=Display
      suppressif NOT ideqval CBS_CONFIG.CbsCmnCpuOpcacheGrayoutFlag == 2;
        // Opcache grayout flag
        // No help string
        oneof
          varid       = CBS_CONFIG.CbsCmnCpuOpcacheGrayoutFlag,
          questionid  = KEY_CBS_CMN_CPU_OPCACHE_GRAYOUT_FLAG,
          prompt      = STRING_TOKEN (AMD_CBS_STR_OPCACHE_GRAYOUT_FLAG),
          help        = STRING_TOKEN (AMD_CBS_STR_OPCACHE_GRAYOUT_FLAG_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_0),               value = 0,    flags = DEFAULT | RESET_REQUIRED | INTERACTIVE;
          option text = STRING_TOKEN (AMD_CBS_STR_1),               value = 1,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
          option text = STRING_TOKEN (AMD_CBS_STR_DISPLAY),         value = 2,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
        endoneof;
      endif;

      // Active Condition: CbsCmnCpuOpcacheGrayoutFlag=0
      grayoutif NOT ideqval CBS_CONFIG.CbsCmnCpuOpcacheGrayoutFlag == 0;
        // Opcache Control
        // Enables or disables the Opcache
        oneof
          varid       = CBS_CONFIG.CbsCmnCpuOpcacheCtrl,
          questionid  = KEY_CBS_CMN_CPU_OPCACHE_CTRL,
          prompt      = STRING_TOKEN (AMD_CBS_STR_OPCACHE_CONTROL),
          help        = STRING_TOKEN (AMD_CBS_STR_OPCACHE_CONTROL_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 1,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 0,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED | INTERACTIVE;
        endoneof;
      endif;

      // SEV ASID Count
      // This fields specifies the maximum valid ASID, which affects the maximum system physical address space. 16TB of physical address space is available for systems that support 253 ASIDs, while 8TB of physical address space is available for systems that support 509 ASIDs.
      oneof
        varid       = CBS_CONFIG.CbsCmnCpuSevAsidCount,
        prompt      = STRING_TOKEN (AMD_CBS_STR_SEV_ASID_COUNT),
        help        = STRING_TOKEN (AMD_CBS_STR_SEV_ASID_COUNT_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_253_ASIDS),       value = 0,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_509_ASIDS),       value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 3,    flags = DEFAULT | RESET_REQUIRED;
      endoneof;

      // SEV-ES ASID Space Limit Control
      // No help string
      oneof
        varid       = CBS_CONFIG.CbsCmnCpuSevAsidSpaceCtrl,
        prompt      = STRING_TOKEN (AMD_CBS_STR_SEV_ES_ASID_SPACE_LIMIT_CONTROL),
        help        = STRING_TOKEN (AMD_CBS_STR_SEV_ES_ASID_SPACE_LIMIT_CONTROL_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0,    flags = DEFAULT | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_MANUAL),          value = 1,    flags = 0 | RESET_REQUIRED;
      endoneof;

      // Display Condition: CbsCmnCpuSevAsidSpaceCtrl=Manual
      suppressif NOT ideqval CBS_CONFIG.CbsCmnCpuSevAsidSpaceCtrl == 1;
        // SEV-ES ASID Space Limit
        // SEV VMs using ASIDs below the SEV-ES ASID Space Limit must enable the SEV-ES feature. ASIDs from SEV-ES ASID Space Limit to (SEV ASID Count + 1) can only be used with SEV VMs. If this field is set to (SEV ASID Count + 1), all ASIDs are forced to be SEV-ES ASIDs. Hence, the valid values for this field is 1 - (SEV ASID Count + 1)
        numeric
          varid       = CBS_CONFIG.CbsCmnCpuSevAsidSpaceLimit,
          prompt      = STRING_TOKEN (AMD_CBS_STR_SEV_ES_ASID_SPACE_LIMIT),
          help        = STRING_TOKEN (AMD_CBS_STR_SEV_ES_ASID_SPACE_LIMIT_HELP),
          flags       = RESET_REQUIRED,
          minimum     = 1,
          maximum     = 510,
          step        = 0,
          default     = 1,
        endnumeric;
      endif;

      // Streaming Stores Control
      // Enables or disables the streaming stores functionality
      oneof
        varid       = CBS_CONFIG.CbsCmnCpuStreamingStoresCtrl,
        prompt      = STRING_TOKEN (AMD_CBS_STR_STREAMING_STORES_CONTROL),
        help        = STRING_TOKEN (AMD_CBS_STR_STREAMING_STORES_CONTROL_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 0,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
      endoneof;

      // Local APIC Mode
      // No help string
      oneof
        varid       = CBS_CONFIG.CbsCpuLApicMode,
        prompt      = STRING_TOKEN (AMD_CBS_STR_LOCAL_APIC_MODE),
        help        = STRING_TOKEN (AMD_CBS_STR_LOCAL_APIC_MODE_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_COMPATIBILITY),   value = 0,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_XAPIC),           value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_X2APIC),          value = 2,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
      endoneof;

      // ACPI _CST C1 Declaration
      // Determines whether or not to declare the C1 state to the OS.
      oneof
        varid       = CBS_CONFIG.CbsCmnCpuCstC1Ctrl,
        prompt      = STRING_TOKEN (AMD_CBS_STR_ACPI_CST_C1_DECLARATION),
        help        = STRING_TOKEN (AMD_CBS_STR_ACPI_CST_C1_DECLARATION_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 3,    flags = DEFAULT | RESET_REQUIRED;
      endoneof;

      // ACPI _PSS
      // Enable / disable the P-state object declaration to the OS.
      oneof
        varid       = CBS_CONFIG.CbsCmnCpuPMCtlPss,
        prompt      = STRING_TOKEN (AMD_CBS_STR_ACPI_PSS),
        help        = STRING_TOKEN (AMD_CBS_STR_ACPI_PSS_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 3,    flags = DEFAULT | RESET_REQUIRED;
      endoneof;

      // MCA error thresh enable
      // Enable MCA error thresholding.
      oneof
        varid       = CBS_CONFIG.CbsCmnCpuMcaErrThreshEn,
        prompt      = STRING_TOKEN (AMD_CBS_STR_MCA_ERROR_THRESH_ENABLE),
        help        = STRING_TOKEN (AMD_CBS_STR_MCA_ERROR_THRESH_ENABLE_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_FALSE),           value = 0,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_TRUE),            value = 1,    flags = DEFAULT | RESET_REQUIRED;
      endoneof;

      // Display Condition: CbsCmnCpuMcaErrThreshEn=True
      suppressif NOT ideqval CBS_CONFIG.CbsCmnCpuMcaErrThreshEn == 1;
        // MCA error thresh count
        // Effective error threshold count = 4095(0xFFF) - <this value> (e.g. the default value of 0xFF5 results in a threshold of 10).
        numeric
          varid       = CBS_CONFIG.CbsCmnCpuMcaErrThreshCount,
          prompt      = STRING_TOKEN (AMD_CBS_STR_MCA_ERROR_THRESH_COUNT),
          help        = STRING_TOKEN (AMD_CBS_STR_MCA_ERROR_THRESH_COUNT_HELP),
          flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
          minimum     = 1,
          maximum     = 4095,
          step        = 0,
          default     = 4085,
        endnumeric;
      endif;

      // SMU and PSP Debug Mode
      // When this option is enabled, specific uncorrected errors detected by the PSP FW or SMU FW will hang and not reset the system
      oneof
        varid       = CBS_CONFIG.CbsCmnCpuSmuPspDebugMode,
        prompt      = STRING_TOKEN (AMD_CBS_STR_SMU_AND_PSP_DEBUG_MODE),
        help        = STRING_TOKEN (AMD_CBS_STR_SMU_AND_PSP_DEBUG_MODE_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 3,    flags = DEFAULT | RESET_REQUIRED;
      endoneof;

      // PPIN Opt-in
      // Turn on PPIN feature
      oneof
        varid       = CBS_CONFIG.CbsCmnCpuPpinCtrl,
        prompt      = STRING_TOKEN (AMD_CBS_STR_PPIN_OPT_IN),
        help        = STRING_TOKEN (AMD_CBS_STR_PPIN_OPT_IN_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
      endoneof;

      // Display Condition: CbsComboFlag=17|CbsComboFlag=18
      suppressif NOT ideqval CBS_CONFIG.CbsComboFlag == 17
             AND NOT ideqval CBS_CONFIG.CbsComboFlag == 18;
        // Fast Short REP MOVSB
        // No help string
        oneof
          varid       = CBS_CONFIG.CbsCmnCpuFSRM,
          prompt      = STRING_TOKEN (AMD_CBS_STR_FAST_SHORT_REP_MOVSB),
          help        = STRING_TOKEN (AMD_CBS_STR_FAST_SHORT_REP_MOVSB_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = DEFAULT | RESET_REQUIRED;
        endoneof;
      endif;

      // Display Condition: CbsComboFlag=17|CbsComboFlag=18
      suppressif NOT ideqval CBS_CONFIG.CbsComboFlag == 17
             AND NOT ideqval CBS_CONFIG.CbsComboFlag == 18;
        // Enhanced REP MOVSB/STOSB
        // No help string
        oneof
          varid       = CBS_CONFIG.CbsCmnCpuERMS,
          prompt      = STRING_TOKEN (AMD_CBS_STR_ENHANCED_REP_MOVSB_STOSB),
          help        = STRING_TOKEN (AMD_CBS_STR_ENHANCED_REP_MOVSB_STOSB_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = DEFAULT | RESET_REQUIRED;
        endoneof;
      endif;

      // Action on BIST Failure
      // Action to take when a Core BIST failure is detected.
      oneof
        varid       = CBS_CONFIG.CbsCmnActionOnBistFailure,
        prompt      = STRING_TOKEN (AMD_CBS_STR_ACTION_ON_BIST_FAILURE),
        help        = STRING_TOKEN (AMD_CBS_STR_ACTION_ON_BIST_FAILURE_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_DO_NOTHING),      value = 0,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_DOWN_CORE),       value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
      endoneof;

      // IBS hardware workaround
      // Set if using IBS execution sampling without software workaround for erratum 1,285. May impact performance.
      oneof
        varid       = CBS_CONFIG.CbsCmnCpuIbsHardwareCtrl,
        prompt      = STRING_TOKEN (AMD_CBS_STR_IBS_HARDWARE_WORKAROUND),
        help        = STRING_TOKEN (AMD_CBS_STR_IBS_HARDWARE_WORKAROUND_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0,    flags = DEFAULT | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
      endoneof;

    endform;
      //
      // form - Performance
      //
      form

        formid        = SETUP_PERFORMANCE_LABLE,

        title         = STRING_TOKEN (AMD_CBS_STR_PERFORMANCE_SECTION);

        subtitle text = STRING_TOKEN (AMD_CBS_STR_PERFORMANCE_SECTION);
        subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

        // Display Condition: CbsComboFlag=255
        suppressif NOT ideqval CBS_CONFIG.CbsComboFlag == 255;
          // OC Mode
          // No help string
          oneof
            varid       = CBS_CONFIG.CbsCmnCpuOcMode,
            questionid  = KEY_CBS_CMN_CPU_OC_MODE,
            prompt      = STRING_TOKEN (AMD_CBS_STR_OC_MODE),
            help        = STRING_TOKEN (AMD_CBS_STR_OC_MODE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_NORMAL_OPERATION), value = 0,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
            option text = STRING_TOKEN (AMD_CBS_STR_OC1),             value = 1,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
            option text = STRING_TOKEN (AMD_CBS_STR_OC2),             value = 2,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
            option text = STRING_TOKEN (AMD_CBS_STR_OC3),             value = 3,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
            option text = STRING_TOKEN (AMD_CBS_STR_CUSTOMIZED),      value = 5,    flags = DEFAULT | RESET_REQUIRED | INTERACTIVE;
          endoneof;
        endif;

        // Active Condition: CbsCmnCpuOcMode=Customized
        grayoutif NOT ideqval CBS_CONFIG.CbsCmnCpuOcMode == 5;
          goto SETUP_CUSTOM_CORE_PSTATES_LABLE,
            prompt      = STRING_TOKEN (AMD_CBS_STR_CUSTOM_CORE_PSTATES_SECTION),
            help        = STRING_TOKEN (AMD_CBS_STR_CUSTOM_CORE_PSTATES_SECTION);
        endif;

      endform;
        //
        // form - Custom Core Pstates
        //
        form

          formid        = SETUP_CUSTOM_CORE_PSTATES_LABLE,

          title         = STRING_TOKEN (AMD_CBS_STR_CUSTOM_CORE_PSTATES_SECTION);

          subtitle text = STRING_TOKEN (AMD_CBS_STR_CUSTOM_CORE_PSTATES_SECTION);
          subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

          // Pstates Disclaimer
          // Legal Disclaimer
          text
            help        = STRING_TOKEN (AMD_CBS_STR_PSTATES_DISCLAIMER_HELP),
            text        = STRING_TOKEN (AMD_CBS_STR_PSTATES_DISCLAIMER);

          // Pstates Disclaimer 1
          // Legal Disclaimer
          text
            help        = STRING_TOKEN (AMD_CBS_STR_PSTATES_DISCLAIMER_1_HELP),
            text        = STRING_TOKEN (AMD_CBS_STR_PSTATES_DISCLAIMER_1);

          goto SETUP_PERFORMANCE_LABLE,
            prompt      = STRING_TOKEN (AMD_CBS_STR_PSTATE_LEGAL_DISCLAIMER_DECLINE_SECTION),
            help        = STRING_TOKEN (AMD_CBS_STR_PSTATE_LEGAL_DISCLAIMER_DECLINE_SECTION);

          goto SETUP_PSTATE_LEGAL_DISCLAIMER_ACCEPT_LABLE,
            prompt      = STRING_TOKEN (AMD_CBS_STR_PSTATE_LEGAL_DISCLAIMER_ACCEPT_SECTION),
            help        = STRING_TOKEN (AMD_CBS_STR_PSTATE_LEGAL_DISCLAIMER_ACCEPT_SECTION);

        endform;
          //
          // form - Pstate_Legal_Disclaimer_Decline
          //
          form

            formid        = SETUP_PSTATE_LEGAL_DISCLAIMER_DECLINE_LABLE,

            title         = STRING_TOKEN (AMD_CBS_STR_PSTATE_LEGAL_DISCLAIMER_DECLINE_SECTION);

            subtitle text = STRING_TOKEN (AMD_CBS_STR_PSTATE_LEGAL_DISCLAIMER_DECLINE_SECTION);
            subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

          endform;
          //
          // form - Pstate_Legal_Disclaimer_Accept
          //
          form

            formid        = SETUP_PSTATE_LEGAL_DISCLAIMER_ACCEPT_LABLE,

            title         = STRING_TOKEN (AMD_CBS_STR_PSTATE_LEGAL_DISCLAIMER_ACCEPT_SECTION);

            subtitle text = STRING_TOKEN (AMD_CBS_STR_PSTATE_LEGAL_DISCLAIMER_ACCEPT_SECTION);
            subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

            // Active Condition: CbsCmnCpuOcMode=Customized
            grayoutif NOT ideqval CBS_CONFIG.CbsCmnCpuOcMode == 5;
              // Custom Pstate0
              // Custom - customize this Pstate, applicable only if PcdOcDisable=FALSE\n\nWARNING - DAMAGE CAUSED BY USE OF YOUR AMD PROCESSOR OUTSIDE OF SPECIFICATION OR IN EXCESS OF FACTORY SETTINGS ARE NOT COVERED UNDER YOUR AMD PRODUCT WARRANTY AND MAY NOT BE COVERED BY YOUR SYSTEM MANUFACTURER'S WARRANTY.\nOperating your AMD processor outside of specification or in excess of factory settings, including but not limited to overclocking, may damage or shorten the life of your processor or other system components, create system instabilities (e.g., data loss and corrupted images) and in extreme cases may result in total system failure. AMD does not provide support or service for issues or damages related to use of an AMD processor outside of processor specifications or in excess of factory settings.\n
              oneof
                varid       = CBS_CONFIG.CbsCpuPstCustomP0,
                questionid  = KEY_CBS_CPU_PST_CUSTOM_P0,
                prompt      = STRING_TOKEN (AMD_CBS_STR_CUSTOM_PSTATE0),
                help        = STRING_TOKEN (AMD_CBS_STR_CUSTOM_PSTATE0_HELP),
                option text = STRING_TOKEN (AMD_CBS_STR_CUSTOM),          value = 1,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
                option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 2,    flags = DEFAULT | RESET_REQUIRED | INTERACTIVE;
              endoneof;
            endif;

            // Display Condition: CbsCpuPstCustomP0=Custom
            // Active Condition: CbsCmnCpuOcMode=Customized
            suppressif NOT ideqval CBS_CONFIG.CbsCpuPstCustomP0 == 1;
            grayoutif NOT ideqval CBS_CONFIG.CbsCmnCpuOcMode == 5;
              // Pstate0 Freq (MHz)
              // Specifies core frequency (MHz)
              numeric
                varid       = CBS_CONFIG.CbsCpuPst0Freq,
                prompt      = STRING_TOKEN (AMD_CBS_STR_PSTATE0_FREQ_MHZ),
                help        = STRING_TOKEN (AMD_CBS_STR_PSTATE0_FREQ_MHZ_HELP),
                flags       = RESET_REQUIRED,
                minimum     = 0,
                maximum     = 0xffffffff,
                step        = 0,
                default     = 0,
              endnumeric;
            endif;
            endif;

            // Display Condition: CbsCpuPstCustomP0=Custom
            // Active Condition: CbsCmnCpuOcMode=Customized
            suppressif NOT ideqval CBS_CONFIG.CbsCpuPstCustomP0 == 1;
            grayoutif NOT ideqval CBS_CONFIG.CbsCmnCpuOcMode == 5;
              // Pstate0 VID
              // Specifies the core voltage.
              numeric
                varid       = CBS_CONFIG.CbsCpuPst0Vid,
                questionid  = KEY_CBS_CPU_PST0_VID,
                prompt      = STRING_TOKEN (AMD_CBS_STR_PSTATE0_VID),
                help        = STRING_TOKEN (AMD_CBS_STR_PSTATE0_VID_HELP),
                flags       = DISPLAY_UINT_HEX | RESET_REQUIRED | INTERACTIVE,
                minimum     = 0,
                maximum     = 0xff,
                step        = 0,
                default     = 255,
              endnumeric;
            endif;
            endif;

          endform;
      //
      // form - Prefetcher settings
      //
      form

        formid        = SETUP_PREFETCHER_SETTINGS_LABLE,

        title         = STRING_TOKEN (AMD_CBS_STR_PREFETCHER_SETTINGS_SECTION);

        subtitle text = STRING_TOKEN (AMD_CBS_STR_PREFETCHER_SETTINGS_SECTION);
        subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

        // L1 Stream HW Prefetcher
        // Option to Enable | Disable L1 Stream HW Prefetcher
        oneof
          varid       = CBS_CONFIG.CbsCmnCpuL1StreamHwPrefetcher,
          prompt      = STRING_TOKEN (AMD_CBS_STR_L1_STREAM_HW_PREFETCHER),
          help        = STRING_TOKEN (AMD_CBS_STR_L1_STREAM_HW_PREFETCHER_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLE),          value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 3,    flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // L2 Stream HW Prefetcher
        // Option to Enable | Disable L2 Stream HW Prefetcher
        oneof
          varid       = CBS_CONFIG.CbsCmnCpuL2StreamHwPrefetcher,
          prompt      = STRING_TOKEN (AMD_CBS_STR_L2_STREAM_HW_PREFETCHER),
          help        = STRING_TOKEN (AMD_CBS_STR_L2_STREAM_HW_PREFETCHER_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLE),          value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 3,    flags = DEFAULT | RESET_REQUIRED;
        endoneof;

      endform;
      //
      // form - Core Watchdog
      //
      form

        formid        = SETUP_CORE_WATCHDOG_LABLE,

        title         = STRING_TOKEN (AMD_CBS_STR_CORE_WATCHDOG_SECTION);

        subtitle text = STRING_TOKEN (AMD_CBS_STR_CORE_WATCHDOG_SECTION);
        subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

        // Core Watchdog Timer Enable
        // Enable or disable CPU Watchdog Timer
        oneof
          varid       = CBS_CONFIG.CbsDbgCpuGenCpuWdt,
          questionid  = KEY_CBS_DBG_CPU_GEN_CPU_WDT,
          prompt      = STRING_TOKEN (AMD_CBS_STR_CORE_WATCHDOG_TIMER_ENABLE),
          help        = STRING_TOKEN (AMD_CBS_STR_CORE_WATCHDOG_TIMER_ENABLE_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 3,    flags = DEFAULT | RESET_REQUIRED | INTERACTIVE;
        endoneof;

        // Display Condition: CbsDbgCpuGenCpuWdt=Enabled
        suppressif NOT ideqval CBS_CONFIG.CbsDbgCpuGenCpuWdt == 1;
          // Core Watchdog Timer Interval
          // No help string
          oneof
            varid       = CBS_CONFIG.CbsDbgCpuGenCpuWdtTimeout,
            prompt      = STRING_TOKEN (AMD_CBS_STR_CORE_WATCHDOG_TIMER_INTERVAL),
            help        = STRING_TOKEN (AMD_CBS_STR_CORE_WATCHDOG_TIMER_INTERVAL_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_21_DOT_461S),     value = 0x900, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_10_DOT_730S),     value = 0x800, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_5_DOT_364S),      value = 0x000, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_2_DOT_681S),      value = 0x100, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_1_DOT_340S),      value = 0x200, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_669_DOT_41MS),    value = 0x300, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_334_DOT_05MS),    value = 0x400, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_166_DOT_37MS),    value = 0x500, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_82_DOT_53MS),     value = 0x600, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_40_DOT_61MS),     value = 0x700, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_20_DOT_970MS),    value = 0x901, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_10_DOT_484MS),    value = 0x801, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_5_DOT_241MS),     value = 0x001, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_2_DOT_620MS),     value = 0x101, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_1_DOT_309MS),     value = 0x201, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_654_DOT_08US),    value = 0x301, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_326_DOT_4US),     value = 0x401, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_162_DOT_56US),    value = 0x501, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_80_DOT_64US),     value = 0x601, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_39_DOT_68US),     value = 0x701, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFFFF, flags = DEFAULT | RESET_REQUIRED;
          endoneof;
        endif;

        // Display Condition: CbsDbgCpuGenCpuWdt=Enabled
        suppressif NOT ideqval CBS_CONFIG.CbsDbgCpuGenCpuWdt == 1;
          // Core Watchdog Timer Severity
          // Specify the CPU watch dog timer severity (MSRC001_0074[CpuWdTmrCfgSeverity]).
          oneof
            varid       = CBS_CONFIG.CbsCmnCpuWdtSev,
            prompt      = STRING_TOKEN (AMD_CBS_STR_CORE_WATCHDOG_TIMER_SEVERITY),
            help        = STRING_TOKEN (AMD_CBS_STR_CORE_WATCHDOG_TIMER_SEVERITY_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_NO_ERROR),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_TRANSPARENT),     value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_CORRECTED),       value = 2,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_DEFERRED),        value = 3,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_UNCORRECTED),     value = 4,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_FATAL),           value = 5,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
          endoneof;
        endif;

      endform;
      //
      // form - CCD/Core/Thread Enablement
      //
      form

        formid        = SETUP_CCD_CORE_THREAD_ENABLEMENT_LABLE,

        title         = STRING_TOKEN (AMD_CBS_STR_CCD_CORE_THREAD_ENABLEMENT_SECTION);

        subtitle text = STRING_TOKEN (AMD_CBS_STR_CCD_CORE_THREAD_ENABLEMENT_SECTION);
        subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

        // Core control
        // Sets the number of cores to be used. Once this option has been used to remove any cores, a POWER CYCLE is required in order for future selections to take effect.
        oneof
          varid       = CBS_CONFIG.CbsCmnCpuCoreCtrlRmb,
          prompt      = STRING_TOKEN (AMD_CBS_STR_CORE_CONTROL),
          help        = STRING_TOKEN (AMD_CBS_STR_CORE_CONTROL_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0,    flags = DEFAULT | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ONE_1_0),         value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_TWO_2_0),         value = 3,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_THREE_3_0),       value = 4,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_FOUR_4_0),        value = 6,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_FIVE_5_0),        value = 8,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_SIX_6_0),         value = 9,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_SEVEN_7_0),       value = 10,   flags = 0 | RESET_REQUIRED;
        endoneof;

        // SMT Control
        // Can be used to disable symmetric multithreading. To re-enable SMT, a POWER CYCLE is needed after selecting the "Auto" option. 
        oneof
          varid       = CBS_CONFIG.CbsCmnCpuSmtCtrl,
          prompt      = STRING_TOKEN (AMD_CBS_STR_SMT_CONTROL),
          help        = STRING_TOKEN (AMD_CBS_STR_SMT_CONTROL_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0x1,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

      endform;
    //
    // form - DF Common Options
    //
    form

      formid        = SETUP_DF_COMMON_OPTIONS_LABLE,

      title         = STRING_TOKEN (AMD_CBS_STR_DF_COMMON_OPTIONS_SECTION);

      subtitle text = STRING_TOKEN (AMD_CBS_STR_DF_COMMON_OPTIONS_SECTION);
      subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

      goto SETUP_MEMORY_ADDRESSING_LABLE,
        prompt      = STRING_TOKEN (AMD_CBS_STR_MEMORY_ADDRESSING_SECTION),
        help        = STRING_TOKEN (AMD_CBS_STR_MEMORY_ADDRESSING_SECTION);

      text
        help        = STRING_TOKEN (AMD_CBS_STR_BLANK),
        text        = STRING_TOKEN (AMD_CBS_STR_BLANK);

      // Persistent memory Base Low
      // The persistent memory Base address lower 32 bits.It must be multiple of 1 MB.
      numeric
        varid       = CBS_CONFIG.CbsCmnPersistentLow,
        prompt      = STRING_TOKEN (AMD_CBS_STR_PERSISTENT_MEMORY_BASE_LOW),
        help        = STRING_TOKEN (AMD_CBS_STR_PERSISTENT_MEMORY_BASE_LOW_HELP),
        flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
        minimum     = 0,
        maximum     = 0xffffffff,
        step        = 0,
        default     = 0,
      endnumeric;

      // Persistent memory Base High
      // The persistent memory Base address higher 32 bits.
      numeric
        varid       = CBS_CONFIG.CbsCmnPersistentHigh,
        prompt      = STRING_TOKEN (AMD_CBS_STR_PERSISTENT_MEMORY_BASE_HIGH),
        help        = STRING_TOKEN (AMD_CBS_STR_PERSISTENT_MEMORY_BASE_HIGH_HELP),
        flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
        minimum     = 0,
        maximum     = 0xffffffff,
        step        = 0,
        default     = 0,
      endnumeric;

      // Persistent memory reserved size Low
      // To reserve the persistent memory size of lower 32 bits.
      numeric
        varid       = CBS_CONFIG.CbsCmnPersistentSizeLow,
        prompt      = STRING_TOKEN (AMD_CBS_STR_PERSISTENT_MEMORY_RESERVED_SIZE_LOW),
        help        = STRING_TOKEN (AMD_CBS_STR_PERSISTENT_MEMORY_RESERVED_SIZE_LOW_HELP),
        flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
        minimum     = 0,
        maximum     = 0xffffffff,
        step        = 0,
        default     = 0,
      endnumeric;

      // Persistent memory reserved size High
      // To reserve the persistent memory size of higher 32bits.
      numeric
        varid       = CBS_CONFIG.CbsCmnPersistentSizeHigh,
        prompt      = STRING_TOKEN (AMD_CBS_STR_PERSISTENT_MEMORY_RESERVED_SIZE_HIGH),
        help        = STRING_TOKEN (AMD_CBS_STR_PERSISTENT_MEMORY_RESERVED_SIZE_HIGH_HELP),
        flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
        minimum     = 0,
        maximum     = 0xffffffff,
        step        = 0,
        default     = 0,
      endnumeric;

      // Persistent memory Retention
      // To retain or clear Persistent memory during warmboot.\nAuto - Default(clear/OS call)\nEnabled - Send command to retain\nDisbaled - Send Command to clear      \n      
      oneof
        varid       = CBS_CONFIG.CbsCmnPersistentMemRetention,
        prompt      = STRING_TOKEN (AMD_CBS_STR_PERSISTENT_MEMORY_RETENTION),
        help        = STRING_TOKEN (AMD_CBS_STR_PERSISTENT_MEMORY_RETENTION_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
      endoneof;

      // CC6 memory region encryption
      // Control whether or not the CC6 save/restore memory is encrypted
      oneof
        varid       = CBS_CONFIG.CbsDfCmnCc6MemEncryption,
        prompt      = STRING_TOKEN (AMD_CBS_STR_CC6_MEMORY_REGION_ENCRYPTION),
        help        = STRING_TOKEN (AMD_CBS_STR_CC6_MEMORY_REGION_ENCRYPTION_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 3,    flags = DEFAULT | RESET_REQUIRED;
      endoneof;

      // Memory Clear
      // When this feature is disabled, BIOS does not implement MemClear after memory training (only if non-ECC DIMMs are used).
      oneof
        varid       = CBS_CONFIG.CbsDfCmnMemClear,
        prompt      = STRING_TOKEN (AMD_CBS_STR_MEMORY_CLEAR),
        help        = STRING_TOKEN (AMD_CBS_STR_MEMORY_CLEAR_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 0,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 3,    flags = DEFAULT | RESET_REQUIRED;
      endoneof;

      // Disable DF to external downstream IP SyncFloodPropagation
      // Disables Error propagation to UMC or any downstream slaves eg. FCH. Use this to avoid reset in failure scenario
      oneof
        varid       = CBS_CONFIG.CbsDfCmnExtIpSyncFloodProp,
        prompt      = STRING_TOKEN (AMD_CBS_STR_DISABLE_DF_TO_EXTERNAL_DOWNSTREAM_IP_SYNCFLOODPROPAGATION),
        help        = STRING_TOKEN (AMD_CBS_STR_DISABLE_DF_TO_EXTERNAL_DOWNSTREAM_IP_SYNCFLOODPROPAGATION_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_SYNC_FLOOD_DISABLED), value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_SYNC_FLOOD_ENABLED), value = 0,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
      endoneof;

      // Disable DF sync flood propagation
      // Control DF::PIEConfig[DisSyncFloodProp]\nDisables propagation from PIE to other DF components and eventually to SDP ports
      oneof
        varid       = CBS_CONFIG.CbsDfCmnSyncFloodProp,
        prompt      = STRING_TOKEN (AMD_CBS_STR_DISABLE_DF_SYNC_FLOOD_PROPAGATION),
        help        = STRING_TOKEN (AMD_CBS_STR_DISABLE_DF_SYNC_FLOOD_PROPAGATION_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_SYNC_FLOOD_DISABLED), value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_SYNC_FLOOD_ENABLED), value = 0,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 3,    flags = DEFAULT | RESET_REQUIRED;
      endoneof;

      // Freeze DF module queues on error
      // Disabling this option sets DF:DfGlobalCtrl[DisImmSyncFloodOnFatalError]\nEnables freezing of all DF queues on error and also forces a sync flood on HWA even if MCAs are disabled
      oneof
        varid       = CBS_CONFIG.CbsDfCmnFreezeQueueError,
        prompt      = STRING_TOKEN (AMD_CBS_STR_FREEZE_DF_MODULE_QUEUES_ON_ERROR),
        help        = STRING_TOKEN (AMD_CBS_STR_FREEZE_DF_MODULE_QUEUES_ON_ERROR_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 3,    flags = DEFAULT | RESET_REQUIRED;
      endoneof;

      // DF Cstates
      // When DF Cstate feature is enabled, FW programs the registers required to enable this feature is the DF HW. (For auto option, it means this option will synchronized with Global C State.)
      oneof
        varid       = CBS_CONFIG.CbsDfCmnCstates,
        prompt      = STRING_TOKEN (AMD_CBS_STR_DF_CSTATES),
        help        = STRING_TOKEN (AMD_CBS_STR_DF_CSTATES_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
      endoneof;

      // Display Condition: CbsComboFlag=0
      suppressif NOT ideqval CBS_CONFIG.CbsComboFlag == 0;
        // MP exception recovery handling
        // Recovery handling method incase of MP exception
        oneof
          varid       = CBS_CONFIG.CbsMpExcepRecovHandle,
          prompt      = STRING_TOKEN (AMD_CBS_STR_MP_EXCEPTION_RECOVERY_HANDLING),
          help        = STRING_TOKEN (AMD_CBS_STR_MP_EXCEPTION_RECOVERY_HANDLING_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_RECOVERY_DISABLED), value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_SYNCFLOOD),       value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_WARM_RESET),      value = 2,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_COLD_RESET),      value = 3,    flags = DEFAULT | RESET_REQUIRED;
        endoneof;
      endif;

      // Display Condition: CbsComboFlag=0
      suppressif NOT ideqval CBS_CONFIG.CbsComboFlag == 0;
        // Memory clear timeout
        // Configure time out on memory clear in seconds
        oneof
          varid       = CBS_CONFIG.CbsMemClrTimeout,
          prompt      = STRING_TOKEN (AMD_CBS_STR_MEMORY_CLEAR_TIMEOUT),
          help        = STRING_TOKEN (AMD_CBS_STR_MEMORY_CLEAR_TIMEOUT_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_5_SEC),           value = 5,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_10_SEC),          value = 10,   flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_15_SEC),          value = 15,   flags = DEFAULT | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_20_SEC),          value = 20,   flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_25_SEC),          value = 25,   flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_30_SEC),          value = 30,   flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_35_SEC),          value = 35,   flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_40_SEC),          value = 40,   flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_45_SEC),          value = 45,   flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_50_SEC),          value = 50,   flags = 0 | RESET_REQUIRED;
        endoneof;
      endif;

    endform;
      //
      // form - Memory Addressing
      //
      form

        formid        = SETUP_MEMORY_ADDRESSING_LABLE,

        title         = STRING_TOKEN (AMD_CBS_STR_MEMORY_ADDRESSING_SECTION);

        subtitle text = STRING_TOKEN (AMD_CBS_STR_MEMORY_ADDRESSING_SECTION);
        subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

        // Memory interleaving size
        // Controls the memory interleaving size. The valid values are AUTO, 256 bytes, 512 bytes, 1 Kbytes or 2Kbytes. This determines the starting address of the interleave (bit 8, 9, 10 or 11).
        oneof
          varid       = CBS_CONFIG.CbsDfCmnMemIntlvSize,
          prompt      = STRING_TOKEN (AMD_CBS_STR_MEMORY_INTERLEAVING_SIZE),
          help        = STRING_TOKEN (AMD_CBS_STR_MEMORY_INTERLEAVING_SIZE_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_256_BYTES),       value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_512_BYTES),       value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_1_KB),            value = 2,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_2_KB),            value = 3,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 7,    flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // DRAM map inversion
        // Inverting the map will cause the highest memory channels to get assigned the lowest addresses in the system.
        oneof
          varid       = CBS_CONFIG.CbsDfCmnDramMapInversion,
          prompt      = STRING_TOKEN (AMD_CBS_STR_DRAM_MAP_INVERSION),
          help        = STRING_TOKEN (AMD_CBS_STR_DRAM_MAP_INVERSION_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 3,    flags = DEFAULT | RESET_REQUIRED;
        endoneof;

      endform;
    //
    // form - UMC Common Options
    //
    form

      formid        = SETUP_UMC_COMMON_OPTIONS_LABLE,

      title         = STRING_TOKEN (AMD_CBS_STR_UMC_COMMON_OPTIONS_SECTION);

      subtitle text = STRING_TOKEN (AMD_CBS_STR_UMC_COMMON_OPTIONS_SECTION);
      subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

      // Active Condition: CbsComboFlag=1|CbsComboFlag=4|CbsComboFlag=2|CbsComboFlag=5
      grayoutif NOT ideqval CBS_CONFIG.CbsComboFlag == 1
            AND NOT ideqval CBS_CONFIG.CbsComboFlag == 4
            AND NOT ideqval CBS_CONFIG.CbsComboFlag == 2
            AND NOT ideqval CBS_CONFIG.CbsComboFlag == 5;
        goto SETUP_DDR_OPTIONS_LABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_DDR_OPTIONS_SECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_DDR_OPTIONS_SECTION);
      endif;

      // Display Condition: CbsComboFlag=255
      // Active Condition: CbsComboFlag=0|CbsComboFlag=3
      suppressif NOT ideqval CBS_CONFIG.CbsComboFlag == 255;
      grayoutif NOT ideqval CBS_CONFIG.CbsComboFlag == 0
            AND NOT ideqval CBS_CONFIG.CbsComboFlag == 3;
        goto SETUP_LPDDR_OPTIONS_LABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_LPDDR_OPTIONS_SECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_LPDDR_OPTIONS_SECTION);
      endif;
      endif;

    endform;
      //
      // form - DDR Options
      //
      form

        formid        = SETUP_DDR_OPTIONS_LABLE,

        title         = STRING_TOKEN (AMD_CBS_STR_DDR_OPTIONS_SECTION);

        subtitle text = STRING_TOKEN (AMD_CBS_STR_DDR_OPTIONS_SECTION);
        subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

        goto SETUP_DDR_TIMING_CONFIGURATION_LABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_DDR_TIMING_CONFIGURATION_SECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_DDR_TIMING_CONFIGURATION_SECTION);

        goto SETUP_DDR_BUS_CONFIGURATION_LABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_DDR_BUS_CONFIGURATION_SECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_DDR_BUS_CONFIGURATION_SECTION);

        goto SETUP_DDR_CONTROLLER_CONFIGURATION_LABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_DDR_CONTROLLER_CONFIGURATION_SECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_DDR_CONTROLLER_CONFIGURATION_SECTION);

        goto SETUP_DDR_RAS_LABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_DDR_RAS_SECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_DDR_RAS_SECTION);

        goto SETUP_DDR_SECURITY_LABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_DDR_SECURITY_SECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_DDR_SECURITY_SECTION);

        goto SETUP_DDR_ADDRESSING_OPTIONS_LABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_DDR_ADDRESSING_OPTIONS_SECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_DDR_ADDRESSING_OPTIONS_SECTION);

        goto SETUP_DDR_TRAINING_OPTIONS_LABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_DDR_TRAINING_OPTIONS_SECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_DDR_TRAINING_OPTIONS_SECTION);

        goto SETUP_DDR_MEMORY_MBIST_LABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_DDR_MEMORY_MBIST_SECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_DDR_MEMORY_MBIST_SECTION);

      endform;
        //
        // form - DDR Timing Configuration
        //
        form

          formid        = SETUP_DDR_TIMING_CONFIGURATION_LABLE,

          title         = STRING_TOKEN (AMD_CBS_STR_DDR_TIMING_CONFIGURATION_SECTION);

          subtitle text = STRING_TOKEN (AMD_CBS_STR_DDR_TIMING_CONFIGURATION_SECTION);
          subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

          // DRAM Timing Configuration Legal Disclaimer
          // No help string
          text
            help        = STRING_TOKEN (AMD_CBS_STR_DRAM_TIMING_CONFIGURATION_LEGAL_DISCLAIMER_HELP),
            text        = STRING_TOKEN (AMD_CBS_STR_DRAM_TIMING_CONFIGURATION_LEGAL_DISCLAIMER);

          // DRAM Timing Configuration Legal Disclaimer 1
          // No help string
          text
            help        = STRING_TOKEN (AMD_CBS_STR_DRAM_TIMING_CONFIGURATION_LEGAL_DISCLAIMER_1_HELP),
            text        = STRING_TOKEN (AMD_CBS_STR_DRAM_TIMING_CONFIGURATION_LEGAL_DISCLAIMER_1);

          goto SETUP_DDR_OPTIONS_LABLE,
            prompt      = STRING_TOKEN (AMD_CBS_STR_DDR_DTC_LEGAL_DISCLAIMER_DECLINE_SECTION),
            help        = STRING_TOKEN (AMD_CBS_STR_DDR_DTC_LEGAL_DISCLAIMER_DECLINE_SECTION);

          goto SETUP_DDR_DTC_LEGAL_DISCLAIMER_ACCEPT_LABLE,
            prompt      = STRING_TOKEN (AMD_CBS_STR_DDR_DTC_LEGAL_DISCLAIMER_ACCEPT_SECTION),
            help        = STRING_TOKEN (AMD_CBS_STR_DDR_DTC_LEGAL_DISCLAIMER_ACCEPT_SECTION);

        endform;
          //
          // form - DDR DTC_Legal_Disclaimer_Decline
          //
          form

            formid        = SETUP_DDR_DTC_LEGAL_DISCLAIMER_DECLINE_LABLE,

            title         = STRING_TOKEN (AMD_CBS_STR_DDR_DTC_LEGAL_DISCLAIMER_DECLINE_SECTION);

            subtitle text = STRING_TOKEN (AMD_CBS_STR_DDR_DTC_LEGAL_DISCLAIMER_DECLINE_SECTION);
            subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

          endform;
          //
          // form - DDR DTC_Legal_Disclaimer_Accept
          //
          form

            formid        = SETUP_DDR_DTC_LEGAL_DISCLAIMER_ACCEPT_LABLE,

            title         = STRING_TOKEN (AMD_CBS_STR_DDR_DTC_LEGAL_DISCLAIMER_ACCEPT_SECTION);

            subtitle text = STRING_TOKEN (AMD_CBS_STR_DDR_DTC_LEGAL_DISCLAIMER_ACCEPT_SECTION);
            subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

            // Active Memory Timing Settings
            oneof
              varid       = CBS_CONFIG.CbsCmnMemTimingSettingDdr,
              prompt      = STRING_TOKEN (AMD_CBS_STR_ACTIVE_MEMORY_TIMING_SETTINGS),
              help        = STRING_TOKEN (AMD_CBS_STR_ACTIVE_MEMORY_TIMING_SETTINGS_HELP),
              option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            endoneof;

            // Display Condition: CbsCmnMemTimingSettingDdr=Enabled
            suppressif NOT ideqval CBS_CONFIG.CbsCmnMemTimingSettingDdr == 1;
              // Memory Target Speed
              // Specifies the memory target speed in MT/s. The valid input is 2000 MT/s, 2400MT/s, and range of 3200MT/s ~ 12000 MT/s(stepping of 200 MT/s). The Value is in decimal.\nThe user input value will be rounded down to align with the stepping of 200MT/s.\nThe Maximum speed defined in the JEDEC spec is 12000MT/s, any input value that is greater than 12000MT/s will be limited to 12000MT/s.
              numeric
                varid       = CBS_CONFIG.CbsCmnMemTargetSpeedDdr,
                prompt      = STRING_TOKEN (AMD_CBS_STR_MEMORY_TARGET_SPEED),
                help        = STRING_TOKEN (AMD_CBS_STR_MEMORY_TARGET_SPEED_HELP),
                flags       = RESET_REQUIRED,
                minimum     = 2000,
                maximum     = 12000,
                step        = 0,
                default     = 3200,
              endnumeric;
            endif;

            // Active Condition: CbsCmnMemTimingSettingDdr=Enabled
            grayoutif NOT ideqval CBS_CONFIG.CbsCmnMemTimingSettingDdr == 1;
              goto SETUP_DDR_SPD_TIMING_LABLE,
                prompt      = STRING_TOKEN (AMD_CBS_STR_DDR_SPD_TIMING_SECTION),
                help        = STRING_TOKEN (AMD_CBS_STR_DDR_SPD_TIMING_SECTION);
            endif;

            // Active Condition: CbsCmnMemTimingSettingDdr=Enabled
            grayoutif NOT ideqval CBS_CONFIG.CbsCmnMemTimingSettingDdr == 1;
              goto SETUP_DDR_NON_SPD_TIMING_LABLE,
                prompt      = STRING_TOKEN (AMD_CBS_STR_DDR_NON_SPD_TIMING_SECTION),
                help        = STRING_TOKEN (AMD_CBS_STR_DDR_NON_SPD_TIMING_SECTION);
            endif;

          endform;
            //
            // form - DDR SPD Timing
            //
            form

              formid        = SETUP_DDR_SPD_TIMING_LABLE,

              title         = STRING_TOKEN (AMD_CBS_STR_DDR_SPD_TIMING_SECTION);

              subtitle text = STRING_TOKEN (AMD_CBS_STR_DDR_SPD_TIMING_SECTION);
              subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

              // Display Condition: CbsCmnMemTimingSettingDdr=Enabled
              suppressif NOT ideqval CBS_CONFIG.CbsCmnMemTimingSettingDdr == 1;
                // Tcl Ctrl
                // Auto: Follow default setting, Manual: Manually specify
                oneof
                  varid       = CBS_CONFIG.CbsCmnMemTimingTclCtrlDdr,
                  prompt      = STRING_TOKEN (AMD_CBS_STR_TCL_CTRL),
                  help        = STRING_TOKEN (AMD_CBS_STR_TCL_CTRL_HELP),
                  option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0,    flags = DEFAULT | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_MANUAL),          value = 1,    flags = 0 | RESET_REQUIRED;
                endoneof;
              endif;

              // Display Condition: CbsCmnMemTimingSettingDdr=Enabled,CbsCmnMemTimingTclCtrlDdr=Manual
              suppressif NOT ideqval CBS_CONFIG.CbsCmnMemTimingSettingDdr == 1
                      OR NOT ideqval CBS_CONFIG.CbsCmnMemTimingTclCtrlDdr == 1;
                // Tcl
                // Specifies the CAS Latency. Valid values: 0x16 ~ 0x40, stepping of 2. The value is in hex.
                numeric
                  varid       = CBS_CONFIG.CbsCmnMemTimingTclDdr,
                  prompt      = STRING_TOKEN (AMD_CBS_STR_TCL),
                  help        = STRING_TOKEN (AMD_CBS_STR_TCL_HELP),
                  flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
                  minimum     = 0x16,
                  maximum     = 0x40,
                  step        = 0,
                  default     = 22,
                endnumeric;
              endif;

              // Display Condition: CbsCmnMemTimingSettingDdr=Enabled
              suppressif NOT ideqval CBS_CONFIG.CbsCmnMemTimingSettingDdr == 1;
                // Trcd Ctrl
                // Auto: Follow default setting, Manual: Manually specify
                oneof
                  varid       = CBS_CONFIG.CbsCmnMemTimingTrcdCtrlDdr,
                  prompt      = STRING_TOKEN (AMD_CBS_STR_TRCD_CTRL),
                  help        = STRING_TOKEN (AMD_CBS_STR_TRCD_CTRL_HELP),
                  option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0,    flags = DEFAULT | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_MANUAL),          value = 1,    flags = 0 | RESET_REQUIRED;
                endoneof;
              endif;

              // Display Condition: CbsCmnMemTimingSettingDdr=Enabled,CbsCmnMemTimingTrcdCtrlDdr=Manual
              suppressif NOT ideqval CBS_CONFIG.CbsCmnMemTimingSettingDdr == 1
                      OR NOT ideqval CBS_CONFIG.CbsCmnMemTimingTrcdCtrlDdr == 1;
                // Trcd
                // Specifies the RAS# Active to CAS# Read Delay Time. Valid values: 0x8 ~ 0x3E, stepping of 2. The value is in hex.
                numeric
                  varid       = CBS_CONFIG.CbsCmnMemTimingTrcdDdr,
                  prompt      = STRING_TOKEN (AMD_CBS_STR_TRCD),
                  help        = STRING_TOKEN (AMD_CBS_STR_TRCD_HELP),
                  flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
                  minimum     = 0x8,
                  maximum     = 0x3E,
                  step        = 0,
                  default     = 8,
                endnumeric;
              endif;

              // Display Condition: CbsCmnMemTimingSettingDdr=Enabled
              suppressif NOT ideqval CBS_CONFIG.CbsCmnMemTimingSettingDdr == 1;
                // Trp Ctrl
                // Auto: Follow default setting, Manual: Manually specify
                oneof
                  varid       = CBS_CONFIG.CbsCmnMemTimingTrpCtrlDdr,
                  prompt      = STRING_TOKEN (AMD_CBS_STR_TRP_CTRL),
                  help        = STRING_TOKEN (AMD_CBS_STR_TRP_CTRL_HELP),
                  option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0,    flags = DEFAULT | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_MANUAL),          value = 1,    flags = 0 | RESET_REQUIRED;
                endoneof;
              endif;

              // Display Condition: CbsCmnMemTimingSettingDdr=Enabled,CbsCmnMemTimingTrpCtrlDdr=Manual
              suppressif NOT ideqval CBS_CONFIG.CbsCmnMemTimingSettingDdr == 1
                      OR NOT ideqval CBS_CONFIG.CbsCmnMemTimingTrpCtrlDdr == 1;
                // Trp
                // Specifies Row Precharge Delay Time. Valid values: 0x8 ~ 0x3E, stepping of 2. The value is in hex.
                numeric
                  varid       = CBS_CONFIG.CbsCmnMemTimingTrpDdr,
                  prompt      = STRING_TOKEN (AMD_CBS_STR_TRP),
                  help        = STRING_TOKEN (AMD_CBS_STR_TRP_HELP),
                  flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
                  minimum     = 0x8,
                  maximum     = 0x3E,
                  step        = 0,
                  default     = 8,
                endnumeric;
              endif;

              // Display Condition: CbsCmnMemTimingSettingDdr=Enabled
              suppressif NOT ideqval CBS_CONFIG.CbsCmnMemTimingSettingDdr == 1;
                // Tras Ctrl
                // Auto: Follow default setting, Manual: Manually specify
                oneof
                  varid       = CBS_CONFIG.CbsCmnMemTimingTrasCtrlDdr,
                  prompt      = STRING_TOKEN (AMD_CBS_STR_TRAS_CTRL),
                  help        = STRING_TOKEN (AMD_CBS_STR_TRAS_CTRL_HELP),
                  option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0,    flags = DEFAULT | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_MANUAL),          value = 1,    flags = 0 | RESET_REQUIRED;
                endoneof;
              endif;

              // Display Condition: CbsCmnMemTimingSettingDdr=Enabled,CbsCmnMemTimingTrasCtrlDdr=Manual
              suppressif NOT ideqval CBS_CONFIG.CbsCmnMemTimingSettingDdr == 1
                      OR NOT ideqval CBS_CONFIG.CbsCmnMemTimingTrasCtrlDdr == 1;
                // Tras
                // Specifies the Active to Precharge Delay Time. Valid values: 0x1E ~ 0x7E stepping of 2
                numeric
                  varid       = CBS_CONFIG.CbsCmnMemTimingTrasDdr,
                  prompt      = STRING_TOKEN (AMD_CBS_STR_TRAS),
                  help        = STRING_TOKEN (AMD_CBS_STR_TRAS_HELP),
                  flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
                  minimum     = 0x1E,
                  maximum     = 0x7E,
                  step        = 0,
                  default     = 30,
                endnumeric;
              endif;

              // Display Condition: CbsCmnMemTimingSettingDdr=Enabled
              suppressif NOT ideqval CBS_CONFIG.CbsCmnMemTimingSettingDdr == 1;
                // Trc Ctrl
                // Auto: Follow default setting, Manual: Manually specify
                oneof
                  varid       = CBS_CONFIG.CbsCmnMemTimingTrcCtrlDdr,
                  prompt      = STRING_TOKEN (AMD_CBS_STR_TRC_CTRL),
                  help        = STRING_TOKEN (AMD_CBS_STR_TRC_CTRL_HELP),
                  option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0,    flags = DEFAULT | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_MANUAL),          value = 1,    flags = 0 | RESET_REQUIRED;
                endoneof;
              endif;

              // Display Condition: CbsCmnMemTimingSettingDdr=Enabled,CbsCmnMemTimingTrcCtrlDdr=Manual
              suppressif NOT ideqval CBS_CONFIG.CbsCmnMemTimingSettingDdr == 1
                      OR NOT ideqval CBS_CONFIG.CbsCmnMemTimingTrcCtrlDdr == 1;
                // Trc
                // Specifies Active to Active/Refresh Delay Time. Valid values: 0x20 ~ 0xFF. The value is in hex.
                numeric
                  varid       = CBS_CONFIG.CbsCmnMemTimingTrcDdr,
                  prompt      = STRING_TOKEN (AMD_CBS_STR_TRC),
                  help        = STRING_TOKEN (AMD_CBS_STR_TRC_HELP),
                  flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
                  minimum     = 0x20,
                  maximum     = 0xFF,
                  step        = 0,
                  default     = 32,
                endnumeric;
              endif;

              // Display Condition: CbsCmnMemTimingSettingDdr=Enabled
              suppressif NOT ideqval CBS_CONFIG.CbsCmnMemTimingSettingDdr == 1;
                // Twr Ctrl
                // Auto: Follow default setting, Manual: Manually specify
                oneof
                  varid       = CBS_CONFIG.CbsCmnMemTimingTwrCtrlDdr,
                  prompt      = STRING_TOKEN (AMD_CBS_STR_TWR_CTRL),
                  help        = STRING_TOKEN (AMD_CBS_STR_TWR_CTRL_HELP),
                  option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0,    flags = DEFAULT | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_MANUAL),          value = 1,    flags = 0 | RESET_REQUIRED;
                endoneof;
              endif;

              // Display Condition: CbsCmnMemTimingSettingDdr=Enabled,CbsCmnMemTimingTwrCtrlDdr=Manual
              suppressif NOT ideqval CBS_CONFIG.CbsCmnMemTimingSettingDdr == 1
                      OR NOT ideqval CBS_CONFIG.CbsCmnMemTimingTwrCtrlDdr == 1;
                // Twr
                // Specifies the Minimum Write Recovery Time. Valid values: 0x30 ~ 0x60, stepping of 2. The value is in hex.
                numeric
                  varid       = CBS_CONFIG.CbsCmnMemTimingTwrDdr,
                  prompt      = STRING_TOKEN (AMD_CBS_STR_TWR),
                  help        = STRING_TOKEN (AMD_CBS_STR_TWR_HELP),
                  flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
                  minimum     = 0x30,
                  maximum     = 0x60,
                  step        = 0,
                  default     = 48,
                endnumeric;
              endif;

              // Display Condition: CbsCmnMemTimingSettingDdr=Enabled
              suppressif NOT ideqval CBS_CONFIG.CbsCmnMemTimingSettingDdr == 1;
                // Trfc1 Ctrl
                // Auto: Follow default setting, Manual: Manually specify
                oneof
                  varid       = CBS_CONFIG.CbsCmnMemTimingTrfc1CtrlDdr,
                  prompt      = STRING_TOKEN (AMD_CBS_STR_TRFC1_CTRL),
                  help        = STRING_TOKEN (AMD_CBS_STR_TRFC1_CTRL_HELP),
                  option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0,    flags = DEFAULT | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_MANUAL),          value = 1,    flags = 0 | RESET_REQUIRED;
                endoneof;
              endif;

              // Display Condition: CbsCmnMemTimingSettingDdr=Enabled,CbsCmnMemTimingTrfc1CtrlDdr=Manual
              suppressif NOT ideqval CBS_CONFIG.CbsCmnMemTimingSettingDdr == 1
                      OR NOT ideqval CBS_CONFIG.CbsCmnMemTimingTrfc1CtrlDdr == 1;
                // Trfc1
                // Specifies the Refresh Recovery Delay Time (tRFC1). Valid values 0x32 ~ 0xFFF. The value is in hex.
                numeric
                  varid       = CBS_CONFIG.CbsCmnMemTimingTrfc1Ddr,
                  prompt      = STRING_TOKEN (AMD_CBS_STR_TRFC1),
                  help        = STRING_TOKEN (AMD_CBS_STR_TRFC1_HELP),
                  flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
                  minimum     = 0x32,
                  maximum     = 0xFFF,
                  step        = 0,
                  default     = 50,
                endnumeric;
              endif;

              // Display Condition: CbsCmnMemTimingSettingDdr=Enabled
              suppressif NOT ideqval CBS_CONFIG.CbsCmnMemTimingSettingDdr == 1;
                // Trfc2 Ctrl
                // Auto: Follow default setting, Manual: Manually specify
                oneof
                  varid       = CBS_CONFIG.CbsCmnMemTimingTrfc2CtrlDdr,
                  prompt      = STRING_TOKEN (AMD_CBS_STR_TRFC2_CTRL),
                  help        = STRING_TOKEN (AMD_CBS_STR_TRFC2_CTRL_HELP),
                  option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0,    flags = DEFAULT | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_MANUAL),          value = 1,    flags = 0 | RESET_REQUIRED;
                endoneof;
              endif;

              // Display Condition: CbsCmnMemTimingSettingDdr=Enabled,CbsCmnMemTimingTrfc2CtrlDdr=Manual
              suppressif NOT ideqval CBS_CONFIG.CbsCmnMemTimingSettingDdr == 1
                      OR NOT ideqval CBS_CONFIG.CbsCmnMemTimingTrfc2CtrlDdr == 1;
                // Trfc2
                // Specifies the Refresh Recovery Delay Time (tRFC2).  Valid values: 0x32 ~ 0xFFF. The value is in hex.
                numeric
                  varid       = CBS_CONFIG.CbsCmnMemTimingTrfc2Ddr,
                  prompt      = STRING_TOKEN (AMD_CBS_STR_TRFC2),
                  help        = STRING_TOKEN (AMD_CBS_STR_TRFC2_HELP),
                  flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
                  minimum     = 0x32,
                  maximum     = 0xFFF,
                  step        = 0,
                  default     = 50,
                endnumeric;
              endif;

              // Display Condition: CbsCmnMemTimingSettingDdr=Enabled
              suppressif NOT ideqval CBS_CONFIG.CbsCmnMemTimingSettingDdr == 1;
                // TrfcSb Ctrl
                // Auto: Follow default setting, Manual: Manually specify
                oneof
                  varid       = CBS_CONFIG.CbsCmnMemTimingTrfcSbCtrlDdr,
                  prompt      = STRING_TOKEN (AMD_CBS_STR_TRFCSB_CTRL),
                  help        = STRING_TOKEN (AMD_CBS_STR_TRFCSB_CTRL_HELP),
                  option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0,    flags = DEFAULT | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_MANUAL),          value = 1,    flags = 0 | RESET_REQUIRED;
                endoneof;
              endif;

              // Display Condition: CbsCmnMemTimingSettingDdr=Enabled,CbsCmnMemTimingTrfcSbCtrlDdr=Manual
              suppressif NOT ideqval CBS_CONFIG.CbsCmnMemTimingSettingDdr == 1
                      OR NOT ideqval CBS_CONFIG.CbsCmnMemTimingTrfcSbCtrlDdr == 1;
                // TrfcSb
                // Specifies the Refresh Recovery Delay Time (tRFCSb). Valid values 0x32 ~ 0x7FF. The value is in hex.
                numeric
                  varid       = CBS_CONFIG.CbsCmnMemTimingTrfcSbDdr,
                  prompt      = STRING_TOKEN (AMD_CBS_STR_TRFCSB),
                  help        = STRING_TOKEN (AMD_CBS_STR_TRFCSB_HELP),
                  flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
