            help        = STRING_TOKEN (AMD_CBS_STR_USB0_2_DOT_0_PORT_0_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;

          // USB0 2.0 Port 1
          // Disable or Enable USB0 2.0 port 1
          oneof
            varid       = CBS_CONFIG.CbsCmnFchUsbXHCI0HsPort1,
            prompt      = STRING_TOKEN (AMD_CBS_STR_USB0_2_DOT_0_PORT_1),
            help        = STRING_TOKEN (AMD_CBS_STR_USB0_2_DOT_0_PORT_1_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;

          // USB0 2.0 Port 2
          // Disable or Enable USB0 2.0 port 2
          oneof
            varid       = CBS_CONFIG.CbsCmnFchUsbXHCI0HsPort2,
            prompt      = STRING_TOKEN (AMD_CBS_STR_USB0_2_DOT_0_PORT_2),
            help        = STRING_TOKEN (AMD_CBS_STR_USB0_2_DOT_0_PORT_2_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;

          // USB0 2.0 Port 3
          // Disable or Enable USB0 2.0 port 3
          oneof
            varid       = CBS_CONFIG.CbsCmnFchUsbXHCI0HsPort3,
            prompt      = STRING_TOKEN (AMD_CBS_STR_USB0_2_DOT_0_PORT_3),
            help        = STRING_TOKEN (AMD_CBS_STR_USB0_2_DOT_0_PORT_3_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;

        endform;
        //
        // form - USB1 2.0 port enable
        //
        form

          formid        = SETUP_USB1_2_DOT_0_PORT_ENABLE_LABLE,

          title         = STRING_TOKEN (AMD_CBS_STR_USB1_2_DOT_0_PORT_ENABLE_SECTION);

          subtitle text = STRING_TOKEN (AMD_CBS_STR_USB1_2_DOT_0_PORT_ENABLE_SECTION);
          subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

          // USB1 2.0 Port 0
          // Disable or Enable USB1 2.0 port 0
          oneof
            varid       = CBS_CONFIG.CbsCmnFchUsbXHCI1HsPort0,
            prompt      = STRING_TOKEN (AMD_CBS_STR_USB1_2_DOT_0_PORT_0),
            help        = STRING_TOKEN (AMD_CBS_STR_USB1_2_DOT_0_PORT_0_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;

          // USB1 2.0 Port 1
          // Disable or Enable USB1 2.0 port 1
          oneof
            varid       = CBS_CONFIG.CbsCmnFchUsbXHCI1HsPort1,
            prompt      = STRING_TOKEN (AMD_CBS_STR_USB1_2_DOT_0_PORT_1),
            help        = STRING_TOKEN (AMD_CBS_STR_USB1_2_DOT_0_PORT_1_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;

          // USB1 2.0 Port 2
          // Disable or Enable USB1 2.0 port 2
          oneof
            varid       = CBS_CONFIG.CbsCmnFchUsbXHCI1HsPort2,
