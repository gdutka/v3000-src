          subtitle text = STRING_TOKEN (AMD_CBS_STR_USB3_2_DOT_0_PORT_ENABLE_SECTION);
          subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

          // USB3 2.0 port 0
