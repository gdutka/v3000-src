                  help        = STRING_TOKEN (AMD_CBS_STR_TRDWR_CTRL_HELP),
                  option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0,    flags = DEFAULT | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_MANUAL),          value = 1,    flags = 0 | RESET_REQUIRED;
                endoneof;
              endif;

              // Display Condition: CbsCmnMemTimingSettingDdr=Enabled,CbsCmnMemTimingTrdwrCtrlDdr=Manual
              suppressif NOT ideqval CBS_CONFIG.CbsCmnMemTimingSettingDdr == 1
                      OR NOT ideqval CBS_CONFIG.CbsCmnMemTimingTrdwrCtrlDdr == 1;
                // Trdwr
                // Specifies the Read to Write Turnaround Timing. Valid value: 0x1 ~ 0x1F. The value is in hex.
                numeric
                  varid       = CBS_CONFIG.CbsCmnMemTimingTrdwrDdr,
                  prompt      = STRING_TOKEN (AMD_CBS_STR_TRDWR),
                  help        = STRING_TOKEN (AMD_CBS_STR_TRDWR_HELP),
                  flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
                  minimum     = 0x1,
                  maximum     = 0x1F,
                  step        = 0,
                  default     = 5,
                endnumeric;
              endif;

            endform;
        //
        // form - DDR Bus Configuration
        //
        form

          formid        = SETUP_DDR_BUS_CONFIGURATION_LABLE,

          title         = STRING_TOKEN (AMD_CBS_STR_DDR_BUS_CONFIGURATION_SECTION);

          subtitle text = STRING_TOKEN (AMD_CBS_STR_DDR_BUS_CONFIGURATION_SECTION);
          subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

          // Processor CA drive strengths
          // Select the drive strength for all CA0-13 IOs
          oneof
            varid       = CBS_CONFIG.CbsCmnMemDrvStrenCaDdr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_PROCESSOR_CA_DRIVE_STRENGTHS),
            help        = STRING_TOKEN (AMD_CBS_STR_PROCESSOR_CA_DRIVE_STRENGTHS_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_120_DOT_0_OHM),   value = 120,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_60_DOT_0_OHM),    value = 60,   flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_40_DOT_0_OHM),    value = 40,   flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_30_DOT_0_OHM),    value = 30,   flags = 0 | RESET_REQUIRED;
          endoneof;

          // Processor CS drive strengths
          // Select the drive strength for all CS IOs
          oneof
            varid       = CBS_CONFIG.CbsCmnMemDrvStrenCsDdr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_PROCESSOR_CS_DRIVE_STRENGTHS),
            help        = STRING_TOKEN (AMD_CBS_STR_PROCESSOR_CS_DRIVE_STRENGTHS_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_120_DOT_0_OHM),   value = 120,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_60_DOT_0_OHM),    value = 60,   flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_40_DOT_0_OHM),    value = 40,   flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_30_DOT_0_OHM),    value = 30,   flags = 0 | RESET_REQUIRED;
          endoneof;

          // Processor CK drive strengths
          // Select the drive strength for all CK{T,C} IOs
          oneof
            varid       = CBS_CONFIG.CbsCmnMemDrvStrenCkDdr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_PROCESSOR_CK_DRIVE_STRENGTHS),
            help        = STRING_TOKEN (AMD_CBS_STR_PROCESSOR_CK_DRIVE_STRENGTHS_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_120_DOT_0_OHM),   value = 120,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_60_DOT_0_OHM),    value = 60,   flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_40_DOT_0_OHM),    value = 40,   flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_30_DOT_0_OHM),    value = 30,   flags = 0 | RESET_REQUIRED;
          endoneof;

          // Processor DQ drive strengths
          // Select the drive strength for all DQ and DMI IOs
          oneof
            varid       = CBS_CONFIG.CbsCmnMemDrvStrenDqDdr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_PROCESSOR_DQ_DRIVE_STRENGTHS),
            help        = STRING_TOKEN (AMD_CBS_STR_PROCESSOR_DQ_DRIVE_STRENGTHS_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_HIGH_IMPEDANCE),  value = 0x0,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_240_OHM),         value = 0x2,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_120_OHM),         value = 0x4,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_80_OHM),          value = 0x6,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_60_OHM),          value = 0xC,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_48_OHM),          value = 0xE,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_40_OHM),          value = 0x1C, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_34_DOT_3_OHM),    value = 0x1E, flags = 0 | RESET_REQUIRED;
          endoneof;

          // Processor ODT impedance
          // Select the ODT impedance for all DBYTE IOs
          oneof
            varid       = CBS_CONFIG.CbsCmnMemOdtImpedProcDdr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_PROCESSOR_ODT_IMPEDANCE),
            help        = STRING_TOKEN (AMD_CBS_STR_PROCESSOR_ODT_IMPEDANCE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_HIGH_IMPEDANCE),  value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_480_OHM),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_240_OHM),         value = 0x2,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_160_OHM),         value = 0x3,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_120_OHM),         value = 0x4,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_96_OHM),          value = 0x5,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_80_OHM),          value = 0x6,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_68_DOT_6_OHM),    value = 0x7,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_60_OHM),          value = 0xC,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_53_DOT_3_OHM),    value = 0xD,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_48_OHM),          value = 0xE,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_43_DOT_6_OHM),    value = 0xF,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_40_OHM),          value = 0x1C, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_36_DOT_9_OHM),    value = 0x1D, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_34_DOT_3_OHM),    value = 0x1E, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_32_OHM),          value = 0x1F, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_30_OHM),          value = 0x3C, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_28_DOT_2_OHM),    value = 0x3D, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_26_DOT_7_OHM),    value = 0x3E, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_25_DOT_3_OHM),    value = 0x3F, flags = 0 | RESET_REQUIRED;
          endoneof;

          // Dram DQ drive strengths
          // Selects the Dram Pull-up and Pull-Down Output Driver Impedance for all DQ and DMI IOs
          oneof
            varid       = CBS_CONFIG.CbsCmnMemDramDrvStrenDqDdr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_DRAM_DQ_DRIVE_STRENGTHS),
            help        = STRING_TOKEN (AMD_CBS_STR_DRAM_DQ_DRIVE_STRENGTHS_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_34_OHM),          value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_40_OHM),          value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_48_OHM),          value = 2,    flags = 0 | RESET_REQUIRED;
          endoneof;

          // Dram ODT impedance RTT_NOM_WR
          // Select the DRAMs On-die Termination impedance for RTT_NOM_WR
          oneof
            varid       = CBS_CONFIG.CbsCmnMemDramOdtImpedRttNomWrDdr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_DRAM_ODT_IMPEDANCE_RTT_NOM_WR),
            help        = STRING_TOKEN (AMD_CBS_STR_DRAM_ODT_IMPEDANCE_RTT_NOM_WR_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RTT_OFF),         value = 0x0,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_240),         value = 0x1,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_2_120),       value = 0x2,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_3_80),        value = 0x3,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_4_60),        value = 0x4,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_5_48),        value = 0x5,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_6_40),        value = 0x6,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_7_34),        value = 0x7,  flags = 0 | RESET_REQUIRED;
          endoneof;

          // Dram ODT impedance RTT_NOM_RD
          // Select the DRAMs On-die Termination impedance for RTT_NOM_RD
          oneof
            varid       = CBS_CONFIG.CbsCmnMemDramOdtImpedRttNomRdDdr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_DRAM_ODT_IMPEDANCE_RTT_NOM_RD),
            help        = STRING_TOKEN (AMD_CBS_STR_DRAM_ODT_IMPEDANCE_RTT_NOM_RD_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RTT_OFF),         value = 0x0,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_240),         value = 0x1,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_2_120),       value = 0x2,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_3_80),        value = 0x3,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_4_60),        value = 0x4,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_5_48),        value = 0x5,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_6_40),        value = 0x6,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_7_34),        value = 0x7,  flags = 0 | RESET_REQUIRED;
          endoneof;

          // Dram ODT impedance RTT_WR
          // Select the DRAMs On-die Termination impedance for RTT_WR
          oneof
            varid       = CBS_CONFIG.CbsCmnMemDramOdtImpedRttWrDdr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_DRAM_ODT_IMPEDANCE_RTT_WR),
            help        = STRING_TOKEN (AMD_CBS_STR_DRAM_ODT_IMPEDANCE_RTT_WR_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RTT_OFF),         value = 0x0,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_240),         value = 0x1,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_2_120),       value = 0x2,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_3_80),        value = 0x3,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_4_60),        value = 0x4,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_5_48),        value = 0x5,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_6_40),        value = 0x6,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_7_34),        value = 0x7,  flags = 0 | RESET_REQUIRED;
          endoneof;

          // Dram ODT impedance RTT_PARK
          // Select the DRAMs On-die Termination impedance for RTT_PARK
          oneof
            varid       = CBS_CONFIG.CbsCmnMemDramOdtImpedRttParkDdr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_DRAM_ODT_IMPEDANCE_RTT_PARK),
            help        = STRING_TOKEN (AMD_CBS_STR_DRAM_ODT_IMPEDANCE_RTT_PARK_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RTT_OFF),         value = 0x0,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_240),         value = 0x1,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_2_120),       value = 0x2,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_3_80),        value = 0x3,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_4_60),        value = 0x4,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_5_48),        value = 0x5,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_6_40),        value = 0x6,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_7_34),        value = 0x7,  flags = 0 | RESET_REQUIRED;
          endoneof;

          // Dram ODT impedance DQS_RTT_PARK
          // Select the DRAMs On-die Termination impedance for DQS_RTT_PARK
          oneof
            varid       = CBS_CONFIG.CbsCmnMemDramOdtImpedRttParkDqsDdr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_DRAM_ODT_IMPEDANCE_DQS_RTT_PARK),
            help        = STRING_TOKEN (AMD_CBS_STR_DRAM_ODT_IMPEDANCE_DQS_RTT_PARK_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RTT_OFF),         value = 0x0,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_240),         value = 0x1,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_2_120),       value = 0x2,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_3_80),        value = 0x3,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_4_60),        value = 0x4,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_5_48),        value = 0x5,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_6_40),        value = 0x6,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_7_34),        value = 0x7,  flags = 0 | RESET_REQUIRED;
          endoneof;

        endform;
        //
        // form - DDR Controller Configuration
        //
        form

          formid        = SETUP_DDR_CONTROLLER_CONFIGURATION_LABLE,

          title         = STRING_TOKEN (AMD_CBS_STR_DDR_CONTROLLER_CONFIGURATION_SECTION);

          subtitle text = STRING_TOKEN (AMD_CBS_STR_DDR_CONTROLLER_CONFIGURATION_SECTION);
          subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

          goto SETUP_DDR_POWER_OPTIONS_LABLE,
            prompt      = STRING_TOKEN (AMD_CBS_STR_DDR_POWER_OPTIONS_SECTION),
            help        = STRING_TOKEN (AMD_CBS_STR_DDR_POWER_OPTIONS_SECTION);

        endform;
          //
          // form - DDR Power Options
          //
          form

            formid        = SETUP_DDR_POWER_OPTIONS_LABLE,

            title         = STRING_TOKEN (AMD_CBS_STR_DDR_POWER_OPTIONS_SECTION);

            subtitle text = STRING_TOKEN (AMD_CBS_STR_DDR_POWER_OPTIONS_SECTION);
            subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

            // Power Down Enable
            // Enable or disable DDR power down mode
            oneof
              varid       = CBS_CONFIG.CbsCmnMemCtrllerPowerDownEnDdr,
              prompt      = STRING_TOKEN (AMD_CBS_STR_POWER_DOWN_ENABLE),
              help        = STRING_TOKEN (AMD_CBS_STR_POWER_DOWN_ENABLE_HELP),
              option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            endoneof;

            // Phy Low Power Disable
            // When LpDis = 1 : Disable putting phy in low power mode.\nWhen LpDis = 0 : Enable putting phy in low power mode and stop clocks to DRAM when all ranks are in power down.\nAuto should be 0.
            oneof
              varid       = CBS_CONFIG.CbsCmnMemCtrllerPdPhyPowerSaveDisDdr,
              prompt      = STRING_TOKEN (AMD_CBS_STR_PHY_LOW_POWER_DISABLE),
              help        = STRING_TOKEN (AMD_CBS_STR_PHY_LOW_POWER_DISABLE_HELP),
              option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_0),               value = 0,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_1),               value = 1,    flags = 0 | RESET_REQUIRED;
            endoneof;

          endform;
        //
        // form - DDR RAS
        //
        form

          formid        = SETUP_DDR_RAS_LABLE,

          title         = STRING_TOKEN (AMD_CBS_STR_DDR_RAS_SECTION);

          subtitle text = STRING_TOKEN (AMD_CBS_STR_DDR_RAS_SECTION);
          subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

          // Disable Memory Error Injection
          // True: UMC::CH::MiscCfg[DisErrInj]=1
          oneof
            varid       = CBS_CONFIG.CbsCmnMemEccDisErrInjectionDdr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_DISABLE_MEMORY_ERROR_INJECTION),
            help        = STRING_TOKEN (AMD_CBS_STR_DISABLE_MEMORY_ERROR_INJECTION_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_FALSE),           value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_TRUE),            value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xff, flags = DEFAULT | RESET_REQUIRED;
          endoneof;

          // Data Poisoning
          //  Enable/disable data poisoning: UMC_CH::EccCtrl[UcFatalEn] UMC_CH::EccCtrl[WrEccEn] Should be enabled/disabled together.
          oneof
            varid       = CBS_CONFIG.CbsCmnMemDataPoisoningDdr4,
            prompt      = STRING_TOKEN (AMD_CBS_STR_DATA_POISONING),
            help        = STRING_TOKEN (AMD_CBS_STR_DATA_POISONING_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
          endoneof;

          goto SETUP_DDR_ECC_CONFIGURATION_LABLE,
            prompt      = STRING_TOKEN (AMD_CBS_STR_DDR_ECC_CONFIGURATION_SECTION),
            help        = STRING_TOKEN (AMD_CBS_STR_DDR_ECC_CONFIGURATION_SECTION);

          goto SETUP_DRAM_SCRUBBERS_LABLE,
            prompt      = STRING_TOKEN (AMD_CBS_STR_DRAM_SCRUBBERS_SECTION),
            help        = STRING_TOKEN (AMD_CBS_STR_DRAM_SCRUBBERS_SECTION);

        endform;
          //
          // form - DDR ECC Configuration
          //
          form

            formid        = SETUP_DDR_ECC_CONFIGURATION_LABLE,

            title         = STRING_TOKEN (AMD_CBS_STR_DDR_ECC_CONFIGURATION_SECTION);

            subtitle text = STRING_TOKEN (AMD_CBS_STR_DDR_ECC_CONFIGURATION_SECTION);
            subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

            // ECC
            // Use this option to enable / disable ECC. Auto will set ECC to enable.
            oneof
              varid       = CBS_CONFIG.CbsCmnMemEccEnDdr,
              prompt      = STRING_TOKEN (AMD_CBS_STR_ECC),
              help        = STRING_TOKEN (AMD_CBS_STR_ECC_HELP),
              option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            endoneof;

          endform;
          //
          // form - DRAM Scrubbers
          //
          form

            formid        = SETUP_DRAM_SCRUBBERS_LABLE,

            title         = STRING_TOKEN (AMD_CBS_STR_DRAM_SCRUBBERS_SECTION);

            subtitle text = STRING_TOKEN (AMD_CBS_STR_DRAM_SCRUBBERS_SECTION);
            subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

            // DRAM Redirect Scrubber Enable
            // Enable/Disable Dram Redirect Scrubber
            oneof
              varid       = CBS_CONFIG.CbsCmnMemDramRedirectScrubEnDdr,
              prompt      = STRING_TOKEN (AMD_CBS_STR_DRAM_REDIRECT_SCRUBBER_ENABLE),
              help        = STRING_TOKEN (AMD_CBS_STR_DRAM_REDIRECT_SCRUBBER_ENABLE_HELP),
              option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            endoneof;

            // DRAM Scrub Redirection Limit
            // Dram ECC Scrub Redirection Limit: 0=8 scrubs, 2=4 scrubs, 1=2 scrubs, 3=Unlimited scrub 
            oneof
              varid       = CBS_CONFIG.CbsCmnMemDramRedirectScrubLimitDdr,
              prompt      = STRING_TOKEN (AMD_CBS_STR_DRAM_SCRUB_REDIRECTION_LIMIT),
              help        = STRING_TOKEN (AMD_CBS_STR_DRAM_SCRUB_REDIRECTION_LIMIT_HELP),
              option text = STRING_TOKEN (AMD_CBS_STR_8_SCRUBS),        value = 0,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_4_SCRUBS),        value = 2,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_2_SCRUBS),        value = 1,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_UNLIMITED_SCRUBS), value = 3,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            endoneof;

            // DRAM Scrub Time
            // Provide a value that is the number of hours to scrub memory.
            oneof
              varid       = CBS_CONFIG.CbsCmnMemDramScrubTime,
              prompt      = STRING_TOKEN (AMD_CBS_STR_DRAM_SCRUB_TIME),
              help        = STRING_TOKEN (AMD_CBS_STR_DRAM_SCRUB_TIME_HELP),
              option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_1_HOUR),          value = 1,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_4_HOURS),         value = 4,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_6_HOURS),         value = 6,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_8_HOURS),         value = 8,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_12_HOURS),        value = 12,   flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_16_HOURS),        value = 16,   flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_24_HOURS),        value = 24,   flags = DEFAULT | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_48_HOURS),        value = 48,   flags = 0 | RESET_REQUIRED;
            endoneof;

          endform;
        //
        // form - DDR Security
        //
        form

          formid        = SETUP_DDR_SECURITY_LABLE,

          title         = STRING_TOKEN (AMD_CBS_STR_DDR_SECURITY_SECTION);

          subtitle text = STRING_TOKEN (AMD_CBS_STR_DDR_SECURITY_SECTION);
          subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

          // Active Condition: CbsCmnScpcAttrCntl=0|CbsCmnScpcAttrCntl=1|CbsCmnScpcAttrCntl=2
          grayoutif NOT ideqval CBS_CONFIG.CbsCmnScpcAttrCntl == 0
                AND NOT ideqval CBS_CONFIG.CbsCmnScpcAttrCntl == 1
                AND NOT ideqval CBS_CONFIG.CbsCmnScpcAttrCntl == 2;
            // TSME
            // No help string
            oneof
              varid       = CBS_CONFIG.CbsCmnMemTsmeEnableDdr,
              questionid  = KEY_CBS_CMN_MEM_TSME_ENABLE_DDR,
              prompt      = STRING_TOKEN (AMD_CBS_STR_TSME),
              help        = STRING_TOKEN (AMD_CBS_STR_TSME_HELP),
              option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED | INTERACTIVE;
              option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
              option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
            endoneof;
          endif;

          // Data Scramble
          // Data scrambling: DataScrambleEn
          oneof
            varid       = CBS_CONFIG.CbsCmnMemDataCtrlDataScrambleEnDdr,
            questionid  = KEY_CBS_CMN_MEM_DATA_CTRL_DATA_SCRAMBLE_EN_DDR,
            prompt      = STRING_TOKEN (AMD_CBS_STR_DATA_SCRAMBLE),
            help        = STRING_TOKEN (AMD_CBS_STR_DATA_SCRAMBLE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 0x1,  flags = 0 | RESET_REQUIRED | INTERACTIVE;
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0x0,  flags = 0 | RESET_REQUIRED | INTERACTIVE;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED | INTERACTIVE;
          endoneof;

          // Enable SPD CRC verification
          // This feature controls the DDR DIMM SPD CRC verify or not
          oneof
            varid       = CBS_CONFIG.CbsCmnMemSpdCrcVerify,
            prompt      = STRING_TOKEN (AMD_CBS_STR_ENABLE_SPD_CRC_VERIFICATION),
            help        = STRING_TOKEN (AMD_CBS_STR_ENABLE_SPD_CRC_VERIFICATION_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLE),          value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = DEFAULT | RESET_REQUIRED;
          endoneof;

          // Active Condition:  CbsCmnMemSpdCrcVerify = Auto|CbsCmnMemSpdCrcVerify = Enable 
          grayoutif NOT ideqval CBS_CONFIG.CbsCmnMemSpdCrcVerify == 0xf
                AND NOT ideqval CBS_CONFIG.CbsCmnMemSpdCrcVerify == 1;
            // SPD read retry count on CRC failure
            // Controls how many SPD read retry while SPD CRC check failure
            numeric
              varid       = CBS_CONFIG.CbsCmnMemSpdReadRetryCountCrc,
              questionid  = KEY_CBS_CMN_MEM_SPD_READ_RETRY_COUNT_CRC,
              prompt      = STRING_TOKEN (AMD_CBS_STR_SPD_READ_RETRY_COUNT_ON_CRC_FAILURE),
              help        = STRING_TOKEN (AMD_CBS_STR_SPD_READ_RETRY_COUNT_ON_CRC_FAILURE_HELP),
              flags       = DISPLAY_UINT_HEX | RESET_REQUIRED | INTERACTIVE,
              minimum     = 0,
              maximum     = 8,
              step        = 0,
              default     = 2,
            endnumeric;
          endif;

        endform;
        //
        // form - DDR Addressing Options
        //
        form

          formid        = SETUP_DDR_ADDRESSING_OPTIONS_LABLE,

          title         = STRING_TOKEN (AMD_CBS_STR_DDR_ADDRESSING_OPTIONS_SECTION);

          subtitle text = STRING_TOKEN (AMD_CBS_STR_DDR_ADDRESSING_OPTIONS_SECTION);
          subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

          // Chipselect Interleaving
          // Interleave memory blocks across the DRAM chip selects for node 0.
          oneof
            varid       = CBS_CONFIG.CbsCmnMemMappingBankInterleaveDdr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_CHIPSELECT_INTERLEAVING),
            help        = STRING_TOKEN (AMD_CBS_STR_CHIPSELECT_INTERLEAVING_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
          endoneof;

          // Address Hash Bank
          // Enable or disable bank address hashing
          oneof
            varid       = CBS_CONFIG.CbsCmnMemAddressHashBankDdr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_ADDRESS_HASH_BANK),
            help        = STRING_TOKEN (AMD_CBS_STR_ADDRESS_HASH_BANK_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
          endoneof;

          // Address Hash CS
          // Enable or disable CS address hashing
          oneof
            varid       = CBS_CONFIG.CbsCmnMemAddressHashCsDdr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_ADDRESS_HASH_CS),
            help        = STRING_TOKEN (AMD_CBS_STR_ADDRESS_HASH_CS_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          endoneof;

          // BankSwapMode
          // BankSwapMode value: 0=Disabled, 2=SwapAPU
          oneof
            varid       = CBS_CONFIG.CbsCmnMemCtrllerBankSwapModeDdr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_BANKSWAPMODE),
            help        = STRING_TOKEN (AMD_CBS_STR_BANKSWAPMODE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_SWAP_APU),        value = 2,    flags = 0 | RESET_REQUIRED;
          endoneof;

        endform;
        //
        // form - DDR Training Options
        //
        form

          formid        = SETUP_DDR_TRAINING_OPTIONS_LABLE,

          title         = STRING_TOKEN (AMD_CBS_STR_DDR_TRAINING_OPTIONS_SECTION);

          subtitle text = STRING_TOKEN (AMD_CBS_STR_DDR_TRAINING_OPTIONS_SECTION);
          subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

          // Memory Restore valid days
          // This token helps to set the raining  intervals and It is limited to 0~65535
          numeric
            varid       = CBS_CONFIG.CbsCmnMemRestoreValidDays,
            prompt      = STRING_TOKEN (AMD_CBS_STR_MEMORY_RESTORE_VALID_DAYS),
            help        = STRING_TOKEN (AMD_CBS_STR_MEMORY_RESTORE_VALID_DAYS_HELP),
            flags       = RESET_REQUIRED,
            minimum     = 0,
            maximum     = 0xffffffff,
            step        = 0,
            default     = 30,
          endnumeric;

          // DFE Read Training
          // Perform 2D Read Training with DFE on.
          oneof
            varid       = CBS_CONFIG.CbsCmnMemCtrllerPmuTrainDfeDdr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_DFE_READ_TRAINING),
            help        = STRING_TOKEN (AMD_CBS_STR_DFE_READ_TRAINING_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLE),          value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
          endoneof;

          // DRAM PDA Enumerate ID Programming Mode
          // Specify PDA enumeration mode\nAuto : default\n0 : Continuous DQS toggling PDA enumeration mode (default)\n1 : Legacy PDA enumeration mode
          oneof
            varid       = CBS_CONFIG.CbsCmnMemDramPdaEnumIdProgModeDdr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_DRAM_PDA_ENUMERATE_ID_PROGRAMMING_MODE),
            help        = STRING_TOKEN (AMD_CBS_STR_DRAM_PDA_ENUMERATE_ID_PROGRAMMING_MODE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_TOGGLING_PDA_ENUMERATION_MODE), value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_LEGACY_PDA_ENUMERATION_MODE), value = 1,    flags = 0 | RESET_REQUIRED;
          endoneof;

        endform;
        //
        // form - DDR Memory MBIST
        //
        form

          formid        = SETUP_DDR_MEMORY_MBIST_LABLE,

          title         = STRING_TOKEN (AMD_CBS_STR_DDR_MEMORY_MBIST_SECTION);

          subtitle text = STRING_TOKEN (AMD_CBS_STR_DDR_MEMORY_MBIST_SECTION);
          subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

          // MBIST Enable
          // Enable or disable Memory MBIST
          oneof
            varid       = CBS_CONFIG.CbsCmnMemMbistEnDdr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_MBIST_ENABLE),
            help        = STRING_TOKEN (AMD_CBS_STR_MBIST_ENABLE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
          endoneof;

          // Active Condition: CbsCmnMemMbistEnDdr=Enabled
          grayoutif NOT ideqval CBS_CONFIG.CbsCmnMemMbistEnDdr == 1;
            // MBIST Test Mode
            // Select MBIST Test Mode -Interface Mode (Tests Single and Multiple CS transactions and Basic Connectivity) or Data Eye Mode (Measures Voltage vs. Timing)
            oneof
              varid       = CBS_CONFIG.CbsCmnMemMbistTestmodeDdr,
              prompt      = STRING_TOKEN (AMD_CBS_STR_MBIST_TEST_MODE),
              help        = STRING_TOKEN (AMD_CBS_STR_MBIST_TEST_MODE_HELP),
              option text = STRING_TOKEN (AMD_CBS_STR_INTERFACE_MODE),  value = 0,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_DATA_EYE_MODE),   value = 1,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_BOTH),            value = 2,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            endoneof;
          endif;

          // Active Condition: CbsCmnMemMbistEnDdr=Enabled
          grayoutif NOT ideqval CBS_CONFIG.CbsCmnMemMbistEnDdr == 1;
            // MBIST Aggressors
            // Enable or disable MBIST Aggressor test
            oneof
              varid       = CBS_CONFIG.CbsCmnMemMbistAggressorsDdr,
              prompt      = STRING_TOKEN (AMD_CBS_STR_MBIST_AGGRESSORS),
              help        = STRING_TOKEN (AMD_CBS_STR_MBIST_AGGRESSORS_HELP),
              option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xff, flags = DEFAULT | RESET_REQUIRED;
            endoneof;
          endif;

          // Active Condition: CbsCmnMemMbistEnDdr=Enabled
          grayoutif NOT ideqval CBS_CONFIG.CbsCmnMemMbistEnDdr == 1;
            // MBIST Per Bit Slave Die Reporting
            // Reports 2D Data Eye Results in ABL Log for each DQ, Chipselect, and Channel
            oneof
              varid       = CBS_CONFIG.CbsCmnMemMbistPerBitSlaveDieReportDdr,
              prompt      = STRING_TOKEN (AMD_CBS_STR_MBIST_PER_BIT_SLAVE_DIE_REPORTING),
              help        = STRING_TOKEN (AMD_CBS_STR_MBIST_PER_BIT_SLAVE_DIE_REPORTING_HELP),
              option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xff, flags = DEFAULT | RESET_REQUIRED;
            endoneof;
          endif;

          // Active Condition: CbsCmnMemMbistEnDdr=Enabled
          grayoutif NOT ideqval CBS_CONFIG.CbsCmnMemMbistEnDdr == 1;
            goto SETUP_DDR_DATA_EYE_LABLE,
              prompt      = STRING_TOKEN (AMD_CBS_STR_DDR_DATA_EYE_SECTION),
              help        = STRING_TOKEN (AMD_CBS_STR_DDR_DATA_EYE_SECTION);
          endif;

        endform;
          //
          // form - DDR Data Eye
          //
          form

            formid        = SETUP_DDR_DATA_EYE_LABLE,

            title         = STRING_TOKEN (AMD_CBS_STR_DDR_DATA_EYE_SECTION);

            subtitle text = STRING_TOKEN (AMD_CBS_STR_DDR_DATA_EYE_SECTION);
            subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

            // Pattern Select
            // No help string
            oneof
              varid       = CBS_CONFIG.CbsCmnMemMbistPatternSelectDdr,
              prompt      = STRING_TOKEN (AMD_CBS_STR_PATTERN_SELECT),
              help        = STRING_TOKEN (AMD_CBS_STR_PATTERN_SELECT_HELP),
              option text = STRING_TOKEN (AMD_CBS_STR_PRBS),            value = 0,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_SSO),             value = 1,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_BOTH),            value = 2,    flags = DEFAULT | RESET_REQUIRED;
            endoneof;

            // Pattern Length
            // This token helps to determine the pattern length. The possible options are N=3...12
            numeric
              varid       = CBS_CONFIG.CbsCmnMemMbistPatternLengthDdr,
              prompt      = STRING_TOKEN (AMD_CBS_STR_PATTERN_LENGTH),
              help        = STRING_TOKEN (AMD_CBS_STR_PATTERN_LENGTH_HELP),
              flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
              minimum     = 3,
              maximum     = 12,
              step        = 0,
              default     = 6,
            endnumeric;

            // Aggressor Channel
            // This helps read the aggressors channels. If it is enabled, you can read from one or more than one aggressor channel. The default is set to disabled.
            oneof
              varid       = CBS_CONFIG.CbsCmnMemMbistAggressorsChnlDdr,
              prompt      = STRING_TOKEN (AMD_CBS_STR_AGGRESSOR_CHANNEL),
              help        = STRING_TOKEN (AMD_CBS_STR_AGGRESSOR_CHANNEL_HELP),
              option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_1_AGGRESSOR_CHANNEL), value = 1,    flags = DEFAULT | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_3_AGGRESSOR_CHANNELS), value = 3,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_7_AGGRESSOR_CHANNELS), value = 7,    flags = 0 | RESET_REQUIRED;
            endoneof;

          endform;
      //
      // form - LPDDR Options
      //
      form

        formid        = SETUP_LPDDR_OPTIONS_LABLE,

        title         = STRING_TOKEN (AMD_CBS_STR_LPDDR_OPTIONS_SECTION);

        subtitle text = STRING_TOKEN (AMD_CBS_STR_LPDDR_OPTIONS_SECTION);
        subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

        goto SETUP_LPDDR_TIMING_CONFIGURATION_LABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_LPDDR_TIMING_CONFIGURATION_SECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_LPDDR_TIMING_CONFIGURATION_SECTION);

        goto SETUP_LPDDR_CONTROLLER_CONFIGURATION_LABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_LPDDR_CONTROLLER_CONFIGURATION_SECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_LPDDR_CONTROLLER_CONFIGURATION_SECTION);

        goto SETUP_LPDDR_BUS_CONFIGURATION_LABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_LPDDR_BUS_CONFIGURATION_SECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_LPDDR_BUS_CONFIGURATION_SECTION);

        goto SETUP_LPDDR_RAS_LABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_LPDDR_RAS_SECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_LPDDR_RAS_SECTION);

        goto SETUP_LPDDR_SECURITY_LABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_LPDDR_SECURITY_SECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_LPDDR_SECURITY_SECTION);

        goto SETUP_LPDDR_ADDRESSING_OPTIONS_LABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_LPDDR_ADDRESSING_OPTIONS_SECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_LPDDR_ADDRESSING_OPTIONS_SECTION);

        goto SETUP_LPDDR_TRAINING_OPTIONS_LABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_LPDDR_TRAINING_OPTIONS_SECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_LPDDR_TRAINING_OPTIONS_SECTION);

        goto SETUP_LPDDR_MEMORY_MBIST_LABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_LPDDR_MEMORY_MBIST_SECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_LPDDR_MEMORY_MBIST_SECTION);

      endform;
        //
        // form - LPDDR Timing Configuration
        //
        form

          formid        = SETUP_LPDDR_TIMING_CONFIGURATION_LABLE,

          title         = STRING_TOKEN (AMD_CBS_STR_LPDDR_TIMING_CONFIGURATION_SECTION);

          subtitle text = STRING_TOKEN (AMD_CBS_STR_LPDDR_TIMING_CONFIGURATION_SECTION);
          subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

          // DRAM Timing Configuration Legal Disclaimer
          // No help string
          text
            help        = STRING_TOKEN (AMD_CBS_STR_DRAM_TIMING_CONFIGURATION_LEGAL_DISCLAIMER_HELP),
            text        = STRING_TOKEN (AMD_CBS_STR_DRAM_TIMING_CONFIGURATION_LEGAL_DISCLAIMER);

          // DRAM Timing Configuration Legal Disclaimer 1
          // No help string
          text
            help        = STRING_TOKEN (AMD_CBS_STR_DRAM_TIMING_CONFIGURATION_LEGAL_DISCLAIMER_1_HELP),
            text        = STRING_TOKEN (AMD_CBS_STR_DRAM_TIMING_CONFIGURATION_LEGAL_DISCLAIMER_1);

          goto SETUP_LPDDR_OPTIONS_LABLE,
            prompt      = STRING_TOKEN (AMD_CBS_STR_LPDDR_DTC_LEGAL_DISCLAIMER_DECLINE_SECTION),
            help        = STRING_TOKEN (AMD_CBS_STR_LPDDR_DTC_LEGAL_DISCLAIMER_DECLINE_SECTION);

          goto SETUP_LPDDR_DTC_LEGAL_DISCLAIMER_ACCEPT_LABLE,
            prompt      = STRING_TOKEN (AMD_CBS_STR_LPDDR_DTC_LEGAL_DISCLAIMER_ACCEPT_SECTION),
            help        = STRING_TOKEN (AMD_CBS_STR_LPDDR_DTC_LEGAL_DISCLAIMER_ACCEPT_SECTION);

        endform;
          //
          // form - LPDDR DTC_Legal_Disclaimer_Decline
          //
          form

            formid        = SETUP_LPDDR_DTC_LEGAL_DISCLAIMER_DECLINE_LABLE,

            title         = STRING_TOKEN (AMD_CBS_STR_LPDDR_DTC_LEGAL_DISCLAIMER_DECLINE_SECTION);

            subtitle text = STRING_TOKEN (AMD_CBS_STR_LPDDR_DTC_LEGAL_DISCLAIMER_DECLINE_SECTION);
            subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

          endform;
          //
          // form - LPDDR DTC_Legal_Disclaimer_Accept
          //
          form

            formid        = SETUP_LPDDR_DTC_LEGAL_DISCLAIMER_ACCEPT_LABLE,

            title         = STRING_TOKEN (AMD_CBS_STR_LPDDR_DTC_LEGAL_DISCLAIMER_ACCEPT_SECTION);

            subtitle text = STRING_TOKEN (AMD_CBS_STR_LPDDR_DTC_LEGAL_DISCLAIMER_ACCEPT_SECTION);
            subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

            // Active Memory Timing Settings
            oneof
              varid       = CBS_CONFIG.CbsCmnMemOverclockLpddr,
              prompt      = STRING_TOKEN (AMD_CBS_STR_ACTIVE_MEMORY_TIMING_SETTINGS_1),
              help        = STRING_TOKEN (AMD_CBS_STR_ACTIVE_MEMORY_TIMING_SETTINGS_HELP),
              option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            endoneof;

            // Active Condition: CbsCmnMemOverclockLpddr=Enabled
            grayoutif NOT ideqval CBS_CONFIG.CbsCmnMemOverclockLpddr == 1;
              // Maximum Memory Data Clock Speed
              // Specifies the maximum memory target speed in MT/s.\nThe system will automatically limit to the highest supported speed if user input exceeds the maximum supported speed.
              oneof
                varid       = CBS_CONFIG.CbsCmnMemSpeedLpddr,
                prompt      = STRING_TOKEN (AMD_CBS_STR_MAXIMUM_MEMORY_DATA_CLOCK_SPEED),
                help        = STRING_TOKEN (AMD_CBS_STR_MAXIMUM_MEMORY_DATA_CLOCK_SPEED_HELP),
                option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
                option text = STRING_TOKEN (AMD_CBS_STR_3200MT_S),        value = 0x30, flags = 0 | RESET_REQUIRED;
                option text = STRING_TOKEN (AMD_CBS_STR_4267MT_S),        value = 0x40, flags = 0 | RESET_REQUIRED;
                option text = STRING_TOKEN (AMD_CBS_STR_5500MT_S),        value = 0x50, flags = 0 | RESET_REQUIRED;
                option text = STRING_TOKEN (AMD_CBS_STR_6400MT_S),        value = 0x59, flags = 0 | RESET_REQUIRED;
              endoneof;
            endif;

            // Active Condition: CbsCmnMemOverclockLpddr=Enabled
            grayoutif NOT ideqval CBS_CONFIG.CbsCmnMemOverclockLpddr == 1;
              goto SETUP_LPDDR_SPD_TIMING_LABLE,
                prompt      = STRING_TOKEN (AMD_CBS_STR_LPDDR_SPD_TIMING_SECTION),
                help        = STRING_TOKEN (AMD_CBS_STR_LPDDR_SPD_TIMING_SECTION);
            endif;

            // Active Condition: CbsCmnMemOverclockLpddr=Enabled
            grayoutif NOT ideqval CBS_CONFIG.CbsCmnMemOverclockLpddr == 1;
              goto SETUP_LPDDR_NON_SPD_TIMING_LABLE,
                prompt      = STRING_TOKEN (AMD_CBS_STR_LPDDR_NON_SPD_TIMING_SECTION),
                help        = STRING_TOKEN (AMD_CBS_STR_LPDDR_NON_SPD_TIMING_SECTION);
            endif;

          endform;
            //
            // form - LPDDR SPD Timing
            //
            form

              formid        = SETUP_LPDDR_SPD_TIMING_LABLE,

              title         = STRING_TOKEN (AMD_CBS_STR_LPDDR_SPD_TIMING_SECTION);

              subtitle text = STRING_TOKEN (AMD_CBS_STR_LPDDR_SPD_TIMING_SECTION);
              subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

              // Display Condition: CbsCmnMemOverclockLpddr=Enabled
              suppressif NOT ideqval CBS_CONFIG.CbsCmnMemOverclockLpddr == 1;
                // Trcpage Ctrl
                // Specify Trcpage
                oneof
                  varid       = CBS_CONFIG.CbsCmnMemTimingTrcpageCtrlLpddr,
                  prompt      = STRING_TOKEN (AMD_CBS_STR_TRCPAGE_CTRL),
                  help        = STRING_TOKEN (AMD_CBS_STR_TRCPAGE_CTRL_HELP),
                  option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0,    flags = DEFAULT | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_MANUAL),          value = 1,    flags = 0 | RESET_REQUIRED;
                endoneof;
              endif;

              // Display Condition: CbsCmnMemOverclockLpddr=Enabled,CbsCmnMemTimingTrcpageCtrlLpddr=Manual
              suppressif NOT ideqval CBS_CONFIG.CbsCmnMemOverclockLpddr == 1
                      OR NOT ideqval CBS_CONFIG.CbsCmnMemTimingTrcpageCtrlLpddr == 1;
                // Trcpage
                // SDRAM Optional Features (tMAW, MAC). Valid value 3FFh - 0h
                numeric
                  varid       = CBS_CONFIG.CbsCmnMemTimingTrcpageLpddr,
                  prompt      = STRING_TOKEN (AMD_CBS_STR_TRCPAGE),
                  help        = STRING_TOKEN (AMD_CBS_STR_TRCPAGE_HELP),
                  flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
                  minimum     = 0,
                  maximum     = 0x3ff,
                  step        = 0,
                  default     = 0,
                endnumeric;
              endif;

              // Display Condition: CbsCmnMemOverclockLpddr=Enabled
              suppressif NOT ideqval CBS_CONFIG.CbsCmnMemOverclockLpddr == 1;
                // Tcwl
                // Specifies the CAS Write Latency
                oneof
                  varid       = CBS_CONFIG.CbsCmnMemTimingTcwlLpddr,
                  prompt      = STRING_TOKEN (AMD_CBS_STR_TCWL),
                  help        = STRING_TOKEN (AMD_CBS_STR_TCWL_HELP),
                  option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_9_CLK),           value = 9,    flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_0AH_CLK),         value = 0xA,  flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_0BH_CLK),         value = 0xB,  flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_0CH_CLK),         value = 0xC,  flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_0EH_CLK),         value = 0xE,  flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_10H_CLK),         value = 0x10, flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_12H_CLK),         value = 0x12, flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_14H_CLK),         value = 0x14, flags = 0 | RESET_REQUIRED;
                endoneof;
              endif;

              // Display Condition: CbsCmnMemOverclockLpddr=Enabled
              suppressif NOT ideqval CBS_CONFIG.CbsCmnMemOverclockLpddr == 1;
                // Tcl
                // Specifies the CAS latency.
                oneof
                  varid       = CBS_CONFIG.CbsCmnMemTimingTclLpddr,
                  prompt      = STRING_TOKEN (AMD_CBS_STR_TCL_1),
                  help        = STRING_TOKEN (AMD_CBS_STR_TCL_HELP),
                  option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_8_CLK),           value = 8,    flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_9_CLK),           value = 9,    flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_0AH_CLK),         value = 0xA,  flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_0BH_CLK),         value = 0xB,  flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_0CH_CLK),         value = 0xC,  flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_0DH_CLK),         value = 0xD,  flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_0EH_CLK),         value = 0xE,  flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_0FH_CLK),         value = 0xF,  flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_10H_CLK),         value = 0x10, flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_11H_CLK),         value = 0x11, flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_12H_CLK),         value = 0x12, flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_13H_CLK),         value = 0x13, flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_14H_CLK),         value = 0x14, flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_15H_CLK),         value = 0x15, flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_16H_CLK),         value = 0x16, flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_17H_CLK),         value = 0x17, flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_18H_CLK),         value = 0x18, flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_19H_CLK),         value = 0x19, flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_1AH_CLK),         value = 0x1A, flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_1BH_CLK),         value = 0x1B, flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_1CH_CLK),         value = 0x1C, flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_1DH_CLK),         value = 0x1D, flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_1EH_CLK),         value = 0x1E, flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_1FH_CLK),         value = 0x1F, flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_20H_CLK),         value = 0x20, flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_21H_CLK),         value = 0x21, flags = 0 | RESET_REQUIRED;
                endoneof;
              endif;

              // Display Condition: CbsCmnMemOverclockLpddr=Enabled
              suppressif NOT ideqval CBS_CONFIG.CbsCmnMemOverclockLpddr == 1;
                // Trcdrd
                // Specifies the RAS# Active to CAS# Read Delay Time.
                oneof
                  varid       = CBS_CONFIG.CbsCmnMemTimingTrcdrdLpddr,
                  prompt      = STRING_TOKEN (AMD_CBS_STR_TRCDRD),
                  help        = STRING_TOKEN (AMD_CBS_STR_TRCDRD_HELP),
                  option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_8_CLK),           value = 8,    flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_9_CLK),           value = 9,    flags = 0 | RESET_REQUIRED;
                  option text = STRING_TOKEN (AMD_CBS_STR_0AH_CLK),         value = 0xA,  flags = 0 | RESET_REQUIRED;
