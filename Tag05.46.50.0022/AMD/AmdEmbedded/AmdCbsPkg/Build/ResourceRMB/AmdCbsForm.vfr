          option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLE),          value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // PCIe Port 11
        // Enable/Disable Switch Downstream Port 11
        oneof
          varid       = CBS_CONFIG.CbsCmnPT21PcieP11,
          prompt      = STRING_TOKEN (AMD_CBS_STR_PCIE_PORT_11),
          help        = STRING_TOKEN (AMD_CBS_STR_PCIE_PORT_11_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLE),          value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // PCIe Port 12
        // Enable/Disable Switch Downstream Port 12\n(Note: Disable this port will also disable USB xHCI controller.)
        oneof
          varid       = CBS_CONFIG.CbsCmnPT21PcieP12,
          prompt      = STRING_TOKEN (AMD_CBS_STR_PCIE_PORT_12),
          help        = STRING_TOKEN (AMD_CBS_STR_PCIE_PORT_12_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLE),          value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // PCIe Port 13
        // Enable/Disable Switch Downstream Port 13\n(Note: Disable this port will also disable SATA AHCI controller.)
        oneof
          varid       = CBS_CONFIG.CbsCmnPT21PcieP13,
          prompt      = STRING_TOKEN (AMD_CBS_STR_PCIE_PORT_13),
          help        = STRING_TOKEN (AMD_CBS_STR_PCIE_PORT_13_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLE),          value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

      endform;
      //
      // form - PROM21 Chipset SATA Configuration Options
      //
      form

        formid        = SETUP_PROM21_CHIPSET_SATA_CONFIGURATION_OPTIONS_LABLE,

        title         = STRING_TOKEN (AMD_CBS_STR_PROM21_CHIPSET_SATA_CONFIGURATION_OPTIONS_SECTION);

        subtitle text = STRING_TOKEN (AMD_CBS_STR_PROM21_CHIPSET_SATA_CONFIGURATION_OPTIONS_SECTION);
        subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

        // SATA Mode
        // Select Promontory 21 SATA Type
        oneof
          varid       = CBS_CONFIG.CbsCmnPT21SataClass,
          prompt      = STRING_TOKEN (AMD_CBS_STR_SATA_MODE_1),
          help        = STRING_TOKEN (AMD_CBS_STR_SATA_MODE_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_AHCI),            value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_RAID),            value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // SATA Port 0
        // AHCI SATA port 0 enable 
        oneof
          varid       = CBS_CONFIG.CbsCmnPT21SataPort0,
          prompt      = STRING_TOKEN (AMD_CBS_STR_SATA_PORT_0),
          help        = STRING_TOKEN (AMD_CBS_STR_SATA_PORT_0_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLE),          value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // SATA Port 1
        // AHCI SATA port 1 enable 
        oneof
          varid       = CBS_CONFIG.CbsCmnPT21SataPort1,
          prompt      = STRING_TOKEN (AMD_CBS_STR_SATA_PORT_1),
          help        = STRING_TOKEN (AMD_CBS_STR_SATA_PORT_1_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLE),          value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // SATA Port 2
        // AHCI SATA port 2 enable 
        oneof
          varid       = CBS_CONFIG.CbsCmnPT21SataPort2,
