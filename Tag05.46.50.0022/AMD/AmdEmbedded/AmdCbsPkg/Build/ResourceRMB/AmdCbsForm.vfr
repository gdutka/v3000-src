          prompt      = STRING_TOKEN (AMD_CBS_STR_FAN_POLARITY),
          help        = STRING_TOKEN (AMD_CBS_STR_FAN_POLARITY_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xF,  flags = DEFAULT | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_1),               value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_0),               value = 0,    flags = 0 | RESET_REQUIRED;
        endoneof;
      endif;

      // VDDP Voltage Control
      // Auto = Use default VDDP voltage\nManual = User can set custom VDDP voltage
      oneof
        varid       = CBS_CONFIG.CbsDbgVddpVoltageCtl,
        prompt      = STRING_TOKEN (AMD_CBS_STR_VDDP_VOLTAGE_CONTROL),
        help        = STRING_TOKEN (AMD_CBS_STR_VDDP_VOLTAGE_CONTROL_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_MANUAL),          value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0,    flags = DEFAULT | RESET_REQUIRED;
      endoneof;

      // Display Condition: CbsDbgVddpVoltageCtl=Manual
      suppressif NOT ideqval CBS_CONFIG.CbsDbgVddpVoltageCtl == 1;
        // VDDP Voltage
        // Specify the target VDDP voltage [mV]
        numeric
          varid       = CBS_CONFIG.CbsDbgVddpVoltage,
          prompt      = STRING_TOKEN (AMD_CBS_STR_VDDP_VOLTAGE),
          help        = STRING_TOKEN (AMD_CBS_STR_VDDP_VOLTAGE_HELP),
          flags       = RESET_REQUIRED,
          minimum     = 0,
          maximum     = 0x7d0,
          step        = 0,
          default     = 0,
        endnumeric;
      endif;

      // VDDM Voltage Control
      // Auto = Use default VDDM voltage\nManual = User can set custom VDDM voltage
      oneof
        varid       = CBS_CONFIG.CbsDbgVddmVoltageCtl,
        prompt      = STRING_TOKEN (AMD_CBS_STR_VDDM_VOLTAGE_CONTROL),
        help        = STRING_TOKEN (AMD_CBS_STR_VDDM_VOLTAGE_CONTROL_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_MANUAL),          value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0,    flags = DEFAULT | RESET_REQUIRED;
      endoneof;

      // Display Condition: CbsDbgVddmVoltageCtl=Manual
      suppressif NOT ideqval CBS_CONFIG.CbsDbgVddmVoltageCtl == 1;
        // VDDM Voltage
        // Specify the target VDDM voltage [mV]
        numeric
          varid       = CBS_CONFIG.CbsDbgVddmVoltage,
          prompt      = STRING_TOKEN (AMD_CBS_STR_VDDM_VOLTAGE),
          help        = STRING_TOKEN (AMD_CBS_STR_VDDM_VOLTAGE_HELP),
          flags       = RESET_REQUIRED,
          minimum     = 0,
          maximum     = 0x7d0,
          step        = 0,
          default     = 0,
        endnumeric;
      endif;

      goto SETUP_SMARTSHIFT_CONTROL_LABLE,
        prompt      = STRING_TOKEN (AMD_CBS_STR_SMARTSHIFT_CONTROL_SECTION),
        help        = STRING_TOKEN (AMD_CBS_STR_SMARTSHIFT_CONTROL_SECTION);

      // Zstates (Z9 and Z10)
      // Enable = Enable the feature : Disable = Disable the feature
      oneof
        varid       = CBS_CONFIG.CbsCmnGnbSmuZstates,
        prompt      = STRING_TOKEN (AMD_CBS_STR_ZSTATES_Z9_AND_Z10),
        help        = STRING_TOKEN (AMD_CBS_STR_ZSTATES_Z9_AND_Z10_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xF,  flags = DEFAULT | RESET_REQUIRED;
      endoneof;

      // CclkFmaxOverride Control
      // Auto = Use default CclkFmaxOverride settings\nManual = User can set custom CclkFmaxOverride
      oneof
        varid       = CBS_CONFIG.CbsCmnCclkFmaxCtl,
        prompt      = STRING_TOKEN (AMD_CBS_STR_CCLKFMAXOVERRIDE_CONTROL),
        help        = STRING_TOKEN (AMD_CBS_STR_CCLKFMAXOVERRIDE_CONTROL_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_MANUAL),          value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0,    flags = DEFAULT | RESET_REQUIRED;
      endoneof;

      // Display Condition: CbsCmnCclkFmaxCtl=Manual
      suppressif NOT ideqval CBS_CONFIG.CbsCmnCclkFmaxCtl == 1;
        // CclkFmaxOverride
        // Specify the CCLK Fmax override [MHz]
        numeric
          varid       = CBS_CONFIG.CbsCmnCclkFmaxOverride,
          prompt      = STRING_TOKEN (AMD_CBS_STR_CCLKFMAXOVERRIDE),
          help        = STRING_TOKEN (AMD_CBS_STR_CCLKFMAXOVERRIDE_HELP),
          flags       = RESET_REQUIRED,
          minimum     = 0,
          maximum     = 65535,
          step        = 0,
          default     = 0,
        endnumeric;
      endif;

      // DF Pstate P0 Ctl
      // No help string
      oneof
        varid       = CBS_CONFIG.CbsCmnDfPstateP0Ctl,
        prompt      = STRING_TOKEN (AMD_CBS_STR_DF_PSTATE_P0_CTL),
        help        = STRING_TOKEN (AMD_CBS_STR_DF_PSTATE_P0_CTL_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_MANUAL),          value = 1,    flags = 0 | RESET_REQUIRED;
      endoneof;

      // Display Condition: CbsCmnDfPstateP0Ctl=Manual
      suppressif NOT ideqval CBS_CONFIG.CbsCmnDfPstateP0Ctl == 1;
        // DF Pstate Fclk P0
        // Fclk frequency in MHZ
        oneof
          varid       = CBS_CONFIG.CbsCmnDfPstateFclkP0,
          prompt      = STRING_TOKEN (AMD_CBS_STR_DF_PSTATE_FCLK_P0),
          help        = STRING_TOKEN (AMD_CBS_STR_DF_PSTATE_FCLK_P0_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_333MHZ),          value = 333,  flags = DEFAULT | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_400MHZ),          value = 400,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_500MHZ),          value = 500,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_533MHZ),          value = 533,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_667MHZ),          value = 667,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_733MHZ),          value = 733,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_800MHZ),          value = 800,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_933MHZ),          value = 933,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_1067MHZ),         value = 1067, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_1200MHZ),         value = 1200, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_1300MHZ),         value = 1300, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_1375MHZ),         value = 1375, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_1466MHZ),         value = 1466, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_1600MHZ),         value = 1600, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_1800MHZ),         value = 1800, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_2000MHZ),         value = 2000, flags = 0 | RESET_REQUIRED;
        endoneof;
      endif;

      // Display Condition: CbsCmnDfPstateP0Ctl=Manual
      suppressif NOT ideqval CBS_CONFIG.CbsCmnDfPstateP0Ctl == 1;
        // DF Pstate MemClk P0
        // Mem frequency in MHZ
        oneof
          varid       = CBS_CONFIG.CbsCmnDfPstateMemClkP0,
          prompt      = STRING_TOKEN (AMD_CBS_STR_DF_PSTATE_MEMCLK_P0),
          help        = STRING_TOKEN (AMD_CBS_STR_DF_PSTATE_MEMCLK_P0_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_167MHZ),          value = 167,  flags = DEFAULT | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_200MHZ),          value = 200,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_267MHZ),          value = 267,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_333MHZ),          value = 333,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_367MHZ),          value = 367,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_400MHZ),          value = 400,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_467MHZ),          value = 467,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_533MHZ),          value = 533,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_600MHZ),          value = 600,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_687MHZ),          value = 687,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_733MHZ),          value = 733,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_800MHZ),          value = 800,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_933MHZ),          value = 933,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_1000MHZ),         value = 1000, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_1600MHZ),         value = 1600, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_1800MHZ),         value = 1800, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_2000MHZ),         value = 2000, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_2400MHZ),         value = 2400, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_2600MHZ),         value = 2600, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_2800MHZ),         value = 2800, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_3000MHZ),         value = 3000, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_3200MHZ),         value = 3200, flags = 0 | RESET_REQUIRED;
        endoneof;
      endif;

      // Fixed FCLK
      // Set the Fclk Value\nNote: Changing this will disable FCLK DPM and\nMore than one level can have the same frequency value
      oneof
        varid       = CBS_CONFIG.CbsCmnFclkValue,
        prompt      = STRING_TOKEN (AMD_CBS_STR_FIXED_FCLK),
        help        = STRING_TOKEN (AMD_CBS_STR_FIXED_FCLK_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_LEVEL_0),         value = 0,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_LEVEL_1),         value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_LEVEL_2),         value = 2,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_LEVEL_3),         value = 3,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
      endoneof;

      // Fixed LCLK
      // Set the Lclk value\nNote: Changing this will disable LCLK DPM and\nMore than one level can have the same frequency value
      oneof
        varid       = CBS_CONFIG.CbsCmnLclkFreq,
        prompt      = STRING_TOKEN (AMD_CBS_STR_FIXED_LCLK),
        help        = STRING_TOKEN (AMD_CBS_STR_FIXED_LCLK_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_LEVEL_0),         value = 0,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_LEVEL_1),         value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_LEVEL_2),         value = 2,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_LEVEL_3),         value = 3,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_LEVEL_4),         value = 4,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_LEVEL_5),         value = 5,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_LEVEL_6),         value = 6,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_LEVEL_7),         value = 7,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
      endoneof;

      // Reset on MP1 SMN Timeout
      // No help string
      oneof
        varid       = CBS_CONFIG.CbsCmnRstOnMp1SMNTimeout,
        prompt      = STRING_TOKEN (AMD_CBS_STR_RESET_ON_MP1_SMN_TIMEOUT),
        help        = STRING_TOKEN (AMD_CBS_STR_RESET_ON_MP1_SMN_TIMEOUT_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = DEFAULT | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
      endoneof;

    endform;
      //
      // form - SmartShift Control
      //
      form

        formid        = SETUP_SMARTSHIFT_CONTROL_LABLE,

        title         = STRING_TOKEN (AMD_CBS_STR_SMARTSHIFT_CONTROL_SECTION);

        subtitle text = STRING_TOKEN (AMD_CBS_STR_SMARTSHIFT_CONTROL_SECTION);
        subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

        // SmartShift Control
        // No help string
        oneof
          varid       = CBS_CONFIG.CbsCmnAACtl,
          prompt      = STRING_TOKEN (AMD_CBS_STR_SMARTSHIFT_CONTROL_1),
          help        = STRING_TOKEN (AMD_CBS_STR_SMARTSHIFT_CONTROL_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xF,  flags = DEFAULT | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_MANUAL),          value = 1,    flags = 0 | RESET_REQUIRED;
        endoneof;

        // Display Condition: CbsCmnAACtl=Manual
        suppressif NOT ideqval CBS_CONFIG.CbsCmnAACtl == 1;
          // SmartShift Enable
          // A+A Support Enable
          oneof
            varid       = CBS_CONFIG.CbsCmnAAEn,
            prompt      = STRING_TOKEN (AMD_CBS_STR_SMARTSHIFT_ENABLE),
            help        = STRING_TOKEN (AMD_CBS_STR_SMARTSHIFT_ENABLE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xF,  flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLE),          value = 1,    flags = 0 | RESET_REQUIRED;
          endoneof;
        endif;

        // Display Condition: CbsCmnAACtl=Manual
        suppressif NOT ideqval CBS_CONFIG.CbsCmnAACtl == 1;
          // APU Only sPPT Limit
          // APU Only sPPT Limit in mW
          numeric
            varid       = CBS_CONFIG.CbsCmnApuOnlySpptLimit,
            prompt      = STRING_TOKEN (AMD_CBS_STR_APU_ONLY_SPPT_LIMIT),
            help        = STRING_TOKEN (AMD_CBS_STR_APU_ONLY_SPPT_LIMIT_HELP),
            flags       = RESET_REQUIRED,
            minimum     = 0,
            maximum     = 0xFFFFFFFF,
            step        = 0,
            default     = 0,
          endnumeric;
        endif;

        // Display Condition: CbsCmnAACtl=Manual
        suppressif NOT ideqval CBS_CONFIG.CbsCmnAACtl == 1;
          // Sustained PowerLimit
          // PcdMsgSetSustainedPowerLimit
          numeric
            varid       = CBS_CONFIG.CbsCmnMsgSetSustainedPowerLimit,
            prompt      = STRING_TOKEN (AMD_CBS_STR_SUSTAINED_POWERLIMIT),
            help        = STRING_TOKEN (AMD_CBS_STR_SUSTAINED_POWERLIMIT_HELP),
            flags       = RESET_REQUIRED,
            minimum     = 0,
            maximum     = 0xFFFFFFFF,
            step        = 0,
            default     = 0,
          endnumeric;
        endif;

        // Display Condition: CbsCmnAACtl=Manual
        suppressif NOT ideqval CBS_CONFIG.CbsCmnAACtl == 1;
          // Fast PPT Limit
          // PcdMsgSetFastPPTLimit
          numeric
            varid       = CBS_CONFIG.CbsCmnMsgSetFastPPTLimit,
            prompt      = STRING_TOKEN (AMD_CBS_STR_FAST_PPT_LIMIT_1),
            help        = STRING_TOKEN (AMD_CBS_STR_FAST_PPT_LIMIT_HELP),
            flags       = RESET_REQUIRED,
            minimum     = 0,
            maximum     = 0xFFFFFFFF,
            step        = 0,
            default     = 0,
          endnumeric;
        endif;

        // Display Condition: CbsCmnAACtl=Manual
        suppressif NOT ideqval CBS_CONFIG.CbsCmnAACtl == 1;
          // Slow PPT Limit
          // PcdMsgSetSlowPPTLimit
          numeric
            varid       = CBS_CONFIG.CbsCmnMsgSeSlowPPTLimit,
            prompt      = STRING_TOKEN (AMD_CBS_STR_SLOW_PPT_LIMIT_1),
            help        = STRING_TOKEN (AMD_CBS_STR_SLOW_PPT_LIMIT_HELP),
            flags       = RESET_REQUIRED,
            minimum     = 0,
            maximum     = 0xFFFFFFFF,
            step        = 0,
            default     = 0,
          endnumeric;
        endif;

      endform;
    //
    // form - SOC Miscellaneous Control
    //
    form

      formid        = SETUP_SOC_MISCELLANEOUS_CONTROL_LABLE,

      title         = STRING_TOKEN (AMD_CBS_STR_SOC_MISCELLANEOUS_CONTROL_SECTION);

      subtitle text = STRING_TOKEN (AMD_CBS_STR_SOC_MISCELLANEOUS_CONTROL_SECTION);
      subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

      // PSP RPMC Switch
      // Control RPMC usage.\nEnable : Enable RMPC function\nDisable : Disable RMPC function\nAuto : Keep default behavior\n\nThis option is for test purpose only,\nNOT FOR PRODUCTION!!!
      oneof
        varid       = CBS_CONFIG.CbsCmnPspRpmcSwitch,
        prompt      = STRING_TOKEN (AMD_CBS_STR_PSP_RPMC_SWITCH),
        help        = STRING_TOKEN (AMD_CBS_STR_PSP_RPMC_SWITCH_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
      endoneof;

      goto SETUP_FIRMWARE_ANTI_ROLLBACK_FAR_LABLE,
        prompt      = STRING_TOKEN (AMD_CBS_STR_FIRMWARE_ANTI_ROLLBACK_FAR_SECTION),
        help        = STRING_TOKEN (AMD_CBS_STR_FIRMWARE_ANTI_ROLLBACK_FAR_SECTION);

      // Display Condition: CbsComboFlag=0|CbsComboFlag=1|CbsComboFlag=2|CbsComboFlag=3|CbsComboFlag=4|CbsComboFlag=5
      suppressif NOT ideqval CBS_CONFIG.CbsComboFlag == 0
             AND NOT ideqval CBS_CONFIG.CbsComboFlag == 1
             AND NOT ideqval CBS_CONFIG.CbsComboFlag == 2
             AND NOT ideqval CBS_CONFIG.CbsComboFlag == 3
             AND NOT ideqval CBS_CONFIG.CbsComboFlag == 4
             AND NOT ideqval CBS_CONFIG.CbsComboFlag == 5;
        // Rom Armor support
        // Enable/disable Rom Armor
        oneof
          varid       = CBS_CONFIG.CbsCmnRomArmorSupport,
          prompt      = STRING_TOKEN (AMD_CBS_STR_ROM_ARMOR_SUPPORT),
          help        = STRING_TOKEN (AMD_CBS_STR_ROM_ARMOR_SUPPORT_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xF,  flags = DEFAULT | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 3,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
        endoneof;
      endif;

      // Rom Armor Spi Config Reg Lock
      // Enable/disable Rom Armor Spi Config Reg Lock
      oneof
        varid       = CBS_CONFIG.CbsCmnRomArmorSpiConfigRegLock,
        prompt      = STRING_TOKEN (AMD_CBS_STR_ROM_ARMOR_SPI_CONFIG_REG_LOCK),
        help        = STRING_TOKEN (AMD_CBS_STR_ROM_ARMOR_SPI_CONFIG_REG_LOCK_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xF,  flags = DEFAULT | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
      endoneof;

      // ABL Console Out Control
      // Enable : Enable ConsoleOut Function for ABL\nDisable : Disable ConsoleOut Function for ABL\nAuto : Keep default behavior
      oneof
        varid       = CBS_CONFIG.CbsCmnSocAblConOut,
        prompt      = STRING_TOKEN (AMD_CBS_STR_ABL_CONSOLE_OUT_CONTROL),
        help        = STRING_TOKEN (AMD_CBS_STR_ABL_CONSOLE_OUT_CONTROL_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 2,    flags = DEFAULT | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_ENABLE),          value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
      endoneof;

      // Display Condition: CbsCmnSocAblConOut=Enable
      suppressif NOT ideqval CBS_CONFIG.CbsCmnSocAblConOut == 1;
        // ABL Console Out Serial Port
        // Specifies the type of console output serial port.
        oneof
          varid       = CBS_CONFIG.CbsCmnSocAblConOutSerialPort,
          prompt      = STRING_TOKEN (AMD_CBS_STR_ABL_CONSOLE_OUT_SERIAL_PORT),
          help        = STRING_TOKEN (AMD_CBS_STR_ABL_CONSOLE_OUT_SERIAL_PORT_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_LPC_UART),        value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_FCH_UART0),       value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_FCH_UART1),       value = 2,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_FCH_UART2),       value = 3,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_FCH_UART3),       value = 4,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ESPI_UART),       value = 5,    flags = 0 | RESET_REQUIRED;
        endoneof;
      endif;

      // Active Condition: CbsCmnSocAblConOutSerialPort=eSPI UART
      grayoutif NOT ideqval CBS_CONFIG.CbsCmnSocAblConOutSerialPort == 5;
        // ABL Console Out Serial Port IO
        // Select Legacy Uart (SIO or eSPI) IO base\n0x3F8:  Set  IO base to 0x3F8\n0x2F8:  Set  IO base to 0x2F8\n0x3E8:  Set  IO base to 0x3E8\n0x2E8:  Set  IO base to 0x2E8\nAuto : Keep default behavior\n  Please make sure the selected eSPI IO base and length has been filled in APCB_FCH_TYPE_ESPI_INIT or APCB_FCH_TYPE_ESPI1_INIT EspiInitConfiguration table.\n      
        oneof
          varid       = CBS_CONFIG.CbsCmnSocAblConOutSerialPortIO,
          prompt      = STRING_TOKEN (AMD_CBS_STR_ABL_CONSOLE_OUT_SERIAL_PORT_IO),
          help        = STRING_TOKEN (AMD_CBS_STR_ABL_CONSOLE_OUT_SERIAL_PORT_IO_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_0X3F8),           value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_0X2F8),           value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_0X3E8),           value = 2,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_0X2E8),           value = 3,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
        endoneof;
      endif;

      // Display Condition: CbsCmnSocAblConOut=Enable
      suppressif NOT ideqval CBS_CONFIG.CbsCmnSocAblConOut == 1;
        // ABL Console Out Boot Mode Select
        // No help string
        oneof
          varid       = CBS_CONFIG.CbsCmnSocAblConOutBootMode,
          prompt      = STRING_TOKEN (AMD_CBS_STR_ABL_CONSOLE_OUT_BOOT_MODE_SELECT),
          help        = STRING_TOKEN (AMD_CBS_STR_ABL_CONSOLE_OUT_BOOT_MODE_SELECT_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_ALL),             value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_S3_S0I3_ONLY),    value = 2,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_NORMAL_BOOT_ONLY), value = 1,    flags = 0 | RESET_REQUIRED;
        endoneof;
      endif;

      // Display Condition: CbsCmnSocAblConOut=Enable
      // Active Condition: CbsCmnSocAblConOut=Enable
      suppressif NOT ideqval CBS_CONFIG.CbsCmnSocAblConOut == 1;
      grayoutif NOT ideqval CBS_CONFIG.CbsCmnSocAblConOut == 1;
        // ABL PMU message Control
        // To control the total number of PMU debug messages.\nSeveral major controls are listed below:\n1. Maximal debug messages (e.g., Eye contours)\n2. Detailed debug messages (e.g. Eye delays)\n3. Coarse debug messages (e.g. rank information)\n4. Stage completion\n5. Assertion messages\n6. Firmware completion messages only
        oneof
          varid       = CBS_CONFIG.CbsCmnSocAblPmuMsgCtrl,
          prompt      = STRING_TOKEN (AMD_CBS_STR_ABL_PMU_MESSAGE_CONTROL),
          help        = STRING_TOKEN (AMD_CBS_STR_ABL_PMU_MESSAGE_CONTROL_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_MAXIMAL_DEBUG_MESSAGES), value = 0x4,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_DETAILED_DEBUG_MESSAGE), value = 0x05, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_COARSE_DEBUG_MESSAGE), value = 0x0A, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_STAGE_COMPLETION), value = 0xC8, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ASSERTION_MESSAGE), value = 0xC9, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_FIRMWARE_COMPLETION_MESSAGE_ONLY), value = 0xFE, flags = 0 | RESET_REQUIRED;
        endoneof;
      endif;
      endif;

      // Secured-core Auto enablement
      // If set to Disable, AGESA will delete EFI variable "BuiltAsSecuredCorePC" if detected\nIf set to Enable, AGESA will set EFI variable "BuiltAsSecuredCorePC" to non-zero value\nIf "BuiltAsSecuredCorePC" set to non-zero, it will identify a device as Secure-core PC\nMore detials refer to "Secured-Core PC Identifier" in MSFT document.\nIf set to Auto, ignore, AGESA will do nothing
      oneof
        varid       = CBS_CONFIG.CbsCmnSocScpcAutoEnablement,
        prompt      = STRING_TOKEN (AMD_CBS_STR_SECURED_CORE_AUTO_ENABLEMENT),
        help        = STRING_TOKEN (AMD_CBS_STR_SECURED_CORE_AUTO_ENABLEMENT_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
      endoneof;

      goto SETUP_PLUTON_HSP_OPTIONS_LABLE,
        prompt      = STRING_TOKEN (AMD_CBS_STR_PLUTON_HSP_OPTIONS_SECTION),
        help        = STRING_TOKEN (AMD_CBS_STR_PLUTON_HSP_OPTIONS_SECTION);

      goto SETUP_AIM_T_OPTIONS_LABLE,
        prompt      = STRING_TOKEN (AMD_CBS_STR_AIM_T_OPTIONS_SECTION),
        help        = STRING_TOKEN (AMD_CBS_STR_AIM_T_OPTIONS_SECTION);

      goto SETUP_INTRUSION_DETECTION_LABLE,
        prompt      = STRING_TOKEN (AMD_CBS_STR_INTRUSION_DETECTION_SECTION),
        help        = STRING_TOKEN (AMD_CBS_STR_INTRUSION_DETECTION_SECTION);

      // Mixed DIMM config extended NUMA domain
      // Mixed DIMM config extended NUMA domain in SRAT that contain only non-interleaving memory region but no processor.
      oneof
        varid       = CBS_CONFIG.CbsCmnMixedDimmConfigNumaDomain,
        prompt      = STRING_TOKEN (AMD_CBS_STR_MIXED_DIMM_CONFIG_EXTENDED_NUMA_DOMAIN),
        help        = STRING_TOKEN (AMD_CBS_STR_MIXED_DIMM_CONFIG_EXTENDED_NUMA_DOMAIN_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
      endoneof;

    endform;
      //
      // form - Firmware Anti-rollback (FAR)
      //
      form

        formid        = SETUP_FIRMWARE_ANTI_ROLLBACK_FAR_LABLE,

        title         = STRING_TOKEN (AMD_CBS_STR_FIRMWARE_ANTI_ROLLBACK_FAR_SECTION);

        subtitle text = STRING_TOKEN (AMD_CBS_STR_FIRMWARE_ANTI_ROLLBACK_FAR_SECTION);
        subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

        // Active Condition: CbsComboFlag=255
        grayoutif NOT ideqval CBS_CONFIG.CbsComboFlag == 255;
          // FAR enforcement state
          // Enabled = FAR is permanently enforced in the CPU, the system can only boot from BIOS with update to date firmware stack as defined by SPL table. \nDisabled  = FAR is NOT enforced in the CPU
          oneof
            varid       = CBS_CONFIG.CbsCmnSocFarEnforced,
            questionid  = KEY_CBS_CMN_SOC_FAR_ENFORCED,
            prompt      = STRING_TOKEN (AMD_CBS_STR_FAR_ENFORCEMENT_STATE),
            help        = STRING_TOKEN (AMD_CBS_STR_FAR_ENFORCEMENT_STATE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = DEFAULT | RESET_REQUIRED | INTERACTIVE;
          endoneof;
        endif;

        // Active Condition: CbsComboFlag=255
        grayoutif NOT ideqval CBS_CONFIG.CbsComboFlag == 255;
          // SPL value in the CPU fuse
          // The current SPL value in the CPU fuse which is converted from fuse bitmask
          numeric
            varid       = CBS_CONFIG.CbsCmnSocSplFuse,
            questionid  = KEY_CBS_CMN_SOC_SPL_FUSE,
            prompt      = STRING_TOKEN (AMD_CBS_STR_SPL_VALUE_IN_THE_CPU_FUSE),
            help        = STRING_TOKEN (AMD_CBS_STR_SPL_VALUE_IN_THE_CPU_FUSE_HELP),
            flags       = RESET_REQUIRED | INTERACTIVE,
            minimum     = 0,
            maximum     = 0xff,
            step        = 0,
            default     = 0,
          endnumeric;
        endif;

        // Active Condition: CbsComboFlag=255
        grayoutif NOT ideqval CBS_CONFIG.CbsComboFlag == 255;
          // SPL value in the SPL table
          // if Initial SPL value is set to 0, the SPL fuse in the CPU will be upgraded to the SPL value in the SPL table at next boot.
          numeric
            varid       = CBS_CONFIG.CbsCmnSocSplValueInTbl,
            questionid  = KEY_CBS_CMN_SOC_SPL_VALUE_IN_TBL,
            prompt      = STRING_TOKEN (AMD_CBS_STR_SPL_VALUE_IN_THE_SPL_TABLE),
            help        = STRING_TOKEN (AMD_CBS_STR_SPL_VALUE_IN_THE_SPL_TABLE_HELP),
            flags       = RESET_REQUIRED | INTERACTIVE,
            minimum     = 0,
            maximum     = 0xff,
            step        = 0,
            default     = 0,
          endnumeric;
        endif;

        // Initial SPL value for FAR
        // Initial SPL value is only applicable when FAR switch is enabled.\n\n0 = initial SPL value is not set, SPL fuse will always follow the SPL value in the SPL table.\n\nNot 0 = if FAR has been enforced, BIOS will keep SPL fuse as it is. otherwise,  BIOS will enforce FAR and set SPL fuse to this initial SPL value.
        numeric
          varid       = CBS_CONFIG.CbsCmnSocInitSplForFar,
          questionid  = KEY_CBS_CMN_SOC_INIT_SPL_FOR_FAR,
          prompt      = STRING_TOKEN (AMD_CBS_STR_INITIAL_SPL_VALUE_FOR_FAR),
          help        = STRING_TOKEN (AMD_CBS_STR_INITIAL_SPL_VALUE_FOR_FAR_HELP),
          flags       = RESET_REQUIRED | INTERACTIVE,
          minimum     = 0,
          maximum     = 0xff,
          step        = 0,
          default     = 0,
        endnumeric;

        // FAR Switch
        // Enabled  = if initial SPL value is 0, and FAR is NOT enforced, BIOS will enforce FAR and set SPL fuse to SPL value in the SPL table.\n	       if initial SPL value is 0, and FAR is enforced, BIOS will update SPL fuse to SPL value in the SPL table.\n		   if initial SPL value is not 0, and FAR is NOT enforced, BIOS will enforce FAR and set SPL fuse to initial SPL value.\n		   if initial SPL value is not 0, and FAR is enforced, BIOS will keep SPL fuse as it is.\n\nDisabled = BIOS will NOT change FAR enforcement state and NOT set SPL fuse.
        oneof
          varid       = CBS_CONFIG.CbsCmnSocFarSwitch,
          questionid  = KEY_CBS_CMN_SOC_FAR_SWITCH,
          prompt      = STRING_TOKEN (AMD_CBS_STR_FAR_SWITCH),
          help        = STRING_TOKEN (AMD_CBS_STR_FAR_SWITCH_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = DEFAULT | RESET_REQUIRED | INTERACTIVE;
        endoneof;

      endform;
      //
      // form - Pluton (HSP) Options
      //
      form

        formid        = SETUP_PLUTON_HSP_OPTIONS_LABLE,

        title         = STRING_TOKEN (AMD_CBS_STR_PLUTON_HSP_OPTIONS_SECTION);

        subtitle text = STRING_TOKEN (AMD_CBS_STR_PLUTON_HSP_OPTIONS_SECTION);
        subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

        // Pluton (HSP) X86 Firmware Support
        // Enable/Disable X86 firmware HSP related code path, including AGESA HSP module, SBIOS HSP related drivers.\nAuto - Depends on PcdAmdHspCoreEnable build value\nNOTE: PSP directory entry 0xB BIT36 have the highest priority.\nNOTE: This option will NOT put HSP hardware in disable state, to disable HSP hardware, you need setup PSP directory entry 0xB, BIT36 to 1.\n// EntryValue[36] = 0: Enable, HSP core is enabled.\n// EntryValue[36] = 1: Disable, HSP core is disabled then PSP will gate the HSP clock, no further PSP to HSP commands. System will boot without HSP.\n\n 
        oneof
          varid       = CBS_CONFIG.CbsCmnSoCMiscX86FwSupport,
          prompt      = STRING_TOKEN (AMD_CBS_STR_PLUTON_HSP_X86_FIRMWARE_SUPPORT),
          help        = STRING_TOKEN (AMD_CBS_STR_PLUTON_HSP_X86_FIRMWARE_SUPPORT_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // Pluton (HSP) UART
        // HSP Firmware will print debug information to FCH UART, select to enable/disable this function, By default it will be disabled.
        oneof
          varid       = CBS_CONFIG.CbsCmnSoCMiscHspUart,
          prompt      = STRING_TOKEN (AMD_CBS_STR_PLUTON_HSP_UART),
          help        = STRING_TOKEN (AMD_CBS_STR_PLUTON_HSP_UART_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // Display Condition: CbsCmnSoCMiscHspUart=Enabled
        suppressif NOT ideqval CBS_CONFIG.CbsCmnSoCMiscHspUart == 1;
          // Pluton (HSP) UART Port
          // HSP Firmware will print debug information to FCH UART, select which FCH UART port to use. If auto selected, UART2 will be used
          oneof
            varid       = CBS_CONFIG.CbsCmnSoCMiscHspUartPort,
            prompt      = STRING_TOKEN (AMD_CBS_STR_PLUTON_HSP_UART_PORT),
            help        = STRING_TOKEN (AMD_CBS_STR_PLUTON_HSP_UART_PORT_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_UART_0),          value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_UART_1),          value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_UART_2),          value = 2,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_UART_3),          value = 3,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_UART_4),          value = 4,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_UART_5),          value = 5,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_UART_6),          value = 6,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_UART_7),          value = 7,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;
        endif;

        // Pluton (HSP) FIPS
        // Enable FIPS mode for HSP
        oneof
          varid       = CBS_CONFIG.CbsCmnSoCMiscHspFips,
          prompt      = STRING_TOKEN (AMD_CBS_STR_PLUTON_HSP_FIPS),
          help        = STRING_TOKEN (AMD_CBS_STR_PLUTON_HSP_FIPS_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // Display Condition: CbsCmnSoCMiscHspFips=Enabled
        suppressif NOT ideqval CBS_CONFIG.CbsCmnSoCMiscHspFips == 1;
          // Pluton (HSP) FIPS zeroization
          // HSP FIPS zeroization enable/disable
          oneof
            varid       = CBS_CONFIG.CbsCmnSoCMiscHspFipsZeroization,
            prompt      = STRING_TOKEN (AMD_CBS_STR_PLUTON_HSP_FIPS_ZEROIZATION),
            help        = STRING_TOKEN (AMD_CBS_STR_PLUTON_HSP_FIPS_ZEROIZATION_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;
        endif;

        // Pluton (HSP) ACPI Fence Enable
        // HSP ACPI fence enable/disable, 0: PCI Fence, 1: ACPI Fence\nThis for debug only, no need to set in production.\nIf set to Auto, ACPI Fence will be set by default except RMB A0\n
        oneof
          varid       = CBS_CONFIG.CbsCmnSoCMiscHspAcpiFenceEnable,
          prompt      = STRING_TOKEN (AMD_CBS_STR_PLUTON_HSP_ACPI_FENCE_ENABLE),
          help        = STRING_TOKEN (AMD_CBS_STR_PLUTON_HSP_ACPI_FENCE_ENABLE_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_FALSE),           value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_TRUE),            value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

      endform;
      //
      // form - AIM-T Options
      //
      form

        formid        = SETUP_AIM_T_OPTIONS_LABLE,

        title         = STRING_TOKEN (AMD_CBS_STR_AIM_T_OPTIONS_SECTION);

        subtitle text = STRING_TOKEN (AMD_CBS_STR_AIM_T_OPTIONS_SECTION);
        subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

        // AGESA MPM support
        // Only works on the platform which is AIM-T capable, turn off all MPM related feature for both wired KVM and wireless manageability
        oneof
          varid       = CBS_CONFIG.CbsCmnSoCMiscMpmSupport,
          questionid  = KEY_CBS_CMN_SO_C_MISC_MPM_SUPPORT,
          prompt      = STRING_TOKEN (AMD_CBS_STR_AGESA_MPM_SUPPORT),
          help        = STRING_TOKEN (AMD_CBS_STR_AGESA_MPM_SUPPORT_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED | INTERACTIVE;
        endoneof;

        // Display Condition: CbsCmnSoCMiscMpmSupport=Enabled
        // Active Condition: CbsCmnSocMiscMpmAttrCntl=0|CbsCmnSocMiscMpmAttrCntl=2|CbsCmnSocMiscMpmAttrCntl=3
        suppressif NOT ideqval CBS_CONFIG.CbsCmnSoCMiscMpmSupport == 1;
        grayoutif NOT ideqval CBS_CONFIG.CbsCmnSocMiscMpmAttrCntl == 0
              AND NOT ideqval CBS_CONFIG.CbsCmnSocMiscMpmAttrCntl == 2
              AND NOT ideqval CBS_CONFIG.CbsCmnSocMiscMpmAttrCntl == 3;
          // KVM for Wired Manageability
          // Only works on the platform which is AIM-T capable, Switch to turn off Wired KVM
          oneof
            varid       = CBS_CONFIG.CbsCmnSoCMiscWiredKvm,
            prompt      = STRING_TOKEN (AMD_CBS_STR_KVM_FOR_WIRED_MANAGEABILITY),
            help        = STRING_TOKEN (AMD_CBS_STR_KVM_FOR_WIRED_MANAGEABILITY_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;
        endif;
        endif;

        // Display Condition: CbsCmnSoCMiscMpmSupport=Enabled
        // Active Condition: CbsCmnSocMiscMpmAttrCntl=0|CbsCmnSocMiscMpmAttrCntl=1|CbsCmnSocMiscMpmAttrCntl=3
        suppressif NOT ideqval CBS_CONFIG.CbsCmnSoCMiscMpmSupport == 1;
        grayoutif NOT ideqval CBS_CONFIG.CbsCmnSocMiscMpmAttrCntl == 0
              AND NOT ideqval CBS_CONFIG.CbsCmnSocMiscMpmAttrCntl == 1
              AND NOT ideqval CBS_CONFIG.CbsCmnSocMiscMpmAttrCntl == 3;
          // Wireless Manageability
          // Only works on the platform which is AIM-T capable, Turn off All WirelessManageability related functions: KVM, TCR, PLDM, ALERT
          oneof
            varid       = CBS_CONFIG.CbsCmnSoCMiscWirelessManageability,
            prompt      = STRING_TOKEN (AMD_CBS_STR_WIRELESS_MANAGEABILITY),
            help        = STRING_TOKEN (AMD_CBS_STR_WIRELESS_MANAGEABILITY_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;
        endif;
        endif;

        // Display Condition: CbsCmnSoCMiscMpmSupport=Enabled,CbsCmnSoCMiscWirelessManageability=Enabled
        // Active Condition: CbsCmnSoCMiscWirelessManageability=Enabled
        suppressif NOT ideqval CBS_CONFIG.CbsCmnSoCMiscMpmSupport == 1
                OR NOT ideqval CBS_CONFIG.CbsCmnSoCMiscWirelessManageability == 1;
        grayoutif NOT ideqval CBS_CONFIG.CbsCmnSoCMiscWirelessManageability == 1;
          // KVM for Wireless Manageability
          // Only works on the platform which is AIM-T capable , Switch to turn off Wireless KVM
          oneof
            varid       = CBS_CONFIG.CbsCmnSoCMiscWirelessKvm,
            prompt      = STRING_TOKEN (AMD_CBS_STR_KVM_FOR_WIRELESS_MANAGEABILITY),
            help        = STRING_TOKEN (AMD_CBS_STR_KVM_FOR_WIRELESS_MANAGEABILITY_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;
        endif;
        endif;

        // Display Condition: CbsComboFlag=255
        suppressif NOT ideqval CBS_CONFIG.CbsComboFlag == 255;
          // MPM attribute control
          // Used to control the active behavior of Wireless Manageability and KVM for Wired Manageability options
          oneof
            varid       = CBS_CONFIG.CbsCmnSocMiscMpmAttrCntl,
            questionid  = KEY_CBS_CMN_SOC_MISC_MPM_ATTR_CNTL,
            prompt      = STRING_TOKEN (AMD_CBS_STR_MPM_ATTRIBUTE_CONTROL),
            help        = STRING_TOKEN (AMD_CBS_STR_MPM_ATTRIBUTE_CONTROL_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_0),               value = 0,    flags = DEFAULT | RESET_REQUIRED | INTERACTIVE;
            option text = STRING_TOKEN (AMD_CBS_STR_1),               value = 1,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
            option text = STRING_TOKEN (AMD_CBS_STR_2),               value = 2,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
            option text = STRING_TOKEN (AMD_CBS_STR_3),               value = 3,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
          endoneof;
        endif;

        // Display Condition: CbsCmnSoCMiscMpmSupport=Enabled,CbsCmnSoCMiscWirelessManageability=Enabled
        // Active Condition: CbsCmnSoCMiscWirelessManageability=Enabled
        suppressif NOT ideqval CBS_CONFIG.CbsCmnSoCMiscMpmSupport == 1
                OR NOT ideqval CBS_CONFIG.CbsCmnSoCMiscWirelessManageability == 1;
        grayoutif NOT ideqval CBS_CONFIG.CbsCmnSoCMiscWirelessManageability == 1;
          // TCR for Wireless Manageability
          // Only works on the platform which is AIM-T capable \nSwitch for MPM Text console redirection\n
          oneof
            varid       = CBS_CONFIG.CbsCmnSoCMiscWirelessTcr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_TCR_FOR_WIRELESS_MANAGEABILITY),
            help        = STRING_TOKEN (AMD_CBS_STR_TCR_FOR_WIRELESS_MANAGEABILITY_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;
        endif;
        endif;

      endform;
      //
      // form - Intrusion Detection
      //
      form

        formid        = SETUP_INTRUSION_DETECTION_LABLE,

        title         = STRING_TOKEN (AMD_CBS_STR_INTRUSION_DETECTION_SECTION);

        subtitle text = STRING_TOKEN (AMD_CBS_STR_INTRUSION_DETECTION_SECTION);
        subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

        // Intrusion Detection Control
        // Intrusion Detection settings should be configured by system administrator only, please input correct password.to show related settings
        numeric
          varid       = CBS_CONFIG.CbsCmnIntrusionDetectionCtl,
          prompt      = STRING_TOKEN (AMD_CBS_STR_INTRUSION_DETECTION_CONTROL),
          help        = STRING_TOKEN (AMD_CBS_STR_INTRUSION_DETECTION_CONTROL_HELP),
          flags       = RESET_REQUIRED,
          minimum     = 0x0000,
          maximum     = 0xFFFF,
          step        = 0,
          default     = 0,
        endnumeric;

        // Display Condition: CbsCmnIntrusionDetectionCtl=18756
        suppressif NOT ideqval CBS_CONFIG.CbsCmnIntrusionDetectionCtl == 18756;
          // Intrusion Detection Enable
          // Control Intrusion detection feature enablement\n\nEnabled=Intrusion detection feature is enabled\nDisabled=Intrusion detection feature is disabled
          oneof
            varid       = CBS_CONFIG.CbsCmnIntrusionDetectionEnable,
            prompt      = STRING_TOKEN (AMD_CBS_STR_INTRUSION_DETECTION_ENABLE),
            help        = STRING_TOKEN (AMD_CBS_STR_INTRUSION_DETECTION_ENABLE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          endoneof;
        endif;

        // Display Condition: CbsCmnIntrusionDetectionCtl=18756
        suppressif NOT ideqval CBS_CONFIG.CbsCmnIntrusionDetectionCtl == 18756;
          // Log Intrusion Event
          // Intrusion event should be logged or not when intrusion is detected\n\nEnabled=System will log intrusion event when intrusion is detected\nDisabled=System will not log intrusion event when intrusion is detected
          oneof
            varid       = CBS_CONFIG.CbsCmnIntrusionLogEvent,
            prompt      = STRING_TOKEN (AMD_CBS_STR_LOG_INTRUSION_EVENT),
            help        = STRING_TOKEN (AMD_CBS_STR_LOG_INTRUSION_EVENT_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = DEFAULT | RESET_REQUIRED;
          endoneof;
        endif;

        // Display Condition: CbsCmnIntrusionDetectionCtl=18756
        suppressif NOT ideqval CBS_CONFIG.CbsCmnIntrusionDetectionCtl == 18756;
          // Clear TPM
          // TPM should be cleared or not when intrusion is detected\n\nEnabled=System will clear TPM when intrusion is detected\nDisabled=System will not clear TPM when intrusion is detected
          oneof
            varid       = CBS_CONFIG.CbsCmnIntrusionClearTpm,
            prompt      = STRING_TOKEN (AMD_CBS_STR_CLEAR_TPM),
            help        = STRING_TOKEN (AMD_CBS_STR_CLEAR_TPM_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = DEFAULT | RESET_REQUIRED;
          endoneof;
        endif;

        // Display Condition: CbsCmnIntrusionDetectionCtl=18756
        suppressif NOT ideqval CBS_CONFIG.CbsCmnIntrusionDetectionCtl == 18756;
          // Power Off System
          // System will be powered off forcibly or not when intrusion is detected\n\nEnabled=System will be powered off forcibly when intrusion is detected\nDisabled=System will not be powered off forcibly when intrusion is detected
          oneof
            varid       = CBS_CONFIG.CbsCmnIntrusionPowerOff,
            prompt      = STRING_TOKEN (AMD_CBS_STR_POWER_OFF_SYSTEM),
            help        = STRING_TOKEN (AMD_CBS_STR_POWER_OFF_SYSTEM_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = DEFAULT | RESET_REQUIRED;
          endoneof;
        endif;

      endform;
    //
    // form - PROM21 Chipset Common Options
    //
    form

      formid        = SETUP_PROM21_CHIPSET_COMMON_OPTIONS_LABLE,

      title         = STRING_TOKEN (AMD_CBS_STR_PROM21_CHIPSET_COMMON_OPTIONS_SECTION);

      subtitle text = STRING_TOKEN (AMD_CBS_STR_PROM21_CHIPSET_COMMON_OPTIONS_SECTION);
      subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

      goto SETUP_PROM21_CHIPSET_PCIE_PORT_CONFIGURATION_OPTIONS_LABLE,
        prompt      = STRING_TOKEN (AMD_CBS_STR_PROM21_CHIPSET_PCIE_PORT_CONFIGURATION_OPTIONS_SECTION),
        help        = STRING_TOKEN (AMD_CBS_STR_PROM21_CHIPSET_PCIE_PORT_CONFIGURATION_OPTIONS_SECTION);

      goto SETUP_PROM21_CHIPSET_SATA_CONFIGURATION_OPTIONS_LABLE,
        prompt      = STRING_TOKEN (AMD_CBS_STR_PROM21_CHIPSET_SATA_CONFIGURATION_OPTIONS_SECTION),
        help        = STRING_TOKEN (AMD_CBS_STR_PROM21_CHIPSET_SATA_CONFIGURATION_OPTIONS_SECTION);

      goto SETUP_PROM21_CHIPSET_USB_CONFIGURATION_OPTIONS_LABLE,
        prompt      = STRING_TOKEN (AMD_CBS_STR_PROM21_CHIPSET_USB_CONFIGURATION_OPTIONS_SECTION),
        help        = STRING_TOKEN (AMD_CBS_STR_PROM21_CHIPSET_USB_CONFIGURATION_OPTIONS_SECTION);

      // Display Condition: CbsComboChipsetFlag=0x43F7|CbsComboChipsetFlag=0x43F8|CbsComboChipsetFlag=0x43F9
      suppressif NOT ideqval CBS_CONFIG.Header.CbsComboChipsetFlag == 0x43F7
             AND NOT ideqval CBS_CONFIG.Header.CbsComboChipsetFlag == 0x43F8
             AND NOT ideqval CBS_CONFIG.Header.CbsComboChipsetFlag == 0x43F9;
        goto SETUP_PROM21L_DOT_1_2_3_USB_PORT_CONFIGURATION_OPTIONS_LABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_PROM21L_DOT_1_2_3_USB_PORT_CONFIGURATION_OPTIONS_SECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_PROM21L_DOT_1_2_3_USB_PORT_CONFIGURATION_OPTIONS_SECTION);
      endif;

      // Display Condition: CbsComboChipsetFlag=0x43FA
      suppressif NOT ideqval CBS_CONFIG.Header.CbsComboChipsetFlag == 0x43FA;
        goto SETUP_PROM21L_DOT_4_USB_PORT_CONFIGURATION_OPTIONS_LABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_PROM21L_DOT_4_USB_PORT_CONFIGURATION_OPTIONS_SECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_PROM21L_DOT_4_USB_PORT_CONFIGURATION_OPTIONS_SECTION);
      endif;

      // Display Condition: CbsChipsetVisibleFlag0=0xF7|CbsChipsetVisibleFlag0=0xF8|CbsChipsetVisibleFlag0=0xF9|CbsChipsetVisibleFlag0=0xFA
      suppressif NOT ideqval CBS_CONFIG.Header.CbsChipsetVisibleFlag0 == 0xF7
             AND NOT ideqval CBS_CONFIG.Header.CbsChipsetVisibleFlag0 == 0xF8
             AND NOT ideqval CBS_CONFIG.Header.CbsChipsetVisibleFlag0 == 0xF9
             AND NOT ideqval CBS_CONFIG.Header.CbsChipsetVisibleFlag0 == 0xFA;
        goto SETUP_SECONDARY_PROM21_CHIPSET_PCIE_PORT_CONFIGURATION_OPTIONS_LABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_SECONDARY_PROM21_CHIPSET_PCIE_PORT_CONFIGURATION_OPTIONS_SECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_SECONDARY_PROM21_CHIPSET_PCIE_PORT_CONFIGURATION_OPTIONS_SECTION);
      endif;

      // Display Condition: CbsChipsetVisibleFlag0=0xF7|CbsChipsetVisibleFlag0=0xF8|CbsChipsetVisibleFlag0=0xF9|CbsChipsetVisibleFlag0=0xFA
      suppressif NOT ideqval CBS_CONFIG.Header.CbsChipsetVisibleFlag0 == 0xF7
             AND NOT ideqval CBS_CONFIG.Header.CbsChipsetVisibleFlag0 == 0xF8
             AND NOT ideqval CBS_CONFIG.Header.CbsChipsetVisibleFlag0 == 0xF9
             AND NOT ideqval CBS_CONFIG.Header.CbsChipsetVisibleFlag0 == 0xFA;
        goto SETUP_SECONDARY_PROM21_CHIPSET_SATA_CONFIGURATION_OPTIONS_LABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_SECONDARY_PROM21_CHIPSET_SATA_CONFIGURATION_OPTIONS_SECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_SECONDARY_PROM21_CHIPSET_SATA_CONFIGURATION_OPTIONS_SECTION);
      endif;

      // Display Condition: CbsChipsetVisibleFlag0=0xF7|CbsChipsetVisibleFlag0=0xF8|CbsChipsetVisibleFlag0=0xF9|CbsChipsetVisibleFlag0=0xFA
      suppressif NOT ideqval CBS_CONFIG.Header.CbsChipsetVisibleFlag0 == 0xF7
             AND NOT ideqval CBS_CONFIG.Header.CbsChipsetVisibleFlag0 == 0xF8
             AND NOT ideqval CBS_CONFIG.Header.CbsChipsetVisibleFlag0 == 0xF9
             AND NOT ideqval CBS_CONFIG.Header.CbsChipsetVisibleFlag0 == 0xFA;
        goto SETUP_SECONDARY_PROM21_CHIPSET_USB_CONFIGURATION_OPTIONS_LABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_SECONDARY_PROM21_CHIPSET_USB_CONFIGURATION_OPTIONS_SECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_SECONDARY_PROM21_CHIPSET_USB_CONFIGURATION_OPTIONS_SECTION);
      endif;

      // Display Condition: CbsChipsetVisibleFlag0=0xF7|CbsChipsetVisibleFlag0=0xF8|CbsChipsetVisibleFlag0=0xF9
      suppressif NOT ideqval CBS_CONFIG.Header.CbsChipsetVisibleFlag0 == 0xF7
             AND NOT ideqval CBS_CONFIG.Header.CbsChipsetVisibleFlag0 == 0xF8
             AND NOT ideqval CBS_CONFIG.Header.CbsChipsetVisibleFlag0 == 0xF9;
        goto SETUP_SECONDARY_PROM21L_DOT_1_2_3_USB_PORT_CONFIGURATION_OPTIONS_LABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_SECONDARY_PROM21L_DOT_1_2_3_USB_PORT_CONFIGURATION_OPTIONS_SECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_SECONDARY_PROM21L_DOT_1_2_3_USB_PORT_CONFIGURATION_OPTIONS_SECTION);
      endif;

      // Display Condition: CbsChipsetVisibleFlag0=0xFA
      suppressif NOT ideqval CBS_CONFIG.Header.CbsChipsetVisibleFlag0 == 0xFA;
        goto SETUP_SECONDARY_PROM21L_DOT_4_USB_PORT_CONFIGURATION_OPTIONS_LABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_SECONDARY_PROM21L_DOT_4_USB_PORT_CONFIGURATION_OPTIONS_SECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_SECONDARY_PROM21L_DOT_4_USB_PORT_CONFIGURATION_OPTIONS_SECTION);
      endif;

    endform;
      //
      // form - PROM21 Chipset PCIe Port Configuration Options
      //
      form

        formid        = SETUP_PROM21_CHIPSET_PCIE_PORT_CONFIGURATION_OPTIONS_LABLE,

        title         = STRING_TOKEN (AMD_CBS_STR_PROM21_CHIPSET_PCIE_PORT_CONFIGURATION_OPTIONS_SECTION);

        subtitle text = STRING_TOKEN (AMD_CBS_STR_PROM21_CHIPSET_PCIE_PORT_CONFIGURATION_OPTIONS_SECTION);
        subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

        // PCIe Port 0
        // Enable/Disable Switch Downstream Port 0
        oneof
          varid       = CBS_CONFIG.CbsCmnPT21PcieP0,
          prompt      = STRING_TOKEN (AMD_CBS_STR_PCIE_PORT_0),
          help        = STRING_TOKEN (AMD_CBS_STR_PCIE_PORT_0_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLE),          value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // PCIe Port 1
        // Enable/Disable Switch Downstream Port 1
        oneof
          varid       = CBS_CONFIG.CbsCmnPT21PcieP1,
          prompt      = STRING_TOKEN (AMD_CBS_STR_PCIE_PORT_1),
          help        = STRING_TOKEN (AMD_CBS_STR_PCIE_PORT_1_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLE),          value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // PCIe Port 2
        // Enable/Disable Switch Downstream Port 2
        oneof
          varid       = CBS_CONFIG.CbsCmnPT21PcieP2,
          prompt      = STRING_TOKEN (AMD_CBS_STR_PCIE_PORT_2),
          help        = STRING_TOKEN (AMD_CBS_STR_PCIE_PORT_2_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLE),          value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // PCIe Port 3
        // Enable/Disable Switch Downstream Port 3
        oneof
          varid       = CBS_CONFIG.CbsCmnPT21PcieP3,
          prompt      = STRING_TOKEN (AMD_CBS_STR_PCIE_PORT_3),
          help        = STRING_TOKEN (AMD_CBS_STR_PCIE_PORT_3_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLE),          value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // PCIe Port 4
        // Enable/Disable Switch Downstream Port 4
        oneof
          varid       = CBS_CONFIG.CbsCmnPT21PcieP4,
          prompt      = STRING_TOKEN (AMD_CBS_STR_PCIE_PORT_4),
          help        = STRING_TOKEN (AMD_CBS_STR_PCIE_PORT_4_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLE),          value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // PCIe Port 5
        // Enable/Disable Switch Downstream Port 5
        oneof
          varid       = CBS_CONFIG.CbsCmnPT21PcieP5,
          prompt      = STRING_TOKEN (AMD_CBS_STR_PCIE_PORT_5),
          help        = STRING_TOKEN (AMD_CBS_STR_PCIE_PORT_5_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLE),          value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // PCIe Port 6
        // Enable/Disable Switch Downstream Port 6
        oneof
          varid       = CBS_CONFIG.CbsCmnPT21PcieP6,
          prompt      = STRING_TOKEN (AMD_CBS_STR_PCIE_PORT_6),
          help        = STRING_TOKEN (AMD_CBS_STR_PCIE_PORT_6_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLE),          value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // PCIe Port 7
        // Enable/Disable Switch Downstream Port 7
        oneof
          varid       = CBS_CONFIG.CbsCmnPT21PcieP7,
          prompt      = STRING_TOKEN (AMD_CBS_STR_PCIE_PORT_7),
          help        = STRING_TOKEN (AMD_CBS_STR_PCIE_PORT_7_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLE),          value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // PCIe Port 8
        // Enable/Disable Switch Downstream Port 8
        oneof
          varid       = CBS_CONFIG.CbsCmnPT21PcieP8,
          prompt      = STRING_TOKEN (AMD_CBS_STR_PCIE_PORT_8),
          help        = STRING_TOKEN (AMD_CBS_STR_PCIE_PORT_8_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLE),          value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // PCIe Port 9
        // Enable/Disable Switch Downstream Port 9
        oneof
          varid       = CBS_CONFIG.CbsCmnPT21PcieP9,
          prompt      = STRING_TOKEN (AMD_CBS_STR_PCIE_PORT_9),
          help        = STRING_TOKEN (AMD_CBS_STR_PCIE_PORT_9_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLE),          value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // PCIe Port 10
        // Enable/Disable Switch Downstream Port 10
        oneof
          varid       = CBS_CONFIG.CbsCmnPT21PcieP10,
          prompt      = STRING_TOKEN (AMD_CBS_STR_PCIE_PORT_10),
