          title         = STRING_TOKEN (AMD_CBS_STR_USB4_2_DOT_0_PORT_ENABLE_SECTION);

          subtitle text = STRING_TOKEN (AMD_CBS_STR_USB4_2_DOT_0_PORT_ENABLE_SECTION);
