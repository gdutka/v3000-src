          help        = STRING_TOKEN (AMD_CBS_STR_USB2_CONTROLLER_ENABLE_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        goto SETUP_USB0_2_DOT_0_PORT_ENABLE_LABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_USB0_2_DOT_0_PORT_ENABLE_SECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_USB0_2_DOT_0_PORT_ENABLE_SECTION);

        goto SETUP_USB1_2_DOT_0_PORT_ENABLE_LABLE,
