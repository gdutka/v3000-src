            help        = STRING_TOKEN (AMD_CBS_STR_USB4_3_DOT_1_PORT_ENABLE_SECTION);
        endif;

      endform;
        //
        // form - USB0 2.0 port enable
        //
        form

          formid        = SETUP_USB0_2_DOT_0_PORT_ENABLE_LABLE,

          title         = STRING_TOKEN (AMD_CBS_STR_USB0_2_DOT_0_PORT_ENABLE_SECTION);

          subtitle text = STRING_TOKEN (AMD_CBS_STR_USB0_2_DOT_0_PORT_ENABLE_SECTION);
          subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

          // USB0 2.0 Port 0
          // Disable or Enable USB0 2.0 port 0
          oneof
