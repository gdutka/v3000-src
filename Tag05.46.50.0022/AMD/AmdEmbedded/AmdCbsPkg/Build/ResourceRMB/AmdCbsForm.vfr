            prompt      = STRING_TOKEN (AMD_CBS_STR_USB1_3_DOT_1_PORT_0),
            help        = STRING_TOKEN (AMD_CBS_STR_USB1_3_DOT_1_PORT_0_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;

          // USB1 3.1 Port 1
          // Disable or Enable USB1 3.1 port 1
          oneof
            varid       = CBS_CONFIG.CbsCmnFchUsbXHCI1SsPort1,
            prompt      = STRING_TOKEN (AMD_CBS_STR_USB1_3_DOT_1_PORT_1),
            help        = STRING_TOKEN (AMD_CBS_STR_USB1_3_DOT_1_PORT_1_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;

        endform;
        //
        // form - USB3 3.1 port enable
        //
        form

          formid        = SETUP_USB3_3_DOT_1_PORT_ENABLE_LABLE,

          title         = STRING_TOKEN (AMD_CBS_STR_USB3_3_DOT_1_PORT_ENABLE_SECTION);

          subtitle text = STRING_TOKEN (AMD_CBS_STR_USB3_3_DOT_1_PORT_ENABLE_SECTION);
          subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

          // USB3 3.1 Port 0
          // Disable or Enable USB3 3.1 port 0
          oneof
            varid       = CBS_CONFIG.CbsCmnFchUsbXHCI3SsPort0,
            prompt      = STRING_TOKEN (AMD_CBS_STR_USB3_3_DOT_1_PORT_0),
            help        = STRING_TOKEN (AMD_CBS_STR_USB3_3_DOT_1_PORT_0_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;

        endform;
        //
        // form - USB4 3.1 port enable
        //
        form

          formid        = SETUP_USB4_3_DOT_1_PORT_ENABLE_LABLE,

          title         = STRING_TOKEN (AMD_CBS_STR_USB4_3_DOT_1_PORT_ENABLE_SECTION);

          subtitle text = STRING_TOKEN (AMD_CBS_STR_USB4_3_DOT_1_PORT_ENABLE_SECTION);
          subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

          // USB4 3.1 Port 0
          // Disable or Enable USB4 3.1 port 0
          oneof
            varid       = CBS_CONFIG.CbsCmnFchUsbXHCI4SsPort0,
            prompt      = STRING_TOKEN (AMD_CBS_STR_USB4_3_DOT_1_PORT_0),
            help        = STRING_TOKEN (AMD_CBS_STR_USB4_3_DOT_1_PORT_0_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;

        endform;
      //
      // form - Ac Power Loss Options
      //
      form

        formid        = SETUP_AC_POWER_LOSS_OPTIONS_LABLE,

        title         = STRING_TOKEN (AMD_CBS_STR_AC_POWER_LOSS_OPTIONS_SECTION);

        subtitle text = STRING_TOKEN (AMD_CBS_STR_AC_POWER_LOSS_OPTIONS_SECTION);
        subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

        // Ac Loss Control
        // Select Ac Loss Control Method
        oneof
          varid       = CBS_CONFIG.CbsCmnFchSystemPwrFailShadow,
          prompt      = STRING_TOKEN (AMD_CBS_STR_AC_LOSS_CONTROL),
          help        = STRING_TOKEN (AMD_CBS_STR_AC_LOSS_CONTROL_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_ALWAYS_OFF),      value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ALWAYS_ON),       value = 1,    flags = DEFAULT | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_RESERVED),        value = 2,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_PREVIOUS),        value = 3,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = 0 | RESET_REQUIRED;
        endoneof;

      endform;
      //
      // form - Uart Configuration Options
      //
      form

        formid        = SETUP_UART_CONFIGURATION_OPTIONS_LABLE,

        title         = STRING_TOKEN (AMD_CBS_STR_UART_CONFIGURATION_OPTIONS_SECTION);

        subtitle text = STRING_TOKEN (AMD_CBS_STR_UART_CONFIGURATION_OPTIONS_SECTION);
        subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

        // Uart 0 Enable
        // Uart 0 has no HW FC if Uart 1 is enabled
        oneof
          varid       = CBS_CONFIG.CbsCmnFchUart0Config,
          prompt      = STRING_TOKEN (AMD_CBS_STR_UART_0_ENABLE),
          help        = STRING_TOKEN (AMD_CBS_STR_UART_0_ENABLE_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // Display Condition: CbsCmnFchUart0Config = Enabled
        suppressif NOT ideqval CBS_CONFIG.CbsCmnFchUart0Config == 1;
          // Uart 0 Legacy Options
          // No help string
          oneof
            varid       = CBS_CONFIG.CbsCmnFchUart0LegacyConfig,
            prompt      = STRING_TOKEN (AMD_CBS_STR_UART_0_LEGACY_OPTIONS),
            help        = STRING_TOKEN (AMD_CBS_STR_UART_0_LEGACY_OPTIONS_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_0X2E8),           value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_0X2F8),           value = 2,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_0X3E8),           value = 3,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_0X3F8),           value = 4,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;
        endif;

        // Uart 1 Enable (no HW FC)
        // No help string
        oneof
          varid       = CBS_CONFIG.CbsCmnFchUart1Config,
          prompt      = STRING_TOKEN (AMD_CBS_STR_UART_1_ENABLE_NO_HW_FC),
          help        = STRING_TOKEN (AMD_CBS_STR_UART_1_ENABLE_NO_HW_FC_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // Display Condition: CbsCmnFchUart1Config = Enabled
        suppressif NOT ideqval CBS_CONFIG.CbsCmnFchUart1Config == 1;
          // Uart 1 Legacy Options
          // No help string
          oneof
            varid       = CBS_CONFIG.CbsCmnFchUart1LegacyConfig,
            prompt      = STRING_TOKEN (AMD_CBS_STR_UART_1_LEGACY_OPTIONS),
            help        = STRING_TOKEN (AMD_CBS_STR_UART_1_LEGACY_OPTIONS_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_0X2E8),           value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_0X2F8),           value = 2,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_0X3E8),           value = 3,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_0X3F8),           value = 4,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;
        endif;

        // Uart 2 Enable
        // Uart 2 has no HW FC if Uart 3 is enabled
        oneof
          varid       = CBS_CONFIG.CbsCmnFchUart2Config,
          prompt      = STRING_TOKEN (AMD_CBS_STR_UART_2_ENABLE),
          help        = STRING_TOKEN (AMD_CBS_STR_UART_2_ENABLE_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // Display Condition: CbsCmnFchUart2Config = Enabled
        suppressif NOT ideqval CBS_CONFIG.CbsCmnFchUart2Config == 1;
          // Uart 2 Legacy Options
          // No help string
          oneof
            varid       = CBS_CONFIG.CbsCmnFchUart2LegacyConfig,
            prompt      = STRING_TOKEN (AMD_CBS_STR_UART_2_LEGACY_OPTIONS),
            help        = STRING_TOKEN (AMD_CBS_STR_UART_2_LEGACY_OPTIONS_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_0X2E8),           value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_0X2F8),           value = 2,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_0X3E8),           value = 3,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_0X3F8),           value = 4,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;
        endif;

        // Uart 3 Enable (no HW FC)
        // No help string
        oneof
          varid       = CBS_CONFIG.CbsCmnFchUart3Config,
          prompt      = STRING_TOKEN (AMD_CBS_STR_UART_3_ENABLE_NO_HW_FC),
          help        = STRING_TOKEN (AMD_CBS_STR_UART_3_ENABLE_NO_HW_FC_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // Display Condition: CbsCmnFchUart3Config = Enabled
        suppressif NOT ideqval CBS_CONFIG.CbsCmnFchUart3Config == 1;
          // Uart 3 Legacy Options
          // No help string
          oneof
            varid       = CBS_CONFIG.CbsCmnFchUart3LegacyConfig,
            prompt      = STRING_TOKEN (AMD_CBS_STR_UART_3_LEGACY_OPTIONS),
            help        = STRING_TOKEN (AMD_CBS_STR_UART_3_LEGACY_OPTIONS_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_0X2E8),           value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_0X2F8),           value = 2,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_0X3E8),           value = 3,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_0X3F8),           value = 4,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;
        endif;

        // Uart 4 Enable
        // No help string
        oneof
          varid       = CBS_CONFIG.CbsCmnFchUart4Config,
          prompt      = STRING_TOKEN (AMD_CBS_STR_UART_4_ENABLE),
          help        = STRING_TOKEN (AMD_CBS_STR_UART_4_ENABLE_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

      endform;
      //
      // form - ESPI Configuration Options
      //
      form

        formid        = SETUP_ESPI_CONFIGURATION_OPTIONS_LABLE,

        title         = STRING_TOKEN (AMD_CBS_STR_ESPI_CONFIGURATION_OPTIONS_SECTION);

        subtitle text = STRING_TOKEN (AMD_CBS_STR_ESPI_CONFIGURATION_OPTIONS_SECTION);
        subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

        // ESPI Enable
        // No help string
        oneof
          varid       = CBS_CONFIG.CbsCmnFchEspiConfig,
          prompt      = STRING_TOKEN (AMD_CBS_STR_ESPI_ENABLE),
          help        = STRING_TOKEN (AMD_CBS_STR_ESPI_ENABLE_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // ESPI CRC Enable
        //  Enable or Disable ESPI CRC feature 
        oneof
          varid       = CBS_CONFIG.CbsCmnFchEspiCrc,
          questionid  = KEY_CBS_CMN_FCH_ESPI_CRC,
          prompt      = STRING_TOKEN (AMD_CBS_STR_ESPI_CRC_ENABLE),
          help        = STRING_TOKEN (AMD_CBS_STR_ESPI_CRC_ENABLE_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED | INTERACTIVE;
        endoneof;

      endform;
      //
      // form - XGBE Configuration Options
      //
      form

        formid        = SETUP_XGBE_CONFIGURATION_OPTIONS_LABLE,

        title         = STRING_TOKEN (AMD_CBS_STR_XGBE_CONFIGURATION_OPTIONS_SECTION);

        subtitle text = STRING_TOKEN (AMD_CBS_STR_XGBE_CONFIGURATION_OPTIONS_SECTION);
        subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

        // XGBE0 enable
        // Enable or disable Ethernet controller.
        oneof
          varid       = CBS_CONFIG.CbsCmnFchXgbe0Enable,
          prompt      = STRING_TOKEN (AMD_CBS_STR_XGBE0_ENABLE),
          help        = STRING_TOKEN (AMD_CBS_STR_XGBE0_ENABLE_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // XGBE1 enable
        // Enable or disable Ethernet controller.
        oneof
          varid       = CBS_CONFIG.CbsCmnFchXgbe1Enable,
          prompt      = STRING_TOKEN (AMD_CBS_STR_XGBE1_ENABLE),
          help        = STRING_TOKEN (AMD_CBS_STR_XGBE1_ENABLE_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // XGBE Port0 LED1 GPIO
        // GPIO number for XGBE Port0 LED1.\nWarning: Duplicated GPIO number should not entered for these GPIO number options and only unused GPIOs should be used for these LEDs otherwise behavior will be unknown 
        numeric
          varid       = CBS_CONFIG.CbsCmnFchXgbePort0Led1Gpio,
          prompt      = STRING_TOKEN (AMD_CBS_STR_XGBE_PORT0_LED1_GPIO),
          help        = STRING_TOKEN (AMD_CBS_STR_XGBE_PORT0_LED1_GPIO_HELP),
          flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
          minimum     = 0,
          maximum     = 0x9d,
          step        = 0,
          default     = 0x0a,
        endnumeric;

        // XGBE Port0 LED2 GPIO
        // GPIO number for XGBE Port0 LED2.\nWarning: Duplicated GPIO number should not entered for these GPIO number options and only unused GPIOs should be used for these LEDs otherwise behavior will be unknown 
        numeric
          varid       = CBS_CONFIG.CbsCmnFchXgbePort0Led2Gpio,
          prompt      = STRING_TOKEN (AMD_CBS_STR_XGBE_PORT0_LED2_GPIO),
          help        = STRING_TOKEN (AMD_CBS_STR_XGBE_PORT0_LED2_GPIO_HELP),
          flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
          minimum     = 0,
          maximum     = 0x9d,
          step        = 0,
          default     = 0x5b,
        endnumeric;

        // XGBE Port1 LED1 GPIO
        // GPIO number for XGBE Port1 LED1.\nWarning: Duplicated GPIO number should not entered for these GPIO number options and only unused GPIOs should be used for these LEDs otherwise behavior will be unknown 
        numeric
          varid       = CBS_CONFIG.CbsCmnFchXgbePort1Led1Gpio,
          prompt      = STRING_TOKEN (AMD_CBS_STR_XGBE_PORT1_LED1_GPIO),
          help        = STRING_TOKEN (AMD_CBS_STR_XGBE_PORT1_LED1_GPIO_HELP),
          flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
          minimum     = 0,
          maximum     = 0x9d,
          step        = 0,
          default     = 0x90,
        endnumeric;

        // XGBE Port1 LED2 GPIO
        // GPIO number for XGBE Port1 LED2.\nWarning: Duplicated GPIO number should not entered for these GPIO number options and only unused GPIOs should be used for these LEDs otherwise behavior will be unknown 
        numeric
          varid       = CBS_CONFIG.CbsCmnFchXgbePort1Led2Gpio,
          prompt      = STRING_TOKEN (AMD_CBS_STR_XGBE_PORT1_LED2_GPIO),
          help        = STRING_TOKEN (AMD_CBS_STR_XGBE_PORT1_LED2_GPIO_HELP),
          flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
          minimum     = 0,
          maximum     = 0x9d,
          step        = 0,
          default     = 0x9d,
        endnumeric;

      endform;
      //
      // form - USB4 Configuration Options
      //
      form

        formid        = SETUP_USB4_CONFIGURATION_OPTIONS_LABLE,

        title         = STRING_TOKEN (AMD_CBS_STR_USB4_CONFIGURATION_OPTIONS_SECTION);

        subtitle text = STRING_TOKEN (AMD_CBS_STR_USB4_CONFIGURATION_OPTIONS_SECTION);
        subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

        // USB4 pre-CM Enable
        // No help string
        oneof
          varid       = CBS_CONFIG.CbsCmnFchCioPreCmEnable,
          prompt      = STRING_TOKEN (AMD_CBS_STR_USB4_PRE_CM_ENABLE),
          help        = STRING_TOKEN (AMD_CBS_STR_USB4_PRE_CM_ENABLE_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        goto SETUP_USB4_RT0_LABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_USB4_RT0_SECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_USB4_RT0_SECTION);

        goto SETUP_USB4_RT1_LABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_USB4_RT1_SECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_USB4_RT1_SECTION);

      endform;
        //
        // form - USB4 RT0
        //
        form

          formid        = SETUP_USB4_RT0_LABLE,

          title         = STRING_TOKEN (AMD_CBS_STR_USB4_RT0_SECTION);

          subtitle text = STRING_TOKEN (AMD_CBS_STR_USB4_RT0_SECTION);
          subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

          // RT0 Router Enable
          // Enable/Disable USB4 Router 0
          oneof
            varid       = CBS_CONFIG.CbsCmnFchCioRt0Enable,
            prompt      = STRING_TOKEN (AMD_CBS_STR_RT0_ROUTER_ENABLE),
            help        = STRING_TOKEN (AMD_CBS_STR_RT0_ROUTER_ENABLE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;

          // Display Condition: CbsCmnFchCioRt0Enable=Enabled
          suppressif NOT ideqval CBS_CONFIG.CbsCmnFchCioRt0Enable == 1;
            // RT0 PCIe Tunnel
            // Enable/Disable Router 0 PCIe tunnel
            oneof
              varid       = CBS_CONFIG.CbsCmnFchCioRt0PcieTunnel,
              prompt      = STRING_TOKEN (AMD_CBS_STR_RT0_PCIE_TUNNEL),
              help        = STRING_TOKEN (AMD_CBS_STR_RT0_PCIE_TUNNEL_HELP),
              option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
            endoneof;
          endif;

        endform;
        //
        // form - USB4 RT1
        //
        form

          formid        = SETUP_USB4_RT1_LABLE,

          title         = STRING_TOKEN (AMD_CBS_STR_USB4_RT1_SECTION);

          subtitle text = STRING_TOKEN (AMD_CBS_STR_USB4_RT1_SECTION);
          subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

          // RT1 Router Enable
          // Enable/Disable USB4 Router 1
          oneof
            varid       = CBS_CONFIG.CbsCmnFchCioRt1Enable,
            prompt      = STRING_TOKEN (AMD_CBS_STR_RT1_ROUTER_ENABLE),
            help        = STRING_TOKEN (AMD_CBS_STR_RT1_ROUTER_ENABLE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;

          // Display Condition: CbsCmnFchCioRt1Enable=Enabled
          suppressif NOT ideqval CBS_CONFIG.CbsCmnFchCioRt1Enable == 1;
            // RT1 PCIe Tunnel
            // Enable/Disable Router 1 PCIe tunnel
            oneof
              varid       = CBS_CONFIG.CbsCmnFchCioRt1PcieTunnel,
              prompt      = STRING_TOKEN (AMD_CBS_STR_RT1_PCIE_TUNNEL),
              help        = STRING_TOKEN (AMD_CBS_STR_RT1_PCIE_TUNNEL_HELP),
              option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
            endoneof;
          endif;

        endform;
      //
      // form - SPI Configuration Options
      //
      form

        formid        = SETUP_SPI_CONFIGURATION_OPTIONS_LABLE,

        title         = STRING_TOKEN (AMD_CBS_STR_SPI_CONFIGURATION_OPTIONS_SECTION);

        subtitle text = STRING_TOKEN (AMD_CBS_STR_SPI_CONFIGURATION_OPTIONS_SECTION);
        subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

        // HFP Enable
        // No help string
        oneof
          varid       = CBS_CONFIG.CbsCmnFchHfpConfig,
          prompt      = STRING_TOKEN (AMD_CBS_STR_HFP_ENABLE),
          help        = STRING_TOKEN (AMD_CBS_STR_HFP_ENABLE_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // HID Enable
        // No help string
        oneof
          varid       = CBS_CONFIG.CbsCmnFchHidConfig,
          prompt      = STRING_TOKEN (AMD_CBS_STR_HID_ENABLE),
          help        = STRING_TOKEN (AMD_CBS_STR_HID_ENABLE_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // Display Condition: CbsCmnFchHidConfig = Enabled
        suppressif NOT ideqval CBS_CONFIG.CbsCmnFchHidConfig == 1;
          // HID Spi Read Mode
          // No help string
          oneof
            varid       = CBS_CONFIG.CbsCmnFchHidSpiReadMode,
            prompt      = STRING_TOKEN (AMD_CBS_STR_HID_SPI_READ_MODE),
            help        = STRING_TOKEN (AMD_CBS_STR_HID_SPI_READ_MODE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_QUAD_IO_1_4_4),   value = 5,    flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_DUAL_IO_1_2_2),   value = 4,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_FAST_READ_1_1_1), value = 7,    flags = 0 | RESET_REQUIRED;
          endoneof;
        endif;

        // Display Condition: CbsCmnFchHidConfig = Enabled
        suppressif NOT ideqval CBS_CONFIG.CbsCmnFchHidConfig == 1;
          // HID Spi Speed
          // No help string
          oneof
            varid       = CBS_CONFIG.CbsCmnFchHidSpeed,
            prompt      = STRING_TOKEN (AMD_CBS_STR_HID_SPI_SPEED),
            help        = STRING_TOKEN (AMD_CBS_STR_HID_SPI_SPEED_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_1_33HMZ),         value = 1,    flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_2_22NMZ),         value = 2,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_3_17_DOT_6MHZ),   value = 3,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_5_800KHZ),        value = 5,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_SPI_SPD6),        value = 6,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_SPI_SPD7),        value = 7,    flags = 0 | RESET_REQUIRED;
          endoneof;
        endif;

        // Display Condition: CbsCmnFchHidSpeed = spi_spd6
        suppressif NOT ideqval CBS_CONFIG.CbsCmnFchHidSpeed == 6;
          // HID Spi Speed6 N
          // Spi Speed6 = 200Mhz/HID Spi Speed6 N
          numeric
            varid       = CBS_CONFIG.CbsCmnFchHidSpiSpeed6N,
            prompt      = STRING_TOKEN (AMD_CBS_STR_HID_SPI_SPEED6_N),
            help        = STRING_TOKEN (AMD_CBS_STR_HID_SPI_SPEED6_N_HELP),
            flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
            minimum     = 4,
            maximum     = 63,
            step        = 0,
            default     = 4,
          endnumeric;
        endif;

        // Display Condition: CbsCmnFchHidSpeed = spi_spd7
        suppressif NOT ideqval CBS_CONFIG.CbsCmnFchHidSpeed == 7;
          // HID Spi Speed7 N
          // Spi Speed7 = 200Mhz/HID Spi Speed7 N
          numeric
            varid       = CBS_CONFIG.CbsCmnFchHidSpiSpeed7N,
            prompt      = STRING_TOKEN (AMD_CBS_STR_HID_SPI_SPEED7_N),
            help        = STRING_TOKEN (AMD_CBS_STR_HID_SPI_SPEED7_N_HELP),
            flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
            minimum     = 4,
            maximum     = 63,
            step        = 0,
            default     = 50,
          endnumeric;
        endif;

        // HID2 Enable
        // No help string
        oneof
          varid       = CBS_CONFIG.CbsCmnFchHid2Config,
          prompt      = STRING_TOKEN (AMD_CBS_STR_HID2_ENABLE),
          help        = STRING_TOKEN (AMD_CBS_STR_HID2_ENABLE_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // Display Condition: CbsCmnFchHid2Config = Enabled
        suppressif NOT ideqval CBS_CONFIG.CbsCmnFchHid2Config == 1;
          // HID2 Spi Read Mode
          // No help string
          oneof
            varid       = CBS_CONFIG.CbsCmnFchHid2SpiReadMode,
            prompt      = STRING_TOKEN (AMD_CBS_STR_HID2_SPI_READ_MODE),
            help        = STRING_TOKEN (AMD_CBS_STR_HID2_SPI_READ_MODE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_QUAD_IO_1_4_4),   value = 5,    flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_DUAL_IO_1_2_2),   value = 4,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_FAST_READ_1_1_1), value = 7,    flags = 0 | RESET_REQUIRED;
          endoneof;
        endif;

        // Display Condition: CbsCmnFchHid2Config = Enabled
        suppressif NOT ideqval CBS_CONFIG.CbsCmnFchHid2Config == 1;
          // HID2 Spi Speed
          // No help string
          oneof
            varid       = CBS_CONFIG.CbsCmnFchHid2Speed,
            prompt      = STRING_TOKEN (AMD_CBS_STR_HID2_SPI_SPEED),
            help        = STRING_TOKEN (AMD_CBS_STR_HID2_SPI_SPEED_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_1_33HMZ),         value = 1,    flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_2_22NMZ),         value = 2,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_3_17_DOT_6MHZ),   value = 3,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_5_800KHZ),        value = 5,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_SPI_SPD6),        value = 6,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_SPI_SPD7),        value = 7,    flags = 0 | RESET_REQUIRED;
          endoneof;
        endif;

        // Display Condition: CbsCmnFchHid2Speed = spi_spd6
        suppressif NOT ideqval CBS_CONFIG.CbsCmnFchHid2Speed == 6;
          // HID2 Spi Speed6 N
          // Spi Speed6 = 200Mhz/HID2 Spi Speed6 N
          numeric
            varid       = CBS_CONFIG.CbsCmnFchHid2SpiSpeed6N,
            prompt      = STRING_TOKEN (AMD_CBS_STR_HID2_SPI_SPEED6_N),
            help        = STRING_TOKEN (AMD_CBS_STR_HID2_SPI_SPEED6_N_HELP),
            flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
            minimum     = 4,
            maximum     = 63,
            step        = 0,
            default     = 4,
          endnumeric;
        endif;

        // Display Condition: CbsCmnFchHid2Speed = spi_spd7
        suppressif NOT ideqval CBS_CONFIG.CbsCmnFchHid2Speed == 7;
          // HID2 Spi Speed7 N
          // Spi Speed7 = 200Mhz/HID2 Spi Speed7 N
          numeric
            varid       = CBS_CONFIG.CbsCmnFchHid2SpiSpeed7N,
            prompt      = STRING_TOKEN (AMD_CBS_STR_HID2_SPI_SPEED7_N),
            help        = STRING_TOKEN (AMD_CBS_STR_HID2_SPI_SPEED7_N_HELP),
            flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
            minimum     = 4,
            maximum     = 63,
            step        = 0,
            default     = 50,
          endnumeric;
        endif;

      endform;
      //
      // form - FCH RAS Options
      //
      form

        formid        = SETUP_FCH_RAS_OPTIONS_LABLE,

        title         = STRING_TOKEN (AMD_CBS_STR_FCH_RAS_OPTIONS_SECTION);

        subtitle text = STRING_TOKEN (AMD_CBS_STR_FCH_RAS_OPTIONS_SECTION);
        subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

        // Reset after sync flood
        // Enable AB to forward downstream sync-flood message to system\ncontroller.
        oneof
          varid       = CBS_CONFIG.CbsCmnFchSyncfloodEnable,
          prompt      = STRING_TOKEN (AMD_CBS_STR_RESET_AFTER_SYNC_FLOOD),
          help        = STRING_TOKEN (AMD_CBS_STR_RESET_AFTER_SYNC_FLOOD_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLE),          value = 1,    flags = DEFAULT | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = 0 | RESET_REQUIRED;
        endoneof;

      endform;
    //
    // form - SMU Common Options
    //
    form

      formid        = SETUP_SMU_COMMON_OPTIONS_LABLE,

      title         = STRING_TOKEN (AMD_CBS_STR_SMU_COMMON_OPTIONS_SECTION);

      subtitle text = STRING_TOKEN (AMD_CBS_STR_SMU_COMMON_OPTIONS_SECTION);
      subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

      label LABEL_CBS_CBS_CMN_GNB_SMU_SYSTEM_CONFIG_START;
      // System Configuration
      // Warning: Select System Configuration may cause the system to hang, as some System Configuration may not be supported by your OPN.\n
      oneof
        varid       = CBS_CONFIG.CbsCmnGnbSMUSystemConfig,
        questionid  = KEY_CBS_CMN_GNB_SMU_SYSTEM_CONFIG,
        prompt      = STRING_TOKEN (AMD_CBS_STR_SYSTEM_CONFIGURATION),
        help        = STRING_TOKEN (AMD_CBS_STR_SYSTEM_CONFIGURATION_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_10W),             value = 1,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
        option text = STRING_TOKEN (AMD_CBS_STR_15W),             value = 2,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
        option text = STRING_TOKEN (AMD_CBS_STR_25W),             value = 3,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
        option text = STRING_TOKEN (AMD_CBS_STR_35W),             value = 6,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
        option text = STRING_TOKEN (AMD_CBS_STR_45W),             value = 7,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
        option text = STRING_TOKEN (AMD_CBS_STR_54W),             value = 8,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED | INTERACTIVE;
      endoneof;
      label LABEL_CBS_CBS_CMN_GNB_SMU_SYSTEM_CONFIG_END;

      // Sustained Power Limit
      numeric
        varid       = CBS_CONFIG.CbsDbgSustainedPowerLimit,
        prompt      = STRING_TOKEN (AMD_CBS_STR_SUSTAINED_POWER_LIMIT),
        help        = STRING_TOKEN (AMD_CBS_STR_SUSTAINED_POWER_LIMIT_HELP),
        flags       = RESET_REQUIRED,
        minimum     = 0,
        maximum     = 0xffffffff,
        step        = 0,
        default     = 0,
      endnumeric;

      // PPT Control
      // Auto = Use the default PPT Limits\nManual = User can set customized PPT Limits
      oneof
        varid       = CBS_CONFIG.CbsDbgPPTCtl,
        prompt      = STRING_TOKEN (AMD_CBS_STR_PPT_CONTROL),
        help        = STRING_TOKEN (AMD_CBS_STR_PPT_CONTROL_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_MANUAL),          value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0,    flags = DEFAULT | RESET_REQUIRED;
      endoneof;

      // Display Condition: CbsDbgPPTCtl=Manual
      suppressif NOT ideqval CBS_CONFIG.CbsDbgPPTCtl == 1;
        // Fast PPT Limit
        // Fast PPT Limit [mW]
        numeric
          varid       = CBS_CONFIG.CbsDbgFastPPTLimit,
          prompt      = STRING_TOKEN (AMD_CBS_STR_FAST_PPT_LIMIT),
          help        = STRING_TOKEN (AMD_CBS_STR_FAST_PPT_LIMIT_HELP),
          flags       = RESET_REQUIRED,
          minimum     = 0,
          maximum     = 0xffffffff,
          step        = 0,
          default     = 0,
        endnumeric;
      endif;

      // Display Condition: CbsDbgPPTCtl=Manual
      suppressif NOT ideqval CBS_CONFIG.CbsDbgPPTCtl == 1;
        // Slow PPT Limit
        // Slow PPT Limit [mW]
        numeric
          varid       = CBS_CONFIG.CbsDbgSlowPPTLimit,
          prompt      = STRING_TOKEN (AMD_CBS_STR_SLOW_PPT_LIMIT),
          help        = STRING_TOKEN (AMD_CBS_STR_SLOW_PPT_LIMIT_HELP),
          flags       = RESET_REQUIRED,
          minimum     = 0,
          maximum     = 0xffffffff,
          step        = 0,
          default     = 0,
        endnumeric;
      endif;

      // Display Condition: CbsDbgPPTCtl=Manual
      suppressif NOT ideqval CBS_CONFIG.CbsDbgPPTCtl == 1;
        // Slow PPT Time Constant
        // Slow PPT Time Constant [seconds]
        numeric
          varid       = CBS_CONFIG.CbsDbgSlowPPTTimeConstant,
          prompt      = STRING_TOKEN (AMD_CBS_STR_SLOW_PPT_TIME_CONSTANT),
          help        = STRING_TOKEN (AMD_CBS_STR_SLOW_PPT_TIME_CONSTANT_HELP),
          flags       = RESET_REQUIRED,
          minimum     = 0,
          maximum     = 0xffffffff,
          step        = 0,
          default     = 0,
        endnumeric;
      endif;

      // STAPM Control
      // Auto = Use the default STAPM settings\nManual = User can set customized STAPM settings
      oneof
        varid       = CBS_CONFIG.CbsDbgSTAPMCtl,
        prompt      = STRING_TOKEN (AMD_CBS_STR_STAPM_CONTROL),
        help        = STRING_TOKEN (AMD_CBS_STR_STAPM_CONTROL_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_MANUAL),          value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0,    flags = DEFAULT | RESET_REQUIRED;
      endoneof;

      // Display Condition: CbsDbgSTAPMCtl=Manual
      suppressif NOT ideqval CBS_CONFIG.CbsDbgSTAPMCtl == 1;
        // System Temperature Tracking
        // 0 = System Temperature Tracking disabled\n1 = System Temperature Tracking enabled
        oneof
          varid       = CBS_CONFIG.CbsDbgSystemTemperatureTracking,
          prompt      = STRING_TOKEN (AMD_CBS_STR_SYSTEM_TEMPERATURE_TRACKING),
          help        = STRING_TOKEN (AMD_CBS_STR_SYSTEM_TEMPERATURE_TRACKING_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xF,  flags = DEFAULT | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_1),               value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_0),               value = 0,    flags = 0 | RESET_REQUIRED;
        endoneof;
      endif;

      // Display Condition: CbsDbgSTAPMCtl=Manual
      suppressif NOT ideqval CBS_CONFIG.CbsDbgSTAPMCtl == 1;
        // STAPM Boost Override
        // 1 = use value in STAPM_BOOST\n0 = use SMU FW default
        oneof
          varid       = CBS_CONFIG.CbsDbgStapmBoostOverride,
          prompt      = STRING_TOKEN (AMD_CBS_STR_STAPM_BOOST_OVERRIDE),
          help        = STRING_TOKEN (AMD_CBS_STR_STAPM_BOOST_OVERRIDE_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xF,  flags = DEFAULT | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_0),               value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_1),               value = 0,    flags = 0 | RESET_REQUIRED;
        endoneof;
      endif;

      // Display Condition: CbsDbgSTAPMCtl=Manual
      suppressif NOT ideqval CBS_CONFIG.CbsDbgSTAPMCtl == 1;
        // STAPM Boost
        // 0 = STAPM Boost Disabled\n1 = STAPM Boost Enabled
        oneof
          varid       = CBS_CONFIG.CbsDbgStapmBoost,
          prompt      = STRING_TOKEN (AMD_CBS_STR_STAPM_BOOST),
          help        = STRING_TOKEN (AMD_CBS_STR_STAPM_BOOST_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xF,  flags = DEFAULT | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_1),               value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_0),               value = 0,    flags = 0 | RESET_REQUIRED;
        endoneof;
      endif;

      // Display Condition: CbsDbgSTAPMCtl=Manual|CbsDbgStapmBoost=1
      suppressif NOT ideqval CBS_CONFIG.CbsDbgSTAPMCtl == 1
             AND NOT ideqval CBS_CONFIG.CbsDbgStapmBoost == 1;
        // Tskin Time Constant
        // Tskin time constant [seconds]
        numeric
          varid       = CBS_CONFIG.CbsDbgTskinTimeConstant,
          prompt      = STRING_TOKEN (AMD_CBS_STR_TSKIN_TIME_CONSTANT),
          help        = STRING_TOKEN (AMD_CBS_STR_TSKIN_TIME_CONSTANT_HELP),
          flags       = RESET_REQUIRED,
          minimum     = 0,
          maximum     = 0xffffffff,
          step        = 0,
          default     = 0,
        endnumeric;
      endif;

      // Thermal Control
      // Auto = Use the default TctlMax\nManual = User can set customized TctlMax
      oneof
        varid       = CBS_CONFIG.CbsDbgTHMCtl,
        prompt      = STRING_TOKEN (AMD_CBS_STR_THERMAL_CONTROL),
        help        = STRING_TOKEN (AMD_CBS_STR_THERMAL_CONTROL_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_MANUAL),          value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0,    flags = DEFAULT | RESET_REQUIRED;
      endoneof;

      // Display Condition: CbsDbgTHMCtl=Manual
      suppressif NOT ideqval CBS_CONFIG.CbsDbgTHMCtl == 1;
        // TjMax
        // Maximum operating temperature ['C] (IRM limit will be enforced)
        numeric
          varid       = CBS_CONFIG.CbsDbgTjMaxLimit,
          prompt      = STRING_TOKEN (AMD_CBS_STR_TJMAX),
          help        = STRING_TOKEN (AMD_CBS_STR_TJMAX_HELP),
          flags       = RESET_REQUIRED,
          minimum     = 0,
          maximum     = 0xffffffff,
          step        = 0,
          default     = 0,
        endnumeric;
      endif;

      // TDC Control
      // Auto = Use the default TDC limits\nManual = User can set customized TDC limits
      oneof
        varid       = CBS_CONFIG.CbsDbgTDCCtl,
        prompt      = STRING_TOKEN (AMD_CBS_STR_TDC_CONTROL),
        help        = STRING_TOKEN (AMD_CBS_STR_TDC_CONTROL_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_MANUAL),          value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0,    flags = DEFAULT | RESET_REQUIRED;
      endoneof;

      // Display Condition: CbsDbgTDCCtl=Manual
      suppressif NOT ideqval CBS_CONFIG.CbsDbgTDCCtl == 1;
        // TDC_VDDCR_VDD
        // VDDCR_VDD TDC Limit [mA] (IRM limit will be enforced)
        numeric
          varid       = CBS_CONFIG.CbsDbgTDCVDDLimit,
          prompt      = STRING_TOKEN (AMD_CBS_STR_TDC_VDDCR_VDD),
          help        = STRING_TOKEN (AMD_CBS_STR_TDC_VDDCR_VDD_HELP),
          flags       = RESET_REQUIRED,
          minimum     = 0,
          maximum     = 0xffffffff,
          step        = 0,
          default     = 0,
        endnumeric;
      endif;

      // Display Condition: CbsDbgTDCCtl=Manual
      suppressif NOT ideqval CBS_CONFIG.CbsDbgTDCCtl == 1;
        // TDC_VDDCR_SOC
        // VDDCR_SOC TDC Limit [mA]
        numeric
          varid       = CBS_CONFIG.CbsDbgTDCSOCLimit,
          prompt      = STRING_TOKEN (AMD_CBS_STR_TDC_VDDCR_SOC),
          help        = STRING_TOKEN (AMD_CBS_STR_TDC_VDDCR_SOC_HELP),
          flags       = RESET_REQUIRED,
          minimum     = 0,
          maximum     = 0xffffffff,
          step        = 0,
          default     = 0,
        endnumeric;
      endif;

      // Display Condition: CbsDbgTDCCtl=Manual
      suppressif NOT ideqval CBS_CONFIG.CbsDbgTDCCtl == 1;
        // TDC_VDDCR_GFX
        // VDDCR_GFX TDC Limit [mA]
        numeric
          varid       = CBS_CONFIG.CbsDbgTDCGFXLimit,
          prompt      = STRING_TOKEN (AMD_CBS_STR_TDC_VDDCR_GFX),
          help        = STRING_TOKEN (AMD_CBS_STR_TDC_VDDCR_GFX_HELP),
          flags       = RESET_REQUIRED,
          minimum     = 0,
          maximum     = 0xffffffff,
          step        = 0,
          default     = 0,
        endnumeric;
      endif;

      // Display Condition: CbsDbgTDCCtl=Manual
      suppressif NOT ideqval CBS_CONFIG.CbsDbgTDCCtl == 1;
        // TDC_VDDCR_CVIP
        // VDDCR_CVIP TDC Limit [mA]
        numeric
          varid       = CBS_CONFIG.CbsDbgTDCCVIPLimit,
          prompt      = STRING_TOKEN (AMD_CBS_STR_TDC_VDDCR_CVIP),
          help        = STRING_TOKEN (AMD_CBS_STR_TDC_VDDCR_CVIP_HELP),
          flags       = RESET_REQUIRED,
          minimum     = 0,
          maximum     = 0xffffffff,
          step        = 0,
          default     = 0,
        endnumeric;
      endif;

      // EDC Control
      // Auto = Use the default EDC limits\nManual = User can set customized EDC limits
      oneof
