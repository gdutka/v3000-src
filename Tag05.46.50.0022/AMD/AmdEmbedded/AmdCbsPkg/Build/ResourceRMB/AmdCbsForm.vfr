            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          endoneof;

        endform;
          //
          // form - LPDDR Power Options
          //
          form

            formid        = SETUP_LPDDR_POWER_OPTIONS_LABLE,

            title         = STRING_TOKEN (AMD_CBS_STR_LPDDR_POWER_OPTIONS_SECTION);

            subtitle text = STRING_TOKEN (AMD_CBS_STR_LPDDR_POWER_OPTIONS_SECTION);
            subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

            // Power Down Enable
            // Enable or disable DDR power down mode
            oneof
              varid       = CBS_CONFIG.CbsCmnMemCtrllerPwrDnEnLpddr,
              prompt      = STRING_TOKEN (AMD_CBS_STR_POWER_DOWN_ENABLE_1),
              help        = STRING_TOKEN (AMD_CBS_STR_POWER_DOWN_ENABLE_HELP),
              option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            endoneof;

            // Phy Low Power Disable
            // When LpDis = 1 : Disable putting phy in low power mode.\nWhen LpDis = 0 : Enable putting phy in low power mode and stop clocks to DRAM when all ranks are in power down.\n\nAuto should be 0.
            oneof
              varid       = CBS_CONFIG.CbsCmnMemCtrllerPdPhyPowerSaveDisLpddr,
              prompt      = STRING_TOKEN (AMD_CBS_STR_PHY_LOW_POWER_DISABLE_1),
              help        = STRING_TOKEN (AMD_CBS_STR_PHY_LOW_POWER_DISABLE_HELP),
              option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_0),               value = 0,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_1),               value = 1,    flags = 0 | RESET_REQUIRED;
            endoneof;

          endform;
        //
        // form - LPDDR Bus Configuration
        //
        form

          formid        = SETUP_LPDDR_BUS_CONFIGURATION_LABLE,

          title         = STRING_TOKEN (AMD_CBS_STR_LPDDR_BUS_CONFIGURATION_SECTION);

          subtitle text = STRING_TOKEN (AMD_CBS_STR_LPDDR_BUS_CONFIGURATION_SECTION);
          subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

          // CAD Bus Timing User Controls
          // Setup time on CAD bus signals to Auto or Manual
          oneof
            varid       = CBS_CONFIG.CbsCmnMemCadBusTimingCtlLpddr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_CAD_BUS_TIMING_USER_CONTROLS),
            help        = STRING_TOKEN (AMD_CBS_STR_CAD_BUS_TIMING_USER_CONTROLS_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_MANUAL),          value = 1,    flags = 0 | RESET_REQUIRED;
          endoneof;

          // Display Condition: CbsCmnMemCadBusTimingCtlLpddr=Manual
          suppressif NOT ideqval CBS_CONFIG.CbsCmnMemCadBusTimingCtlLpddr == 1;
            // AddrCmdSetup
            // Setup time on CAD bus signals. Valid values 3Fh-0h.
            numeric
              varid       = CBS_CONFIG.CbsCmnMemAddrCmdSetupLpddr,
              prompt      = STRING_TOKEN (AMD_CBS_STR_ADDRCMDSETUP),
              help        = STRING_TOKEN (AMD_CBS_STR_ADDRCMDSETUP_HELP),
              flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
              minimum     = 0,
              maximum     = 0x3f,
              step        = 0,
              default     = 0,
            endnumeric;
          endif;

          // Display Condition: CbsCmnMemCadBusTimingCtlLpddr=Manual
          suppressif NOT ideqval CBS_CONFIG.CbsCmnMemCadBusTimingCtlLpddr == 1;
            // CsOdtSetup
            // Setup time on CAD bus signals. Valid values 3Fh-0h.
            numeric
              varid       = CBS_CONFIG.CbsCmnMemCsOdtSetupLpddr,
              prompt      = STRING_TOKEN (AMD_CBS_STR_CSODTSETUP),
              help        = STRING_TOKEN (AMD_CBS_STR_CSODTSETUP_HELP),
              flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
              minimum     = 0,
              maximum     = 0x3f,
              step        = 0,
              default     = 0,
            endnumeric;
          endif;

          // CA drive strengths
          // Select the drive strength for all CA0-7 IOs
          oneof
            varid       = CBS_CONFIG.CbsCmnMemPhyIoDrvStrenCaLpddr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_CA_DRIVE_STRENGTHS),
            help        = STRING_TOKEN (AMD_CBS_STR_CA_DRIVE_STRENGTHS_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_120_DOT_0_OHM),   value = 120,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_60_DOT_0_OHM),    value = 60,   flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_40_DOT_0_OHM),    value = 40,   flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_30_DOT_0_OHM),    value = 30,   flags = 0 | RESET_REQUIRED;
          endoneof;

          // CS drive strengths
          // Select the drive strength for all LP5 CS IOs
          oneof
            varid       = CBS_CONFIG.CbsCmnMemPhyIoDrvStrenCsLpddr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_CS_DRIVE_STRENGTHS),
            help        = STRING_TOKEN (AMD_CBS_STR_CS_DRIVE_STRENGTHS_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_400_DOT_0_OHM),   value = 400,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_100_DOT_0_OHM),   value = 100,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_67_DOT_0_OHM),    value = 67,   flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_50_DOT_0_OHM),    value = 50,   flags = 0 | RESET_REQUIRED;
          endoneof;

          // CK drive strengths
          // Select the drive strength for all CK{T,C} IOs
          oneof
            varid       = CBS_CONFIG.CbsCmnMemPhyIoDrvStrenCkLpddr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_CK_DRIVE_STRENGTHS),
            help        = STRING_TOKEN (AMD_CBS_STR_CK_DRIVE_STRENGTHS_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_120_DOT_0_OHM),   value = 120,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_60_DOT_0_OHM),    value = 60,   flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_40_DOT_0_OHM),    value = 40,   flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_30_DOT_0_OHM),    value = 30,   flags = 0 | RESET_REQUIRED;
          endoneof;

          // WCK drive strengths
          // Select the drive strength for all WCK{T,C} IOs
          oneof
            varid       = CBS_CONFIG.CbsCmnMemPhyIoDrvStrenWckLpddr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_WCK_DRIVE_STRENGTHS),
            help        = STRING_TOKEN (AMD_CBS_STR_WCK_DRIVE_STRENGTHS_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_120_DOT_0_OHM),   value = 120,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_60_DOT_0_OHM),    value = 60,   flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_40_DOT_0_OHM),    value = 40,   flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_30_DOT_0_OHM),    value = 30,   flags = 0 | RESET_REQUIRED;
          endoneof;

          // DQ drive strengths
          // Select the drive strength for all DQ and DMI IOs
          oneof
            varid       = CBS_CONFIG.CbsCmnMemPhyIoDrvStrenDqLpddr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_DQ_DRIVE_STRENGTHS),
            help        = STRING_TOKEN (AMD_CBS_STR_DQ_DRIVE_STRENGTHS_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_120_DOT_0_OHM),   value = 120,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_60_DOT_0_OHM),    value = 60,   flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_40_DOT_0_OHM),    value = 40,   flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_30_DOT_0_OHM),    value = 30,   flags = 0 | RESET_REQUIRED;
          endoneof;

          // DQS drive strengths
          // Select the drive strength for all DQS{T,C} IOs
          oneof
            varid       = CBS_CONFIG.CbsCmnMemPhyIoDrvStrenDqsLpddr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_DQS_DRIVE_STRENGTHS),
            help        = STRING_TOKEN (AMD_CBS_STR_DQS_DRIVE_STRENGTHS_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_120_DOT_0_OHM),   value = 120,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_60_DOT_0_OHM),    value = 60,   flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_40_DOT_0_OHM),    value = 40,   flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_30_DOT_0_OHM),    value = 30,   flags = 0 | RESET_REQUIRED;
          endoneof;

          // Processor ODT impedance
          // Select the ODT impedance for all DBYTE IOs
          oneof
            varid       = CBS_CONFIG.CbsCmnMemPhyIoOdtStrenProcLpddr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_PROCESSOR_ODT_IMPEDANCE_1),
            help        = STRING_TOKEN (AMD_CBS_STR_PROCESSOR_ODT_IMPEDANCE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_120_DOT_0_OHM),   value = 120,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_60_DOT_0_OHM),    value = 60,   flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_40_DOT_0_OHM),    value = 40,   flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_30_DOT_0_OHM),    value = 30,   flags = 0 | RESET_REQUIRED;
          endoneof;

          // Processor CA ODT impedance
          // Select the ODT impedance for ACHAN CA IOs
          oneof
            varid       = CBS_CONFIG.CbsCmnMemPhyIoOdtStrenProcCaLpddr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_PROCESSOR_CA_ODT_IMPEDANCE),
            help        = STRING_TOKEN (AMD_CBS_STR_PROCESSOR_CA_ODT_IMPEDANCE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_120_DOT_0_OHM),   value = 120,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_60_DOT_0_OHM),    value = 60,   flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_40_DOT_0_OHM),    value = 40,   flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_30_DOT_0_OHM),    value = 30,   flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
          endoneof;

          // Processor CK ODT impedance
          // Select the ODT impedance for ACHAN CK IOs
          oneof
            varid       = CBS_CONFIG.CbsCmnMemPhyIoOdtStrenProcCkLpddr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_PROCESSOR_CK_ODT_IMPEDANCE),
            help        = STRING_TOKEN (AMD_CBS_STR_PROCESSOR_CK_ODT_IMPEDANCE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_120_DOT_0_OHM),   value = 120,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_60_DOT_0_OHM),    value = 60,   flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_40_DOT_0_OHM),    value = 40,   flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_30_DOT_0_OHM),    value = 30,   flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
          endoneof;

          // Processor WCK ODT impedance
          // Select the ODT impedance for ACHAN WCK IOs
          oneof
            varid       = CBS_CONFIG.CbsCmnMemPhyIoOdtStrenProcWckLpddr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_PROCESSOR_WCK_ODT_IMPEDANCE),
            help        = STRING_TOKEN (AMD_CBS_STR_PROCESSOR_WCK_ODT_IMPEDANCE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_120_DOT_0_OHM),   value = 120,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_60_DOT_0_OHM),    value = 60,   flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_40_DOT_0_OHM),    value = 40,   flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_30_DOT_0_OHM),    value = 30,   flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
          endoneof;

          // Dram CA ODT impedance
          // Select the ODT impedance for Dram CA Bus Receiver
          oneof
            varid       = CBS_CONFIG.CbsCmnMemDramIoOdtStrenCaLpddr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_DRAM_CA_ODT_IMPEDANCE),
            help        = STRING_TOKEN (AMD_CBS_STR_DRAM_CA_ODT_IMPEDANCE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_1),           value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_2),           value = 2,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_3),           value = 3,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_4),           value = 4,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_5),           value = 5,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_6),           value = 6,    flags = 0 | RESET_REQUIRED;
          endoneof;

          // Dram DQ ODT impedance
          // Select the ODT impedance for Dram DQ Bus Receiver
          oneof
            varid       = CBS_CONFIG.CbsCmnMemDramIoOdtStrenDqLpddr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_DRAM_DQ_ODT_IMPEDANCE),
            help        = STRING_TOKEN (AMD_CBS_STR_DRAM_DQ_ODT_IMPEDANCE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_1),           value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_2),           value = 2,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_3),           value = 3,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_4),           value = 4,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_5),           value = 5,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_6),           value = 6,    flags = 0 | RESET_REQUIRED;
          endoneof;

          // Dram WCK ODT impedance
          // Select the ODT impedance for Dram WCK Bus Receiver
          oneof
            varid       = CBS_CONFIG.CbsCmnMemDramIoOdtStrenWckLpddr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_DRAM_WCK_ODT_IMPEDANCE),
            help        = STRING_TOKEN (AMD_CBS_STR_DRAM_WCK_ODT_IMPEDANCE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_1),           value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_2),           value = 2,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_3),           value = 3,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_4),           value = 4,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_5),           value = 5,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_6),           value = 6,    flags = 0 | RESET_REQUIRED;
          endoneof;

          // Dram Non-Target ODT impedance
          // Select the ODT impedance for Dram Non-Target Rank
          oneof
            varid       = CBS_CONFIG.CbsCmnMemDramIoOdtStrenNtdq,
            prompt      = STRING_TOKEN (AMD_CBS_STR_DRAM_NON_TARGET_ODT_IMPEDANCE),
            help        = STRING_TOKEN (AMD_CBS_STR_DRAM_NON_TARGET_ODT_IMPEDANCE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_1),           value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_2),           value = 2,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_3),           value = 3,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_4),           value = 4,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_5),           value = 5,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_6),           value = 6,    flags = 0 | RESET_REQUIRED;
          endoneof;

          // Dram Pull-Down drive strengths
          // Select the drive strength for Dram Pull-Down resistance
          oneof
            varid       = CBS_CONFIG.CbsCmnMemDramIoDrvStrenPdds,
            prompt      = STRING_TOKEN (AMD_CBS_STR_DRAM_PULL_DOWN_DRIVE_STRENGTHS),
            help        = STRING_TOKEN (AMD_CBS_STR_DRAM_PULL_DOWN_DRIVE_STRENGTHS_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_1),           value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_2),           value = 2,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_3),           value = 3,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_4),           value = 4,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_5),           value = 5,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_RZQ_6),           value = 6,    flags = 0 | RESET_REQUIRED;
          endoneof;

        endform;
        //
        // form - LPDDR RAS
        //
        form

          formid        = SETUP_LPDDR_RAS_LABLE,

          title         = STRING_TOKEN (AMD_CBS_STR_LPDDR_RAS_SECTION);

          subtitle text = STRING_TOKEN (AMD_CBS_STR_LPDDR_RAS_SECTION);
          subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

          // DRAM Read Link ECC Enable
          // Use this option to enable / disable Link ECC on DRAM Read. Auto will set ECC to enable.
          oneof
            varid       = CBS_CONFIG.CbsCmnMemCtrllerDramRdLinkEccEnLpddr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_DRAM_READ_LINK_ECC_ENABLE),
            help        = STRING_TOKEN (AMD_CBS_STR_DRAM_READ_LINK_ECC_ENABLE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
          endoneof;

          // DRAM Write Link ECC Enable
          // Use this option to enable / disable Link ECC on DRAM Write. Auto will set ECC to enable.
          oneof
            varid       = CBS_CONFIG.CbsCmnMemCtrllerDramWrLinkEccEnLpddr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_DRAM_WRITE_LINK_ECC_ENABLE),
            help        = STRING_TOKEN (AMD_CBS_STR_DRAM_WRITE_LINK_ECC_ENABLE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
          endoneof;

          // Disable Memory Error Injection
          // True: UMC::CH::MiscCfg[DisErrInj]=1
          oneof
            varid       = CBS_CONFIG.CbsCmnMemDisMemErrInjLpddr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_DISABLE_MEMORY_ERROR_INJECTION_1),
            help        = STRING_TOKEN (AMD_CBS_STR_DISABLE_MEMORY_ERROR_INJECTION_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_FALSE),           value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_TRUE),            value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xff, flags = DEFAULT | RESET_REQUIRED;
          endoneof;

        endform;
        //
        // form - LPDDR Security
        //
        form

          formid        = SETUP_LPDDR_SECURITY_LABLE,

          title         = STRING_TOKEN (AMD_CBS_STR_LPDDR_SECURITY_SECTION);

          subtitle text = STRING_TOKEN (AMD_CBS_STR_LPDDR_SECURITY_SECTION);
          subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

          // Active Condition: CbsCmnScpcAttrCntl=0|CbsCmnScpcAttrCntl=1|CbsCmnScpcAttrCntl=2
          grayoutif NOT ideqval CBS_CONFIG.CbsCmnScpcAttrCntl == 0
                AND NOT ideqval CBS_CONFIG.CbsCmnScpcAttrCntl == 1
                AND NOT ideqval CBS_CONFIG.CbsCmnScpcAttrCntl == 2;
            // TSME
            // No help string
            oneof
              varid       = CBS_CONFIG.CbsCmnMemTsmeLpddr,
              questionid  = KEY_CBS_CMN_MEM_TSME_LPDDR,
              prompt      = STRING_TOKEN (AMD_CBS_STR_TSME_1),
              help        = STRING_TOKEN (AMD_CBS_STR_TSME_HELP),
              option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED | INTERACTIVE;
              option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
              option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
            endoneof;
          endif;

          // Data Scramble
          // Data scrambling: DataScrambleEn
          oneof
            varid       = CBS_CONFIG.CbsCmnMemCtrllerDataScrambleLpddr,
            questionid  = KEY_CBS_CMN_MEM_CTRLLER_DATA_SCRAMBLE_LPDDR,
            prompt      = STRING_TOKEN (AMD_CBS_STR_DATA_SCRAMBLE_1),
            help        = STRING_TOKEN (AMD_CBS_STR_DATA_SCRAMBLE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 0x1,  flags = 0 | RESET_REQUIRED | INTERACTIVE;
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0x0,  flags = 0 | RESET_REQUIRED | INTERACTIVE;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED | INTERACTIVE;
          endoneof;

        endform;
        //
        // form - LPDDR Addressing Options
        //
        form

          formid        = SETUP_LPDDR_ADDRESSING_OPTIONS_LABLE,

          title         = STRING_TOKEN (AMD_CBS_STR_LPDDR_ADDRESSING_OPTIONS_SECTION);

          subtitle text = STRING_TOKEN (AMD_CBS_STR_LPDDR_ADDRESSING_OPTIONS_SECTION);
          subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

          // Chip Select Interleaving
          // Interleave memory blocks across the DRAM chip selects for node 0.
          oneof
            varid       = CBS_CONFIG.CbsCmnMemMappingBankInterleaveLpddr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_CHIP_SELECT_INTERLEAVING),
            help        = STRING_TOKEN (AMD_CBS_STR_CHIP_SELECT_INTERLEAVING_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
          endoneof;

          // Bank Swap
          // Swapping BankGroup/Bank bits with ColumnHigh bits.
          oneof
            varid       = CBS_CONFIG.CbsCmnMemCtrllerBankSwapLpddr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_BANK_SWAP),
            help        = STRING_TOKEN (AMD_CBS_STR_BANK_SWAP_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
          endoneof;

          // BankGroup Swap
          // Swapping Bank and BankGroup bits
          oneof
            varid       = CBS_CONFIG.CbsCmnMemCtrllerBankGroupSwapLpddr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_BANKGROUP_SWAP),
            help        = STRING_TOKEN (AMD_CBS_STR_BANKGROUP_SWAP_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 2,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
          endoneof;

          // Address Hash Bank
          // Enable or disable bank address hashing
          oneof
            varid       = CBS_CONFIG.CbsCmnMemAddressHashBankLpddr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_ADDRESS_HASH_BANK_1),
            help        = STRING_TOKEN (AMD_CBS_STR_ADDRESS_HASH_BANK_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
          endoneof;

          // Address Hash CS
          // Enable or disable CS address hashing
          oneof
            varid       = CBS_CONFIG.CbsCmnMemAddressHashCsLpddr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_ADDRESS_HASH_CS_1),
            help        = STRING_TOKEN (AMD_CBS_STR_ADDRESS_HASH_CS_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          endoneof;

        endform;
        //
        // form - LPDDR Training Options
        //
        form

          formid        = SETUP_LPDDR_TRAINING_OPTIONS_LABLE,

          title         = STRING_TOKEN (AMD_CBS_STR_LPDDR_TRAINING_OPTIONS_SECTION);

          subtitle text = STRING_TOKEN (AMD_CBS_STR_LPDDR_TRAINING_OPTIONS_SECTION);
          subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

          // DFE Read Training
          // Perform 2D Read Training with DFE on.
          oneof
            varid       = CBS_CONFIG.CbsCmnMemCtrllerPmuTrainDfeLpddr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_DFE_READ_TRAINING_1),
            help        = STRING_TOKEN (AMD_CBS_STR_DFE_READ_TRAINING_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLE),          value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
          endoneof;

        endform;
        //
        // form - LPDDR Memory MBIST
        //
        form

          formid        = SETUP_LPDDR_MEMORY_MBIST_LABLE,

          title         = STRING_TOKEN (AMD_CBS_STR_LPDDR_MEMORY_MBIST_SECTION);

          subtitle text = STRING_TOKEN (AMD_CBS_STR_LPDDR_MEMORY_MBIST_SECTION);
          subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

          // MBIST Enable
          // Enable or disable Memory MBIST
          oneof
            varid       = CBS_CONFIG.CbsCmnMemMbistEnLpddr,
            prompt      = STRING_TOKEN (AMD_CBS_STR_MBIST_ENABLE_1),
            help        = STRING_TOKEN (AMD_CBS_STR_MBIST_ENABLE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
          endoneof;

          // Active Condition: CbsCmnMemMbistEnLpddr=Enabled
          grayoutif NOT ideqval CBS_CONFIG.CbsCmnMemMbistEnLpddr == 1;
            // MBIST Test Mode
            // Select MBIST Test Mode -Interface Mode (Tests Single and Multiple CS transactions and Basic Connectivity) or Data Eye Mode (Measures Voltage vs. Timing)
            oneof
              varid       = CBS_CONFIG.CbsCmnMemMbistTestmodeLpddr,
              prompt      = STRING_TOKEN (AMD_CBS_STR_MBIST_TEST_MODE_1),
              help        = STRING_TOKEN (AMD_CBS_STR_MBIST_TEST_MODE_HELP),
              option text = STRING_TOKEN (AMD_CBS_STR_INTERFACE_MODE),  value = 0,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_DATA_EYE_MODE),   value = 1,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_BOTH),            value = 2,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            endoneof;
          endif;

          // Active Condition: CbsCmnMemMbistEnLpddr=Enabled
          grayoutif NOT ideqval CBS_CONFIG.CbsCmnMemMbistEnLpddr == 1;
            // MBIST Aggressors
            // Enable or disable MBIST Aggressor test
            oneof
              varid       = CBS_CONFIG.CbsCmnMemMbistAggressorsLpddr,
              prompt      = STRING_TOKEN (AMD_CBS_STR_MBIST_AGGRESSORS_1),
              help        = STRING_TOKEN (AMD_CBS_STR_MBIST_AGGRESSORS_HELP),
              option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xff, flags = DEFAULT | RESET_REQUIRED;
            endoneof;
          endif;

          // Active Condition: CbsCmnMemMbistEnLpddr=Enabled
          grayoutif NOT ideqval CBS_CONFIG.CbsCmnMemMbistEnLpddr == 1;
            goto SETUP_LPDDR_DATA_EYE_LABLE,
              prompt      = STRING_TOKEN (AMD_CBS_STR_LPDDR_DATA_EYE_SECTION),
              help        = STRING_TOKEN (AMD_CBS_STR_LPDDR_DATA_EYE_SECTION);
          endif;

        endform;
          //
          // form - LPDDR Data Eye
          //
          form

            formid        = SETUP_LPDDR_DATA_EYE_LABLE,

            title         = STRING_TOKEN (AMD_CBS_STR_LPDDR_DATA_EYE_SECTION);

            subtitle text = STRING_TOKEN (AMD_CBS_STR_LPDDR_DATA_EYE_SECTION);
            subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

            // Pattern Select
            // No help string
            oneof
              varid       = CBS_CONFIG.CbsCmnMemMbistPatternSelectLpddr,
              prompt      = STRING_TOKEN (AMD_CBS_STR_PATTERN_SELECT_1),
              help        = STRING_TOKEN (AMD_CBS_STR_PATTERN_SELECT_HELP),
              option text = STRING_TOKEN (AMD_CBS_STR_PRBS),            value = 0,    flags = DEFAULT | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_SSO),             value = 1,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_BOTH),            value = 2,    flags = 0 | RESET_REQUIRED;
            endoneof;

            // Pattern Length
            // This token helps to determine the pattern length. The possible options are N=3...12
            numeric
              varid       = CBS_CONFIG.CbsCmnMemMbistPatternLengthLpddr,
              prompt      = STRING_TOKEN (AMD_CBS_STR_PATTERN_LENGTH_1),
              help        = STRING_TOKEN (AMD_CBS_STR_PATTERN_LENGTH_HELP),
              flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
              minimum     = 3,
              maximum     = 12,
              step        = 0,
              default     = 3,
            endnumeric;

            // Aggressor Channel
            // This helps read the aggressors channels. If it is enabled, you can read from one or more than one aggressor channel. The default is set to disabled.
            oneof
              varid       = CBS_CONFIG.CbsCmnMemMbistAggressorsChnlLpddr,
              prompt      = STRING_TOKEN (AMD_CBS_STR_AGGRESSOR_CHANNEL_1),
              help        = STRING_TOKEN (AMD_CBS_STR_AGGRESSOR_CHANNEL_HELP),
              option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_1_AGGRESSOR_CHANNEL), value = 1,    flags = DEFAULT | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_3_AGGRESSOR_CHANNELS), value = 3,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_7_AGGRESSOR_CHANNELS), value = 7,    flags = 0 | RESET_REQUIRED;
            endoneof;

            // Read Voltage Sweep Step Size
            // This option determines the step size for Read Data Eye voltage sweep, Supported options are 1,2 and 4
            oneof
              varid       = CBS_CONFIG.CbsCmnMemMbistReadDataEyeVoltageStepLpddr,
              prompt      = STRING_TOKEN (AMD_CBS_STR_READ_VOLTAGE_SWEEP_STEP_SIZE),
              help        = STRING_TOKEN (AMD_CBS_STR_READ_VOLTAGE_SWEEP_STEP_SIZE_HELP),
              option text = STRING_TOKEN (AMD_CBS_STR_1),               value = 0,    flags = DEFAULT | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_2),               value = 1,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_4),               value = 4,    flags = 0 | RESET_REQUIRED;
            endoneof;

            // Read Timing Sweep Step Size
            // This options supports step size for Read Data Eye. Supported options are 1, 2 and 4
            oneof
              varid       = CBS_CONFIG.CbsCmnMemMbistReadDataEyeTimingStepLpddr,
              prompt      = STRING_TOKEN (AMD_CBS_STR_READ_TIMING_SWEEP_STEP_SIZE),
              help        = STRING_TOKEN (AMD_CBS_STR_READ_TIMING_SWEEP_STEP_SIZE_HELP),
              option text = STRING_TOKEN (AMD_CBS_STR_1),               value = 1,    flags = DEFAULT | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_2),               value = 2,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_4),               value = 4,    flags = 0 | RESET_REQUIRED;
            endoneof;

            // Write Voltage Sweep Step Size
            // This option determines the step size for write Data Eye voltage sweep, Supported options are 1,2 and 4
            oneof
              varid       = CBS_CONFIG.CbsCmnMemMbistWriteDataEyeVoltageStepLpddr,
              prompt      = STRING_TOKEN (AMD_CBS_STR_WRITE_VOLTAGE_SWEEP_STEP_SIZE),
              help        = STRING_TOKEN (AMD_CBS_STR_WRITE_VOLTAGE_SWEEP_STEP_SIZE_HELP),
              option text = STRING_TOKEN (AMD_CBS_STR_1),               value = 0,    flags = DEFAULT | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_2),               value = 1,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_4),               value = 4,    flags = 0 | RESET_REQUIRED;
            endoneof;

            // Write Timing Sweep Step Size
            // This options supports step size for write Data Eye. Supported options are 1, 2 and 4
            oneof
              varid       = CBS_CONFIG.CbsCmnMemMbistWriteDataEyeTimingStepLpddr,
              prompt      = STRING_TOKEN (AMD_CBS_STR_WRITE_TIMING_SWEEP_STEP_SIZE),
              help        = STRING_TOKEN (AMD_CBS_STR_WRITE_TIMING_SWEEP_STEP_SIZE_HELP),
              option text = STRING_TOKEN (AMD_CBS_STR_1),               value = 1,    flags = DEFAULT | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_2),               value = 2,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (AMD_CBS_STR_4),               value = 4,    flags = 0 | RESET_REQUIRED;
            endoneof;

          endform;
    //
    // form - NBIO Common Options
    //
    form

      formid        = SETUP_NBIO_COMMON_OPTIONS_LABLE,

      title         = STRING_TOKEN (AMD_CBS_STR_NBIO_COMMON_OPTIONS_SECTION);

      subtitle text = STRING_TOKEN (AMD_CBS_STR_NBIO_COMMON_OPTIONS_SECTION);
      subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

      // Active Condition: CbsCmnScpcAttrCntl=0
      grayoutif NOT ideqval CBS_CONFIG.CbsCmnScpcAttrCntl == 0;
        // IOMMU
        // Enable/Disable IOMMU
        oneof
          varid       = CBS_CONFIG.CbsCmnGnbNbIOMMU,
          questionid  = KEY_CBS_CMN_GNB_NB_IOMMU,
          prompt      = STRING_TOKEN (AMD_CBS_STR_IOMMU),
          help        = STRING_TOKEN (AMD_CBS_STR_IOMMU_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED | INTERACTIVE;
        endoneof;
      endif;

      // Display Condition: CbsCmnGnbNbIOMMU=Enabled
      // Active Condition: CbsCmnScpcAttrCntl=0|CbsCmnScpcAttrCntl=1
      suppressif NOT ideqval CBS_CONFIG.CbsCmnGnbNbIOMMU == 1;
      grayoutif NOT ideqval CBS_CONFIG.CbsCmnScpcAttrCntl == 0
            AND NOT ideqval CBS_CONFIG.CbsCmnScpcAttrCntl == 1;
        // DMAr Support
        // Enable DMAr system protection during POST.
        oneof
          varid       = CBS_CONFIG.CbsCmnDmarSupport,
          prompt      = STRING_TOKEN (AMD_CBS_STR_DMAR_SUPPORT),
          help        = STRING_TOKEN (AMD_CBS_STR_DMAR_SUPPORT_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xF,  flags = DEFAULT | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
        endoneof;
      endif;
      endif;

      // Display Condition: CbsCmnGnbNbIOMMU=Enabled
      // Active Condition: CbsCmnScpcAttrCntl=0|CbsCmnScpcAttrCntl=1
      suppressif NOT ideqval CBS_CONFIG.CbsCmnGnbNbIOMMU == 1;
      grayoutif NOT ideqval CBS_CONFIG.CbsCmnScpcAttrCntl == 0
            AND NOT ideqval CBS_CONFIG.CbsCmnScpcAttrCntl == 1;
        // DMA Protection
        // Enable DMA remap support in IVRS IVinfo Field.
        oneof
          varid       = CBS_CONFIG.CbsCmnDmaProtection,
          prompt      = STRING_TOKEN (AMD_CBS_STR_DMA_PROTECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_DMA_PROTECTION_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xF,  flags = DEFAULT | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
        endoneof;
      endif;
      endif;

      // Display Condition: CbsComboFlag=255
      suppressif NOT ideqval CBS_CONFIG.CbsComboFlag == 255;
        // SCPC attribute control
        // Used to control the active behavior of IOMMU and DMAr support and DMA protection options
        oneof
          varid       = CBS_CONFIG.CbsCmnScpcAttrCntl,
          questionid  = KEY_CBS_CMN_SCPC_ATTR_CNTL,
          prompt      = STRING_TOKEN (AMD_CBS_STR_SCPC_ATTRIBUTE_CONTROL),
          help        = STRING_TOKEN (AMD_CBS_STR_SCPC_ATTRIBUTE_CONTROL_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_0),               value = 0,    flags = DEFAULT | RESET_REQUIRED | INTERACTIVE;
          option text = STRING_TOKEN (AMD_CBS_STR_1),               value = 1,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
          option text = STRING_TOKEN (AMD_CBS_STR_2),               value = 2,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
          option text = STRING_TOKEN (AMD_CBS_STR_3),               value = 3,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
        endoneof;
      endif;

      // PCIe ARI Support
      // Enable/Disable ARI
      oneof
        varid       = CBS_CONFIG.CbsCmnGnbPcieAriSupport,
        prompt      = STRING_TOKEN (AMD_CBS_STR_PCIE_ARI_SUPPORT),
        help        = STRING_TOKEN (AMD_CBS_STR_PCIE_ARI_SUPPORT_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
      endoneof;

      // PCIe ARI Enumeration
      // ARI Forwarding Enable for each downstream port
      oneof
        varid       = CBS_CONFIG.CbsGnbCmnPcieAriEnumeration,
        prompt      = STRING_TOKEN (AMD_CBS_STR_PCIE_ARI_ENUMERATION),
        help        = STRING_TOKEN (AMD_CBS_STR_PCIE_ARI_ENUMERATION_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_ENABLE),          value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
      endoneof;

      goto SETUP_NBIO_RAS_COMMON_OPTIONS_LABLE,
        prompt      = STRING_TOKEN (AMD_CBS_STR_NBIO_RAS_COMMON_OPTIONS_SECTION),
        help        = STRING_TOKEN (AMD_CBS_STR_NBIO_RAS_COMMON_OPTIONS_SECTION);

      // Enable AER Cap
      // Enables Advanced Error Reporting Capability
      oneof
        varid       = CBS_CONFIG.CbsDbgGnbDbgAERCAPEnable,
        prompt      = STRING_TOKEN (AMD_CBS_STR_ENABLE_AER_CAP),
        help        = STRING_TOKEN (AMD_CBS_STR_ENABLE_AER_CAP_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_ENABLE),          value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xF,  flags = DEFAULT | RESET_REQUIRED;
      endoneof;

      // Display Condition: CbsDbgGnbDbgAERCAPEnable=Enable|CbsDbgGnbDbgAERCAPEnable=Auto
      suppressif NOT ideqval CBS_CONFIG.CbsDbgGnbDbgAERCAPEnable == 1
             AND NOT ideqval CBS_CONFIG.CbsDbgGnbDbgAERCAPEnable == 0xF;
        // ACS Enable
        // AER must be enabled for ACS enable to work
        oneof
          varid       = CBS_CONFIG.CbsDbgGnbDbgACSEnable,
          prompt      = STRING_TOKEN (AMD_CBS_STR_ACS_ENABLE),
          help        = STRING_TOKEN (AMD_CBS_STR_ACS_ENABLE_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLE),          value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xF,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;
      endif;

      // PSPP Policy
      oneof
        varid       = CBS_CONFIG.CbsCmnGnbPciePsppPolicy,
        questionid  = KEY_CBS_CMN_GNB_PCIE_PSPP_POLICY,
        prompt      = STRING_TOKEN (AMD_CBS_STR_PSPP_POLICY),
        help        = STRING_TOKEN (AMD_CBS_STR_PSPP_POLICY_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
        option text = STRING_TOKEN (AMD_CBS_STR_BALANCED),        value = 2,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED | INTERACTIVE;
      endoneof;

      goto SETUP_GFX_CONFIGURATION_LABLE,
        prompt      = STRING_TOKEN (AMD_CBS_STR_GFX_CONFIGURATION_SECTION),
        help        = STRING_TOKEN (AMD_CBS_STR_GFX_CONFIGURATION_SECTION);

      // Display Condition: CbsCmnGnbGfxUmaMode=Auto|CbsCmnGnbGfxUmaMode=UMA_SPECIFIED|CbsCmnGnbGfxUmaMode=UMA_AUTO
      suppressif NOT ideqval CBS_CONFIG.CbsCmnGnbGfxUmaMode == 0xf
             AND NOT ideqval CBS_CONFIG.CbsCmnGnbGfxUmaMode == 1
             AND NOT ideqval CBS_CONFIG.CbsCmnGnbGfxUmaMode == 2;
        goto SETUP_AUDIO_CONFIGURATION_LABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_AUDIO_CONFIGURATION_SECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_AUDIO_CONFIGURATION_SECTION);
      endif;

      // PCIe All Ports Settings
      // These settings will be applied to all active PCIe ports unless overriden on a per port basis.
      oneof
        varid       = CBS_CONFIG.CbsCmnPciePortAllPorts,
        prompt      = STRING_TOKEN (AMD_CBS_STR_PCIE_ALL_PORTS_SETTINGS),
        help        = STRING_TOKEN (AMD_CBS_STR_PCIE_ALL_PORTS_SETTINGS_HELP),
        option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        option text = STRING_TOKEN (AMD_CBS_STR_CUSTOM),          value = 1,    flags = 0 | RESET_REQUIRED;
      endoneof;

      // Display Condition: CbsCmnPciePortAllPorts = Custom
      suppressif NOT ideqval CBS_CONFIG.CbsCmnPciePortAllPorts == 1;
        goto SETUP_PORT_CAPABILITY_ALL_PORTS_LABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_PORT_CAPABILITY_ALL_PORTS_SECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_PORT_CAPABILITY_ALL_PORTS_SECTION);
      endif;

      // Display Condition: CbsCmnPciePortAllPorts = Custom
      suppressif NOT ideqval CBS_CONFIG.CbsCmnPciePortAllPorts == 1;
        goto SETUP_POWER_MANAGEMENT_FEATURES_ALL_PORTS_LABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_POWER_MANAGEMENT_FEATURES_ALL_PORTS_SECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_POWER_MANAGEMENT_FEATURES_ALL_PORTS_SECTION);
      endif;

      goto SETUP_PCIE_CORE_LABLE,
        prompt      = STRING_TOKEN (AMD_CBS_STR_PCIE_CORE_SECTION),
        help        = STRING_TOKEN (AMD_CBS_STR_PCIE_CORE_SECTION);

      goto SETUP_PMM_GENERAL_LABLE,
        prompt      = STRING_TOKEN (AMD_CBS_STR_PMM_GENERAL_SECTION),
        help        = STRING_TOKEN (AMD_CBS_STR_PMM_GENERAL_SECTION);

    endform;
      //
      // form - NBIO RAS Common Options
      //
      form

        formid        = SETUP_NBIO_RAS_COMMON_OPTIONS_LABLE,

        title         = STRING_TOKEN (AMD_CBS_STR_NBIO_RAS_COMMON_OPTIONS_SECTION);

        subtitle text = STRING_TOKEN (AMD_CBS_STR_NBIO_RAS_COMMON_OPTIONS_SECTION);
        subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

        // NBIO RAS Control
        // (0) Disabled, (1) MCA
        oneof
          varid       = CBS_CONFIG.CbsCmnRASControl,
          prompt      = STRING_TOKEN (AMD_CBS_STR_NBIO_RAS_CONTROL),
          help        = STRING_TOKEN (AMD_CBS_STR_NBIO_RAS_CONTROL_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_MCA),             value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xF,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // Egress Poison Severity High
        // Each bit set to 1 enables HIGH severity on the associated IOHC egress port. A bit of 0 indicates LOW severity.
        numeric
          varid       = CBS_CONFIG.PcdEgressPoisonSeverityHi,
          prompt      = STRING_TOKEN (AMD_CBS_STR_EGRESS_POISON_SEVERITY_HIGH),
          help        = STRING_TOKEN (AMD_CBS_STR_EGRESS_POISON_SEVERITY_HIGH_HELP),
          flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
          minimum     = 0,
          maximum     = 0xffffffff,
          step        = 0,
          default     = 0x00030000,
        endnumeric;

        // Egress Poison Severity Low
        // Each bit set to 1 enables HIGH severity on the associated IOHC egress port. A bit of 0 indicates LOW severity.
        numeric
          varid       = CBS_CONFIG.PcdEgressPoisonSeverityLo,
          prompt      = STRING_TOKEN (AMD_CBS_STR_EGRESS_POISON_SEVERITY_LOW),
          help        = STRING_TOKEN (AMD_CBS_STR_EGRESS_POISON_SEVERITY_LOW_HELP),
          flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
          minimum     = 0,
          maximum     = 0xffffffff,
          step        = 0,
          default     = 0x00001014,
        endnumeric;

        // NBIO SyncFlood Generation
        // This value may be used to mask SyncFlood caused by NBIO RAS options.  When set to TRUE SyncFlood from NBIO is masked.  When set to FALSE NBIO is capable of generating SyncFlood.
        oneof
          varid       = CBS_CONFIG.CbsCmnNBIOSyncFloodGen,
          prompt      = STRING_TOKEN (AMD_CBS_STR_NBIO_SYNCFLOOD_GENERATION),
          help        = STRING_TOKEN (AMD_CBS_STR_NBIO_SYNCFLOOD_GENERATION_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // NBIO SyncFlood Reporting
        // This value may be used to enable SyncFlood reporting to APML.  When set to TRUE SyncFlood will be reported to APML.  When set to FALSE that reporting well be disabled
        oneof
          varid       = CBS_CONFIG.PcdSyncFloodToApml,
          prompt      = STRING_TOKEN (AMD_CBS_STR_NBIO_SYNCFLOOD_REPORTING),
          help        = STRING_TOKEN (AMD_CBS_STR_NBIO_SYNCFLOOD_REPORTING_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = DEFAULT | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xF,  flags = 0 | RESET_REQUIRED;
        endoneof;

        // Egress Poison Mask High
        // These set the enable mask for masking of errors logged in EGRESS_POISON_STATUS. For each bit set to 1, errors are masked.  For each bit set to 0, errors trigger response actions.
        numeric
          varid       = CBS_CONFIG.PcdAmdNbioEgressPoisonMaskHi,
          prompt      = STRING_TOKEN (AMD_CBS_STR_EGRESS_POISON_MASK_HIGH),
          help        = STRING_TOKEN (AMD_CBS_STR_EGRESS_POISON_MASK_HIGH_HELP),
          flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
          minimum     = 0,
          maximum     = 0xffffffff,
          step        = 0,
          default     = 0xFFFCFFFF,
        endnumeric;

        // Egress Poison Mask Low
        // These set the enable mask for masking of errors logged in EGRESS_POISON_STATUS. For each bit set to 1, errors are masked.  For each bit set to 0, errors trigger response actions.
        numeric
          varid       = CBS_CONFIG.PcdAmdNbioEgressPoisonMaskLo,
          prompt      = STRING_TOKEN (AMD_CBS_STR_EGRESS_POISON_MASK_LOW),
          help        = STRING_TOKEN (AMD_CBS_STR_EGRESS_POISON_MASK_LOW_HELP),
          flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
          minimum     = 0,
          maximum     = 0xffffffff,
          step        = 0,
          default     = 0xFFFFEFEB,
        endnumeric;

        // Uncorrected Converted to Poison Enable Mask High
        // These set the enable mask for masking of uncorrectable parity errors on internal arrays.  For each bit set to 0, a system fatal error event is triggered for UCP errors on arrays associated with that egress port.  For each bit set to 1, errors are masked.
        numeric
          varid       = CBS_CONFIG.PcdAmdNbioRASUcpMaskHi,
          prompt      = STRING_TOKEN (AMD_CBS_STR_UNCORRECTED_CONVERTED_TO_POISON_ENABLE_MASK_HIGH),
          help        = STRING_TOKEN (AMD_CBS_STR_UNCORRECTED_CONVERTED_TO_POISON_ENABLE_MASK_HIGH_HELP),
          flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
          minimum     = 0,
          maximum     = 0xffffffff,
          step        = 0,
          default     = 0,
        endnumeric;

        // Uncorrected Converted to Poison Enable Mask Low
        // These set the enable mask for masking of uncorrectable parity errors on internal arrays.  For each bit set to 0, a system fatal error event is triggered for UCP errors on arrays associated with that egress port.  For each bit set to 1, errors are masked.
        numeric
          varid       = CBS_CONFIG.PcdAmdNbioRASUcpMaskLo,
          prompt      = STRING_TOKEN (AMD_CBS_STR_UNCORRECTED_CONVERTED_TO_POISON_ENABLE_MASK_LOW),
          help        = STRING_TOKEN (AMD_CBS_STR_UNCORRECTED_CONVERTED_TO_POISON_ENABLE_MASK_LOW_HELP),
          flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
          minimum     = 0,
          maximum     = 0xffffffff,
          step        = 0,
          default     = 0,
        endnumeric;

        // System Hub Watchdog Timer
        // This value specifies the timer interval of the SYSHUB Watchdog timer in miliseconds
        numeric
          varid       = CBS_CONFIG.PcdSyshubWdtTimerInterval,
          prompt      = STRING_TOKEN (AMD_CBS_STR_SYSTEM_HUB_WATCHDOG_TIMER),
          help        = STRING_TOKEN (AMD_CBS_STR_SYSTEM_HUB_WATCHDOG_TIMER_HELP),
          flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
          minimum     = 0,
          maximum     = 0xffff,
          step        = 0,
          default     = 2600,
        endnumeric;

        // NBIO Poison Consumption
        oneof
          varid       = CBS_CONFIG.CbsDbgPoisonConsumption,
          prompt      = STRING_TOKEN (AMD_CBS_STR_NBIO_POISON_CONSUMPTION),
          help        = STRING_TOKEN (AMD_CBS_STR_NBIO_POISON_CONSUMPTION_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = DEFAULT | RESET_REQUIRED;
        endoneof;

      endform;
      //
      // form - GFX Configuration
      //
      form

        formid        = SETUP_GFX_CONFIGURATION_LABLE,

        title         = STRING_TOKEN (AMD_CBS_STR_GFX_CONFIGURATION_SECTION);

        subtitle text = STRING_TOKEN (AMD_CBS_STR_GFX_CONFIGURATION_SECTION);
        subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

        // iGPU Configuration
        // UMA Mode
        oneof
          varid       = CBS_CONFIG.CbsCmnGnbGfxUmaMode,
          prompt      = STRING_TOKEN (AMD_CBS_STR_IGPU_CONFIGURATION),
          help        = STRING_TOKEN (AMD_CBS_STR_IGPU_CONFIGURATION_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_IGPU_DISABLED),   value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_UMA_SPECIFIED),   value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_UMA_AUTO),        value = 2,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_UMA_GAME_OPTIMIZED), value = 3,    flags = 0 | RESET_REQUIRED;
        endoneof;

        // UMA Version
        // UMA Legacy Version\nUMA Non Legacy Version\nHybrid Secure
        oneof
          varid       = CBS_CONFIG.CbsCmnGnbGfxUmaVersion,
          prompt      = STRING_TOKEN (AMD_CBS_STR_UMA_VERSION),
          help        = STRING_TOKEN (AMD_CBS_STR_UMA_VERSION_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_LEGACY),          value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_NON_LEGACY),      value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // Display Condition: CbsCmnGnbGfxUmaMode=UMA_SPECIFIED
        suppressif NOT ideqval CBS_CONFIG.CbsCmnGnbGfxUmaMode == 1;
          // UMA Frame buffer Size
          // Set UMA FB size
          oneof
            varid       = CBS_CONFIG.CbsCmnGnbGfxUmaFrameBufferSize,
            prompt      = STRING_TOKEN (AMD_CBS_STR_UMA_FRAME_BUFFER_SIZE),
            help        = STRING_TOKEN (AMD_CBS_STR_UMA_FRAME_BUFFER_SIZE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xffffffff, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_64M),             value = 64,   flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_128M),            value = 128,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_256M),            value = 256,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_384M),            value = 384,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_512M),            value = 512,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_80M),             value = 80,   flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_96M),             value = 96,   flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_768M),            value = 768,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_1G),              value = 1024, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_2G),              value = 2048, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_3G),              value = 3072, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_4G),              value = 4096, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_8G),              value = 8192, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_16G),             value = 16384, flags = 0 | RESET_REQUIRED;
          endoneof;
        endif;

        // Active Condition: CbsCmnScpcAttrCntl=0
        grayoutif NOT ideqval CBS_CONFIG.CbsCmnScpcAttrCntl == 0;
          // GPU Host Translation Cache
          // Option to disable GPU Host Translation Cache
          oneof
            varid       = CBS_CONFIG.CbsCmnGpuHostTranslation,
            prompt      = STRING_TOKEN (AMD_CBS_STR_GPU_HOST_TRANSLATION_CACHE),
            help        = STRING_TOKEN (AMD_CBS_STR_GPU_HOST_TRANSLATION_CACHE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xF,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;
        endif;

      endform;
      //
      // form - Audio Configuration
      //
      form

        formid        = SETUP_AUDIO_CONFIGURATION_LABLE,

        title         = STRING_TOKEN (AMD_CBS_STR_AUDIO_CONFIGURATION_SECTION);

        subtitle text = STRING_TOKEN (AMD_CBS_STR_AUDIO_CONFIGURATION_SECTION);
        subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

        // NB Azalia
        // Enable Integrate HD Audio controller
        oneof
          varid       = CBS_CONFIG.CbsCmnGnbGfxNbAzalia,
          questionid  = KEY_CBS_CMN_GNB_GFX_NB_AZALIA,
          prompt      = STRING_TOKEN (AMD_CBS_STR_NB_AZALIA),
          help        = STRING_TOKEN (AMD_CBS_STR_NB_AZALIA_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED | INTERACTIVE;
        endoneof;

        // Audio IOs
        // Audio IOs control
        oneof
          varid       = CBS_CONFIG.CbsDbgGnbAudioIOs,
          prompt      = STRING_TOKEN (AMD_CBS_STR_AUDIO_IOS),
          help        = STRING_TOKEN (AMD_CBS_STR_AUDIO_IOS_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_HDA_3SDI_PDM_2CH), value = 4,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_HDA_1SDI_PDM_6CH), value = 5,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_HDA_1SDI_SDW0_1MDATA_PDM_2CH), value = 6,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_SDW0_4MDATA_PDM_6CH), value = 7,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_SDW0_4MDATA_SDW1_1MDATA_PDM_2CH), value = 8,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_3I2S_PORTS_1_REFCLK_1_INTR), value = 9,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_HDA_3SDI_PDM_6CH_I2S), value = 10,   flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_HDA_3SDI_PDM_8CH), value = 11,   flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_HDA_1SDI_SDW0_1MDATA_PDM_6CH_I2S), value = 12,   flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_SDW0_4MDATA_SDW1_1MDATA_PDM_6CH_I2S), value = 13,   flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_SDW0_4MDATA_SDW1_1MDATA_PDM_8CH), value = 14,   flags = 0 | RESET_REQUIRED;
        endoneof;

      endform;
      //
      // form - Port Capability All Ports
      //
      form

        formid        = SETUP_PORT_CAPABILITY_ALL_PORTS_LABLE,

        title         = STRING_TOKEN (AMD_CBS_STR_PORT_CAPABILITY_ALL_PORTS_SECTION);

        subtitle text = STRING_TOKEN (AMD_CBS_STR_PORT_CAPABILITY_ALL_PORTS_SECTION);
        subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

        // Display Condition: CbsCmnPciePortAllPorts = Custom
        suppressif NOT ideqval CBS_CONFIG.CbsCmnPciePortAllPorts == 1;
          // ASPM
          // Enable port ASPM
          oneof
            varid       = CBS_CONFIG.CbsCmnPcieAllPortsCAPASPM,
            prompt      = STRING_TOKEN (AMD_CBS_STR_ASPM),
            help        = STRING_TOKEN (AMD_CBS_STR_ASPM_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_L1_SUPPORT),      value = 2,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;
        endif;

        // Display Condition: CbsCmnPciePortAllPorts = Custom
        suppressif NOT ideqval CBS_CONFIG.CbsCmnPciePortAllPorts == 1;
          // L1 PM SubState
          // Enable for PM L1 SS and ASPM L1 SS
          oneof
            varid       = CBS_CONFIG.CbsCmnPcieAllPortsCAPPML1SS,
            prompt      = STRING_TOKEN (AMD_CBS_STR_L1_PM_SUBSTATE),
            help        = STRING_TOKEN (AMD_CBS_STR_L1_PM_SUBSTATE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_L1_DOT_1_ONLY),   value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_L1_DOT_2_AND_L1_DOT_1), value = 2,    flags = 0 | RESET_REQUIRED;
          endoneof;
        endif;

        // LTR Support
        // Enables support for Latency Tolerance Reporting
        oneof
          varid       = CBS_CONFIG.CbsCmnPcieAllPortsCAPLTR,
          prompt      = STRING_TOKEN (AMD_CBS_STR_LTR_SUPPORT),
          help        = STRING_TOKEN (AMD_CBS_STR_LTR_SUPPORT_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_NOT_SUPPORTED),   value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_SUPPORTED),       value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xF,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

      endform;
      //
      // form - Power Management Features All Ports
      //
      form

        formid        = SETUP_POWER_MANAGEMENT_FEATURES_ALL_PORTS_LABLE,

        title         = STRING_TOKEN (AMD_CBS_STR_POWER_MANAGEMENT_FEATURES_ALL_PORTS_SECTION);

        subtitle text = STRING_TOKEN (AMD_CBS_STR_POWER_MANAGEMENT_FEATURES_ALL_PORTS_SECTION);
        subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

        // Display Condition: CbsCmnPciePortAllPorts = Custom
        suppressif NOT ideqval CBS_CONFIG.CbsCmnPciePortAllPorts == 1;
          // ASPM
          // Enable port ASPM
          oneof
            varid       = CBS_CONFIG.CbsCmnPcieAllPortsPMLinkASPM,
            prompt      = STRING_TOKEN (AMD_CBS_STR_ASPM_1),
            help        = STRING_TOKEN (AMD_CBS_STR_ASPM_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_L1),              value = 2,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;
        endif;

        // Display Condition: CbsCmnPciePortAllPorts = Custom
        suppressif NOT ideqval CBS_CONFIG.CbsCmnPciePortAllPorts == 1;
          // L1 PM SubState
          // Enable for PM L1 SS and ASPM L1 SS
          oneof
            varid       = CBS_CONFIG.CbsCmnPcieAllPortsPML1SS,
            prompt      = STRING_TOKEN (AMD_CBS_STR_L1_PM_SUBSTATE_1),
            help        = STRING_TOKEN (AMD_CBS_STR_L1_PM_SUBSTATE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_L1_DOT_1_ONLY),   value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_L1_DOT_2_AND_L1_DOT_1), value = 2,    flags = 0 | RESET_REQUIRED;
          endoneof;
        endif;

      endform;
      //
      // form - PCIe Core
      //
      form

        formid        = SETUP_PCIE_CORE_LABLE,

        title         = STRING_TOKEN (AMD_CBS_STR_PCIE_CORE_SECTION);

        subtitle text = STRING_TOKEN (AMD_CBS_STR_PCIE_CORE_SECTION);
        subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

        // LCLK Gating
        // Enable LCLK clock gating
        oneof
          varid       = CBS_CONFIG.CbsCmnPcieCoreLclkGating,
          prompt      = STRING_TOKEN (AMD_CBS_STR_LCLK_GATING),
          help        = STRING_TOKEN (AMD_CBS_STR_LCLK_GATING_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // PCIe Dynamic PG
        //  Enable/Disable Pcie Core Dynamic Power Gating
        oneof
          varid       = CBS_CONFIG.CbsCmnPcieCoreDynamicPowerGating,
          prompt      = STRING_TOKEN (AMD_CBS_STR_PCIE_DYNAMIC_PG),
          help        = STRING_TOKEN (AMD_CBS_STR_PCIE_DYNAMIC_PG_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

      endform;
      //
      // form - PMM - General
      //
      form

        formid        = SETUP_PMM_GENERAL_LABLE,

        title         = STRING_TOKEN (AMD_CBS_STR_PMM_GENERAL_SECTION);

        subtitle text = STRING_TOKEN (AMD_CBS_STR_PMM_GENERAL_SECTION);
        subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

        // NBIO Global CG Override
        // No help string
        oneof
          varid       = CBS_CONFIG.CbsCmnNbioGlobalCGOverride,
          prompt      = STRING_TOKEN (AMD_CBS_STR_NBIO_GLOBAL_CG_OVERRIDE),
          help        = STRING_TOKEN (AMD_CBS_STR_NBIO_GLOBAL_CG_OVERRIDE_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
        endoneof;

        // Display Condition: CbsCmnNbioGlobalCGOverride=Auto
        suppressif NOT ideqval CBS_CONFIG.CbsCmnNbioGlobalCGOverride == 0xf;
          // IOHC LCLK Clock Gating
          // LCLK Gating (IOC)
          oneof
            varid       = CBS_CONFIG.CbsCmnGnbPmmIohcLclkGating,
            prompt      = STRING_TOKEN (AMD_CBS_STR_IOHC_LCLK_CLOCK_GATING),
            help        = STRING_TOKEN (AMD_CBS_STR_IOHC_LCLK_CLOCK_GATING_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;
        endif;

        // Display Condition: CbsCmnNbioGlobalCGOverride=Auto
        suppressif NOT ideqval CBS_CONFIG.CbsCmnNbioGlobalCGOverride == 0xf;
          // IOHC Power Gating
          oneof
            varid       = CBS_CONFIG.CbsCmnGnbNbIOHCPowerGating,
            prompt      = STRING_TOKEN (AMD_CBS_STR_IOHC_POWER_GATING),
            help        = STRING_TOKEN (AMD_CBS_STR_IOHC_POWER_GATING_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;
        endif;

        // Display Condition: CbsCmnNbioGlobalCGOverride=Auto
        suppressif NOT ideqval CBS_CONFIG.CbsCmnNbioGlobalCGOverride == 0xf;
          // IOMMU L1 Clock Gating
          // IOMMU L1 LCLK Gating
          oneof
            varid       = CBS_CONFIG.CbsCmnGnbNbIOMMUL1ClockGating,
            prompt      = STRING_TOKEN (AMD_CBS_STR_IOMMU_L1_CLOCK_GATING),
            help        = STRING_TOKEN (AMD_CBS_STR_IOMMU_L1_CLOCK_GATING_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;
        endif;

        // Display Condition: CbsCmnNbioGlobalCGOverride=Auto
        suppressif NOT ideqval CBS_CONFIG.CbsCmnNbioGlobalCGOverride == 0xf;
          // IOMMU L2 Clock Gating
          // IOMMU L2 LCLK Gating
          oneof
            varid       = CBS_CONFIG.CbsCmnGnbNbIOMMUL2ClockGating,
            prompt      = STRING_TOKEN (AMD_CBS_STR_IOMMU_L2_CLOCK_GATING),
            help        = STRING_TOKEN (AMD_CBS_STR_IOMMU_L2_CLOCK_GATING_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;
        endif;

        // Display Condition: CbsCmnNbioGlobalCGOverride=Auto
        suppressif NOT ideqval CBS_CONFIG.CbsCmnNbioGlobalCGOverride == 0xf;
          // IOMMU Dynamic Power Gating
          // IOMMU Dynamic PG
          oneof
            varid       = CBS_CONFIG.CbsCmnGnbNbIOMMUDynamicPG,
            prompt      = STRING_TOKEN (AMD_CBS_STR_IOMMU_DYNAMIC_POWER_GATING),
            help        = STRING_TOKEN (AMD_CBS_STR_IOMMU_DYNAMIC_POWER_GATING_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;
        endif;

        // IOMMU L2 Memory Power Gating
        oneof
          varid       = CBS_CONFIG.CbsCmnGnbNbIOMMUL2MemoryPG,
          prompt      = STRING_TOKEN (AMD_CBS_STR_IOMMU_L2_MEMORY_POWER_GATING),
          help        = STRING_TOKEN (AMD_CBS_STR_IOMMU_L2_MEMORY_POWER_GATING_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // Display Condition: CbsCmnNbioGlobalCGOverride=Auto
        suppressif NOT ideqval CBS_CONFIG.CbsCmnNbioGlobalCGOverride == 0xf;
          // NBIF PG
          oneof
            varid       = CBS_CONFIG.CbsCmnNbioNbifPg,
            prompt      = STRING_TOKEN (AMD_CBS_STR_NBIF_PG),
            help        = STRING_TOKEN (AMD_CBS_STR_NBIF_PG_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          endoneof;
        endif;

        // Display Condition: CbsCmnNbioGlobalCGOverride=Auto
        suppressif NOT ideqval CBS_CONFIG.CbsCmnNbioGlobalCGOverride == 0xf;
          // SHUB PG
          oneof
            varid       = CBS_CONFIG.CbsCmnNbioShubPg,
            prompt      = STRING_TOKEN (AMD_CBS_STR_SHUB_PG),
            help        = STRING_TOKEN (AMD_CBS_STR_SHUB_PG_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          endoneof;
        endif;

        // MMHUB SRAM Light Sleep
        // No help string
        oneof
          varid       = CBS_CONFIG.CbsCmnPmmMmhubSramLS,
          prompt      = STRING_TOKEN (AMD_CBS_STR_MMHUB_SRAM_LIGHT_SLEEP),
          help        = STRING_TOKEN (AMD_CBS_STR_MMHUB_SRAM_LIGHT_SLEEP_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
        endoneof;

        // NBIF INTR OBFF
        // OBFF enable for Interrupt : OBFF_EMU_INTR_EN
        oneof
          varid       = CBS_CONFIG.CbsCmnPmmNbifIntrOBFF,
          prompt      = STRING_TOKEN (AMD_CBS_STR_NBIF_INTR_OBFF),
          help        = STRING_TOKEN (AMD_CBS_STR_NBIF_INTR_OBFF_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
        endoneof;

        // NBIF DMA OBFF
        // OBFF enable for DMA : OBFF_EMU_DMA_EN
        oneof
          varid       = CBS_CONFIG.CbsCmnPmmNbifDmaOBFF,
          prompt      = STRING_TOKEN (AMD_CBS_STR_NBIF_DMA_OBFF),
          help        = STRING_TOKEN (AMD_CBS_STR_NBIF_DMA_OBFF_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
        endoneof;

      endform;
    //
    // form - FCH Common Options
    //
    form

      formid        = SETUP_FCH_COMMON_OPTIONS_LABLE,

      title         = STRING_TOKEN (AMD_CBS_STR_FCH_COMMON_OPTIONS_SECTION);

      subtitle text = STRING_TOKEN (AMD_CBS_STR_FCH_COMMON_OPTIONS_SECTION);
      subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

      goto SETUP_I3C_I2C_CONFIGURATION_OPTIONS_LABLE,
        prompt      = STRING_TOKEN (AMD_CBS_STR_I3C_I2C_CONFIGURATION_OPTIONS_SECTION),
        help        = STRING_TOKEN (AMD_CBS_STR_I3C_I2C_CONFIGURATION_OPTIONS_SECTION);

      goto SETUP_SATA_CONFIGURATION_OPTIONS_LABLE,
        prompt      = STRING_TOKEN (AMD_CBS_STR_SATA_CONFIGURATION_OPTIONS_SECTION),
        help        = STRING_TOKEN (AMD_CBS_STR_SATA_CONFIGURATION_OPTIONS_SECTION);

      goto SETUP_USB_CONFIGURATION_OPTIONS_LABLE,
        prompt      = STRING_TOKEN (AMD_CBS_STR_USB_CONFIGURATION_OPTIONS_SECTION),
        help        = STRING_TOKEN (AMD_CBS_STR_USB_CONFIGURATION_OPTIONS_SECTION);

      goto SETUP_AC_POWER_LOSS_OPTIONS_LABLE,
        prompt      = STRING_TOKEN (AMD_CBS_STR_AC_POWER_LOSS_OPTIONS_SECTION),
        help        = STRING_TOKEN (AMD_CBS_STR_AC_POWER_LOSS_OPTIONS_SECTION);

      goto SETUP_UART_CONFIGURATION_OPTIONS_LABLE,
        prompt      = STRING_TOKEN (AMD_CBS_STR_UART_CONFIGURATION_OPTIONS_SECTION),
        help        = STRING_TOKEN (AMD_CBS_STR_UART_CONFIGURATION_OPTIONS_SECTION);

      goto SETUP_ESPI_CONFIGURATION_OPTIONS_LABLE,
        prompt      = STRING_TOKEN (AMD_CBS_STR_ESPI_CONFIGURATION_OPTIONS_SECTION),
        help        = STRING_TOKEN (AMD_CBS_STR_ESPI_CONFIGURATION_OPTIONS_SECTION);

      goto SETUP_XGBE_CONFIGURATION_OPTIONS_LABLE,
        prompt      = STRING_TOKEN (AMD_CBS_STR_XGBE_CONFIGURATION_OPTIONS_SECTION),
        help        = STRING_TOKEN (AMD_CBS_STR_XGBE_CONFIGURATION_OPTIONS_SECTION);

      // Display Condition: CbsComboFlag=3|CbsComboFlag=4|CbsComboFlag=5
      suppressif NOT ideqval CBS_CONFIG.CbsComboFlag == 3
             AND NOT ideqval CBS_CONFIG.CbsComboFlag == 4
             AND NOT ideqval CBS_CONFIG.CbsComboFlag == 5;
        goto SETUP_USB4_CONFIGURATION_OPTIONS_LABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_USB4_CONFIGURATION_OPTIONS_SECTION),
          help        = STRING_TOKEN (AMD_CBS_STR_USB4_CONFIGURATION_OPTIONS_SECTION);
      endif;

      goto SETUP_SPI_CONFIGURATION_OPTIONS_LABLE,
        prompt      = STRING_TOKEN (AMD_CBS_STR_SPI_CONFIGURATION_OPTIONS_SECTION),
        help        = STRING_TOKEN (AMD_CBS_STR_SPI_CONFIGURATION_OPTIONS_SECTION);

      goto SETUP_FCH_RAS_OPTIONS_LABLE,
        prompt      = STRING_TOKEN (AMD_CBS_STR_FCH_RAS_OPTIONS_SECTION),
        help        = STRING_TOKEN (AMD_CBS_STR_FCH_RAS_OPTIONS_SECTION);

    endform;
      //
      // form - I3C/I2C Configuration Options
      //
      form

        formid        = SETUP_I3C_I2C_CONFIGURATION_OPTIONS_LABLE,

        title         = STRING_TOKEN (AMD_CBS_STR_I3C_I2C_CONFIGURATION_OPTIONS_SECTION);

        subtitle text = STRING_TOKEN (AMD_CBS_STR_I3C_I2C_CONFIGURATION_OPTIONS_SECTION);
        subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

        // I3C/I2C 0 Enable
        // No help string
        oneof
          varid       = CBS_CONFIG.CbsCmnFchI3C0Config,
          prompt      = STRING_TOKEN (AMD_CBS_STR_I3C_I2C_0_ENABLE),
          help        = STRING_TOKEN (AMD_CBS_STR_I3C_I2C_0_ENABLE_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_BOTH_DISABLED),   value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_I3C_ENABLED),     value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_I2C_ENABLED),     value = 2,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // Display Condition: CbsCmnFchI3C0Config=I3C Enabled
        suppressif NOT ideqval CBS_CONFIG.CbsCmnFchI3C0Config == 1;
          // I3C 0 Mode
          // No help string
          oneof
            varid       = CBS_CONFIG.CbsCmnFchI3C0Mode,
            prompt      = STRING_TOKEN (AMD_CBS_STR_I3C_0_MODE),
            help        = STRING_TOKEN (AMD_CBS_STR_I3C_0_MODE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_I3C),             value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_I2C),             value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;
        endif;

        // I3C/I2C 1 Enable
        // No help string
        oneof
          varid       = CBS_CONFIG.CbsCmnFchI3C1Config,
          prompt      = STRING_TOKEN (AMD_CBS_STR_I3C_I2C_1_ENABLE),
          help        = STRING_TOKEN (AMD_CBS_STR_I3C_I2C_1_ENABLE_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_BOTH_DISABLED),   value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_I3C_ENABLED),     value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_I2C_ENABLED),     value = 2,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // Display Condition: CbsCmnFchI3C1Config=I3C Enabled
        suppressif NOT ideqval CBS_CONFIG.CbsCmnFchI3C1Config == 1;
          // I3C 1 Mode
          // No help string
          oneof
            varid       = CBS_CONFIG.CbsCmnFchI3C1Mode,
            prompt      = STRING_TOKEN (AMD_CBS_STR_I3C_1_MODE),
            help        = STRING_TOKEN (AMD_CBS_STR_I3C_1_MODE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_I3C),             value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_I2C),             value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;
        endif;

        // I3C/I2C 2 Enable
        // No help string
        oneof
          varid       = CBS_CONFIG.CbsCmnFchI3C2Config,
          prompt      = STRING_TOKEN (AMD_CBS_STR_I3C_I2C_2_ENABLE),
          help        = STRING_TOKEN (AMD_CBS_STR_I3C_I2C_2_ENABLE_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_BOTH_DISABLED),   value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_I3C_ENABLED),     value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_I2C_ENABLED),     value = 2,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // Display Condition: CbsCmnFchI3C2Config=I3C Enabled
        suppressif NOT ideqval CBS_CONFIG.CbsCmnFchI3C2Config == 1;
          // I3C 2 Mode
          // No help string
          oneof
            varid       = CBS_CONFIG.CbsCmnFchI3C2Mode,
            prompt      = STRING_TOKEN (AMD_CBS_STR_I3C_2_MODE),
            help        = STRING_TOKEN (AMD_CBS_STR_I3C_2_MODE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_I3C),             value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_I2C),             value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;
        endif;

        // I3C/I2C 3 Enable
        // No help string
        oneof
          varid       = CBS_CONFIG.CbsCmnFchI3C3Config,
          prompt      = STRING_TOKEN (AMD_CBS_STR_I3C_I2C_3_ENABLE),
          help        = STRING_TOKEN (AMD_CBS_STR_I3C_I2C_3_ENABLE_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_BOTH_DISABLED),   value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_I3C_ENABLED),     value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_I2C_ENABLED),     value = 2,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // Display Condition: CbsCmnFchI3C3Config=I3C Enabled
        suppressif NOT ideqval CBS_CONFIG.CbsCmnFchI3C3Config == 1;
          // I3C 3 Mode
          // No help string
          oneof
            varid       = CBS_CONFIG.CbsCmnFchI3C3Mode,
            prompt      = STRING_TOKEN (AMD_CBS_STR_I3C_3_MODE),
            help        = STRING_TOKEN (AMD_CBS_STR_I3C_3_MODE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_I3C),             value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_I2C),             value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;
        endif;

      endform;
      //
      // form - SATA Configuration Options
      //
      form

        formid        = SETUP_SATA_CONFIGURATION_OPTIONS_LABLE,

        title         = STRING_TOKEN (AMD_CBS_STR_SATA_CONFIGURATION_OPTIONS_SECTION);

        subtitle text = STRING_TOKEN (AMD_CBS_STR_SATA_CONFIGURATION_OPTIONS_SECTION);
        subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

        // SATA Controller
        // Disable or enable OnChip SATA controller
        oneof
          varid       = CBS_CONFIG.CbsCmnFchSataEnable,
          questionid  = KEY_CBS_CMN_FCH_SATA_ENABLE,
          prompt      = STRING_TOKEN (AMD_CBS_STR_SATA_CONTROLLER),
          help        = STRING_TOKEN (AMD_CBS_STR_SATA_CONTROLLER_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED | INTERACTIVE;
        endoneof;

        // SATA Auto Shutdown
        // Disable SATA controller if there is no port connection.
        oneof
          varid       = CBS_CONFIG.CbsCmnFchSataAutoShutDown,
          questionid  = KEY_CBS_CMN_FCH_SATA_AUTO_SHUT_DOWN,
          prompt      = STRING_TOKEN (AMD_CBS_STR_SATA_AUTO_SHUTDOWN),
          help        = STRING_TOKEN (AMD_CBS_STR_SATA_AUTO_SHUTDOWN_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED | INTERACTIVE;
        endoneof;

        // Display Condition: CbsCmnFchSataEnable=Enabled,CbsComboFlag=2|CbsCmnFchSataEnable=Enabled,CbsComboFlag=5
        suppressif NOT ideqval CBS_CONFIG.CbsCmnFchSataEnable == 1
                OR NOT ideqval CBS_CONFIG.CbsComboFlag == 2
               AND NOT ideqval CBS_CONFIG.CbsComboFlag == 5;
          // SATA Mode
          // Select OnChip SATA Type. Don't select RAID for Raven FP5 platform. Raven FP5 doesn't support RAID.
          oneof
            varid       = CBS_CONFIG.CbsCmnFchSataClass,
            questionid  = KEY_CBS_CMN_FCH_SATA_CLASS,
            prompt      = STRING_TOKEN (AMD_CBS_STR_SATA_MODE),
            help        = STRING_TOKEN (AMD_CBS_STR_SATA_MODE_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_AHCI),            value = 2,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
            option text = STRING_TOKEN (AMD_CBS_STR_AHCI_AS_ID_0X7904), value = 5,    flags = 0 | RESET_REQUIRED | INTERACTIVE;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED | INTERACTIVE;
            option text = STRING_TOKEN (AMD_CBS_STR_RAID),            value = 0x1,  flags = 0 | RESET_REQUIRED | INTERACTIVE;
          endoneof;
        endif;

        // Sata RAS Support
        // Disable or enable Sata RAS Support
        oneof
          varid       = CBS_CONFIG.CbsCmnFchSataRasSupport,
          prompt      = STRING_TOKEN (AMD_CBS_STR_SATA_RAS_SUPPORT),
          help        = STRING_TOKEN (AMD_CBS_STR_SATA_RAS_SUPPORT_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // Sata Disabled AHCI Prefetch Function
        // Disable or enable Sata Disabled AHCI Prefetch Function
        oneof
          varid       = CBS_CONFIG.CbsCmnFchSataAhciDisPrefetchFunction,
          prompt      = STRING_TOKEN (AMD_CBS_STR_SATA_DISABLED_AHCI_PREFETCH_FUNCTION),
          help        = STRING_TOKEN (AMD_CBS_STR_SATA_DISABLED_AHCI_PREFETCH_FUNCTION_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // Aggresive SATA Device Sleep Port 0
        // No help string
        oneof
          varid       = CBS_CONFIG.CbsDbgFchSataAggresiveDevSlpP0,
          prompt      = STRING_TOKEN (AMD_CBS_STR_AGGRESIVE_SATA_DEVICE_SLEEP_PORT_0),
          help        = STRING_TOKEN (AMD_CBS_STR_AGGRESIVE_SATA_DEVICE_SLEEP_PORT_0_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLE),          value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xF,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // Display Condition: CbsDbgFchSataAggresiveDevSlpP0=Enable
        suppressif NOT ideqval CBS_CONFIG.CbsDbgFchSataAggresiveDevSlpP0 == 1;
          // DevSleep0 Port Number
          // SATA port number map to DEVSLP pad 0: 0-7: SATA 0; 8-15: SATA 1
          numeric
            varid       = CBS_CONFIG.CbsDbgFchSataDevSlpPort0Num,
            prompt      = STRING_TOKEN (AMD_CBS_STR_DEVSLEEP0_PORT_NUMBER),
            help        = STRING_TOKEN (AMD_CBS_STR_DEVSLEEP0_PORT_NUMBER_HELP),
            flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
            minimum     = 0,
            maximum     = 15,
            step        = 0,
            default     = 0,
          endnumeric;
        endif;

        // Aggresive SATA Device Sleep Port 1
        // No help string
        oneof
          varid       = CBS_CONFIG.CbsDbgFchSataAggresiveDevSlpP1,
          prompt      = STRING_TOKEN (AMD_CBS_STR_AGGRESIVE_SATA_DEVICE_SLEEP_PORT_1),
          help        = STRING_TOKEN (AMD_CBS_STR_AGGRESIVE_SATA_DEVICE_SLEEP_PORT_1_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLE),         value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLE),          value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xF,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // Display Condition: CbsDbgFchSataAggresiveDevSlpP1=Enable
        suppressif NOT ideqval CBS_CONFIG.CbsDbgFchSataAggresiveDevSlpP1 == 1;
          // DevSleep1 Port Number
          // SATA port number map to DEVSLP pad 1: 0-7: SATA 0 ports; 8-15: SATA 1 ports
          numeric
            varid       = CBS_CONFIG.CbsDbgFchSataDevSlpPort1Num,
            prompt      = STRING_TOKEN (AMD_CBS_STR_DEVSLEEP1_PORT_NUMBER),
            help        = STRING_TOKEN (AMD_CBS_STR_DEVSLEEP1_PORT_NUMBER_HELP),
            flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
            minimum     = 0,
            maximum     = 15,
            step        = 0,
            default     = 0,
          endnumeric;
        endif;

      endform;
      //
      // form - USB Configuration Options
      //
      form

        formid        = SETUP_USB_CONFIGURATION_OPTIONS_LABLE,

        title         = STRING_TOKEN (AMD_CBS_STR_USB_CONFIGURATION_OPTIONS_SECTION);

        subtitle text = STRING_TOKEN (AMD_CBS_STR_USB_CONFIGURATION_OPTIONS_SECTION);
        subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

        // USB0 controller enable
        // Enable or disable USB3 controller.
        oneof
          varid       = CBS_CONFIG.CbsCmnFchUsbXHCI0Enable,
          prompt      = STRING_TOKEN (AMD_CBS_STR_USB0_CONTROLLER_ENABLE),
          help        = STRING_TOKEN (AMD_CBS_STR_USB0_CONTROLLER_ENABLE_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // USB1 controller enable
        // Enable or disable USB3 controller.
        oneof
          varid       = CBS_CONFIG.CbsCmnFchUsbXHCI1Enable,
          prompt      = STRING_TOKEN (AMD_CBS_STR_USB1_CONTROLLER_ENABLE),
          help        = STRING_TOKEN (AMD_CBS_STR_USB1_CONTROLLER_ENABLE_HELP),
          option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
        endoneof;

        // USB2 controller enable
