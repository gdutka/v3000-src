        // Display Condition: CbsComboFlag=3|CbsComboFlag=4|CbsComboFlag=5
        suppressif NOT ideqval CBS_CONFIG.CbsComboFlag == 3
               AND NOT ideqval CBS_CONFIG.CbsComboFlag == 4
               AND NOT ideqval CBS_CONFIG.CbsComboFlag == 5;
          goto SETUP_USB3_3_DOT_1_PORT_ENABLE_LABLE,
            prompt      = STRING_TOKEN (AMD_CBS_STR_USB3_3_DOT_1_PORT_ENABLE_SECTION),
            help        = STRING_TOKEN (AMD_CBS_STR_USB3_3_DOT_1_PORT_ENABLE_SECTION);
        endif;

        // Display Condition: CbsComboFlag=3|CbsComboFlag=4|CbsComboFlag=5
        suppressif NOT ideqval CBS_CONFIG.CbsComboFlag == 3
               AND NOT ideqval CBS_CONFIG.CbsComboFlag == 4
               AND NOT ideqval CBS_CONFIG.CbsComboFlag == 5;
          goto SETUP_USB4_3_DOT_1_PORT_ENABLE_LABLE,
