            help        = STRING_TOKEN (AMD_CBS_STR_USB4_2_DOT_0_PORT0_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;

        endform;
        //
        // form - USB0 3.1 port enable
        //
        form

          formid        = SETUP_USB0_3_DOT_1_PORT_ENABLE_LABLE,

          title         = STRING_TOKEN (AMD_CBS_STR_USB0_3_DOT_1_PORT_ENABLE_SECTION);

          subtitle text = STRING_TOKEN (AMD_CBS_STR_USB0_3_DOT_1_PORT_ENABLE_SECTION);
          subtitle text = STRING_TOKEN (AMD_CBS_STR_BLANK);

          // USB0 3.1 Port 0
          // Disable or Enable USB0 3.1 port 0
          oneof
            varid       = CBS_CONFIG.CbsCmnFchUsbXHCI0SsPort0,
            prompt      = STRING_TOKEN (AMD_CBS_STR_USB0_3_DOT_1_PORT_0),
            help        = STRING_TOKEN (AMD_CBS_STR_USB0_3_DOT_1_PORT_0_HELP),
            option text = STRING_TOKEN (AMD_CBS_STR_DISABLED),        value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_ENABLED),         value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (AMD_CBS_STR_AUTO),            value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
          endoneof;

          // USB0 3.1 Port 1
