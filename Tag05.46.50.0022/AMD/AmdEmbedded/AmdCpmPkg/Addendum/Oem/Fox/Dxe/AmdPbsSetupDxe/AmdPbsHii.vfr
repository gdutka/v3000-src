#include "AmdPbsConfig.h"
#include "AmdPbsSetupDxeStrDefs.h"

formset
  guid     = AMD_PBS_SETUP_FORMSET_GUID,
  title    = STRING_TOKEN(STR_AMD_PBS_SETUP_TITLE),
  help     = STRING_TOKEN(STR_AMD_PBS_SETUP_TITLE_HELP),
  class    = AMD_PBS_SETUP_CLASS,
  subclass = AMD_PBS_SETUP_SUB_CLASS,

  //
  // Define a Buffer Storage (EFI_IFR_VARSTORE)
  //
  varstore AMD_PBS_SETUP_OPTION,                          // This is the data structure type
    name  = AMD_PBS_SETUP,                                // Define referenced name in vfr
    guid  = AMD_PBS_SETUP_GUID;                           // GUID of this buffer storage

  form formid = AMD_PBS_SETUP_FORM_ID,                    // Form ID
    title  = STRING_TOKEN(STR_AMD_PBS_SETUP_FORM_TITLE);  // Form title

    goto AMD_PBS_FWVER_FORM_ID,
      prompt      = STRING_TOKEN(STR_AMD_PBS_FWVER_FORM_TITLE),
      help        = STRING_TOKEN(STR_AMD_PBS_FWVER_FORM_HELP);

    goto AMD_PBS_PCIE_CONFIG_FORM_ID,
       prompt = STRING_TOKEN(STR_AMD_PBS_PCIE_CONFIG_FORM_TITLE),
       help = STRING_TOKEN(STR_AMD_PBS_PCIE_CONFIG_FORM_HELP);

    goto AMD_PBS_POWER_SAVING_CONFIG_FORM_ID,
      prompt = STRING_TOKEN(STR_AMD_PBS_POWER_SAVING_CONFIG_FORM_TITLE),
      help = STRING_TOKEN(STR_AMD_PBS_POWER_SAVING_CONFIG_FORM_HELP);

    goto AMD_PBS_GRAPHICS_CONFIG_FORM_ID,
      prompt = STRING_TOKEN(STR_AMD_PBS_GRAPHICS_CONFIG_FORM_TITLE),
      help = STRING_TOKEN(STR_AMD_PBS_GRAPHICS_CONFIG_FORM_HELP);

    goto AMD_PBS_DISPLAY_CONFIG_FORM_ID,
       prompt = STRING_TOKEN(STR_AMD_PBS_DISPLAY_CONFIG_FORM_TITLE),
       help = STRING_TOKEN(STR_AMD_PBS_DISPLAY_CONFIG_FORM_HELP);

    goto AMD_PBS_USBTBT_CONFIG_FORM_ID,
       prompt = STRING_TOKEN(STR_AMD_PBS_USBTBT_CONFIG_FORM_TITLE),
       help = STRING_TOKEN(STR_AMD_PBS_USBTBT_CONFIG_FORM_HELP);

    goto AMD_PBS_AUDIO_CONFIG_FORM_ID,
       prompt = STRING_TOKEN(STR_AMD_PBS_AUDIO_CONFIG_FORM_TITLE),
       help = STRING_TOKEN(STR_AMD_PBS_AUDIO_CONFIG_FORM_HELP);

    goto AMD_PBS_I2C_CONFIG_FORM_ID,
      prompt = STRING_TOKEN(STR_AMD_PBS_I2C_CONFIG_FORM_TITLE),
      help = STRING_TOKEN(STR_AMD_PBS_I2C_CONFIG_FORM_HELP);

    goto AMD_PBS_THERMAL_CONFIG_FORM_ID,
      prompt = STRING_TOKEN(STR_AMD_PBS_THERMAL_CONFIG_FORM_TITLE),
      help = STRING_TOKEN(STR_AMD_PBS_THERMAL_CONFIG_FORM_HELP);

    goto AMD_PBS_MP2_CONFIG_FORM_ID,
      prompt = STRING_TOKEN(STR_AMD_PBS_MP2_CONFIG_FORM_TITLE),
      help = STRING_TOKEN(STR_AMD_PBS_MP2_CONFIG_FORM_HELP);

    goto AMD_PBS_DEBUG_CONFIG_FORM_ID,
      prompt = STRING_TOKEN(STR_AMD_PBS_DEBUG_CONFIG_FORM_TITLE),
      help = STRING_TOKEN(STR_AMD_PBS_DEBUG_CONFIG_FORM_HELP);

    goto AMD_PBS_PMF_FORM_ID,
      prompt      = STRING_TOKEN(STR_AMD_PBS_PMF_FORM_TITLE),
      help        = STRING_TOKEN(STR_AMD_PBS_PMF_FORM_HELP);

    goto AMD_PBS_RAS_FORM_ID,
      prompt = STRING_TOKEN(STR_RAS_FORM),
      help = STRING_TOKEN(STR_RAS_FORM_HELP);

    suppressif NOT ideqval AMD_PBS_SETUP.PBSPlatformSel == 0x31
           AND NOT ideqval AMD_PBS_SETUP.PBSPlatformSel == 0x20
           AND NOT ideqval AMD_PBS_SETUP.PBSPlatformSel == 0x45
           AND NOT ideqval AMD_PBS_SETUP.PBSPlatformSel == 0x46;
      oneof
        varid       = AMD_PBS_SETUP.SLTCheck,
        prompt      = STRING_TOKEN(STR_AMD_PBS_EN_SLTCHECK_PROMPT),
        help        = STRING_TOKEN(STR_AMD_PBS_EN_SLTCHECK_PROMPT),
        option text = STRING_TOKEN(STR_DISABLED_TEXT),                    value = 0, flags = INTERACTIVE | RESET_REQUIRED;
        option text = STRING_TOKEN(STR_ENABLED_TEXT),                     value = 1, flags = INTERACTIVE | RESET_REQUIRED | DEFAULT;
        option text = STRING_TOKEN(STR_AMD_PBS_EN_SLTCHECK_FORCE_HALT),   value = 2, flags = INTERACTIVE | RESET_REQUIRED;

      endoneof;
    endif;

    oneof
      varid       = AMD_PBS_SETUP.Above4GBMmioLimit,
      prompt      = STRING_TOKEN(STR_ABOVE_4G_LIMIT_STRING),
      help        = STRING_TOKEN(STR_ABOVE_4G_LIMIT_HELP),
      option text = STRING_TOKEN(STR_ABOVE_4G_LIMIT_35),  value = 35, flags = INTERACTIVE | RESET_REQUIRED;
      option text = STRING_TOKEN(STR_ABOVE_4G_LIMIT_36),  value = 36, flags = INTERACTIVE | RESET_REQUIRED;
      option text = STRING_TOKEN(STR_ABOVE_4G_LIMIT_37),  value = 37, flags = INTERACTIVE | RESET_REQUIRED;
      option text = STRING_TOKEN(STR_ABOVE_4G_LIMIT_38),  value = 38, flags = INTERACTIVE | RESET_REQUIRED;
      option text = STRING_TOKEN(STR_ABOVE_4G_LIMIT_39),  value = 39, flags = INTERACTIVE | RESET_REQUIRED;
      option text = STRING_TOKEN(STR_ABOVE_4G_LIMIT_40),  value = 40, flags = INTERACTIVE | RESET_REQUIRED | DEFAULT;
      option text = STRING_TOKEN(STR_ABOVE_4G_LIMIT_41),  value = 41, flags = INTERACTIVE | RESET_REQUIRED;
      option text = STRING_TOKEN(STR_ABOVE_4G_LIMIT_42),  value = 42, flags = INTERACTIVE | RESET_REQUIRED;
      option text = STRING_TOKEN(STR_ABOVE_4G_LIMIT_43),  value = 43, flags = INTERACTIVE | RESET_REQUIRED;
      option text = STRING_TOKEN(STR_ABOVE_4G_LIMIT_44),  value = 44, flags = INTERACTIVE | RESET_REQUIRED;
      option text = STRING_TOKEN(STR_ABOVE_4G_LIMIT_45),  value = 45, flags = INTERACTIVE | RESET_REQUIRED;
      option text = STRING_TOKEN(STR_ABOVE_4G_LIMIT_46),  value = 46, flags = INTERACTIVE | RESET_REQUIRED;
      option text = STRING_TOKEN(STR_ABOVE_4G_LIMIT_47),  value = 47, flags = INTERACTIVE | RESET_REQUIRED;
      option text = STRING_TOKEN(STR_ABOVE_4G_LIMIT_48),  value = 48, flags = INTERACTIVE | RESET_REQUIRED;
    endoneof;

//    oneof
//      varid       = AMD_PBS_SETUP.HdtBreakPointBoot,
//      prompt      = STRING_TOKEN(STR_AMD_HDTBREAKPOINTBOOT_STRING),
//      help        = STRING_TOKEN(STR_AMD_HDTBREAKPOINTBOOT_HELP),
//      option text = STRING_TOKEN(STR_DISABLED_TEXT),  value = 0, flags = INTERACTIVE | RESET_REQUIRED | DEFAULT;
//      option text = STRING_TOKEN(STR_ENABLED_TEXT),   value = 1, flags = INTERACTIVE | RESET_REQUIRED;
//    endoneof;

//    oneof
//      varid       = AMD_PBS_SETUP.HdtBreakPointS3,
//      prompt      = STRING_TOKEN(STR_AMD_HDTBREAKPOINTS3_STRING),
//      help        = STRING_TOKEN(STR_AMD_HDTBREAKPOINTS3_HELP),
//      option text = STRING_TOKEN(STR_DISABLED_TEXT),  value = 0, flags = INTERACTIVE | RESET_REQUIRED | DEFAULT;
//      option text = STRING_TOKEN(STR_ENABLED_TEXT),   value = 1, flags = INTERACTIVE | RESET_REQUIRED;
//    endoneof;


   suppressif ideqval AMD_PBS_SETUP.PlatformId == 1;
    oneof
      varid       = AMD_PBS_SETUP.S5_5V,
      prompt      = STRING_TOKEN(STR_5V_S5_STRING),
      help        = STRING_TOKEN(STR_5V_S5_HELP),
      option text = STRING_TOKEN(STR_5V_S5_506V_TEXT),   value = 0, flags = INTERACTIVE | RESET_REQUIRED | DEFAULT;
      option text = STRING_TOKEN(STR_5V_S5_512V_TEXT),   value = 1, flags = INTERACTIVE | RESET_REQUIRED;
      option text = STRING_TOKEN(STR_5V_S5_516V_TEXT),   value = 2, flags = INTERACTIVE | RESET_REQUIRED;
    endoneof;
   endif;

    oneof
      varid       = AMD_PBS_SETUP.AmdPspKvmMouseProtocol,
      prompt      = STRING_TOKEN(STR_AMD_KVM_MOUSE_PROTOCOL_STRING),
      help        = STRING_TOKEN(STR_AMD_KVM_MOUSE_PROTOCOL_HELP),
      option text = STRING_TOKEN(STR_AMD_KVM_ABSOLUTE_PROTOCOL),  value = 0, flags = INTERACTIVE | RESET_REQUIRED;
      option text = STRING_TOKEN(STR_AMD_KVM_SIMPLE_PROTOCOL),    value = 1, flags = INTERACTIVE | RESET_REQUIRED;
      option text = STRING_TOKEN(STR_AUTO_TEXT),                  value = 3, flags = INTERACTIVE | RESET_REQUIRED | DEFAULT;
    endoneof;

    oneof
      varid       = AMD_PBS_SETUP.ProcessorAggregatorDevice,
      prompt      = STRING_TOKEN(STR_PROCESSOR_AGGREGATOR_DEVICE_PROMPT),
      help        = STRING_TOKEN(STR_PROCESSOR_AGGREGATOR_DEVICE_HELP),
      option text = STRING_TOKEN(STR_DISABLED_TEXT),  value = 0, flags = INTERACTIVE | RESET_REQUIRED | DEFAULT;
      option text = STRING_TOKEN(STR_ENABLED_TEXT),   value = 1, flags = INTERACTIVE | RESET_REQUIRED;
    endoneof;

    suppressif ideqval AMD_PBS_SETUP.ProcessorAggregatorDevice == 0;
      oneof
        varid       = AMD_PBS_SETUP.CoreCountControl,
        prompt      = STRING_TOKEN(STR_CORE_COUNT_CONTROL_PROMPT),
        help        = STRING_TOKEN(STR_CORE_COUNT_CONTROL_HELP),
        option text = STRING_TOKEN(STR_DISABLED_TEXT),  value = 0, flags = INTERACTIVE | RESET_REQUIRED | DEFAULT;
        option text = STRING_TOKEN(STR_ENABLED_TEXT),   value = 1, flags = INTERACTIVE | RESET_REQUIRED;
      endoneof;
    endif;

   suppressif ideqval AMD_PBS_SETUP.ProcessorAggregatorDevice == 0 OR ideqval AMD_PBS_SETUP.CoreCountControl == 0;
      numeric
        varid       = AMD_PBS_SETUP.CoreCountSwSciGpeId,
        prompt      = STRING_TOKEN(STR_CORE_COUNT_SW_SCI_GPE_ID_PROMPT),
        help        = STRING_TOKEN(STR_CORE_COUNT_SW_SCI_GPE_ID_HELP),
        minimum     = 0,
        maximum     = 31,
        step        = 0,
        default     = 25,
      endnumeric;
    endif;

    oneof
      varid       = AMD_PBS_SETUP.APICSwEnable,
      prompt      = STRING_TOKEN(STR_APIC_SOFTWARE_ENABLE_PROMPT),
      help        = STRING_TOKEN(STR_APIC_SOFTWARE_ENABLE_HELP),
      option text = STRING_TOKEN(STR_DISABLED_TEXT),  value = 0, flags = INTERACTIVE | RESET_REQUIRED ;
      option text = STRING_TOKEN(STR_ENABLED_TEXT),   value = 1, flags = INTERACTIVE | RESET_REQUIRED | DEFAULT;
    endoneof;

    oneof
      varid       = AMD_PBS_SETUP.DynamicP3TLimitEnable,
      prompt      = STRING_TOKEN(STR_DYNAMIC_P3T_LIMIT_STRING),
      help        = STRING_TOKEN(STR_DYNAMIC_P3T_LIMIT_HELP),
      option text = STRING_TOKEN(STR_DISABLED_TEXT),  value = 0, flags = INTERACTIVE | RESET_REQUIRED;
      option text = STRING_TOKEN(STR_ENABLED_FOR_PURE_DC_TEXT),   value = 1, flags = INTERACTIVE | RESET_REQUIRED | DEFAULT;
      option text = STRING_TOKEN(STR_ENABLED_TEXT),   value = 2, flags = INTERACTIVE | RESET_REQUIRED;
    endoneof;

#if defined(INTERNAL_IDS)
    oneof
      varid       = AMD_PBS_SETUP.PdFwUpdate,
      prompt      = STRING_TOKEN(STR_PD_FW_UPDATE_PROMPT),
      help        = STRING_TOKEN(STR_PD_FW_UPDATE_HELP),
      option text = STRING_TOKEN(STR_DISABLED_TEXT),  value = 0, flags = INTERACTIVE | RESET_REQUIRED | DEFAULT;
      option text = STRING_TOKEN(STR_ENABLED_TEXT),   value = 1, flags = INTERACTIVE | RESET_REQUIRED;
    endoneof;
#else
    oneof
      varid       = AMD_PBS_SETUP.PdFwUpdate,
      prompt      = STRING_TOKEN(STR_PD_FW_UPDATE_PROMPT),
      help        = STRING_TOKEN(STR_PD_FW_UPDATE_HELP),
      option text = STRING_TOKEN(STR_DISABLED_TEXT),  value = 0, flags = INTERACTIVE | RESET_REQUIRED | DEFAULT;
      option text = STRING_TOKEN(STR_ENABLED_TEXT),   value = 1, flags = INTERACTIVE | RESET_REQUIRED;
    endoneof;
#endif

    oneof
      varid = AMD_PBS_SETUP.AmdCpmSrisModeDebug,
      prompt = STRING_TOKEN(STR_SRIS_MODE_DEBUG),
      help = STRING_TOKEN(STR_SRIS_MODE_DEBUG_HELP),
      option text = STRING_TOKEN(STR_DISABLED_TEXT),  value = 0, flags = INTERACTIVE | RESET_REQUIRED | DEFAULT;
      option text = STRING_TOKEN(STR_ENABLED_TEXT),   value = 1, flags = INTERACTIVE | RESET_REQUIRED;
    endoneof;

    oneof
      varid = AMD_PBS_SETUP.SpiCs3,
      prompt = STRING_TOKEN(STR_SPI_CS3),
      help = STRING_TOKEN(STR_SPI_CS3_HELP),
      option text = STRING_TOKEN(STR_DISABLED_TEXT),  value = 0, flags = INTERACTIVE | RESET_REQUIRED | DEFAULT;
      option text = STRING_TOKEN(STR_ENABLED_TEXT),   value = 1, flags = INTERACTIVE | RESET_REQUIRED;
    endoneof;

    grayoutif ideqval AMD_PBS_SETUP.XgbePssOutputPort1 == 1;
      oneof
        varid = AMD_PBS_SETUP.Agpio32ResetL,
        prompt = STRING_TOKEN(STR_AGPIO32_RESET_L),
        help = STRING_TOKEN(STR_AGPIO32_RESET_L_HELP),
        option text = STRING_TOKEN(STR_AUTO_TEXT),    value = 0, flags = INTERACTIVE | RESET_REQUIRED | DEFAULT;
        option text = STRING_TOKEN(STR_ENABLED_TEXT), value = 1, flags = INTERACTIVE | RESET_REQUIRED;
      endoneof;
    endif;

  endform;

  //
  //  Form AMD_PBS_FWVER_FORM_ID: Firmware Version
  //
  form formid = AMD_PBS_FWVER_FORM_ID,                    // Form ID
    title  = STRING_TOKEN(STR_AMD_PBS_FWVER_FORM_TITLE);  // Form title

    subtitle text = STRING_TOKEN(STR_AMD_PBS_FWVER_FORM_TITLE);
    subtitle text = STRING_TOKEN(STR_BLANK_STRING);

    text
      help        = STRING_TOKEN(STR_BLANK_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_AGESA_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_AGESA_VALUE),
      flags       = 0,
      key         = 0;

    text
      help        = STRING_TOKEN(STR_BLANK_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_PSP_BOOT_LOADER_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_PSP_BOOT_LOADER_VALUE),
      flags       = 0,
      key         = 0;

    text
      help        = STRING_TOKEN(STR_BLANK_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_PSP_TRUSTED_OS_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_PSP_TRUSTED_OS_VALUE),
      flags       = 0,
      key         = 0;

    subtitle text = STRING_TOKEN(STR_BLANK_STRING);

    text
      help        = STRING_TOKEN(STR_BLANK_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_ABL_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_ABL_VALUE),
      flags       = 0,
      key         = 0;

    text
      help        = STRING_TOKEN(STR_BLANK_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_APCB_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_APCB_VALUE),
      flags       = 0,
      key         = 0;

    text
      help        = STRING_TOKEN(STR_BLANK_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_APOB_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_APOB_VALUE),
      flags       = 0,
      key         = 0;

    subtitle text = STRING_TOKEN(STR_BLANK_STRING);

    text
      help        = STRING_TOKEN(STR_BLANK_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_UCODE_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_UCODE_VALUE),
      flags       = 0,
      key         = 0;

    text
      help        = STRING_TOKEN(STR_BLANK_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_SMU_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_SMU_VALUE),
      flags       = 0,
      key         = 0;

    text
      help        = STRING_TOKEN(STR_BLANK_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_ZSC_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_ZSC_VALUE),
      flags       = 0,
      key         = 0;

    text
      help        = STRING_TOKEN(STR_BLANK_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_DXIO_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_DXIO_VALUE),
      flags       = 0,
      key         = 0;

    subtitle text = STRING_TOKEN(STR_BLANK_STRING);

    text
      help        = STRING_TOKEN(STR_BLANK_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_MP2_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_MP2_VALUE),
      flags       = 0,
      key         = 0;

    text
      help        = STRING_TOKEN(STR_BLANK_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_KVM_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_KVM_VALUE),
      flags       = 0,
      key         = 0;

    subtitle text = STRING_TOKEN(STR_BLANK_STRING);

    text
      help        = STRING_TOKEN(STR_BLANK_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_XHCI_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_XHCI_VALUE),
      flags       = 0,
      key         = 0;

    text
      help        = STRING_TOKEN(STR_BLANK_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_VBIOS_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_VBIOS_VALUE),
      flags       = 0,
      key         = 0;

    text
      help        = STRING_TOKEN(STR_BLANK_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_GOP_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_GOP_VALUE),
      flags       = 0,
      key         = 0;

    subtitle text = STRING_TOKEN(STR_BLANK_STRING);

    text
      help        = STRING_TOKEN(STR_BLANK_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_EC_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_EC_VALUE),
      flags       = 0,
      key         = 0;

    //
    // PD0 INFO
    //
    text
      help        = STRING_TOKEN(STR_BLANK_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_PD_VERSION_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_PD_VERSION_VALUE),
      flags       = 0,
      key         = 0;

    text
      help        = STRING_TOKEN(STR_BLANK_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_PDA_VERSION_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_PDA_VERSION_VALUE),
      flags       = 0,
      key         = 0;
    
    //
    // VRM INFO
    //
//    text
//      help        = STRING_TOKEN(STR_BLANK_STRING),
//      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_VRM_STRING),
//      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_VRM_VALUE),
//      flags       = 0,
//      key         = 0;

    subtitle text = STRING_TOKEN(STR_BLANK_STRING);

      text
      help        = STRING_TOKEN(STR_BLANK_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_AIMT_FW_PART1_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_AIMT_FW_PART1_VALUE),
      flags       = 0,
      key         = 0;

      text
      help        = STRING_TOKEN(STR_BLANK_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_AIMT_FW_PART2_STRING),
      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_AIMT_FW_PART2_VALUE),
      flags       = 0,
      key         = 0;
//
// PLAT-76499, Just Keep PD0 Retimer Info.
//

//    text
//      help        = STRING_TOKEN(STR_BLANK_STRING),
//      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_PD1_RETIMER_STRING),
//      text        = STRING_TOKEN(STR_AMD_PBS_FWVER_PD1_RETIMER_VALUE),
//      flags       = 0,
//      key         = 0;
  endform;

  //
  //  Form AMD_PBS_PCIE_CONFIG_FORM_ID
  //
  form formid = AMD_PBS_PCIE_CONFIG_FORM_ID,
    title  = STRING_TOKEN(STR_AMD_PBS_PCIE_CONFIG_FORM_TITLE);

    subtitle text = STRING_TOKEN(STR_AMD_PBS_PCIE_CONFIG_FORM_TITLE);
    subtitle text = STRING_TOKEN(STR_BLANK_STRING);

    //
    // Customize timeout value for PCIe training
    //
    oneof
      varid       = AMD_PBS_SETUP.PbsDbgGnbDxioTimingControlEnable,
      prompt      = STRING_TOKEN (AMD_PBS_STR_PCIE_DXIO_TIMING_CONTROLENABLE),
      help        = STRING_TOKEN (AMD_PBS_STR_PCIE_DXIO_TIMING_CONTROLENABLE_HELP),
      option text = STRING_TOKEN (STR_AUTO_TEXT),               value = 0xf,  flags = DEFAULT | RESET_REQUIRED;
      option text = STRING_TOKEN (STR_ENABLED_TEXT),            value = 1,    flags = 0 | RESET_REQUIRED;
      option text = STRING_TOKEN (STR_DISABLED_TEXT),           value = 0,    flags = 0 | RESET_REQUIRED;
    endoneof;

    suppressif NOT ideqval AMD_PBS_SETUP.PbsDbgGnbDxioTimingControlEnable == 1;
      // PCIE Link Receiver Detection Polling
      // ex; 200000 micro second
      numeric
        varid       = AMD_PBS_SETUP.PbsDbgGnbPcieLinkReceiverDetectionPolling,
        prompt      = STRING_TOKEN (AMD_PBS_STR_PCIE_LINK_RECEIVER_DETECTION_POLLING),
        help        = STRING_TOKEN (AMD_PBS_STR_PCIE_LINK_RECEIVER_DETECTION_POLLING_HELP),
        flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
        minimum     = 0,
        maximum     = 0xFFFFFFFF,
        step        = 0,
        default     = 0,
      endnumeric;
    endif;

    suppressif NOT ideqval AMD_PBS_SETUP.PbsDbgGnbDxioTimingControlEnable == 1;
      // PCIE Link L0 Polling
      // ex; 200000 micro second
      numeric
        varid       = AMD_PBS_SETUP.PbsDbgGnbPcieLinkL0Polling,
        prompt      = STRING_TOKEN (AMD_PBS_STR_PCIE_LINK_L0_POLLING),
        help        = STRING_TOKEN (AMD_PBS_STR_PCIE_LINK_L0_POLLING_HELP),
        flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
        minimum     = 0,
        maximum     = 0xFFFFFFFF,
        step        = 0,
        default     = 0,
      endnumeric;
    endif;

    //
    //  Internal MUX selection.
    //
    oneof
      varid       = AMD_PBS_SETUP.PcieSlot1,
      prompt      = STRING_TOKEN(STR_PCIE_SLOT_1_PROMPT),
      help        = STRING_TOKEN(STR_PCIE_SLOT_1_HELP),
      option text = STRING_TOKEN(STR_DISABLED_TEXT),     value = 0, flags = INTERACTIVE | RESET_REQUIRED | DEFAULT;
      option text = STRING_TOKEN(STR_ENABLED_TEXT),      value = 1, flags = INTERACTIVE | RESET_REQUIRED;
      endoneof;
    suppressif ideqval AMD_PBS_SETUP.PcieSlot1 == 1;
      oneof
        varid       = AMD_PBS_SETUP.XgbePathSelect,
