  gEfiAmdAgesaPkgTokenSpaceGuid.PcdMpmWirelessManageability
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdMpmProvisioned
  gAmdCpmPkgTokenSpaceGuid.EcRamBaseAddr
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdP3TLimit

[Depex]
