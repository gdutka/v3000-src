            }
        }
        If (LEqual (And (Local0, 0x8000), 0x8000)) {                      // IO Expander 3 Port 1 Gpio 7
            If (CondRefOf (\_GPE.SP77)) {
                CpmDebugPrint ("  KER-ASL-Callout \\_GPE.SP77\n", 0, 0, 0, 0, 0, 0)
                \_GPE.SP77 ()
            }
        }

        //
        // Exit Callout Method after handling this event
        //
        If (CondRefOf (\_GPE.AIE3)) {
            CpmDebugPrint ("  KER-ASL-Callout \\_GPE.AIE3\n", 0, 0, 0, 0, 0, 0)
            \_GPE.AIE3 ()
        }
        CpmDebugPrint ("  KER-ASL-\\_GPE.SIE3 End\n", 0, 0, 0, 0, 0, 0)
    }

    Name (CpmAlibFunctionCReturnBuffer, Buffer (8) {})                        // M4D2

    Method (XL0B, 0, Notserialized) {
        Store (Buffer (8) {}, Local3)
        CreateWordField (Local3, 0, CpmAlibStructureSize)         // Buffer Size
        CreateByteField (Local3, 2, CpmAlibSubFunction)           // DPTCi Sub Function
        CreateDwordField (Local3, 3, CpmAlibControlValue)         // DPTCi Control Value
        Store (0, CpmAlibControlValue)
        Store (7, CpmAlibStructureSize)                           // Size of Buffer
        Store (0x30, CpmAlibSubFunction)                          // Message ID of core
        If (CondRefOf (\_SB.ALIB)) {
            CpmDebugPrint ("  KER-ASL-Call \\_SB.ALIB (0x0C, 0x%X)\n", Local3, 0, 0, 0, 0, 0)
            Store (\_SB.ALIB (0x0C, Local3), Local4)
            Store (Local4, CpmAlibFunctionCReturnBuffer)
            CreateDwordField (CpmAlibFunctionCReturnBuffer, 0, CpmAlibReturnData0)      // ALIB Return Data 0
            CreateDwordField (CpmAlibFunctionCReturnBuffer, 4, CpmAlibReturnData1)      // ALIB Return Data 1
            ToInteger (CpmAlibReturnData0, Local0)
            ToInteger (CpmAlibReturnData1, Local1)
            CpmDebugPrint ("  KER-ASL-ALIB Return Data (0x%X, 0x%X)\n", Local0, Local1, 0, 0, 0, 0)
            If (LEqual (Local0, 0)) {
                If (CondRefOf (\_SB.APAD)) {
                    Store (Local1, Index (\_SB.APAD.CpmIdleCoreCount, 1))
                    // Notify Processor Aggregator Device - Processor Utilization Request - 0x80
                    CpmDebugPrint ("  KER-ASL-Notify \\_SB.APAD 0x80\n", 0, 0, 0, 0, 0, 0)
                    Notify (\_SB.APAD, 0x80)
                }
            } ElseIf (LEqual (Local0, 1)) {
                // Notify Processor Device - Minimum Excursion - 0x84
                CpmDebugPrint ("  KER-ASL-Notify \\_SB.APAD 0x84\n", 0, 0, 0, 0, 0, 0)
                // Notify (\_SB.APAD, 0x84)
            } ElseIf (LEqual (Local0, 2)) {
                // Notify Processor Device - Highest Performance Changed - 0x85
                CpmDebugPrint ("  KER-ASL-Notify \\_SB.APAD 0x85\n", 0, 0, 0, 0, 0, 0)
                If (CondRefOf (NFPC)) {
                    NFPC()
                }
            }
        } // End of If (CondRefOf (\_SB.ALIB))
    } // End of Method (XL0B, 0, Notserialized)
} // End of Scope (\_GPE)

