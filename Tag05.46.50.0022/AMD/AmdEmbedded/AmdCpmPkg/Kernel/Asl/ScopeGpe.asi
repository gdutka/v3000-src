Scope (\_GPE) {
    //
    // Smbus IO Expander 0 Interrupt Event Method
    //
    Method (SIE0, 0, Notserialized) {
        CpmDebugPrint ("  KER-ASL-\\_GPE.SIE0 Start\n", 0, 0, 0, 0, 0, 0)
        //
        // Entry Callout Method before handling this event
        //
        If (CondRefOf (\_GPE.BIE0)) {
            CpmDebugPrint ("  KER-ASL-Callout \\_GPE.BIE0\n", 0, 0, 0, 0, 0, 0)
            \_GPE.BIE0 ()
        }

        //
        // Check GPIO Input Pin Status
        //
        Store (CpmCheckExpanderInputEvent (0), Local0)

        //
        // GPIO Input Event Callout Method
        //
        If (LEqual (And (Local0, 0x0001), 0x0001)) {                      // IO Expander 0 Port 0 Gpio 0
            If (CondRefOf (\_GPE.SP00)) {
                CpmDebugPrint ("  KER-ASL-Callout \\_GPE.SP00\n", 0, 0, 0, 0, 0, 0)
                \_GPE.SP00 ()
            }
        }
        If (LEqual (And (Local0, 0x0002), 0x0002)) {                      // IO Expander 0 Port 0 Gpio 1
            If (CondRefOf (\_GPE.SP01)) {
                CpmDebugPrint ("  KER-ASL-Callout \\_GPE.SP01\n", 0, 0, 0, 0, 0, 0)
                \_GPE.SP01 ()
            }
        }
        If (LEqual (And (Local0, 0x0004), 0x0004)) {                      // IO Expander 0 Port 0 Gpio 2
            If (CondRefOf (\_GPE.SP02)) {
                CpmDebugPrint ("  KER-ASL-Callout \\_GPE.SP02\n", 0, 0, 0, 0, 0, 0)
                \_GPE.SP02 ()
            }
        }
        If (LEqual (And (Local0, 0x0008), 0x0008)) {                      // IO Expander 0 Port 0 Gpio 3
            If (CondRefOf (\_GPE.SP03)) {
                CpmDebugPrint ("  KER-ASL-Callout \\_GPE.SP03\n", 0, 0, 0, 0, 0, 0)
                \_GPE.SP03 ()
            }
        }
        If (LEqual (And (Local0, 0x0010), 0x0010)) {                      // IO Expander 0 Port 0 Gpio 4
            If (CondRefOf (\_GPE.SP04)) {
                CpmDebugPrint ("  KER-ASL-Callout \\_GPE.SP04\n", 0, 0, 0, 0, 0, 0)
                \_GPE.SP04 ()
            }
        }
        If (LEqual (And (Local0, 0x0020), 0x0020)) {                      // IO Expander 0 Port 0 Gpio 5
            If (CondRefOf (\_GPE.SP05)) {
                CpmDebugPrint ("  KER-ASL-Callout \\_GPE.SP05\n", 0, 0, 0, 0, 0, 0)
                \_GPE.SP05 ()
            }
        }
        If (LEqual (And (Local0, 0x0040), 0x0040)) {                      // IO Expander 0 Port 0 Gpio 6
            If (CondRefOf (\_GPE.SP06)) {
                CpmDebugPrint ("  KER-ASL-Callout \\_GPE.SP06\n", 0, 0, 0, 0, 0, 0)
                \_GPE.SP06 ()
            }
        }
        If (LEqual (And (Local0, 0x0080), 0x0080)) {                      // IO Expander 0 Port 0 Gpio 7
            If (CondRefOf (\_GPE.SP07)) {
                CpmDebugPrint ("  KER-ASL-Callout \\_GPE.SP07\n", 0, 0, 0, 0, 0, 0)
                \_GPE.SP07 ()
            }
        }
        If (LEqual (And (Local0, 0x0100), 0x0100)) {                      // IO Expander 0 Port 1 Gpio 0
            If (CondRefOf (\_GPE.SP10)) {
                CpmDebugPrint ("  KER-ASL-Callout \\_GPE.SP10\n", 0, 0, 0, 0, 0, 0)
                \_GPE.SP10 ()
            }
        }
        If (LEqual (And (Local0, 0x0200), 0x0200)) {                      // IO Expander 0 Port 1 Gpio 1
            If (CondRefOf (\_GPE.SP11)) {
                CpmDebugPrint ("  KER-ASL-Callout \\_GPE.SP11\n", 0, 0, 0, 0, 0, 0)
                \_GPE.SP11 ()
            }
        }
        If (LEqual (And (Local0, 0x0400), 0x0400)) {                      // IO Expander 0 Port 1 Gpio 2
            If (CondRefOf (\_GPE.SP12)) {
                CpmDebugPrint ("  KER-ASL-Callout \\_GPE.SP12\n", 0, 0, 0, 0, 0, 0)
                \_GPE.SP12 ()
            }
        }
        If (LEqual (And (Local0, 0x0800), 0x0800)) {                      // IO Expander 0 Port 1 Gpio 3
            If (CondRefOf (\_GPE.SP13)) {
                CpmDebugPrint ("  KER-ASL-Callout \\_GPE.SP13\n", 0, 0, 0, 0, 0, 0)
                \_GPE.SP13 ()
            }
        }
        If (LEqual (And (Local0, 0x1000), 0x1000)) {                      // IO Expander 0 Port 1 Gpio 4
            If (CondRefOf (\_GPE.SP14)) {
                CpmDebugPrint ("  KER-ASL-Callout \\_GPE.SP14\n", 0, 0, 0, 0, 0, 0)
                \_GPE.SP14 ()
            }
        }
        If (LEqual (And (Local0, 0x2000), 0x2000)) {                      // IO Expander 0 Port 1 Gpio 5
            If (CondRefOf (\_GPE.SP15)) {
                CpmDebugPrint ("  KER-ASL-Callout \\_GPE.SP15\n", 0, 0, 0, 0, 0, 0)
                \_GPE.SP15 ()
