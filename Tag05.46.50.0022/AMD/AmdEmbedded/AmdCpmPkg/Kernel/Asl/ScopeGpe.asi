        }
        If (LEqual (And (Local0, 0x4000), 0x4000)) {                      // IO Expander 0 Port 1 Gpio 6
            If (CondRefOf (\_GPE.SP16)) {
                CpmDebugPrint ("  KER-ASL-Callout \\_GPE.SP16\n", 0, 0, 0, 0, 0, 0)
                \_GPE.SP16 ()
            }
        }
        If (LEqual (And (Local0, 0x8000), 0x8000)) {                      // IO Expander 0 Port 1 Gpio 7
            If (CondRefOf (\_GPE.SP17)) {
                CpmDebugPrint ("  KER-ASL-Callout \\_GPE.SP17\n", 0, 0, 0, 0, 0, 0)
                \_GPE.SP17 ()
            }
        }

        //
        // Exit Callout Method after handling this event
        //
        If (CondRefOf (\_GPE.AIE0)) {
            CpmDebugPrint ("  KER-ASL-Callout \\_GPE.AIE0\n", 0, 0, 0, 0, 0, 0)
            \_GPE.AIE0 ()
        }
        CpmDebugPrint ("  KER-ASL-\\_GPE.SIE0 End\n", 0, 0, 0, 0, 0, 0)
    }

