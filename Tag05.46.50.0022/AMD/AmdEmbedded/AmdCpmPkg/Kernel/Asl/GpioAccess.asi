Name (CpmGeventGpioMappingTableRMB, Buffer (24) { // RMB
  0x59,         // GEVENT0 => GPIO89
  0x5A,         // GEVENT1 => GPIO90
  0x03,         // GEVENT2 => GPIO3
  0x16,         // GEVENT3 => GPIO22
  0x04,         // GEVENT4 => GPIO4
  0x0B,         // GEVENT5 => GPIO11
