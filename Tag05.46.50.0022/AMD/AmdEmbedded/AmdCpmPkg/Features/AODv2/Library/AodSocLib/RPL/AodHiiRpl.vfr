 ***************************************************************************/

/*****************************************************************************
 *
 * This software package can be used to enable the Overclocking of certain
 * AMD processors and its use is subject to the terms and conditions of the
 * AMD Overclocking Waiver. Enabling overclocking through use of the low-level
 * routines included in this package and operating an AMD processor outside of
 * the applicable AMD product specifications will void any AMD warranty and can
 * result in damage to the processor or the system into which the processor has
 * been integrated. The user of this software assumes, and AMD disclaims, all
 * risk, liability, costs and damages relating to or arising from the overclocking
 * of AMD processors.
 *
 ******************************************************************************
 */

#include <Guid/HiiPlatformSetupFormset.h>
#include "AodSocLib.h"
formset
  guid      = AOD_SETUP_FORMSET_GUID,
  title     = STRING_TOKEN(STR_AOD_ACCEPT_SECTION),
  help      = STRING_TOKEN(STR_AOD_ACCEPT_SECTION_HELP),
  class     = AOD_SETUP_CLASS,
  subclass  = AOD_SETUP_SUB_CLASS,

  //
  // Define a Buffer Storage (EFI_IFR_VARSTORE)
  //
  AOD_SETUP_VARSTORE

  form formid = AOD_SETUP_FORM_ID,                    // Form ID
    title  = STRING_TOKEN(STR_AOD_SETUP_FORM_TITLE);  // Form title
    subtitle text = STRING_TOKEN (STR_LEGAL_DISCLAIMER);

    goto SETUP_ACCEPT_LABLE,
      prompt      = STRING_TOKEN (STR_ACCEPT_SECTION),
      help        = STRING_TOKEN (STR_BLANK_STRING);

    goto AOD_SETUP_DECLINE_FORM_ID,
      prompt      = STRING_TOKEN (STR_DECLINE_SECTION),
      help        = STRING_TOKEN (STR_BLANK_STRING);
  endform;

  //
  // form - Decline
  //
  form

    formid        = AOD_SETUP_DECLINE_FORM_ID,

    title         = STRING_TOKEN (STR_DECLINE_SECTION);

    subtitle text = STRING_TOKEN (STR_DECLINE_SECTION);
    subtitle text = STRING_TOKEN (STR_BLANK_STRING);

  endform;
    //
  // form - ACCEPT
  //
  form

    formid        = SETUP_ACCEPT_LABLE,

    title         = STRING_TOKEN (STR_AOD_ACCEPT_SECTION);

    subtitle text = STRING_TOKEN (STR_AOD_ACCEPT_SECTION);
    subtitle text = STRING_TOKEN (STR_AOD_BLANK);

    goto SETUP_MANUAL_CPU_OVERCLOCKING_LABLE,
      prompt      = STRING_TOKEN (STR_AOD_MANUAL_CPU_OVERCLOCKING_SECTION),
      help        = STRING_TOKEN (STR_AOD_MANUAL_CPU_OVERCLOCKING_SECTION);

    // Display Condition: MemOverClocking=1
    suppressif NOT ideqval AOD_CONFIG.Header.MemOverClocking == 1;
      goto SETUP_DDR_AND_INFINITY_FABRIC_FREQUENCY_TIMINGS_LABLE,
        prompt      = STRING_TOKEN (STR_AOD_DDR_AND_INFINITY_FABRIC_FREQUENCY_TIMINGS_SECTION),
        help        = STRING_TOKEN (STR_AOD_DDR_AND_INFINITY_FABRIC_FREQUENCY_TIMINGS_SECTION);
    endif;

    // Display Condition: MocOverClocking=1
    suppressif NOT ideqval AOD_CONFIG.Header.MocOverClocking == 1;
      goto SETUP_PRECISION_BOOST_OVERDRIVE_LABLE,
        prompt      = STRING_TOKEN (STR_AOD_PRECISION_BOOST_OVERDRIVE_SECTION),
        help        = STRING_TOKEN (STR_AOD_PRECISION_BOOST_OVERDRIVE_SECTION);
    endif;

    // Display Condition: MemOverClocking=1
    suppressif NOT ideqval AOD_CONFIG.Header.MemOverClocking == 1;
      goto SETUP_VDDG_VOLTAGE_CONTROL_LABLE,
        prompt      = STRING_TOKEN (STR_AOD_VDDG_VOLTAGE_CONTROL_SECTION),
        help        = STRING_TOKEN (STR_AOD_VDDG_VOLTAGE_CONTROL_SECTION);
    endif;

    // Display Condition: MemOverClocking=1
    suppressif NOT ideqval AOD_CONFIG.Header.MemOverClocking == 1;
      goto SETUP_VDDP_VOLTAGE_CONTROL_LABLE,
        prompt      = STRING_TOKEN (STR_AOD_VDDP_VOLTAGE_CONTROL_SECTION),
        help        = STRING_TOKEN (STR_AOD_VDDP_VOLTAGE_CONTROL_SECTION);
    endif;

    // Display Condition: MemOverClocking=1|GfxOverClocking=1
    suppressif NOT ideqval AOD_CONFIG.Header.MemOverClocking == 1
           AND NOT ideqval AOD_CONFIG.Header.GfxOverClocking == 1;
      goto SETUP_SOC_UNCORE_OC_MODE_LABLE,
        prompt      = STRING_TOKEN (STR_AOD_SOC_UNCORE_OC_MODE_SECTION),
        help        = STRING_TOKEN (STR_AOD_SOC_UNCORE_OC_MODE_SECTION);
    endif;

    // Display Condition: MemOverClocking=1|GfxOverClocking=1
    suppressif NOT ideqval AOD_CONFIG.Header.MemOverClocking == 1
           AND NOT ideqval AOD_CONFIG.Header.GfxOverClocking == 1;
      goto SETUP_SOC_VOLTAGE_LABLE,
        prompt      = STRING_TOKEN (STR_AOD_SOC_VOLTAGE_SECTION),
        help        = STRING_TOKEN (STR_AOD_SOC_VOLTAGE_SECTION);
    endif;

    goto SETUP_ECO_MODE_LABLE,
      prompt      = STRING_TOKEN (STR_AOD_ECO_MODE_SECTION),
      help        = STRING_TOKEN (STR_AOD_ECO_MODE_SECTION);

    // Display Condition: CpuOverClocking=1|GfxOverClocking=1
    suppressif NOT ideqval AOD_CONFIG.Header.CpuOverClocking == 1
           AND NOT ideqval AOD_CONFIG.Header.GfxOverClocking == 1;
      goto SETUP_LN2_MODE_LABLE,
        prompt      = STRING_TOKEN (STR_AOD_LN2_MODE_SECTION),
        help        = STRING_TOKEN (STR_AOD_LN2_MODE_SECTION);
    endif;

    // Display Condition: MemOverClocking=1
    suppressif NOT ideqval AOD_CONFIG.Header.MemOverClocking == 1;
      goto SETUP_VDD_MISC_LABLE,
        prompt      = STRING_TOKEN (STR_AOD_VDD_MISC_SECTION),
        help        = STRING_TOKEN (STR_AOD_VDD_MISC_SECTION);
    endif;

    // Display Condition: CpuOverClocking=1|GfxPrecisedOverClocking=1
    suppressif NOT ideqval AOD_CONFIG.Header.CpuOverClocking == 1
           AND NOT ideqval AOD_CONFIG.Header.GfxPrecisedOverClocking == 1;
      goto SETUP_LCLK_FREQUENCY_CONTROL_LABLE,
        prompt      = STRING_TOKEN (STR_AOD_LCLK_FREQUENCY_CONTROL_SECTION),
        help        = STRING_TOKEN (STR_AOD_LCLK_FREQUENCY_CONTROL_SECTION);
    endif;

    // Display Condition: MemOverClocking=1|GfxPrecisedOverClocking=1
    suppressif NOT ideqval AOD_CONFIG.Header.MemOverClocking == 1
           AND NOT ideqval AOD_CONFIG.Header.GfxPrecisedOverClocking == 1;
      goto SETUP_ONBOARD_VOLTAGE_CONTROL_LABLE,
        prompt      = STRING_TOKEN (STR_AOD_ONBOARD_VOLTAGE_CONTROL_SECTION),
        help        = STRING_TOKEN (STR_AOD_ONBOARD_VOLTAGE_CONTROL_SECTION);
    endif;

  endform;


    //
    // form - Manual CPU Overclocking
    //
    form

      formid        = SETUP_MANUAL_CPU_OVERCLOCKING_LABLE,

      title         = STRING_TOKEN (STR_AOD_MANUAL_CPU_OVERCLOCKING_SECTION);

      subtitle text = STRING_TOKEN (STR_AOD_MANUAL_CPU_OVERCLOCKING_SECTION);
      subtitle text = STRING_TOKEN (STR_AOD_BLANK);

      // Display Condition: CpuOverClocking=1
      suppressif NOT ideqval AOD_CONFIG.Header.CpuOverClocking == 1;
        // CPU Frequency
        // Specifies a custom CPU core frequency. Should be combined with a custom CPU voltage. Power saving features for idle cores (e.g. cc6 sleep) remain active.
        numeric
          varid       = AOD_CONFIG.AodCpuPst0Freq,
          prompt      = STRING_TOKEN (STR_AOD_CPU_FREQUENCY),
          help        = STRING_TOKEN (STR_AOD_CPU_FREQUENCY_HELP),
          flags       = RESET_REQUIRED,
          minimum     = 0,
          maximum     = 0xffffffff,
          step        = 0,
          default     = 0,
        endnumeric;
      endif;

      // Display Condition: CpuOverClocking=1
      suppressif NOT ideqval AOD_CONFIG.Header.CpuOverClocking == 1;
        // CPU Voltage
        // Specifies a custom CPU core voltage (mV). Should be combined with a custom CPU core frequency. Power saving features for idle cores (e.g. cc6 sleep) remain active.
        numeric
          varid       = AOD_CONFIG.AodCpuPst0Voltage,
          prompt      = STRING_TOKEN (STR_AOD_CPU_VOLTAGE),
          help        = STRING_TOKEN (STR_AOD_CPU_VOLTAGE_HELP),
          flags       = RESET_REQUIRED,
          minimum     = 0,
          maximum     = 0xAF0,
          step        = 0,
          default     = 0,
        endnumeric;
      endif;

      // Display Condition: CpuOverClocking=1|PBOAdvancedOverClocking=1
      suppressif NOT ideqval AOD_CONFIG.Header.CpuOverClocking == 1
             AND NOT ideqval AOD_CONFIG.Header.PBOAdvancedOverClocking == 1;
        goto SETUP_CPU_CORE_COUNT_CONTROL_LABLE,
          prompt      = STRING_TOKEN (STR_AOD_CPU_CORE_COUNT_CONTROL_SECTION),
          help        = STRING_TOKEN (STR_AOD_CPU_CORE_COUNT_CONTROL_SECTION);
      endif;

    endform;
      //
      // form - CPU Core Count Control
      //
      form

        formid        = SETUP_CPU_CORE_COUNT_CONTROL_LABLE,

        title         = STRING_TOKEN (STR_AOD_CPU_CORE_COUNT_CONTROL_SECTION);

        subtitle text = STRING_TOKEN (STR_AOD_CPU_CORE_COUNT_CONTROL_SECTION);
        subtitle text = STRING_TOKEN (STR_AOD_BLANK);

        label LABEL_CBS_AOD_DOWN_CORE_DYNAMIC_START;
        // Down Core Dynamic
        // No help string
        label LABEL_CBS_AOD_DOWN_CORE_DYNAMIC_END;

        // Display Condition: AodComboFlag=1
        suppressif NOT ideqval AOD_CONFIG.Header.AodComboFlag == 1;
          // SMT Control
          // Can be used to disable symmetric multithreading. To re-enable SMT, a POWER CYCLE is needed after selecting the 'Auto' option. WARNING - S3 is NOT SUPPORTED on systems where SMT is disabled.
          oneof
            varid       = AOD_CONFIG.AodCpuSmtCtrl,
            prompt      = STRING_TOKEN (STR_AOD_SMT_CONTROL),
            help        = STRING_TOKEN (STR_AOD_SMT_CONTROL_HELP),
            option text = STRING_TOKEN (STR_AOD_AUTO),                value = 1,    flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_DISABLE),             value = 0,    flags = 0 | RESET_REQUIRED;
          endoneof;
        endif;

      endform;
    //
    // form - DDR and Infinity Fabric Frequency/Timings
    //
    form

      formid        = SETUP_DDR_AND_INFINITY_FABRIC_FREQUENCY_TIMINGS_LABLE,

      title         = STRING_TOKEN (STR_AOD_DDR_AND_INFINITY_FABRIC_FREQUENCY_TIMINGS_SECTION);

      subtitle text = STRING_TOKEN (STR_AOD_DDR_AND_INFINITY_FABRIC_FREQUENCY_TIMINGS_SECTION);
      subtitle text = STRING_TOKEN (STR_AOD_BLANK);

      goto SETUP_DDR_OPTIONS_LABLE,
        prompt      = STRING_TOKEN (STR_AOD_DDR_OPTIONS_SECTION),
        help        = STRING_TOKEN (STR_AOD_DDR_OPTIONS_SECTION);

      goto SETUP_INFINITY_FABRIC_FREQUENCY_AND_DIVIDERS_LABLE,
        prompt      = STRING_TOKEN (STR_AOD_INFINITY_FABRIC_FREQUENCY_AND_DIVIDERS_SECTION),
        help        = STRING_TOKEN (STR_AOD_INFINITY_FABRIC_FREQUENCY_AND_DIVIDERS_SECTION);

    endform;
      //
      // form - DDR Options
      //
      form

        formid        = SETUP_DDR_OPTIONS_LABLE,

        title         = STRING_TOKEN (STR_AOD_DDR_OPTIONS_SECTION);

        subtitle text = STRING_TOKEN (STR_AOD_DDR_OPTIONS_SECTION);
        subtitle text = STRING_TOKEN (STR_AOD_BLANK);

        goto SETUP_DDR_TIMING_CONFIGURATION_LABLE,
          prompt      = STRING_TOKEN (STR_AOD_DDR_TIMING_CONFIGURATION_SECTION),
          help        = STRING_TOKEN (STR_AOD_DDR_TIMING_CONFIGURATION_SECTION);

        goto SETUP_DDR_BUS_CONFIGURATION_LABLE,
          prompt      = STRING_TOKEN (STR_AOD_DDR_BUS_CONFIGURATION_SECTION),
          help        = STRING_TOKEN (STR_AOD_DDR_BUS_CONFIGURATION_SECTION);

        goto SETUP_DDR_CONTROLLER_CONFIGURATION_LABLE,
          prompt      = STRING_TOKEN (STR_AOD_DDR_CONTROLLER_CONFIGURATION_SECTION),
          help        = STRING_TOKEN (STR_AOD_DDR_CONTROLLER_CONFIGURATION_SECTION);

      endform;
        //
        // form - DDR Timing Configuration
        //
        form

          formid        = SETUP_DDR_TIMING_CONFIGURATION_LABLE,

          title         = STRING_TOKEN (STR_AOD_DDR_TIMING_CONFIGURATION_SECTION);

          subtitle text = STRING_TOKEN (STR_AOD_DDR_TIMING_CONFIGURATION_SECTION);
          subtitle text = STRING_TOKEN (STR_AOD_BLANK);

          // Active Memory Timing Settings
          oneof
            varid       = AOD_CONFIG.AodMemTimingSettingDdr,
            prompt      = STRING_TOKEN (STR_AOD_ACTIVE_MEMORY_TIMING_SETTINGS),
            help        = STRING_TOKEN (STR_AOD_ACTIVE_MEMORY_TIMING_SETTINGS_HELP),
            option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_ENABLED),             value = 1,    flags = 0 | RESET_REQUIRED;
          endoneof;

          // Display Condition: AodMemTimingSettingDdr=Enabled
          suppressif NOT ideqval AOD_CONFIG.AodMemTimingSettingDdr == 1;
            // Memory Target Speed
            // Specifies the memory target speed in MT/s. The valid input is 2000 MT/s, 2400MT/s, and range of 3200MT/s ~ 12000 MT/s(stepping of 200 MT/s).\nThe user input value will be rounded down to align with the stepping of 200MT/s.
            numeric
              varid       = AOD_CONFIG.AodMemTargetSpeedDdr,
              prompt      = STRING_TOKEN (STR_AOD_MEMORY_TARGET_SPEED),
              help        = STRING_TOKEN (STR_AOD_MEMORY_TARGET_SPEED_HELP),
              flags       = RESET_REQUIRED,
              minimum     = 2000,
              maximum     = 12000,
              step        = 200,
              default     = 3200,
            endnumeric;
          endif;

          // Active Condition: AodMemTimingSettingDdr=Enabled
          grayoutif NOT ideqval AOD_CONFIG.AodMemTimingSettingDdr == 1;
            goto SETUP_DDR_SPD_TIMING_LABLE,
              prompt      = STRING_TOKEN (STR_AOD_DDR_SPD_TIMING_SECTION),
              help        = STRING_TOKEN (STR_AOD_DDR_SPD_TIMING_SECTION);
          endif;

          // Active Condition: AodMemTimingSettingDdr=Enabled
          grayoutif NOT ideqval AOD_CONFIG.AodMemTimingSettingDdr == 1;
            goto SETUP_DDR_NON_SPD_TIMING_LABLE,
              prompt      = STRING_TOKEN (STR_AOD_DDR_NON_SPD_TIMING_SECTION),
              help        = STRING_TOKEN (STR_AOD_DDR_NON_SPD_TIMING_SECTION);
          endif;

        endform;
          //
          // form - DDR SPD Timing
          //
          form

            formid        = SETUP_DDR_SPD_TIMING_LABLE,

            title         = STRING_TOKEN (STR_AOD_DDR_SPD_TIMING_SECTION);

            subtitle text = STRING_TOKEN (STR_AOD_DDR_SPD_TIMING_SECTION);
            subtitle text = STRING_TOKEN (STR_AOD_BLANK);

            // Display Condition: AodMemTimingSettingDdr=Enabled
            suppressif NOT ideqval AOD_CONFIG.AodMemTimingSettingDdr == 1;
              // Tcl Ctrl
              // Auto: Follow default setting, Manual: Manually specify
              oneof
                varid       = AOD_CONFIG.AodMemTimingTclCtrlDdr,
                prompt      = STRING_TOKEN (STR_AOD_TCL_CTRL),
                help        = STRING_TOKEN (STR_AOD_TCL_CTRL_HELP),
                option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0,    flags = DEFAULT | RESET_REQUIRED;
                option text = STRING_TOKEN (STR_AOD_MANUAL),              value = 1,    flags = 0 | RESET_REQUIRED;
              endoneof;
            endif;

            // Display Condition: AodMemTimingSettingDdr=Enabled,AodMemTimingTclCtrlDdr=Manual
            suppressif NOT ideqval AOD_CONFIG.AodMemTimingSettingDdr == 1
                    OR NOT ideqval AOD_CONFIG.AodMemTimingTclCtrlDdr == 1;
              // Tcl
              // Specifies the CAS Latency. Valid values: 0x16 ~ 0x40, stepping of 2. The value is in hex.
              numeric
                varid       = AOD_CONFIG.AodMemTimingTclDdr,
                prompt      = STRING_TOKEN (STR_AOD_TCL),
                help        = STRING_TOKEN (STR_AOD_TCL_HELP),
                flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
                minimum     = 0x16,
                maximum     = 0x40,
                step        = 2,
                default     = 22,
              endnumeric;
            endif;

            // Display Condition: AodMemTimingSettingDdr=Enabled
            suppressif NOT ideqval AOD_CONFIG.AodMemTimingSettingDdr == 1;
              // Trcd Ctrl
              // Auto: Follow default setting, Manual: Manually specify
              oneof
                varid       = AOD_CONFIG.AodMemTimingTrcdCtrlDdr,
                prompt      = STRING_TOKEN (STR_AOD_TRCD_CTRL),
                help        = STRING_TOKEN (STR_AOD_TRCD_CTRL_HELP),
                option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0,    flags = DEFAULT | RESET_REQUIRED;
                option text = STRING_TOKEN (STR_AOD_MANUAL),              value = 1,    flags = 0 | RESET_REQUIRED;
              endoneof;
            endif;

            // Display Condition: AodMemTimingSettingDdr=Enabled,AodMemTimingTrcdCtrlDdr=Manual
            suppressif NOT ideqval AOD_CONFIG.AodMemTimingSettingDdr == 1
                    OR NOT ideqval AOD_CONFIG.AodMemTimingTrcdCtrlDdr == 1;
              // Trcd
              // Specifies the RAS# Active to CAS# Read Delay Time. Valid values: 0x8 ~ 0x3E, stepping of 2. The value is in hex.
              numeric
                varid       = AOD_CONFIG.AodMemTimingTrcdDdr,
                prompt      = STRING_TOKEN (STR_AOD_TRCD),
                help        = STRING_TOKEN (STR_AOD_TRCD_HELP),
                flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
                minimum     = 0x8,
                maximum     = 0x3E,
                step        = 2,
                default     = 8,
              endnumeric;
            endif;

            // Display Condition: AodMemTimingSettingDdr=Enabled
            suppressif NOT ideqval AOD_CONFIG.AodMemTimingSettingDdr == 1;
              // Trp Ctrl
              // Auto: Follow default setting, Manual: Manually specify
              oneof
                varid       = AOD_CONFIG.AodMemTimingTrpCtrlDdr,
                prompt      = STRING_TOKEN (STR_AOD_TRP_CTRL),
                help        = STRING_TOKEN (STR_AOD_TRP_CTRL_HELP),
                option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0,    flags = DEFAULT | RESET_REQUIRED;
                option text = STRING_TOKEN (STR_AOD_MANUAL),              value = 1,    flags = 0 | RESET_REQUIRED;
              endoneof;
            endif;

            // Display Condition: AodMemTimingSettingDdr=Enabled,AodMemTimingTrpCtrlDdr=Manual
            suppressif NOT ideqval AOD_CONFIG.AodMemTimingSettingDdr == 1
                    OR NOT ideqval AOD_CONFIG.AodMemTimingTrpCtrlDdr == 1;
              // Trp
              // Specifies Row Precharge Delay Time. Valid values: 0x8 ~ 0x3E, stepping of 2. The value is in hex.
              numeric
                varid       = AOD_CONFIG.AodMemTimingTrpDdr,
                prompt      = STRING_TOKEN (STR_AOD_TRP),
                help        = STRING_TOKEN (STR_AOD_TRP_HELP),
                flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
                minimum     = 0x8,
                maximum     = 0x3E,
                step        = 2,
                default     = 8,
              endnumeric;
            endif;

            // Display Condition: AodMemTimingSettingDdr=Enabled
            suppressif NOT ideqval AOD_CONFIG.AodMemTimingSettingDdr == 1;
              // Tras Ctrl
              // Auto: Follow default setting, Manual: Manually specify
              oneof
                varid       = AOD_CONFIG.AodMemTimingTrasCtrlDdr,
                prompt      = STRING_TOKEN (STR_AOD_TRAS_CTRL),
                help        = STRING_TOKEN (STR_AOD_TRAS_CTRL_HELP),
                option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0,    flags = DEFAULT | RESET_REQUIRED;
                option text = STRING_TOKEN (STR_AOD_MANUAL),              value = 1,    flags = 0 | RESET_REQUIRED;
              endoneof;
            endif;

            // Display Condition: AodMemTimingSettingDdr=Enabled,AodMemTimingTrasCtrlDdr=Manual
            suppressif NOT ideqval AOD_CONFIG.AodMemTimingSettingDdr == 1
                    OR NOT ideqval AOD_CONFIG.AodMemTimingTrasCtrlDdr == 1;
              // Tras
              // Specifies the Active to Precharge Delay Time. Valid values: 0x1E ~ 0x7E stepping of 2
              numeric
                varid       = AOD_CONFIG.AodMemTimingTrasDdr,
                prompt      = STRING_TOKEN (STR_AOD_TRAS),
                help        = STRING_TOKEN (STR_AOD_TRAS_HELP),
                flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
                minimum     = 0x1E,
                maximum     = 0x7E,
                step        = 2,
                default     = 30,
              endnumeric;
            endif;

            // Display Condition: AodMemTimingSettingDdr=Enabled
            suppressif NOT ideqval AOD_CONFIG.AodMemTimingSettingDdr == 1;
              // Trc Ctrl
              // Auto: Follow default setting, Manual: Manually specify
              oneof
                varid       = AOD_CONFIG.AodMemTimingTrcCtrlDdr,
                prompt      = STRING_TOKEN (STR_AOD_TRC_CTRL),
                help        = STRING_TOKEN (STR_AOD_TRC_CTRL_HELP),
                option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0,    flags = DEFAULT | RESET_REQUIRED;
                option text = STRING_TOKEN (STR_AOD_MANUAL),              value = 1,    flags = 0 | RESET_REQUIRED;
              endoneof;
            endif;

            // Display Condition: AodMemTimingSettingDdr=Enabled,AodMemTimingTrcCtrlDdr=Manual
            suppressif NOT ideqval AOD_CONFIG.AodMemTimingSettingDdr == 1
                    OR NOT ideqval AOD_CONFIG.AodMemTimingTrcCtrlDdr == 1;
              // Trc
              // Specifies Active to Active/Refresh Delay Time. Valid values: 0x20 ~ 0xFF. The value is in hex.
              numeric
                varid       = AOD_CONFIG.AodMemTimingTrcDdr,
                prompt      = STRING_TOKEN (STR_AOD_TRC),
                help        = STRING_TOKEN (STR_AOD_TRC_HELP),
                flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
                minimum     = 0x20,
                maximum     = 0xFF,
                step        = 0,
                default     = 32,
              endnumeric;
            endif;

            // Display Condition: AodMemTimingSettingDdr=Enabled
            suppressif NOT ideqval AOD_CONFIG.AodMemTimingSettingDdr == 1;
              // Twr Ctrl
              // Auto: Follow default setting, Manual: Manually specify
              oneof
                varid       = AOD_CONFIG.AodMemTimingTwrCtrlDdr,
                prompt      = STRING_TOKEN (STR_AOD_TWR_CTRL),
                help        = STRING_TOKEN (STR_AOD_TWR_CTRL_HELP),
                option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0,    flags = DEFAULT | RESET_REQUIRED;
                option text = STRING_TOKEN (STR_AOD_MANUAL),              value = 1,    flags = 0 | RESET_REQUIRED;
              endoneof;
            endif;

            // Display Condition: AodMemTimingSettingDdr=Enabled,AodMemTimingTwrCtrlDdr=Manual
            suppressif NOT ideqval AOD_CONFIG.AodMemTimingSettingDdr == 1
                    OR NOT ideqval AOD_CONFIG.AodMemTimingTwrCtrlDdr == 1;
              // Twr
              // Specifies the Minimum Write Recovery Time. Valid values: 0x30 ~ 0x60, stepping of 2. The value is in hex.
              numeric
                varid       = AOD_CONFIG.AodMemTimingTwrDdr,
                prompt      = STRING_TOKEN (STR_AOD_TWR),
                help        = STRING_TOKEN (STR_AOD_TWR_HELP),
                flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
                minimum     = 0x30,
                maximum     = 0x60,
                step        = 2,
                default     = 48,
              endnumeric;
            endif;

            // Display Condition: AodMemTimingSettingDdr=Enabled
            suppressif NOT ideqval AOD_CONFIG.AodMemTimingSettingDdr == 1;
              // Trfc1 Ctrl
              // Auto: Follow default setting, Manual: Manually specify
              oneof
                varid       = AOD_CONFIG.AodMemTimingTrfc1CtrlDdr,
                prompt      = STRING_TOKEN (STR_AOD_TRFC1_CTRL),
