              numeric
                varid       = AOD_CONFIG.AodMemTimingTwrwrScDdr,
                prompt      = STRING_TOKEN (STR_AOD_TWRWRSC),
                help        = STRING_TOKEN (STR_AOD_TWRWRSC_HELP),
                flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
                minimum     = 0x1,
                maximum     = 0xF,
                step        = 0,
                default     = 1,
              endnumeric;
            endif;

            // Display Condition: AodMemTimingSettingDdr=Enabled
            suppressif NOT ideqval AOD_CONFIG.AodMemTimingSettingDdr == 1;
              // TwrwrSd Ctrl
              // Auto: Follow default setting, Manual: Manually specify
              oneof
                varid       = AOD_CONFIG.AodMemTimingTwrwrSdCtrlDdr,
                prompt      = STRING_TOKEN (STR_AOD_TWRWRSD_CTRL),
                help        = STRING_TOKEN (STR_AOD_TWRWRSD_CTRL_HELP),
                option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0,    flags = DEFAULT | RESET_REQUIRED;
                option text = STRING_TOKEN (STR_AOD_MANUAL),              value = 1,    flags = 0 | RESET_REQUIRED;
              endoneof;
            endif;

            // Display Condition: AodMemTimingSettingDdr=Enabled,AodMemTimingTwrwrSdCtrlDdr=Manual
            suppressif NOT ideqval AOD_CONFIG.AodMemTimingSettingDdr == 1
                    OR NOT ideqval AOD_CONFIG.AodMemTimingTwrwrSdCtrlDdr == 1;
              // TwrwrSd
              // Specifies the Write to Write turnaround timing in the same DIMM. Valid values: 0x1 ~ 0xF. The value is in hex.
              numeric
                varid       = AOD_CONFIG.AodMemTimingTwrwrSdDdr,
                prompt      = STRING_TOKEN (STR_AOD_TWRWRSD),
                help        = STRING_TOKEN (STR_AOD_TWRWRSD_HELP),
                flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
                minimum     = 0x1,
                maximum     = 0xF,
                step        = 0,
                default     = 3,
              endnumeric;
            endif;

            // Display Condition: AodMemTimingSettingDdr=Enabled
            suppressif NOT ideqval AOD_CONFIG.AodMemTimingSettingDdr == 1;
              // TwrwrDd Ctrl
              // Auto: Follow default setting, Manual: Manually specify
              oneof
                varid       = AOD_CONFIG.AodMemTimingTwrwrDdCtrlDdr,
                prompt      = STRING_TOKEN (STR_AOD_TWRWRDD_CTRL),
                help        = STRING_TOKEN (STR_AOD_TWRWRDD_CTRL_HELP),
                option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0,    flags = DEFAULT | RESET_REQUIRED;
                option text = STRING_TOKEN (STR_AOD_MANUAL),              value = 1,    flags = 0 | RESET_REQUIRED;
              endoneof;
            endif;

            // Display Condition: AodMemTimingSettingDdr=Enabled,AodMemTimingTwrwrDdCtrlDdr=Manual
            suppressif NOT ideqval AOD_CONFIG.AodMemTimingSettingDdr == 1
                    OR NOT ideqval AOD_CONFIG.AodMemTimingTwrwrDdCtrlDdr == 1;
              // TwrwrDd
              // Specifies the Write to Write turnaround timing in a different DIMM. Valid values: 0x1 ~ 0xF. The value is in hex.
              numeric
                varid       = AOD_CONFIG.AodMemTimingTwrwrDdDdr,
                prompt      = STRING_TOKEN (STR_AOD_TWRWRDD),
                help        = STRING_TOKEN (STR_AOD_TWRWRDD_HELP),
                flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
                minimum     = 0x1,
                maximum     = 0xF,
                step        = 0,
                default     = 3,
              endnumeric;
            endif;

            // Display Condition: AodMemTimingSettingDdr=Enabled
            suppressif NOT ideqval AOD_CONFIG.AodMemTimingSettingDdr == 1;
              // Twrrd Ctrl
              // Auto: Follow default setting, Manual: Manually specify
              oneof
                varid       = AOD_CONFIG.AodMemTimingTwrrdCtrlDdr,
                prompt      = STRING_TOKEN (STR_AOD_TWRRD_CTRL),
                help        = STRING_TOKEN (STR_AOD_TWRRD_CTRL_HELP),
                option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0,    flags = DEFAULT | RESET_REQUIRED;
                option text = STRING_TOKEN (STR_AOD_MANUAL),              value = 1,    flags = 0 | RESET_REQUIRED;
              endoneof;
            endif;

            // Display Condition: AodMemTimingSettingDdr=Enabled,AodMemTimingTwrrdCtrlDdr=Manual
            suppressif NOT ideqval AOD_CONFIG.AodMemTimingSettingDdr == 1
                    OR NOT ideqval AOD_CONFIG.AodMemTimingTwrrdCtrlDdr == 1;
              // Twrrd
              // Specifies the Write to Read turnaround timing. Valid values: 0x1 ~ 0xF. The value is in hex.
              numeric
                varid       = AOD_CONFIG.AodMemTimingTwrrdDdr,
                prompt      = STRING_TOKEN (STR_AOD_TWRRD),
                help        = STRING_TOKEN (STR_AOD_TWRRD_HELP),
                flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
                minimum     = 0x1,
                maximum     = 0xF,
                step        = 0,
                default     = 5,
              endnumeric;
            endif;

            // Display Condition: AodMemTimingSettingDdr=Enabled
            suppressif NOT ideqval AOD_CONFIG.AodMemTimingSettingDdr == 1;
              // Trdwr Ctrl
              // Auto: Follow default setting, Manual: Manually specify
              oneof
                varid       = AOD_CONFIG.AodMemTimingTrdwrCtrlDdr,
                prompt      = STRING_TOKEN (STR_AOD_TRDWR_CTRL),
                help        = STRING_TOKEN (STR_AOD_TRDWR_CTRL_HELP),
                option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0,    flags = DEFAULT | RESET_REQUIRED;
                option text = STRING_TOKEN (STR_AOD_MANUAL),              value = 1,    flags = 0 | RESET_REQUIRED;
              endoneof;
            endif;

            // Display Condition: AodMemTimingSettingDdr=Enabled,AodMemTimingTrdwrCtrlDdr=Manual
            suppressif NOT ideqval AOD_CONFIG.AodMemTimingSettingDdr == 1
                    OR NOT ideqval AOD_CONFIG.AodMemTimingTrdwrCtrlDdr == 1;
              // Trdwr
              // Specifies the Read to Write Trunaround Timing. Valid value: 0x1 ~ 0xF. The value is in hex.
              numeric
                varid       = AOD_CONFIG.AodMemTimingTrdwrDdr,
                prompt      = STRING_TOKEN (STR_AOD_TRDWR),
                help        = STRING_TOKEN (STR_AOD_TRDWR_HELP),
                flags       = DISPLAY_UINT_HEX | RESET_REQUIRED,
                minimum     = 0x1,
                maximum     = 0x1F,
                step        = 0,
                default     = 5,
              endnumeric;
            endif;

          endform;
        //
        // form - DDR Bus Configuration
        //
        form

          formid        = SETUP_DDR_BUS_CONFIGURATION_LABLE,

          title         = STRING_TOKEN (STR_AOD_DDR_BUS_CONFIGURATION_SECTION);

          subtitle text = STRING_TOKEN (STR_AOD_DDR_BUS_CONFIGURATION_SECTION);
          subtitle text = STRING_TOKEN (STR_AOD_BLANK);

          // Processor CA drive strengths
          // Select the drive strength for all CA0-13 IOs
          oneof
            varid       = AOD_CONFIG.AodMemDrvStrenCaDdr,
            prompt      = STRING_TOKEN (STR_AOD_PROCESSOR_CA_DRIVE_STRENGTHS),
            help        = STRING_TOKEN (STR_AOD_PROCESSOR_CA_DRIVE_STRENGTHS_HELP),
            option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_120_DOT_0_OHM),       value = 120,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_60_DOT_0_OHM),        value = 60,   flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_40_DOT_0_OHM),        value = 40,   flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_30_DOT_0_OHM),        value = 30,   flags = 0 | RESET_REQUIRED;
          endoneof;

          // Processor DQ drive strengths
          // Select the drive strength for all DQ and DMI IOs
          oneof
            varid       = AOD_CONFIG.AodMemDrvStrenDqDdr,
            prompt      = STRING_TOKEN (STR_AOD_PROCESSOR_DQ_DRIVE_STRENGTHS),
            help        = STRING_TOKEN (STR_AOD_PROCESSOR_DQ_DRIVE_STRENGTHS_HELP),
            option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_HIGH_IMPEDANCE),      value = 0x0,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_240_OHM),             value = 0x2,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_120_OHM),             value = 0x4,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_80_OHM),              value = 0x6,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_60_OHM),              value = 0xC,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_48_OHM),              value = 0xE,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_40_OHM),              value = 0x1C, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_34_DOT_3_OHM),        value = 0x1E, flags = 0 | RESET_REQUIRED;
          endoneof;

          // Processor ODT impedance
          // Specifies the Processor ODT
          oneof
            varid       = AOD_CONFIG.AodMemDataBusCfgProcOdtDdr,
            prompt      = STRING_TOKEN (STR_AOD_PROCESSOR_ODT_IMPEDANCE),
            help        = STRING_TOKEN (STR_AOD_PROCESSOR_ODT_IMPEDANCE_HELP),
            option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_HIGH_IMPEDANCE),      value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_480_OHM),             value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_240_OHM),             value = 2,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_160_OHM),             value = 3,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_120_OHM),             value = 4,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_96_OHM),              value = 5,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_80_OHM),              value = 6,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_68_OHM),              value = 7,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_60_OHM),              value = 0xc,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_53_OHM),              value = 0xd,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_48_OHM),              value = 0xe,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_43_OHM),              value = 0xf,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_40_OHM),              value = 0x1c, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_36_OHM),              value = 0x1d, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_34_OHM),              value = 0x1e, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_32_OHM),              value = 0x1f, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_30_OHM),              value = 0x3c, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_28_DOT_2_OHM),        value = 0x3d, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_26_DOT_7_OHM),        value = 0x3e, flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_25_DOT_3_OHM),        value = 0x3f, flags = 0 | RESET_REQUIRED;
          endoneof;

          // Dram DQ drive strengths
          // Selects the Dram Pull-up and Pull-Down Output Driver Impedance for all DQ and DMI IOs
          oneof
            varid       = AOD_CONFIG.AodMemDramDrvStrenDqDdr,
            prompt      = STRING_TOKEN (STR_AOD_DRAM_DQ_DRIVE_STRENGTHS),
            help        = STRING_TOKEN (STR_AOD_DRAM_DQ_DRIVE_STRENGTHS_HELP),
            option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_48_OHM),              value = 2,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_40_OHM),              value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_34_OHM),              value = 0,    flags = 0 | RESET_REQUIRED;
          endoneof;

          // Dram ODT impedance RTT_NOM_WR
          // Select the DRAMs On-die Termination impedance for RTT_NOM_WR
          oneof
            varid       = AOD_CONFIG.AodMemDramOdtImpedRttNomWrDdr,
            prompt      = STRING_TOKEN (STR_AOD_DRAM_ODT_IMPEDANCE_RTT_NOM_WR),
            help        = STRING_TOKEN (STR_AOD_DRAM_ODT_IMPEDANCE_RTT_NOM_WR_HELP),
            option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RTT_OFF),             value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_240),             value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_2_120),           value = 0x2,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_3_80),            value = 0x3,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_4_60),            value = 0x4,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_5_48),            value = 0x5,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_6_40),            value = 0x6,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_7_34),            value = 0x7,  flags = 0 | RESET_REQUIRED;
          endoneof;

          // Dram ODT impedance RTT_NOM_RD
          // Specifies the RTT_NOM_RD
          oneof
            varid       = AOD_CONFIG.AodMemDramOdtImpedRttNomRdDdr,
            prompt      = STRING_TOKEN (STR_AOD_DRAM_ODT_IMPEDANCE_RTT_NOM_RD),
            help        = STRING_TOKEN (STR_AOD_DRAM_ODT_IMPEDANCE_RTT_NOM_RD_HELP),
            option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0xff, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RTT_OFF),             value = 0x0,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_240),             value = 0x1,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_2_120),           value = 0x2,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_3_80),            value = 0x3,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_4_60),            value = 0x4,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_5_48),            value = 0x5,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_6_40),            value = 0x6,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_7_34),            value = 0x7,  flags = 0 | RESET_REQUIRED;
          endoneof;

          // Dram ODT impedance RTT_WR
          // Select the DRAMs On-die Termination impedance for RTT_WR
          oneof
            varid       = AOD_CONFIG.AodMemDramOdtImpedRttWrDdr,
            prompt      = STRING_TOKEN (STR_AOD_DRAM_ODT_IMPEDANCE_RTT_WR),
            help        = STRING_TOKEN (STR_AOD_DRAM_ODT_IMPEDANCE_RTT_WR_HELP),
            option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RTT_OFF),             value = 0x0,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_240),             value = 0x1,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_2_120),           value = 0x2,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_3_80),            value = 0x3,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_4_60),            value = 0x4,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_5_48),            value = 0x5,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_6_40),            value = 0x6,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_7_34),            value = 0x7,  flags = 0 | RESET_REQUIRED;
          endoneof;

          // Dram ODT impedance RTT_PARK
          // Select the DRAMs On-die Termination impedance for RTT_PARK
          oneof
            varid       = AOD_CONFIG.AodMemDramOdtImpedRttParkDdr,
            prompt      = STRING_TOKEN (STR_AOD_DRAM_ODT_IMPEDANCE_RTT_PARK),
            help        = STRING_TOKEN (STR_AOD_DRAM_ODT_IMPEDANCE_RTT_PARK_HELP),
            option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0xff, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RTT_OFF),             value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_240),             value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_2_120),           value = 2,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_3_80),            value = 3,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_4_60),            value = 4,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_5_48),            value = 0x5,  flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_6_40),            value = 6,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_7_34),            value = 7,    flags = 0 | RESET_REQUIRED;
          endoneof;

          // Dram ODT impedance DQS_RTT_PARK
          // Specifies the RTT_PARK_DQS
          oneof
            varid       = AOD_CONFIG.AodMemDramOdtImpedRttParkDqsDdr,
            prompt      = STRING_TOKEN (STR_AOD_DRAM_ODT_IMPEDANCE_DQS_RTT_PARK),
            help        = STRING_TOKEN (STR_AOD_DRAM_ODT_IMPEDANCE_DQS_RTT_PARK_HELP),
            option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0xff, flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RTT_OFF),             value = 0,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_240),             value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_2_120),           value = 2,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_3_80),            value = 3,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_4_60),            value = 4,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_5_48),            value = 5,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_6_40),            value = 6,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_RZQ_7_34),            value = 7,    flags = 0 | RESET_REQUIRED;
          endoneof;

          endform;
        //
        // form - DDR Controller Configuration
        //
        form

          formid        = SETUP_DDR_CONTROLLER_CONFIGURATION_LABLE,

          title         = STRING_TOKEN (STR_AOD_DDR_CONTROLLER_CONFIGURATION_SECTION);

          subtitle text = STRING_TOKEN (STR_AOD_DDR_CONTROLLER_CONFIGURATION_SECTION);
          subtitle text = STRING_TOKEN (STR_AOD_BLANK);

          goto SETUP_DDR_POWER_OPTIONS_LABLE,
            prompt      = STRING_TOKEN (STR_AOD_DDR_POWER_OPTIONS_SECTION),
            help        = STRING_TOKEN (STR_AOD_DDR_POWER_OPTIONS_SECTION);

        endform;
          //
          // form - DDR Power Options
          //
          form

            formid        = SETUP_DDR_POWER_OPTIONS_LABLE,

            title         = STRING_TOKEN (STR_AOD_DDR_POWER_OPTIONS_SECTION);

            subtitle text = STRING_TOKEN (STR_AOD_DDR_POWER_OPTIONS_SECTION);
            subtitle text = STRING_TOKEN (STR_AOD_BLANK);

            // Power Down Enable
            // Enable or disable DDR power down mode
            oneof
              varid       = AOD_CONFIG.AodMemCtrllerPowerDownEnDdr,
              prompt      = STRING_TOKEN (STR_AOD_POWER_DOWN_ENABLE),
              help        = STRING_TOKEN (STR_AOD_POWER_DOWN_ENABLE_HELP),
              option text = STRING_TOKEN (STR_AOD_DISABLED),            value = 0,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (STR_AOD_ENABLED),             value = 1,    flags = 0 | RESET_REQUIRED;
              option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0xFF, flags = DEFAULT | RESET_REQUIRED;
            endoneof;

          endform;
      //
      // form - Infinity Fabric Frequency and Dividers
      //
      form

        formid        = SETUP_INFINITY_FABRIC_FREQUENCY_AND_DIVIDERS_LABLE,

        title         = STRING_TOKEN (STR_AOD_INFINITY_FABRIC_FREQUENCY_AND_DIVIDERS_SECTION);

        subtitle text = STRING_TOKEN (STR_AOD_INFINITY_FABRIC_FREQUENCY_AND_DIVIDERS_SECTION);
        subtitle text = STRING_TOKEN (STR_AOD_BLANK);

        // Infinity Fabric Frequency and Dividers
        // Set Infinity Fabric frequency (FCLK) Auto: FCLK = MCLK. Manual: FCLK must be less than MCLK for best performance in most cases. Latency penalties are incurred if FCLK and MCLK are mismatched, but sufficiently high MCLK can negate or overcome this penalty.
        oneof
          varid       = AOD_CONFIG.AodFclkFrequency,
          prompt      = STRING_TOKEN (STR_AOD_INFINITY_FABRIC_FREQUENCY_AND_DIVIDERS_1),
          help        = STRING_TOKEN (STR_AOD_INFINITY_FABRIC_FREQUENCY_AND_DIVIDERS_HELP),
          option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0xFFFF, flags = DEFAULT | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_800_MHZ),             value = 800,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_933_MHZ),             value = 933,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_1067_MHZ),            value = 1067, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_1200_MHZ),            value = 1200, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_1333_MHZ),            value = 1333, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_1367_MHZ),            value = 1367, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_1400_MHZ),            value = 1400, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_1433_MHZ),            value = 1433, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_1467_MHZ),            value = 1467, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_1500_MHZ),            value = 1500, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_1533_MHZ),            value = 1533, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_1567_MHZ),            value = 1567, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_1600_MHZ),            value = 1600, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_1633_MHZ),            value = 1633, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_1667_MHZ),            value = 1667, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_1700_MHZ),            value = 1700, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_1733_MHZ),            value = 1733, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_1767_MHZ),            value = 1767, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_1800_MHZ),            value = 1800, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_1833_MHZ),            value = 1833, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_1867_MHZ),            value = 1867, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_1900_MHZ),            value = 1900, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_1933_MHZ),            value = 1933, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_1967_MHZ),            value = 1967, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_2000_MHZ),            value = 2000, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_2033_MHZ),            value = 2033, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_2067_MHZ),            value = 2067, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_2100_MHZ),            value = 2100, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_2133_MHZ),            value = 2133, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_2167_MHZ),            value = 2167, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_2200_MHZ),            value = 2200, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_2233_MHZ),            value = 2233, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_2267_MHZ),            value = 2267, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_2300_MHZ),            value = 2300, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_2333_MHZ),            value = 2333, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_2367_MHZ),            value = 2367, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_2400_MHZ),            value = 2400, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_2433_MHZ),            value = 2433, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_2467_MHZ),            value = 2467, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_2500_MHZ),            value = 2500, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_2550_MHZ),            value = 2550, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_2600_MHZ),            value = 2600, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_2650_MHZ),            value = 2650, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_2700_MHZ),            value = 2700, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_2750_MHZ),            value = 2750, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_2800_MHZ),            value = 2800, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_2850_MHZ),            value = 2850, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_2900_MHZ),            value = 2900, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_2950_MHZ),            value = 2950, flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_3000_MHZ),            value = 3000, flags = 0 | RESET_REQUIRED;
        endoneof;

        // UCLK DIV1 MODE
        // Set UCLK DIV mode
        oneof
          varid       = AOD_CONFIG.AodUclkDiv1Mode,
          prompt      = STRING_TOKEN (STR_AOD_UCLK_DIV1_MODE),
          help        = STRING_TOKEN (STR_AOD_UCLK_DIV1_MODE_HELP),
          option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0xff, flags = DEFAULT | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_UCLK_MEMCLK),         value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_UCLK_MEMCLK_2),       value = 0,    flags = 0 | RESET_REQUIRED;
        endoneof;
      endform;
    //
    // form - Precision Boost Overdrive
    //
    form

      formid        = SETUP_PRECISION_BOOST_OVERDRIVE_LABLE,

      title         = STRING_TOKEN (STR_AOD_PRECISION_BOOST_OVERDRIVE_SECTION);

      subtitle text = STRING_TOKEN (STR_AOD_PRECISION_BOOST_OVERDRIVE_SECTION);
      subtitle text = STRING_TOKEN (STR_AOD_BLANK);

      // Precision Boost Overdrive
      // Precision Boost Overdrive:\n  Enabled: Allows Processor to run beyond defined values for PPT, VDD_CPU EDC, VDD_CPU TDC, VDD_SOC EDC, VDD_SOC TDC to the limits of the board, and allows it to boost at higher voltages for longer durations than default operation.\n
      oneof
        varid       = AOD_CONFIG.AodNbioPBOCtl,
        prompt      = STRING_TOKEN (STR_AOD_PRECISION_BOOST_OVERDRIVE),
        help        = STRING_TOKEN (STR_AOD_PRECISION_BOOST_OVERDRIVE_HELP),
        option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0xff, flags = DEFAULT | RESET_REQUIRED;
        option text = STRING_TOKEN (STR_AOD_DISABLE),             value = 0,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (STR_AOD_ENABLED),             value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (STR_AOD_ADVANCED),            value = 2,    flags = 0 | RESET_REQUIRED;
      endoneof;

      // Display Condition: AodNbioPBOCtl=Advanced
      suppressif NOT ideqval AOD_CONFIG.AodNbioPBOCtl == 2;
        // PBO Limits
        // Default: Loads AMD default socket power (PPT), electrically-limited VRM current (EDC), and thermally-limited VRM current (TDC) limits. Motherboard: Allows the processor to run according to increased PPT, EDC, and TDC limits defined by your motherboard. Manual: Allows the processor to ignore AMD default limits for PPT, EDC, and TDC and instead use manual values (up to the maximum capabilities of the of the motherboard).
        oneof
          varid       = AOD_CONFIG.AodNbioPBOAdvancedCtrl,
          prompt      = STRING_TOKEN (STR_AOD_PBO_LIMITS),
          help        = STRING_TOKEN (STR_AOD_PBO_LIMITS_HELP),
          option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0xff, flags = DEFAULT | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_DISABLE),             value = 0,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_MOTHERBOARD),         value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_MANUAL),              value = 2,    flags = 0 | RESET_REQUIRED;
        endoneof;
      endif;

      // Display Condition: AodNbioPBOCtl=Advanced,AodNbioPBOAdvancedCtrl=Manual
      suppressif NOT ideqval AOD_CONFIG.AodNbioPBOCtl == 2
              OR NOT ideqval AOD_CONFIG.AodNbioPBOAdvancedCtrl == 2;
        // PPT Limit [mW]
        // Adjust total CPU socket power delivery capability. Adjustable up to the limit supported by your motherboard.
        numeric
          varid       = AOD_CONFIG.AodNbioSocketPPTLimit,
          prompt      = STRING_TOKEN (STR_AOD_PPT_LIMIT_MW),
          help        = STRING_TOKEN (STR_AOD_PPT_LIMIT_MW_HELP),
          flags       = RESET_REQUIRED,
          minimum     = 0,
          maximum     = 0xffffffff,
          step        = 0,
          default     = 0,
        endnumeric;
      endif;

      // Display Condition: AodNbioPBOCtl=Advanced,AodNbioPBOAdvancedCtrl=Manual
      suppressif NOT ideqval AOD_CONFIG.AodNbioPBOCtl == 2
              OR NOT ideqval AOD_CONFIG.AodNbioPBOAdvancedCtrl == 2;
        // TDC Limit [mA]
        // Adjust peak current from your motherboard's CPU core VRM phases in thermally-limited scenarios. Adjustable up to the limit supported by your motherboard.
        numeric
          varid       = AOD_CONFIG.AodNbioTDCVDDLimit,
          prompt      = STRING_TOKEN (STR_AOD_TDC_LIMIT_MA),
          help        = STRING_TOKEN (STR_AOD_TDC_LIMIT_MA_HELP),
          flags       = RESET_REQUIRED,
          minimum     = 0,
          maximum     = 0xffffffff,
          step        = 0,
          default     = 0,
        endnumeric;
      endif;

      // Display Condition: AodNbioPBOCtl=Advanced,AodNbioPBOAdvancedCtrl=Manual
      suppressif NOT ideqval AOD_CONFIG.AodNbioPBOCtl == 2
              OR NOT ideqval AOD_CONFIG.AodNbioPBOAdvancedCtrl == 2;
        // EDC Limit [mA]
        // Adjust peak current from your motherboard CPU core VRM phases in electrically-limited scenarios. Adjustable up to the limit supported by your motherboard.
        numeric
          varid       = AOD_CONFIG.AodNbioEDCVDDLimit,
          prompt      = STRING_TOKEN (STR_AOD_EDC_LIMIT_MA),
          help        = STRING_TOKEN (STR_AOD_EDC_LIMIT_MA_HELP),
          flags       = RESET_REQUIRED,
          minimum     = 0,
          maximum     = 0xffffffff,
          step        = 0,
          default     = 0,
        endnumeric;
      endif;

      // Display Condition: AodNbioPBOCtl=Advanced,AodNbioPBOAdvancedCtrl=Manual
      suppressif NOT ideqval AOD_CONFIG.AodNbioPBOCtl == 2
              OR NOT ideqval AOD_CONFIG.AodNbioPBOAdvancedCtrl == 2;
        // SOC TDC Limit [mA]
        // Adjust peak current from your motherboard SoC/Uncore VRM phases in thermally-limited scenarios. Adjustable up to the limit supported by your motherboard.
        numeric
          varid       = AOD_CONFIG.AodNbioTDCSOCLimit,
          prompt      = STRING_TOKEN (STR_AOD_SOC_TDC_LIMIT_MA),
          help        = STRING_TOKEN (STR_AOD_SOC_TDC_LIMIT_MA_HELP),
          flags       = RESET_REQUIRED,
          minimum     = 0,
          maximum     = 0xffffffff,
          step        = 0,
          default     = 0,
        endnumeric;
      endif;

      // Display Condition: AodNbioPBOCtl=Advanced,AodNbioPBOAdvancedCtrl=Manual
      suppressif NOT ideqval AOD_CONFIG.AodNbioPBOCtl == 2
              OR NOT ideqval AOD_CONFIG.AodNbioPBOAdvancedCtrl == 2;
        // SOC EDC Limit [mA]
        // Adjust peak current from your motherboard's SoC/uncore VRM phases in electrically-limited scenarios. Adjustable up to the limit supported by your motherboard.
        numeric
          varid       = AOD_CONFIG.AodNbioEDCSOCLimit,
          prompt      = STRING_TOKEN (STR_AOD_SOC_EDC_LIMIT_MA),
          help        = STRING_TOKEN (STR_AOD_SOC_EDC_LIMIT_MA_HELP),
          flags       = RESET_REQUIRED,
          minimum     = 0,
          maximum     = 0xffffffff,
          step        = 0,
          default     = 0,
        endnumeric;
      endif;

      // Display Condition: AodNbioPBOCtl=Advanced,PBOAdvancedOverClocking=1
      suppressif NOT ideqval AOD_CONFIG.AodNbioPBOCtl == 2
              OR NOT ideqval AOD_CONFIG.Header.PBOAdvancedOverClocking == 1;
        // Precision Boost Overdrive Scalar Ctrl
        oneof
          varid       = AOD_CONFIG.AodNbioPBOScalarCtl,
          prompt      = STRING_TOKEN (STR_AOD_PRECISION_BOOST_OVERDRIVE_SCALAR_CTRL),
          help        = STRING_TOKEN (STR_AOD_PRECISION_BOOST_OVERDRIVE_SCALAR_CTRL_HELP),
          option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0xff, flags = DEFAULT | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_MANUAL),              value = 1,    flags = 0 | RESET_REQUIRED;
        endoneof;
      endif;

      // Display Condition: AodNbioPBOCtl=Advanced,AodNbioPBOScalarCtl=Manual,PBOAdvancedOverClocking=1
      suppressif NOT ideqval AOD_CONFIG.AodNbioPBOCtl == 2
              OR NOT ideqval AOD_CONFIG.AodNbioPBOScalarCtl == 1
              OR NOT ideqval AOD_CONFIG.Header.PBOAdvancedOverClocking == 1;
        // Precision Boost Overdrive Scalar
        // Overrides the AMD default silicon health management to potentially achieve higher sustained frequencies under CPU load.
        oneof
          varid       = AOD_CONFIG.AodNbioPBOScalar,
          prompt      = STRING_TOKEN (STR_AOD_PRECISION_BOOST_OVERDRIVE_SCALAR),
          help        = STRING_TOKEN (STR_AOD_PRECISION_BOOST_OVERDRIVE_SCALAR_HELP),
          option text = STRING_TOKEN (STR_AOD_1X),                  value = 100,  flags = DEFAULT | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_2X),                  value = 200,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_3X),                  value = 300,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_4X),                  value = 400,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_5X),                  value = 500,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_6X),                  value = 600,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_7X),                  value = 700,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_8X),                  value = 800,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_9X),                  value = 900,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_10X),                 value = 1000, flags = 0 | RESET_REQUIRED;
        endoneof;
      endif;

      // Display Condition: AodNbioPBOCtl=Advanced,PBOAdvancedOverClocking=1
      suppressif NOT ideqval AOD_CONFIG.AodNbioPBOCtl == 2
              OR NOT ideqval AOD_CONFIG.Header.PBOAdvancedOverClocking == 1;
        goto SETUP_CURVE_OPTIMIZER_LABLE,
          prompt      = STRING_TOKEN (STR_AOD_CURVE_OPTIMIZER_SECTION),
          help        = STRING_TOKEN (STR_AOD_CURVE_OPTIMIZER_SECTION);
      endif;

      // Display Condition: AodNbioPBOCtl=Advanced,PBOAdvancedOverClocking=1
      suppressif NOT ideqval AOD_CONFIG.AodNbioPBOCtl == 2
              OR NOT ideqval AOD_CONFIG.Header.PBOAdvancedOverClocking == 1;
        goto SETUP_GFX_CURVE_OPTIMIZER_LABLE,
          prompt      = STRING_TOKEN (STR_AOD_GFX_CURVE_OPTIMIZER_SECTION),
          help        = STRING_TOKEN (STR_AOD_GFX_CURVE_OPTIMIZER_SECTION);
      endif;

      // Display Condition: AodNbioPBOCtl=Advanced,PBOAdvancedOverClocking=1
      suppressif NOT ideqval AOD_CONFIG.AodNbioPBOCtl == 2
              OR NOT ideqval AOD_CONFIG.Header.PBOAdvancedOverClocking == 1;
        // CPU Boost Clock Override
        // Increases (Positive) or Decreases (Negative) the maximum CPU frequency that may be automatically achieved by the CPU Boost Algorithm
        oneof
          varid       = AOD_CONFIG.AodCpuBoostClock,
          prompt      = STRING_TOKEN (STR_AOD_CPU_BOOST_CLOCK_OVERRIDE),
          help        = STRING_TOKEN (STR_AOD_CPU_BOOST_CLOCK_OVERRIDE_HELP),
          option text = STRING_TOKEN (STR_AOD_DISABLED),            value = 0,    flags = DEFAULT | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_ENABLED_POSITIVE),    value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_ENABLED_NEGATIVE),    value = 2,    flags = 0 | RESET_REQUIRED;
        endoneof;
      endif;

      // Display Condition: AodNbioPBOCtl=Advanced,AodCpuBoostClock=Enabled (Positive),PBOAdvancedOverClocking=1
      suppressif NOT ideqval AOD_CONFIG.AodNbioPBOCtl == 2
              OR NOT ideqval AOD_CONFIG.AodCpuBoostClock == 1
              OR NOT ideqval AOD_CONFIG.Header.PBOAdvancedOverClocking == 1;
        // Max CPU Boost Clock Override(+)
        // Increases the maximum CPU frequency that may be automatically achieved by the Precision Boost 2 algorithm.
        numeric
          varid       = AOD_CONFIG.AodFMaxFreqIncrease,
          prompt      = STRING_TOKEN (STR_AOD_MAX_CPU_BOOST_CLOCK_OVERRIDE),
          help        = STRING_TOKEN (STR_AOD_MAX_CPU_BOOST_CLOCK_OVERRIDE_HELP),
          flags       = RESET_REQUIRED,
          minimum     = 25,
          maximum     = 200,
          step        = 25,
          default     = 25,
        endnumeric;
      endif;

      // Display Condition: AodNbioPBOCtl=Advanced,AodCpuBoostClock=Enabled (Negative),PBOAdvancedOverClocking=1
      suppressif NOT ideqval AOD_CONFIG.AodNbioPBOCtl == 2
              OR NOT ideqval AOD_CONFIG.AodCpuBoostClock == 2
              OR NOT ideqval AOD_CONFIG.Header.PBOAdvancedOverClocking == 1;
        // Max CPU Boost Clock Override(-)
        // Decreases the maximum CPU frequency that may be automatically achieved by the Precision Boost 2 algorithm.
        numeric
          varid       = AOD_CONFIG.AodFMaxFreqDecrease,
          prompt      = STRING_TOKEN (STR_AOD_MAX_CPU_BOOST_CLOCK_OVERRIDE_1),
          help        = STRING_TOKEN (STR_AOD_MAX_CPU_BOOST_CLOCK_OVERRIDE_HELP),
          flags       = RESET_REQUIRED,
          minimum     = 25,
          maximum     = 1000,
          step        = 25,
          default     = 25,
        endnumeric;
      endif;

      // Display Condition: AodNbioPBOCtl=Advanced,PBOAdvancedOverClocking=1
      suppressif NOT ideqval AOD_CONFIG.AodNbioPBOCtl == 2
              OR NOT ideqval AOD_CONFIG.Header.PBOAdvancedOverClocking == 1;
        // GPU Boost Clock Override
        // Increases the maximum GPU frequency that may be automatically achieved by the GPU boost algorithm
        oneof
          varid       = AOD_CONFIG.AodGpuBoostClock,
          prompt      = STRING_TOKEN (STR_AOD_GPU_BOOST_CLOCK_OVERRIDE),
          help        = STRING_TOKEN (STR_AOD_GPU_BOOST_CLOCK_OVERRIDE_HELP),
          option text = STRING_TOKEN (STR_AOD_ENABLED),             value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_DISABLED),            value = 0,    flags = DEFAULT | RESET_REQUIRED;
        endoneof;
      endif;

      // Display Condition: AodNbioPBOCtl=Advanced,AodGpuBoostClock=Enabled,PBOAdvancedOverClocking=1
      suppressif NOT ideqval AOD_CONFIG.AodNbioPBOCtl == 2
              OR NOT ideqval AOD_CONFIG.AodGpuBoostClock == 1
              OR NOT ideqval AOD_CONFIG.Header.PBOAdvancedOverClocking == 1;
        // Max GPU Boost Clock Override
        // Increases the maximum GPU frequency that may be automatically achieved by the GPU boost algorithm.
        oneof
          varid       = AOD_CONFIG.AodGfxFMaxFreq,
          prompt      = STRING_TOKEN (STR_AOD_MAX_GPU_BOOST_CLOCK_OVERRIDE),
          help        = STRING_TOKEN (STR_AOD_MAX_GPU_BOOST_CLOCK_OVERRIDE_HELP),
          option text = STRING_TOKEN (STR_AOD_0_MHZ),               value = 0,    flags = DEFAULT | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_25_MHZ),              value = 25,   flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_50_MHZ),              value = 50,   flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_75_MHZ),              value = 75,   flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_100_MHZ),             value = 100,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_125_MHZ),             value = 125,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_150_MHZ),             value = 150,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_175_MHZ),             value = 175,  flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_200_MHZ),             value = 200,  flags = 0 | RESET_REQUIRED;
        endoneof;
      endif;

      // Display Condition: AodNbioPBOCtl=Advanced
      suppressif NOT ideqval AOD_CONFIG.AodNbioPBOCtl == 2;
        // Platform Thermal Throttle Ctrl
        // Allows the user to decrease the maximum allowed processor temperature (celsius).
        oneof
          varid       = AOD_CONFIG.AodNbiocHTCCtl,
          prompt      = STRING_TOKEN (STR_AOD_PLATFORM_THERMAL_THROTTLE_CTRL),
          help        = STRING_TOKEN (STR_AOD_PLATFORM_THERMAL_THROTTLE_CTRL_HELP),
          option text = STRING_TOKEN (STR_AOD_MANUAL),              value = 1,    flags = 0 | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0,    flags = DEFAULT | RESET_REQUIRED;
        endoneof;
      endif;

      // Display Condition: AodNbioPBOCtl=Advanced,AodNbiocHTCCtl=Manual
      suppressif NOT ideqval AOD_CONFIG.AodNbioPBOCtl == 2
              OR NOT ideqval AOD_CONFIG.AodNbiocHTCCtl == 1;
        // Platform Thermal Throttle Limit
        // Allows the user to decrease the maximum allowed processor temperature (celsius).
        numeric
          varid       = AOD_CONFIG.AodNbiocHTC,
          prompt      = STRING_TOKEN (STR_AOD_PLATFORM_THERMAL_THROTTLE_LIMIT),
          help        = STRING_TOKEN (STR_AOD_PLATFORM_THERMAL_THROTTLE_LIMIT_HELP),
          flags       = RESET_REQUIRED,
          minimum     = 0,
          maximum     = 0xff,
          step        = 0,
          default     = 0,
        endnumeric;
      endif;

    endform;
      //
      // form - Curve Optimizer
      //
      form

        formid        = SETUP_CURVE_OPTIMIZER_LABLE,

        title         = STRING_TOKEN (STR_AOD_CURVE_OPTIMIZER_SECTION);

        subtitle text = STRING_TOKEN (STR_AOD_CURVE_OPTIMIZER_SECTION);
        subtitle text = STRING_TOKEN (STR_AOD_BLANK);

        // Display Condition: AodNbioPBOCtl=Advanced
        suppressif NOT ideqval AOD_CONFIG.AodNbioPBOCtl == 2;
          // Curve Optimizer
          // Allows the user to shift the Voltage / Frequency (AVFS) curve to include higher voltages (positive values) or lower voltages (negative values). The larger the value entered the larger the magnitude of the voltage shift
          oneof
            varid       = AOD_CONFIG.AodCurveOptimizer,
            prompt      = STRING_TOKEN (STR_AOD_CURVE_OPTIMIZER_1),
            help        = STRING_TOKEN (STR_AOD_CURVE_OPTIMIZER_HELP),
            option text = STRING_TOKEN (STR_AOD_DISABLE),             value = 0,    flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_ALL_CORES),           value = 1,    flags = 0 | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_PER_CORE),            value = 2,    flags = 0 | RESET_REQUIRED;
          endoneof;
        endif;

        // Display Condition: AodNbioPBOCtl=Advanced,AodCurveOptimizer=All Cores
        suppressif NOT ideqval AOD_CONFIG.AodNbioPBOCtl == 2
                OR NOT ideqval AOD_CONFIG.AodCurveOptimizer == 1;
          // All Core Curve Optimizer Sign
          // Determines the direction of the curve shift on all cores. Positive shifts the curve up to use higher voltages. Negative shifts the curve down to use lower voltages
          oneof
            varid       = AOD_CONFIG.AodAllCoreCurveOptimizerSign,
            prompt      = STRING_TOKEN (STR_AOD_ALL_CORE_CURVE_OPTIMIZER_SIGN),
            help        = STRING_TOKEN (STR_AOD_ALL_CORE_CURVE_OPTIMIZER_SIGN_HELP),
            option text = STRING_TOKEN (STR_AOD_POSITIVE),            value = 0,    flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_NEGATIVE),            value = 1,    flags = 0 | RESET_REQUIRED;
          endoneof;
        endif;

        // Display Condition: AodNbioPBOCtl=Advanced,AodCurveOptimizer=All Cores
        suppressif NOT ideqval AOD_CONFIG.AodNbioPBOCtl == 2
                OR NOT ideqval AOD_CONFIG.AodCurveOptimizer == 1;
          // All Core Curve Optimizer Magnitude
          // Determines the magnitude of the curve shift to be made (entered in whole numbers) the larger the value entered the larger the magnitude of the shift
          numeric
            varid       = AOD_CONFIG.AodAllCoreCurveOptimizerMagnitude,
            prompt      = STRING_TOKEN (STR_AOD_ALL_CORE_CURVE_OPTIMIZER_MAGNITUDE),
            help        = STRING_TOKEN (STR_AOD_ALL_CORE_CURVE_OPTIMIZER_MAGNITUDE_HELP),
            flags       = RESET_REQUIRED,
            minimum     = 0,
            maximum     = 0x1E,
            step        = 0,
            default     = 0,
          endnumeric;
        endif;

        // Display Condition: AodNbioPBOCtl=Advanced,AodCurveOptimizer=Per Core
        suppressif NOT ideqval AOD_CONFIG.AodNbioPBOCtl == 2
                OR NOT ideqval AOD_CONFIG.AodCurveOptimizer == 2;
          label LABEL_CBS_AOD_PER_CORE_CURVE_OPTIMIZER_DYNAMIC_START;
          // Per Core Curve Optimizer Dynamic
          // No help string
          label LABEL_CBS_AOD_PER_CORE_CURVE_OPTIMIZER_DYNAMIC_END;
        endif;

      endform;
      //
      // form - GFX Curve Optimizer
      //
      form

        formid        = SETUP_GFX_CURVE_OPTIMIZER_LABLE,

        title         = STRING_TOKEN (STR_AOD_GFX_CURVE_OPTIMIZER_SECTION);

        subtitle text = STRING_TOKEN (STR_AOD_GFX_CURVE_OPTIMIZER_SECTION);
        subtitle text = STRING_TOKEN (STR_AOD_BLANK);

        // Display Condition: AodNbioPBOCtl=Advanced
        suppressif NOT ideqval AOD_CONFIG.AodNbioPBOCtl == 2;
          // GFX Curve Optimizer
          // Allows the user to shift the GFX Voltage / Frequency (AVFS) curve to include higher voltages (positive values) or lower voltages (negative values). The larger the value entered the larger the magnitude of the voltage shift.
          oneof
            varid       = AOD_CONFIG.AodGfxCurveOptimizer,
            prompt      = STRING_TOKEN (STR_AOD_GFX_CURVE_OPTIMIZER_1),
            help        = STRING_TOKEN (STR_AOD_GFX_CURVE_OPTIMIZER_HELP),
            option text = STRING_TOKEN (STR_AOD_DISABLE),             value = 0,    flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_GFX_CURVE_OPTIMIZER), value = 1,    flags = 0 | RESET_REQUIRED;
          endoneof;
        endif;

        // Display Condition: AodNbioPBOCtl=Advanced,AodGfxCurveOptimizer=GFX Curve Optimizer
        suppressif NOT ideqval AOD_CONFIG.AodNbioPBOCtl == 2
                OR NOT ideqval AOD_CONFIG.AodGfxCurveOptimizer == 1;
          // GFX Curve Optimizer Sign
          // Determines the direction of the curve shift for GFX. Positive shifts the curve up to use higher voltages. Negative shifts the curve down to use lower voltages
          oneof
            varid       = AOD_CONFIG.AodGfxCurveOptimizerSign,
            prompt      = STRING_TOKEN (STR_AOD_GFX_CURVE_OPTIMIZER_SIGN),
            help        = STRING_TOKEN (STR_AOD_GFX_CURVE_OPTIMIZER_SIGN_HELP),
            option text = STRING_TOKEN (STR_AOD_POSITIVE),            value = 0,    flags = DEFAULT | RESET_REQUIRED;
            option text = STRING_TOKEN (STR_AOD_NEGATIVE),            value = 1,    flags = 0 | RESET_REQUIRED;
          endoneof;
        endif;

        // Display Condition: AodNbioPBOCtl=Advanced,AodGfxCurveOptimizer=GFX Curve Optimizer
        suppressif NOT ideqval AOD_CONFIG.AodNbioPBOCtl == 2
                OR NOT ideqval AOD_CONFIG.AodGfxCurveOptimizer == 1;
          // GFX Curve Optimizer Magnitude
          // Determines the magnitude of the GFX curve shift to be made (entered in whole numbers) the larger the value entered the larger the magnitude of the shift.Field Defaults to 0 and is user enterable in whole integer numbers. Value entered, combined with the sign above, is the used to send the SMU an GFX Curve Optimizer offset messages.
          numeric
            varid       = AOD_CONFIG.AodGfxCurveOptimizerMagnitude,
            prompt      = STRING_TOKEN (STR_AOD_GFX_CURVE_OPTIMIZER_MAGNITUDE),
            help        = STRING_TOKEN (STR_AOD_GFX_CURVE_OPTIMIZER_MAGNITUDE_HELP),
            flags       = RESET_REQUIRED,
            minimum     = 0,
            maximum     = 0x1E,
            step        = 0,
            default     = 0,
          endnumeric;
        endif;

      endform;
    //
    // form - SoC/Uncore OC Mode
    //
    form

      formid        = SETUP_SOC_UNCORE_OC_MODE_LABLE,

      title         = STRING_TOKEN (STR_AOD_SOC_UNCORE_OC_MODE_SECTION);

      subtitle text = STRING_TOKEN (STR_AOD_SOC_UNCORE_OC_MODE_SECTION);
      subtitle text = STRING_TOKEN (STR_AOD_BLANK);

      // SoC/Uncore OC Mode
      // Forces CPU SoC/uncore components (e.g. Infinity Fabric, memory, and integrated graphics) to run at their maximum specified frequency at all times. May improve performance at the expense of idle power savings
      oneof
        varid       = AOD_CONFIG.AodGnbFclkOcFlag,
        prompt      = STRING_TOKEN (STR_AOD_SOC_UNCORE_OC_MODE),
        help        = STRING_TOKEN (STR_AOD_SOC_UNCORE_OC_MODE_HELP),
        option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0xff, flags = DEFAULT | RESET_REQUIRED;
        option text = STRING_TOKEN (STR_AOD_ENABLED),             value = 1,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (STR_AOD_DISABLED),            value = 0,    flags = 0 | RESET_REQUIRED;
      endoneof;

    endform;
    //
    // form - SoC Voltage
    //
    form

      formid        = SETUP_SOC_VOLTAGE_LABLE,

      title         = STRING_TOKEN (STR_AOD_SOC_VOLTAGE_SECTION);

      subtitle text = STRING_TOKEN (STR_AOD_SOC_VOLTAGE_SECTION);
      subtitle text = STRING_TOKEN (STR_AOD_BLANK);

      // Soc Voltage Help Text
      // Specifies the SoC/uncore voltage (VDD_SOC) in mV to support memory and Infinity Fabric overclocking. VDD_SOC also determines the GPU voltage on processors with integrated graphics. \nThis voltage only can change when one of below items'SoC/Uncore OC Mode' 'UCLK','Active Memory Timing Settings,'Infinity Fabric Frequency and Dividers'' changed
      subtitle text = STRING_TOKEN (STR_AOD_SOC_VOLTAGE_HELP_TEXT_HELP);
      subtitle text = STRING_TOKEN (STR_AOD_BLANK);
      // Active Condition: AodGnbFclkOcFlag=Enabled|AodMemTimingSettingDdr=Enabled|AodUclkDiv1Mode!=Auto|AodFclkFrequency!=Auto
      grayoutif NOT ideqval AOD_CONFIG.AodGnbFclkOcFlag == 1
            AND NOT ideqval AOD_CONFIG.AodMemTimingSettingDdr == 1
            AND ideqval AOD_CONFIG.AodUclkDiv1Mode == 0xff
            AND ideqval AOD_CONFIG.AodFclkFrequency == 0xFFFF;
        // SoC Voltage
        // Specifies the SoC/uncore voltage (VDD_SOC) in mV to support memory and Infinity Fabric overclocking. VDD_SOC also determines the GPU voltage on processors with integrated graphics. 'SoC/Uncore OC Mode' needs to be enabled to force this voltage.
        numeric
          varid       = AOD_CONFIG.AodSocOverclockingVoltage,
          prompt      = STRING_TOKEN (STR_AOD_SOC_VOLTAGE),
          help        = STRING_TOKEN (STR_AOD_SOC_VOLTAGE_HELP),
          flags       = RESET_REQUIRED,
          minimum     = 0,
          maximum     = 2800,
          step        = 0,
          default     = 0,
        endnumeric;
      endif;

    endform;
    //
    // form - LN2 Mode
    //
    form

      formid        = SETUP_LN2_MODE_LABLE,

      title         = STRING_TOKEN (STR_AOD_LN2_MODE_SECTION);

      subtitle text = STRING_TOKEN (STR_AOD_LN2_MODE_SECTION);
      subtitle text = STRING_TOKEN (STR_AOD_BLANK);

      // LN2 Mode
      // Enables settings that provide additional stability at extreme cold operating temperatures
      oneof
        varid       = AOD_CONFIG.AodLN2Mode,
        prompt      = STRING_TOKEN (STR_AOD_LN2_MODE),
        help        = STRING_TOKEN (STR_AOD_LN2_MODE_HELP),
        option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0xff, flags = DEFAULT | RESET_REQUIRED;
        option text = STRING_TOKEN (STR_AOD_DISABLED),            value = 0,    flags = 0 | RESET_REQUIRED;
        option text = STRING_TOKEN (STR_AOD_ENABLED),             value = 1,    flags = 0 | RESET_REQUIRED;
      endoneof;

    endform;
    //
    // form - Onboard Voltage Control
    //
    form

      formid        = SETUP_ONBOARD_VOLTAGE_CONTROL_LABLE,

      title         = STRING_TOKEN (STR_AOD_ONBOARD_VOLTAGE_CONTROL_SECTION);

      subtitle text = STRING_TOKEN (STR_AOD_ONBOARD_VOLTAGE_CONTROL_SECTION);
      subtitle text = STRING_TOKEN (STR_AOD_BLANK);

      goto SETUP_VDDIO_VOLTAGE_CONTROL_LABLE,
        prompt      = STRING_TOKEN (STR_AOD_VDDIO_VOLTAGE_CONTROL_SECTION),
        help        = STRING_TOKEN (STR_AOD_VDDIO_VOLTAGE_CONTROL_SECTION);

      goto SETUP_VPP_VOLTAGE_CONTROL_LABLE,
        prompt      = STRING_TOKEN (STR_AOD_VPP_VOLTAGE_CONTROL_SECTION),
        help        = STRING_TOKEN (STR_AOD_VPP_VOLTAGE_CONTROL_SECTION);

      // Display Condition: AodComboFlag=2
      suppressif NOT ideqval AOD_CONFIG.Header.AodComboFlag == 2;
        goto SETUP_VDD_MEM_VOLTAGE_CONTROL_LABLE,
          prompt      = STRING_TOKEN (STR_AOD_VDD_MEM_VOLTAGE_CONTROL_SECTION),
          help        = STRING_TOKEN (STR_AOD_VDD_MEM_VOLTAGE_CONTROL_SECTION);
      endif;
    endform;
      //
      // form - VDDIO Voltage Control
      //
      form

        formid        = SETUP_VDDIO_VOLTAGE_CONTROL_LABLE,

        title         = STRING_TOKEN (STR_AOD_VDDIO_VOLTAGE_CONTROL_SECTION);

        subtitle text = STRING_TOKEN (STR_AOD_VDDIO_VOLTAGE_CONTROL_SECTION);
        subtitle text = STRING_TOKEN (STR_AOD_BLANK);

        // Current DIMM VDD Voltage
        text
          help        = STRING_TOKEN(STR_AOD_BLANK),
          text        = STRING_TOKEN(STR_AOD_CURRENT_VDD_VOLTAGE_STRING),
          text        = STRING_TOKEN(STR_AOD_CURRENT_VDD_VOLTAGE),
          flags       = 0,
          key         = 0;

        // Current DIMM VDDQ Voltage
        text
          help        = STRING_TOKEN(STR_AOD_BLANK),
          text        = STRING_TOKEN(STR_AOD_CURRENT_VDDQ_VOLTAGE_STRING),
          text        = STRING_TOKEN(STR_AOD_CURRENT_VDDQ_VOLTAGE),
          flags       = 0,
          key         = 0;

        // Current APU VDDIO Value (mV)
        text
          help        = STRING_TOKEN(STR_AOD_BLANK),
          text        = STRING_TOKEN(STR_AOD_CURRENT_APU_VDDIO_VOLTAGE_STRING),
          text        = STRING_TOKEN(STR_AOD_CURRENT_APU_VDDIO_VOLTAGE),
          flags       = 0,
          key         = 0;



      // VDDIO Ctrl
      // Allows the user to adjust the VDDIO voltage."Manual" means control both of APU VDDIO and DIMM VDDIO. "Separate" means  independent control of APU/DIMM VDDIO.
      oneof
        varid       = AOD_CONFIG.AodVddIoCtrl,
        questionid  = KEY_AOD_VDDIO_CTRL,
        prompt      = STRING_TOKEN (STR_AOD_VDDIO_CTRL),
        help        = STRING_TOKEN (STR_AOD_VDDIO_CTRL_HELP),
        option text = STRING_TOKEN (STR_AOD_AUTO),          value = 0,    flags = DEFAULT | INTERACTIVE |RESET_REQUIRED;
        option text = STRING_TOKEN (STR_AOD_MANUAL),        value = 1,    flags = 0 | INTERACTIVE | RESET_REQUIRED;
        option text = STRING_TOKEN (STR_AOD_SEPARATE),      value = 2,    flags = 0 | INTERACTIVE | RESET_REQUIRED;
      endoneof;

      // Display Condition: AodVddIoCtrl=Manual|AodVddIoCtrl=Separate
      suppressif NOT ideqval AOD_CONFIG.AodVddIoCtrl == 1
             AND NOT ideqval AOD_CONFIG.AodVddIoCtrl == 2;
        // VDDIO Adjust
        // Adjust MEM VDDIO, stepping is 10mV. Range is from 800mV to 1435mV
        numeric
          varid       = AOD_CONFIG.AodDimmVdd,
          questionid  = KEY_AOD_DIMM_VDDIO,
          prompt      = STRING_TOKEN (STR_AOD_DIMM_VDD_ADJUST),
          help        = STRING_TOKEN (STR_AOD_DIMM_VDD_ADJUST_HELP),
          flags       = RESET_REQUIRED | INTERACTIVE,
          minimum     = 800,
          maximum     = 1430,
          step        = 10,
          default     = 1100,
        endnumeric;
      endif;
        // Display Condition: AodVddIoCtrl=Separate
        suppressif NOT ideqval AOD_CONFIG.AodVddIoCtrl == 2;
          // DIMM VDDQ Adjust
          // Adjust DIMM DQ Power Supply, stepping is 10mV. Range is from 800mV to 1430mV
          numeric
            varid       = AOD_CONFIG.AodDimmVddq,
            prompt      = STRING_TOKEN (STR_AOD_DIMM_VDDQ_ADJUST),
            help        = STRING_TOKEN (STR_AOD_DIMM_VDDQ_ADJUST_HELP),
            flags       = RESET_REQUIRED,
            minimum     = 800,
            maximum     = 1430,
            step        = 0,
            default     = 1100,
          endnumeric;
        endif;
      // Display Condition: AodVddIoCtrl=Separate
      suppressif NOT ideqval AOD_CONFIG.AodVddIoCtrl == 2;
        label LABEL_CBS_AOD_APU_VDD_IO_DYNAMIC_START;
        // APU VDDIO Adjust
        // No help string
        label LABEL_CBS_AOD_APU_VDD_IO_DYNAMIC_END;
      endif;

      endform;
      //
      // form - VPP Voltage Control
      //
      form

        formid        = SETUP_VPP_VOLTAGE_CONTROL_LABLE,

        title         = STRING_TOKEN (STR_AOD_VPP_VOLTAGE_CONTROL_SECTION);

        subtitle text = STRING_TOKEN (STR_AOD_VPP_VOLTAGE_CONTROL_SECTION);
        subtitle text = STRING_TOKEN (STR_AOD_BLANK);

        // Current  VPP Voltage
        text
          help        = STRING_TOKEN(STR_AOD_BLANK),
          text        = STRING_TOKEN(STR_AOD_CURRENT_VPP_VOLTAGE_STRING),
          text        = STRING_TOKEN(STR_AOD_CURRENT_VPP_VOLTAGE),
          flags       = 0,
          key         = 0;

        // VPP Ctrl
        // No help string
        oneof
          varid       = AOD_CONFIG.AodVppCtrl,
          prompt      = STRING_TOKEN (STR_AOD_VPP_CTRL),
          help        = STRING_TOKEN (STR_AOD_VPP_CTRL_HELP),
          option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0,    flags = DEFAULT | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_MANUAL),              value = 1,    flags = 0 | RESET_REQUIRED;
        endoneof;
      // Display Condition: AodVddIoCtrl=Manual|AodVddIoCtrl=Separate
      // VPP Adjust
      // Adjust MEM VPP, stepping is 10mV. Range is from 1500mV to 2135mV
    suppressif NOT ideqval AOD_CONFIG.AodVppCtrl == 1;
      numeric
        varid       = AOD_CONFIG.AodVppVoltage,
        prompt      = STRING_TOKEN (STR_AOD_VPP_ADJUST),
        help        = STRING_TOKEN (STR_AOD_VPP_ADJUST_HELP),
        flags       = RESET_REQUIRED,
        minimum     = 1500,
        maximum     = 2130,
        step        = 10,
        default     = 1800,
      endnumeric;
    endif;


      endform;

      //
      // form - VDD_MEM Voltage Control
      //
      form

        formid        = SETUP_VDD_MEM_VOLTAGE_CONTROL_LABLE,

        title         = STRING_TOKEN (STR_AOD_VDD_MEM_VOLTAGE_CONTROL_SECTION);

        subtitle text = STRING_TOKEN (STR_AOD_VDD_MEM_VOLTAGE_CONTROL_SECTION);
        subtitle text = STRING_TOKEN (STR_AOD_BLANK);

        // Current  VDD_MEM Voltage
        // Current  VPP Voltage
        text
          help        = STRING_TOKEN(STR_AOD_BLANK),
          text        = STRING_TOKEN(STR_AOD_CURRENT_VDD_MEM_VOLTAGE_STRING),
          text        = STRING_TOKEN(STR_AOD_CURRENT_VDD_MEM_VOLTAGE),
          flags       = 0,
          key         = 0;

        // VDD_MEM Control
        // Auto: Follow default setting, Manual: Manually specify the VDD_MEM Voltage since VDDP_DDR is source from it.VDD_MEM must greater 100mv than VDDP_DDR
        oneof
          varid       = AOD_CONFIG.AodVddMemCtrl,
          prompt      = STRING_TOKEN (STR_AOD_VDD_MEM_CONTROL),
          help        = STRING_TOKEN (STR_AOD_VDD_MEM_CONTROL_HELP),
          option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0,    flags = DEFAULT | RESET_REQUIRED;
          option text = STRING_TOKEN (STR_AOD_MANUAL),              value = 1,    flags = 0 | RESET_REQUIRED;
        endoneof;
        // Display Condition: AodVddIoCtrl=Separate
        suppressif NOT ideqval AOD_CONFIG.AodVddMemCtrl == 1;
          label LABEL_CBS_AOD_VDD_MEM_ADJUST_START;
          // VDD_MEM Adjust
          // No help string
          label LABEL_CBS_AOD_VDD_MEM_ADJUST_END;
        endif;
      endform;
    //
    // form - VDDP Voltage Control
    //
    form

      formid        = SETUP_VDDP_VOLTAGE_CONTROL_LABLE,

      title         = STRING_TOKEN (STR_AOD_VDDP_VOLTAGE_CONTROL_SECTION);

      subtitle text = STRING_TOKEN (STR_AOD_VDDP_VOLTAGE_CONTROL_SECTION);
      subtitle text = STRING_TOKEN (STR_AOD_BLANK);

      // VDDP Voltage Control
      // Allows the user to adjust the VDDP voltage."Manual" means set voltage for the DDR bus signaling (PHY),. "Auto" means VDDP is system default.
      oneof
        varid       = AOD_CONFIG.AodVddpVoltageCtrl,
        prompt      = STRING_TOKEN (STR_AOD_VDDP_VOLTAGE_CONTROL),
        help        = STRING_TOKEN (STR_AOD_VDDP_VOLTAGE_CONTROL_HELP),
        option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0xff, flags = DEFAULT | RESET_REQUIRED;
        option text = STRING_TOKEN (STR_AOD_MANUAL),              value = 1,    flags = 0 | RESET_REQUIRED;
      endoneof;

      // Display Condition: AodVddpVoltageCtrl=Manual
      suppressif NOT ideqval AOD_CONFIG.AodVddpVoltageCtrl == 1;
        // VDDP Voltage Adjust
        // VDDP is a voltage for the DDR bus signaling (PHY), and it is derived from your DRAM Voltage (VDDIO_Mem). As a result, VDDP voltage in mV can approach but not exceed your DRAM Voltage
        numeric
          varid       = AOD_CONFIG.AodVddpVoltage,
          prompt      = STRING_TOKEN (STR_AOD_VDDP_VOLTAGE_ADJUST),
          help        = STRING_TOKEN (STR_AOD_VDDP_VOLTAGE_ADJUST_HELP),
          flags       = RESET_REQUIRED,
          minimum     = 0,
          maximum     = 0x7d0,
          step        = 0,
          default     = 0,
        endnumeric;
      endif;

    endform;
    //
    // form - LCLK Frequency Control
    //
    form

      formid        = SETUP_LCLK_FREQUENCY_CONTROL_LABLE,

      title         = STRING_TOKEN (STR_AOD_LCLK_FREQUENCY_CONTROL_SECTION);

      subtitle text = STRING_TOKEN (STR_AOD_LCLK_FREQUENCY_CONTROL_SECTION);
      subtitle text = STRING_TOKEN (STR_AOD_BLANK);

      // LCLK Frequency Control
      // AUTO: Default Settings. Manual: manually configure LCLK frequency
      oneof
        varid       = AOD_CONFIG.AodLclkCtrl,
        prompt      = STRING_TOKEN (STR_AOD_LCLK_FREQUENCY_CONTROL),
        help        = STRING_TOKEN (STR_AOD_LCLK_FREQUENCY_CONTROL_HELP),
        option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0,    flags = DEFAULT | RESET_REQUIRED;
        option text = STRING_TOKEN (STR_AOD_MANUAL),              value = 1,    flags = 0 | RESET_REQUIRED;
      endoneof;

      // Display Condition: AodLclkCtrl=Manual
      suppressif NOT ideqval AOD_CONFIG.AodLclkCtrl == 1;
        // Minimun Frequency
        // Minimum LCLK Frequency. Set minimum and maximun to the same value for fixed frequency operation.Range:150MHz ~ 2500MHz
        numeric
          varid       = AOD_CONFIG.AodMinLclkFreq,
          questionid  = KEY_AOD_MIN_LCLK_FREQ,
          prompt      = STRING_TOKEN (STR_AOD_MINIMUN_FREQUENCY),
          help        = STRING_TOKEN (STR_AOD_MINIMUN_FREQUENCY_HELP),
          flags       =  RESET_REQUIRED | INTERACTIVE,
          minimum     = 150,
          maximum     = 2500,
          step        = 0,
          default     = 150,
        endnumeric;
      endif;

      // Display Condition: AodLclkCtrl=Manual
      suppressif NOT ideqval AOD_CONFIG.AodLclkCtrl == 1;
        // Maximum Frequency
        // Maximum LCLK Frequency. Set minimum and maximun to the same value for fixed frequency operation.Range:150MHz ~ 2500MHz
        numeric
          varid       = AOD_CONFIG.AodMaxLclkFreq,
          questionid  = KEY_AOD_MAX_LCLK_FREQ,
          prompt      = STRING_TOKEN (STR_AOD_MAXIMUM_FREQUENCY),
          help        = STRING_TOKEN (STR_AOD_MAXIMUM_FREQUENCY_HELP),
          flags       = RESET_REQUIRED | INTERACTIVE,
          minimum     = 150,
          maximum     = 2500,
          step        = 0,
          default     = 2500,
        endnumeric;
      endif;

    endform;
    //
    // form - VDD Misc
    //
    form

      formid        = SETUP_VDD_MISC_LABLE,

      title         = STRING_TOKEN (STR_AOD_VDD_MISC_SECTION);

      subtitle text = STRING_TOKEN (STR_AOD_VDD_MISC_SECTION);
      subtitle text = STRING_TOKEN (STR_AOD_BLANK);

      // VDD Misc Control
      // Allows the user to adjust the VDD Misc voltage."Manual" means set voltage for the GMI PHY,. "Auto" means VDD MISC is system default.
      oneof
        varid       = AOD_CONFIG.AodVddMiscCtrl,
        prompt      = STRING_TOKEN (STR_AOD_VDD_MISC_CONTROL),
        help        = STRING_TOKEN (STR_AOD_VDD_MISC_CONTROL_HELP),
        option text = STRING_TOKEN (STR_AOD_AUTO),                value = 0,    flags = DEFAULT | RESET_REQUIRED;
        option text = STRING_TOKEN (STR_AOD_MANUAL),              value = 1,    flags = 0 | RESET_REQUIRED;
      endoneof;

      // Display Condition: AodVddMiscCtrl=Manual
      suppressif NOT ideqval AOD_CONFIG.AodVddMiscCtrl == 1;
        // VDD Misc Voltage
        // specific the VDD Misc Voltage in mV, definitely follow SVI3 type 2 Slave VID(500~5600mV step 10mV)
        numeric
          varid       = AOD_CONFIG.AodVddMiscVoltage,
          prompt      = STRING_TOKEN (STR_AOD_VDD_MISC_VOLTAGE),
          help        = STRING_TOKEN (STR_AOD_VDD_MISC_VOLTAGE_HELP),
          flags       = RESET_REQUIRED,
          minimum     = 500,
          maximum     = 5600,
          step        = 10,
          default     = 800,
        endnumeric;
      endif;

    endform;
endformset;