[defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = AodSmm
  FILE_GUID                      = B54299AD-B521-4BB8-A361-689249FE72B9
  MODULE_TYPE                    = DXE_SMM_DRIVER
  PI_SPECIFICATION_VERSION       = 0x0001000A
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = AodSmmEntryPoint

[sources]
  AodSmm.c
  AodSmm.h

[LibraryClasses]
  UefiDriverEntryPoint
  BaseMemoryLib
  BaseLib
  DebugLib
  SmmServicesTableLib
  UefiRuntimeServicesTableLib
  UefiBootServicesTableLib
  MemoryAllocationLib
  UefiLib
  PcdLib
  AodBaseLib
  SmmMemLib

[Pcd]
  gAmdCpmPkgTokenSpaceGuid.SwSmiCmdAodUpdateMemClkTimings

[Guids]
  gAodSystemConfigurationGuid

[Protocols]
  gFchSmmSwDispatch2ProtocolGuid         #CONSUMED
  gEfiSmmBase2ProtocolGuid               #CONSUMED
  gAodNvAreaUpdatedProtocolGuid          #CONSUMED
  gAmdAodSmmCmdProtocolGuid
  gEfiSmmReadyToLockProtocolGuid         #CONSUMED
  gAmdCpmVariableHookProtocolGuid

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  AgesaModulePkg/AgesaCommonModulePkg.dec
  AgesaModulePkg/AgesaModuleFchPkg.dec
  AgesaModulePkg/AgesaFamily17ModulePkg.dec
  AmdCpmPkg/AmdCpmPkg.dec
  AgesaPkg/AgesaPkg.dec
  AmdCbsPkg/AmdCbsPkg.dec

[Depex]
  gEfiSmmBase2ProtocolGuid
  AND
  gFchSmmSwDispatch2ProtocolGuid
  AND
  gAodNvAreaUpdatedProtocolGuid

