//***************************************************************************
//
//  ATCS.asi - AMD Chipset ACPI Control Method
//
//***************************************************************************

    Name(CpmAtcsBuffer0, Buffer(255){})
    Name(CpmAtcsBuffer1, Buffer(3){})
    Name(CpmDockingStatus, 1)

    Method (ATCS, 2 ,Serialized)
    {
        If(LEqual(Arg0, 0))
        {
            CpmSetPostCode(CpmTpAtcsAtc0Begin)
            ATC0()
            CpmSetPostCode(CpmTpAtcsAtc0End)
        }
        If(LEqual(Arg0, 1))
        {
            CpmSetPostCode(CpmTpAtcsAtc1Begin)
            ATC1()
            CpmSetPostCode(CpmTpAtcsAtc1End)
        }
        If(LEqual(Arg0, 2))
        {
            CpmSetPostCode(CpmTpAtcsAtc2Begin)
            ATC2(Arg1)
            CpmSetPostCode(CpmTpAtcsAtc2End)
        }
        If(LEqual(Arg0, 3))
        {
            CpmSetPostCode(CpmTpAtcsAtc3Begin)
            ATC3()
            CpmSetPostCode(CpmTpAtcsAtc3End)
        }
        If(LEqual(Arg0, 4))
        {
            CpmSetPostCode(CpmTpAtcsAtc4Begin)
            ATC4(Arg1)
            CpmSetPostCode(CpmTpAtcsAtc4End)
        }
        If(LEqual(Arg0, 6))
        {
            CpmSetPostCode(CpmTpAtcsAtc6Begin)
            ATC6(Arg1)
            CpmSetPostCode(CpmTpAtcsAtc6End)
        }
        If(LEqual(Arg0, 7))
        {
            CpmSetPostCode(CpmTpAtcsAtc7Begin)
            ATC7(Arg1)
            CpmSetPostCode(CpmTpAtcsAtc7End)
        }
        If (LEqual (Arg0, 8))
        {
            CpmSetPostCode(CpmTpAtcsAtc8Begin)
            ATC8 (DeRefOf (Index (Arg1, 2)), DeRefOf (Index (Arg1, 3)), DeRefOf (Index (Arg1, 4)), DeRefOf (Index (Arg1, 5)))
            CpmSetPostCode(CpmTpAtcsAtc8End)
        }
        If(LEqual(Arg0, 9))
        {
            CpmSetPostCode(CpmTpAtcsAtc9Begin)
            ATC9 ()
            CpmSetPostCode(CpmTpAtcsAtc9End)
        }
        If(LEqual(Arg0, 10))
        {
            CpmSetPostCode(CpmTpAtcsAtcABegin)
            ATCA (Arg1)
            CpmSetPostCode(CpmTpAtcsAtcAEnd)
        }
        Return (CpmAtcsBuffer0)
    }

    // Verify Interface
    Method (ATC0)
    {
        CreateWordField(CpmAtcsBuffer0, 0, CpmStructureSize)                          // Structure size field
        CreateWordField(CpmAtcsBuffer0, 2, CpmInterfaceVersion)                       // Interface field
        CreateDWordField(CpmAtcsBuffer0, 4, CpmSupportedFunctionsBitVector)           // Supported field
        Store(8, CpmStructureSize)                                          // Size
        Store(1, CpmInterfaceVersion)                                       // Interface version
        Store(CpmAtcsSupportedFunctionMask, CpmSupportedFunctionsBitVector) // Supported Functions Bit Vector
        Store(\_SB.ALIB(0, CpmAtcsBuffer0), CpmAtcsBuffer0)
    }

    // Get External State
    Method (ATC1, 0, Serialized)
    {
        CreateWordField(CpmAtcsBuffer0, 0, CpmStructureSize)                          // Structure size field
        CreateDWordField(CpmAtcsBuffer0, 2, CpmValidFlagsMask)                        // Valid Flags Mask field
        CreateDWordField(CpmAtcsBuffer0, 6, CpmFlags)                                 // Flags field
        CreateField(CpmAtcsBuffer0, 48, 1, CpmDockingFlag)                            // Docking status

        Store(10, CpmStructureSize)                                         // size
        Store(1, CpmValidFlagsMask)                                         // Valid Flags Mask
        Store(CpmAtcsSupportedFunctionMask, CpmFlags)                       // Clean up

        Store(CpmReadTable(CpmDisplayFeatureTable, CpmDisplayFeatureDockingDeviceId), Local0)

        If(And(Local0, 0x80))
        {
            Store(And(Local0, 0x01), CpmDockingStatus)
        } Else
        {
            If(And(Local0, 0x7F))
            {
                Store(CpmGetDeviceStatus(Local0), CpmDockingStatus)
            }
        }
        Store(CpmDockingStatus, CpmDockingFlag)
    }

    // PCIe Performace Request
    Method (ATC2, 1, Serialized)
    {
        CreateWordField(CpmAtcsBuffer0, 0, CpmStructureSize)          // Structure size field
        CreateByteField(CpmAtcsBuffer0, 2, CpmReturnValue)            // Return Values

        Store(3, CpmStructureSize)                          // prepare return default:size
        Store(1, CpmReturnValue)                            // assume Request refused
        Store(\_SB.ALIB(2, Arg0), CpmAtcsBuffer0)                     // ALIB's PCIe Performance Request
    }

    // PCIE Device Ready Nodification
    Method (ATC3, 0, Serialized)
    {
        CreateWordField(CpmAtcsBuffer0, 0, CpmStructureSize)          // Structure size field
        CreateByteField(CpmAtcsBuffer0, 2, CpmReturnValue)            // Return Values

        CreateWordField(CpmAtcsBuffer1, 0, CpmStructureSize2)         // Structure size field
        CreateByteField(CpmAtcsBuffer1, 2, CpmPsppPolicy)             // PSPP Policy

        Store(3, CpmStructureSize)                          // prepare return default:size
        Store(1, CpmReturnValue)                            // assume Request refused
        Store(3, CpmStructureSize2)                         // size
        Store(1, CpmPsppPolicy)                             // start PSPP
        Store(\_SB.ALIB(3, CpmAtcsBuffer1), CpmAtcsBuffer0)                     // ALIB's PCIe Performance Request
    }

   // Set PCIe Bus Width
    Method (ATC4, 1, Serialized)
    {
        CreateWordField(CpmAtcsBuffer0, 0, CpmStructureSize)          // Structure size field
        CreateByteField(CpmAtcsBuffer0, 2, CpmActiveLaneNumber)       // Number of active lanes

        Store(3, CpmStructureSize)                          // prepare return default: size
        Store(1, CpmActiveLaneNumber)                       // prepare return default: Num Lanes
        Store(\_SB.ALIB(4, Arg0), CpmAtcsBuffer0)           // ALIB's Set PCIe Bus width
    }

   // Get UMA Size
    Method (ATC6, 1, Serialized)
    {
        CreateWordField(CpmAtcsBuffer0, 0, CpmStructureSize)          // Structure size field
        CreateDwordField(CpmAtcsBuffer0, 2, CpmCurrentUmaSize)        // Uma Size

        Store(6, CpmStructureSize)                          // prepare return default: size
        Store(CpmUmaSize, CpmCurrentUmaSize)                // prepare return default: uma size
    }

   // Set Auto UMA Allocation
    Method (ATC7, 1, Serialized)
    {
        CpmTriggerSmi(CpmSwSmiCmdSetAutoUmaMode, 0, 1)      // Trigger a SW SMI to set auto UMA allocation mode
    }

   // Power Shift Control
    Method (ATC8, 4, Serialized)
    {
        Store (Buffer (5) {}, Local0)
        CreateWordField (Local0, 0, CpmStructureSize)                 // The size of the parameter buffer for this function
        CreateByteField (Local0, 2, CpmDgpuTargetState)               // The TargetState identifies the desired action for ALIB communication to SMU to initiate a new SmartShift state
        CreateWordField (Local0, 3, CpmDgpuAddress)                   // This value identifies the PCI address of the dGPU.
        Store (5, CpmStructureSize)                                   // Size of Buffer
        Store (Arg0, Local1)
        Store (Arg1, Local2)
        Add (ShiftLeft (Local2, 8), Local1, CpmDgpuAddress)
        Store (Arg2, Local3)
        Store (Arg3, Local4)
        If (LAnd (LEqual (Local3, 0), LEqual (Local4, 0))) {
            // D state = D0 ;  Driver State: Driver operational
            // ENABLE - This value indicates that ALIB should update the dGPU MMIO region to SMU and enable the SmartShift feature.
            Store (1, CpmDgpuTargetState)
            \_SB.ALIB (0xAA, Local0)                                  // ALIB's Power Shift Control
        } else {
            If (LAnd (LEqual (Local3, 0), LEqual (Local4, 1))) {
                // D state = D0 ;  Driver State: Driver NOT operational
                // DISABLE - This value indicates that ALIB should disable the SmartShift feature.
                Store (0, CpmDgpuTargetState)
                \_SB.ALIB (0xAA, Local0)                              // ALIB's Power Shift Control
            } else {
                If (LAnd (LEqual (Local3, 3), LEqual (Local4, 1))) {
                    // D state = D3 ;  Driver State: Driver NOT operational
                    // Stop GPU - This value indicates that ALIB should notify SMU to stop the GPU interface.
                    Store (3, CpmDgpuTargetState)
                    \_SB.ALIB (0xAA, Local0)                          // ALIB's Power Shift Control
                }
            }
        }
    }

    // Get Package Power Tracking Limit Adjustment
    Method (ATC9, 0, Serialized)
    {
        Store (CpmAtcsFunction9Buffer, CpmAtcsBuffer0)
    }

    // Set UMA Allocation Size
    Method (ATCA, 1, Serialized)
    {
        CreateWordField(Arg0, 0, CpmStructureSize)          // Structure size field
        CreateWordField(Arg0, 2, CpmUmaSizeId)              // UMA Size ID
        CpmTriggerSmi(CpmSwSmiCmdSetUmaSizeId, CpmUmaSizeId, 1)      // Trigger a SW SMI to set UMA size ID
    }
