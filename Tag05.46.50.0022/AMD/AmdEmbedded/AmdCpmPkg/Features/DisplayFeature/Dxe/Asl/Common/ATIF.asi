//***************************************************************************
//
//  ATIF.asi -  ATI DDI interface
//
//***************************************************************************

    // The ATIB object creates the 256 byte buffer that will be returned
    // to the OS as per the 256 byte size definition for ATIF spec.
    Name (ATIB, Buffer (0x100) {})
    Name (AtifNotifyCommandCode, 0x81)

    Method (ATIF, 2, Serialized) {
        CpmDebugPrint ("  FEA-ASL-ATIF Function %d\n", Arg0, 0, 0, 0, 0, 0)
        If (LEqual (Arg0, 0)) {
            Return (AF00)
        }
        If (LEqual (Arg0, 1)) {
            Return (AF01)
        }
        If (LEqual (Arg0, 2)) {
            Return (AF02)
        }
        If (LEqual (Arg0, 3)) {
            Return (AF03 (DerefOf (Index (Arg1, 2)), DerefOf (Index (Arg1, 4))))
        }
        If (LEqual (Arg0, 4)) {
            Return (AF04)
        }
        If (LEqual (Arg0, 15)) {
            Return (AF15)
        }
        If (LEqual (Arg0, 16)) {
            Return (AF16 (DerefOf (Index (Arg1, 2))))
        }
        If (LEqual (Arg0, 21)) {
            Return (AF21)
        }
        If (LEqual (Arg0, 22)) {
            Return (AF22)
        }
        If (LEqual (Arg0, 23)) {
            Return (AF23)
        }

        // Return null structure as function not supported
        CreateWordField (ATIB, 0, CpmStructureSize)
        CreateWordField (ATIB, 2, CpmInterfaceVersion)
        CreateDWordField (ATIB, 4, CpmSupportedNotificationsMask)
        CreateDWordField (ATIB, 8, CpmSupportedFunctionsBitVector)
        Store (0, CpmStructureSize)
        Store (0, CpmInterfaceVersion)
        Store (0, CpmSupportedNotificationsMask)
        Store (0x00000000, CpmSupportedFunctionsBitVector)
        Return (ATIB)
    } // End of Method (ATIF, 2, Serialized)

    Method (AF00) {
        CreateWordField (ATIB, 0, CpmStructureSize)
        CreateWordField (ATIB, 2, CpmInterfaceVersion)
        CreateDWordField (ATIB, 4, CpmSupportedNotificationsMask)
        CreateDWordField (ATIB, 8, CpmSupportedFunctionsBitVector)

        Store (12, CpmStructureSize)
        Store (1, CpmInterfaceVersion)
        Store (CpmAtifSupportedNotificationMask, CpmSupportedNotificationsMask)
        If (LNot (CondRefOf (\_SB.LID._LID))) {
            And (CpmAtifFunctionBitVector, 0xFFFFFFF7, CpmAtifFunctionBitVector)
        }

        Store (CpmAtifFunctionBitVector, CpmSupportedFunctionsBitVector)
        CpmDebugPrint ("    Return Supported Notifications Mask = 0x%X  Supported Functions Bit Vector = 0x%X\n", CpmSupportedNotificationsMask, CpmSupportedFunctionsBitVector, 0, 0, 0, 0)
        Return (ATIB)
    } // End of Method (AF00)

    Method (AF01) {
        CreateWordField (ATIB, 0, CpmStructureSize)
        CreateDWordField (ATIB, 2, CpmValidFlagsMask)
        CreateDWordField (ATIB, 6, CpmFlags)
        CreateByteField (ATIB, 10, CpmNotifyCommandCode)

        Store (3, CpmValidFlagsMask)
        And (ShiftRight (CpmAtifFlags, 24), 0xFF, Local0)
        And (CpmAtifFlags, 0x03, Local1)
        Store (Local1, CpmFlags)
        If (LAnd (LGreaterEqual (Local0, 0xD0), LLessEqual (Local0, 0xD9))) {
            Store (11, CpmStructureSize)
            Store (Local0, CpmNotifyCommandCode)
            Store (Local0, AtifNotifyCommandCode)
        } else {
            Store (10, CpmStructureSize)
            If (LNotEqual (AtifNotifyCommandCode, 0x81)) {
                Store (0x81, AtifNotifyCommandCode)
            }
        }

        CpmDebugPrint ("    Return Flags = 0x%X  Notify Command Code = 0x%X\n", CpmFlags, AtifNotifyCommandCode, 0, 0, 0, 0)
        Return (ATIB)
    } // End of Method (AF01)

    Name (CpmPendingSystemBIOSRequestBuffer, Buffer (4) {0, 0, 0, 0}) // Pending System BIOS Requests. (these get cleared only when function 2 is called)
    Name (CpmSaveExpansionMode, 0x00)                             // Expansion Mode.(Bits 1-0)
    Name (CpmSaveThermalStateTargetGraphicsController, 0x00)      // Thermal State:       Target Graphics Controller
    Name (CpmSaveThermalStateStateId, 0x00)                       // Thermal State:       State Id
    Name (CpmSaveForcedPowerStateTargetGraphicsController, 0x00)  // Forced Power State:  Target Graphics Controller
    Name (CpmSaveForcedPowerStateStateId, 0x00)                   // Forced Power State:  State Id
    Name (CpmSaveSystemPowerSource, 0x00)                         // System Power Source
    Name (CpmSavePowerLimitTargetGraphicsController, 0x00)        // Power Limit:         Target Graphics Controller (BYTE)
    Name (CpmSavePowerLimitValue, 0x00000000)                     // Power Limit:         Value (DWORD)

    // These are intended for Display configuration change request (Bit 5)
    // and Display Device Status Change (Bit 6) notifications
    // Currently not supported
    Name (SSDM, 0x000A)                                               // Save Supported Displays mask
    Name (SCDY, 0x0000)                                               // Connected Displays

    Method (AF02) {
        CreateBitField (CpmPendingSystemBIOSRequestBuffer, 0, CpmDisplaySwitchRequest)                    // Display switch request
        CreateBitField (CpmPendingSystemBIOSRequestBuffer, 1, CpmExpansionModeChangeRequest)              // Expansion mode change request
        CreateBitField (CpmPendingSystemBIOSRequestBuffer, 2, CpmThermalStateChangeRequest)               // Thermal state change request
        CreateBitField (CpmPendingSystemBIOSRequestBuffer, 3, CpmForcedPowerStateChangeRequest)           // Forced power state change request
        CreateBitField (CpmPendingSystemBIOSRequestBuffer, 4, CpmSystemPowerStateChangeRequest)           // System power state change request
        CreateBitField (CpmPendingSystemBIOSRequestBuffer, 5, CpmDisplayConfigurationChangeRequest)       // Display configuration change request
        CreateBitField (CpmPendingSystemBIOSRequestBuffer, 6, CpmPowerXpressGraphicsSwitchToggleRequest)  // Display device status change request
        CreateBitField (CpmPendingSystemBIOSRequestBuffer, 7, CpmPanelBrightnessLevelChangeRequest)       // Brightness level change request
        CreateBitField (CpmPendingSystemBIOSRequestBuffer, 8, CpmDgpuDisplayConnectStateChangeRequest)    // Discrete GPU display connect state change request
        CreateBitField (CpmPendingSystemBIOSRequestBuffer,12, CpmPowerLimitRequest)                       // Power Limit Request

        CreateWordField  (ATIB, 0,  CpmStructureSize)                             // Structure size = 18
        CreateDWordField (ATIB, 2,  CpmPendingSystemBIOSRequests)                 // Pending System BIOS Requests
        CreateByteField  (ATIB, 6,  CpmExpansionMode)                             // Expansion Mode
        CreateByteField  (ATIB, 7,  CpmThermalStateTargetGraphicsController)      // Thermal State: Target Gfx controller
        CreateByteField  (ATIB, 8,  CpmThermalStateStateId)                       // Thermal State: State Id
        CreateByteField  (ATIB, 9,  CpmForcedPowerStateTargetGraphicsController)  // Forced Power State: Target Gfx controller
        CreateByteField  (ATIB, 10, CpmForcedPowerStateStateId)                   // Forced Power State: State Id
        CreateByteField  (ATIB, 11, CpmSystemPowerSource)                         // System Power Source
        CreateByteField  (ATIB, 12, CpmPanelBrightnessBacklightLevel)             // Brightness Level
        CreateByteField  (ATIB, 13, CpmPowerLimitTargetGraphicsController)        // Power Limit: Target Graphics Controller (BYTE)
        CreateDWordField (ATIB, 14, CpmPowerLimitValue)                           // Power Limit: Value (DWORD)

        Store (Zero, ATIB)
        Store (18, CpmStructureSize)                                              // Size of ATIB structure
        Store (CpmPendingSystemBIOSRequestBuffer, CpmPendingSystemBIOSRequests)   // Load current pending System BIOS request indicators

        If (CpmDisplaySwitchRequest) {
            // Clear out pending indicator
            Store (Zero, CpmDisplaySwitchRequest)
        }

        If (CpmExpansionModeChangeRequest) {
            // Pass back panel expansion mode
            Store (CpmSaveExpansionMode, CpmExpansionMode)
            Store (Zero, CpmSaveExpansionMode)
            // Clear out pending indicator
            Store (Zero, CpmExpansionModeChangeRequest)
        }

        If (CpmThermalStateChangeRequest) {
            Store (CpmSaveThermalStateTargetGraphicsController, CpmThermalStateTargetGraphicsController)
            Store (CpmSaveThermalStateStateId, CpmThermalStateStateId)
            Store (Zero, CpmSaveThermalStateTargetGraphicsController)
            Store (Zero, CpmSaveThermalStateStateId)
            Store (Zero, CpmThermalStateChangeRequest)
        }

        If (CpmForcedPowerStateChangeRequest) {
            Store (CpmSaveForcedPowerStateTargetGraphicsController, CpmForcedPowerStateTargetGraphicsController)
            Store (CpmSaveForcedPowerStateStateId, CpmForcedPowerStateStateId)
            Store (Zero, CpmSaveForcedPowerStateTargetGraphicsController)
            Store (Zero, CpmSaveForcedPowerStateStateId)
            Store (Zero, CpmForcedPowerStateChangeRequest)
        }

        If (CpmSystemPowerStateChangeRequest) {
            Store (CpmSaveSystemPowerSource, CpmSystemPowerSource)
            Store (Zero, CpmSystemPowerStateChangeRequest)
        }

        If (CpmPowerXpressGraphicsSwitchToggleRequest) {
            Store (Zero, CpmPowerXpressGraphicsSwitchToggleRequest)
        }

        If (CpmPanelBrightnessLevelChangeRequest) {
            Store (Zero, CpmPanelBrightnessLevelChangeRequest)
        }

        If (CpmDgpuDisplayConnectStateChangeRequest) {
            Store (Zero, CpmDgpuDisplayConnectStateChangeRequest)
        }

        If (CpmPowerLimitRequest) {
            Store (CpmSavePowerLimitTargetGraphicsController, CpmPowerLimitTargetGraphicsController)
            Store (CpmSavePowerLimitValue, CpmPowerLimitValue)
            Store (Zero, CpmSavePowerLimitTargetGraphicsController)
            Store (Zero, CpmSavePowerLimitValue)
            Store (Zero, CpmPowerLimitRequest)
        }

        CpmDebugPrint ("    Return Pending System BIOS Requests                        = 0x%X\n", CpmPendingSystemBIOSRequests, 0, 0, 0, 0, 0)
        CpmDebugPrint ("           Expansion Mode                                      = 0x%X\n", CpmExpansionMode, 0, 0, 0, 0, 0)
        CpmDebugPrint ("           Thermal State: Target Graphics Controller           = 0x%X\n", CpmThermalStateTargetGraphicsController, 0, 0, 0, 0, 0)
        CpmDebugPrint ("           Thermal State: State Id                             = 0x%X\n", CpmThermalStateStateId, 0, 0, 0, 0, 0)
        CpmDebugPrint ("           Forced Power State: Target Graphics Controller      = 0x%X\n", CpmForcedPowerStateTargetGraphicsController, 0, 0, 0, 0, 0)
        CpmDebugPrint ("           Forced Power State: State Id                        = 0x%X\n", CpmForcedPowerStateStateId, 0, 0, 0, 0, 0)
        CpmDebugPrint ("           System Power Source                                 = 0x%X\n", CpmSystemPowerSource, 0, 0, 0, 0, 0)
        CpmDebugPrint ("           Panel Brightness Backlight Level                    = 0x%X\n", CpmPanelBrightnessBacklightLevel, 0, 0, 0, 0, 0)
        CpmDebugPrint ("           GPU Package Power Limit: Target Graphics Controller = 0x%X\n", CpmPowerLimitTargetGraphicsController, 0, 0, 0, 0, 0)
        CpmDebugPrint ("           GPU Package Power Limit: Value                      = 0x%X\n", CpmPowerLimitValue, 0, 0, 0, 0, 0)
        Return (ATIB)
    } // End of Method (AF02)

    Method (AF03, 2) {
        CreateWordField (ATIB, 0, CpmStructureSize)                   // Structure size
        CreateWordField (ATIB, 2, CpmSelectedDisplays)                // Selected (Active) Displays
        CreateWordField (ATIB, 4, CpmConnectedDisplays)               // Connected Displays

        Store (Arg0, CpmSelectedDisplays)
        Store (Arg1, CpmConnectedDisplays)

        // Init next display option to invalid index (0x06)
        Name (CpmNextDisplayOption, 0x06)
        Name (CpmConnectorIndex, 0x06)
        Name (CpmDeviceCombinationBuffer, Buffer (20) {0})
        Name (CpmDeviceCombinationNumber, 0)

        Store (CpmReadTable (CpmDisplayFeatureTable, CpmDisplayFeatureAtifDeviceCombinationNumber), CpmDeviceCombinationNumber)
        Store (0, Local1)
        While (LLess (Local1, CpmDeviceCombinationNumber)) {
            Store (CpmReadTable (CpmDisplayFeatureTable, Add (CpmDisplayFeatureAtifDeviceCombinationBuffer, Local1)), Local2)
            Store (Local2, Index (CpmDeviceCombinationBuffer, Local1))
            Increment (Local1)
        }

        // Algorithm for EC-hotKey Display Switch
        // Select order is CRT1->DFP1->DFP2 ->LCD1+CRT1->LCD1+DFP1->LCD1+DFP2->LCD1
        // Find table index for current Active devices
        // Increment index to next select option
        // If devices in select option are all connected then exit
        // otherwise increment index to next select option and keep searching
        // If index not found then return 0 in CpmSelectedDisplays
        // else for valid index, return this as next Active device option in ATIB buffer
        Store (CpmSelectedDisplays, Local1)
        // mask out all but LCD1, CRT1, DFP1, DFP2
        And (Local1, 0x8B, Local1)
        Store (CpmConnectedDisplays, Local2)
        If (CondRefOf (\_SB.LID._LID)) {
            Store (\_SB.LID._LID (), Local0)
            And (Local2, Not (0x01), Local2)
            Or (Local2, Local0, Local2)
        }

        Store (Zero, Local0)
        While (LLess (Local0, CpmDeviceCombinationNumber)) {
            Store (DerefOf (Index (CpmDeviceCombinationBuffer, Local0)), Local3)
            If (LEqual (Local3, Local1)) {
                Store (Local0, CpmConnectorIndex)
                Store (CpmDeviceCombinationNumber, Local0)
            } Else {
                Increment(Local0)
            }
        }
        Store (CpmConnectorIndex, Local0)
        While (LLess (Local0, CpmDeviceCombinationNumber)) {
            Increment (Local0)
            If (LEqual (Local0, CpmDeviceCombinationNumber)) {
                Store (0x00, Local0)
            }
            Store (DerefOf (Index (CpmDeviceCombinationBuffer, Local0)), Local3)
            If (LEqual (And (Local3, Local2), Local3)) {
                Store (Local0, CpmNextDisplayOption)
                Store (CpmDeviceCombinationNumber, Local0)
            }
        }
        If (LEqual (CpmNextDisplayOption, CpmDeviceCombinationNumber)) {
            Store (Zero, CpmSelectedDisplays)
        } Else {
            Store (CpmNextDisplayOption, Local0)
            Store (DerefOf (Index (CpmDeviceCombinationBuffer, Local0)), Local3)
            And (CpmSelectedDisplays, Not (0x0B), CpmSelectedDisplays)
            Or (CpmSelectedDisplays, Local3, CpmSelectedDisplays)
        }
        Store (0x04, CpmStructureSize)

        Return (ATIB)
    } // ENd of Method (AF03, 2)

    Method (AF04) {
        CreateWordField (ATIB, 0, CpmStructureSize)                   // Structure size
        CreateByteField (ATIB, 2, CpmLidState)                        // Only bit 0 is valid
        Store (0x03, CpmStructureSize)                                // Set the output structure size

        Store (0x00, Local1)
        If (CondRefOf (\_SB.LID._LID)) {
            Store (\_SB.LID._LID (), Local0)
            Xor (Local0, 0x01, Local1)
        }

        // Get LID object status, and convert it to ATIF's polarity
        Store (Local1, CpmLidState)
        Return (ATIB)
    } // End of Method (AF04)

    Method (AF15) {
        Store (CpmAtifDeviceListBuffer, ATIB)
        // return the full 256 byte buffer
        Return (ATIB)
    } // End of Method (AF15)

    Method (AF16, 1) {
        Store (CpmReadTable16 (CpmDisplayFeatureTable, CpmDisplayFeatureAtif16Buffer), Local0)
        If (LNotEqual (Local0, 0x00)) {
            Store (0x0, Local1)
            While (LLess (Local1, Local0)) {
                Store (CpmReadTable (CpmDisplayFeatureTable, Add (CpmDisplayFeatureAtif16Buffer, Local1)), Local2)
                Store (Local2, Index (ATIB, Local1))
                Increment (Local1)
            }
        } Else {
            Store (CpmCallBack (CpmCallBackAtif16, Arg0, CPM_DISPLAY_FEATURE_DGPU), Local3)
            If (LEqual (ObjectType (Local3), 3)) {
                Store (Local3, ATIB)
            } Else {
                Store (0x05, Index (ATIB, 0))
                Store (0x00, Index (ATIB, 1))
                Store (0x00, Index (ATIB, 2))
                Store (0x00, Index (ATIB, 3))
                Store (0x02, Index (ATIB, 4))
            }
        }

        CreateWordField (ATIB, 0, CpmStructureSize)                   // Structure size
        CreateWordField (ATIB, 2, CpmFlags)                           // Flags
        CreateByteField (ATIB, 4, CpmErrorCode)                       // Error Code
        CreateByteField (ATIB, 5, CpmAcLevel)                         // AC Level
        CreateByteField (ATIB, 6, CpmDcLevel)                         // DC Level
        CreateByteField (ATIB, 7, CpmMinInputSignalLevel)             // Min Input Signal Level
        CreateByteField (ATIB, 8, CpmMaxInputSignalLevel)             // Max Input Signal Level
        CreateByteField (ATIB, 9, CpmCount)                           // Count
        CpmDebugPrint ("    Return Structure Size         = 0x%X\n", CpmStructureSize, 0, 0, 0, 0, 0)
        CpmDebugPrint ("           Flags                  = 0x%X\n", CpmFlags, 0, 0, 0, 0, 0)
        CpmDebugPrint ("           Error Code             = 0x%X\n", CpmErrorCode, 0, 0, 0, 0, 0)
        If (LGreater (CpmStructureSize, 5)) {
            CpmDebugPrint ("           AC Level               = 0x%X\n", CpmAcLevel, 0, 0, 0, 0, 0)
            CpmDebugPrint ("           DC Level               = 0x%X\n", CpmDcLevel, 0, 0, 0, 0, 0)
            CpmDebugPrint ("           Min Input Signal Level = 0x%X\n", CpmMinInputSignalLevel, 0, 0, 0, 0, 0)
            CpmDebugPrint ("           Max Input Signal Level = 0x%X\n", CpmMaxInputSignalLevel, 0, 0, 0, 0, 0)
            CpmDebugPrint ("           Count                  = %d\n", CpmCount, 0, 0, 0, 0, 0)
            If (LGreater (CpmStructureSize, 10)) {
                Store (10, Local1)
                While (LLess (Local1, CpmStructureSize)) {
                    Store (DerefOf (Index (ATIB, Local1)), Local2)
                    Increment (Local1)
                    Store (DerefOf (Index (ATIB, Local1)), Local3)
                    Increment (Local1)
                    ShiftRight (Subtract (Local1, 10), 1, Local4)
                    CpmDebugPrint ("           Count[%d]  Luminance Level = 0x%X  Signal Level = %d\n", Local4, Local2, Local3, 0, 0, 0)
                }
            }
        }
        Return (ATIB)
    } // End of  Method (AF16, 1)

    Method (AF21) {
        Store (CpmAtifFun21ReturnTable, ATIB)

        CreateWordField (ATIB, 0, CpmCount)                           // Num Devices
        CreateWordField (ATIB, 2, CpmStructureSize)                   // Device Structure size
        CpmDebugPrint ("    Return Num Devices            = 0x%X\n", CpmCount, 0, 0, 0, 0, 0)
        CpmDebugPrint ("    Return Device Structure size  = 0x%X\n", CpmStructureSize, 0, 0, 0, 0, 0)
        Store (0x0, Local0)
        If (LAnd (LGreater (CpmCount, 0), LLess (CpmCount, 4))) {
            While (LLess (Local0, CpmCount)) {                            // Num Devices
                Add (ShiftLeft (Local0, 2), 4, Local1)
                Add (Local1, 2, Local2)
                Store (DerefOf (Index (ATIB, Local1)), Local3)
                Store (DerefOf (Index (ATIB, Local2)), Local4)
                CpmDebugPrint ("    Return Device Structure [%d] Flags              = 0x%X\n", Local0, Local3, 0, 0, 0, 0)
                CpmDebugPrint ("    Return Device Structure [%d] Bus                = 0x%X\n", Local0, Local4, 0, 0, 0, 0)
                Increment (Local0)
            }
        }
        Return (ATIB)
    } // End of Method (AF21)

    Method (AF22) {
        CreateWordField (ATIB, 0, CpmStructureSize)
        CreateByteField (ATIB, 2, CpmTargetGraphics)
        CreateDWordField (ATIB, 3, CpmValue)

        Store (CpmReadTable (CpmDisplayFeatureTable, CpmDisplayFeatureAtifFun22Support), Local0)
        If (LGreaterEqual (Local0, 0x1)) {
            Store (7, CpmStructureSize)
            Decrement (Local0)
            Store (Local0, CpmTargetGraphics)
            Store (CpmReadTable32 (CpmDisplayFeatureTable, CpmDisplayFeatureAtifFun22Value), CpmValue)
        } Else {
            Store (0, CpmStructureSize)
            Store (0, CpmTargetGraphics)
            Store (0, CpmValue)
        }

        CpmDebugPrint ("    Return Structure Size         = 0x%X\n", CpmStructureSize, 0, 0, 0, 0, 0)
        CpmDebugPrint ("           GPU Package Power Limit: Target Graphics Controller = %d\n", CpmTargetGraphics, 0, 0, 0, 0, 0)
        CpmDebugPrint ("           GPU Package Power Limit: Value                      = 0x%X\n", CpmValue, 0, 0, 0, 0, 0)
        Return (ATIB)
    } // End of Method (AF22)

    Method (AF23) {
        Store (CpmAtifFunction23Buffer, ATIB)
        CreateWordField (ATIB, 0, CpmStructureSize)
        CreateByteField (ATIB, 2, CpmAcMaximumPerformanceLimit)
        CreateByteField (ATIB, 3, CpmAcBetterPerformanceLimit)
        CreateByteField (ATIB, 4, CpmAcBetterBatteryLimit)
        CreateByteField (ATIB, 5, CpmDcMaximumPerformanceLimit)
        CreateByteField (ATIB, 6, CpmDcBetterPerformanceLimit)
        CreateByteField (ATIB, 7, CpmDcBetterBatteryLimit)
        CreateByteField (ATIB, 8, CpmDcBatterySaverLimit)

        CpmDebugPrint ("    Return Structure Size               = %d\n", CpmStructureSize, 0, 0, 0, 0, 0)
        If (LGreaterEqual (CpmStructureSize, 2)) {
            CpmDebugPrint ("           AC Maximum Performance Limit = %d\n", CpmAcMaximumPerformanceLimit, 0, 0, 0, 0, 0)
            CpmDebugPrint ("           AC Better Performance Limit  = %d\n", CpmAcBetterPerformanceLimit, 0, 0, 0, 0, 0)
            CpmDebugPrint ("           AC Better Battery Limit      = %d\n", CpmAcBetterBatteryLimit, 0, 0, 0, 0, 0)
            CpmDebugPrint ("           DC Maximum Performance Limit = %d\n", CpmDcMaximumPerformanceLimit, 0, 0, 0, 0, 0)
            CpmDebugPrint ("           DC Better Performance Limit  = %d\n", CpmDcBetterPerformanceLimit, 0, 0, 0, 0, 0)
            CpmDebugPrint ("           DC Better Battery Limit      = %d\n", CpmDcBetterBatteryLimit, 0, 0, 0, 0, 0)
            CpmDebugPrint ("           DC Battery Saver Limit       = %d\n", CpmDcBatterySaverLimit, 0, 0, 0, 0, 0)
        }
        Return (ATIB)
    } // End of Method (AF23)

    // The following methods are intended to be called back from OEM/Customer EC based code
    // in order to initiate a System BIOS request to the Display Driver.
    // For example, the EC may implement a hot-key sequence that generates an SCI
    // and the ASL handler for the specific SCI _Qxx would, for example, request a
    // Display Switch by calling back to Method(AFN0).  The Display Driver will then
    // call Method(ATIF, ...) with Arg0 = 2 (for executing Function AF02) followed
    // by Method(ATIF, ...) with ARg0 = 3 (for executing Function AF03) will will
    // return back to the driver the next SBIOS choice for Active Display device(s).

    Method (AFN0, 0, Serialized) {
        CpmDebugPrint ("  FEA-ASL-ATIF-AFN0  Supported Notification Mask = 0x%X\n", CpmAtifSupportedNotificationMask, 0, 0, 0, 0, 0)
        If (And (CpmAtifSupportedNotificationMask, 0x01)) {
            // Display switch request
            // Set the request to pending state
            // Inform the display driver
            CreateBitField (CpmPendingSystemBIOSRequestBuffer, 0, CpmDisplaySwitchRequest)
            Store (One, CpmDisplaySwitchRequest)
            CpmDebugPrint ("    Notify (VGA, 0x%X)\n", AtifNotifyCommandCode, 0, 0, 0, 0, 0)
            Notify (VGA, AtifNotifyCommandCode)
        }
    } // End of Method (AFN0, 0, Serialized)

    // Arg0: Expansion mode
    Method (AFN1, 1, Serialized) {
        CpmDebugPrint ("  FEA-ASL-ATIF-AFN1  Supported Notification Mask = 0x%X  Save Expansion Mode = 0x%X\n", CpmAtifSupportedNotificationMask, Arg0, 0, 0, 0, 0)
        If (And (CpmAtifSupportedNotificationMask, 0x02)) {
            Store (Arg0, Local0)
            Store (Local0, CpmSaveExpansionMode)
            CreateBitField (CpmPendingSystemBIOSRequestBuffer, 0x01, CpmExpansionModeChangeRequest)
            Store (One, CpmExpansionModeChangeRequest)
            CpmDebugPrint ("    Notify (VGA, 0x%X)  Pending System BIOS Request Buffer = 0x%X\n", AtifNotifyCommandCode, CpmPendingSystemBIOSRequestBuffer, 0, 0, 0, 0)
            Notify (VGA, AtifNotifyCommandCode)
        }
    } // End of Method (AFN1, 1, Serialized)

    // Arg0: Thermal State: State Id
    // Arg1: Thermal State: Target Graphics Controller
    Method (AFN2, 2, Serialized) {
        CpmDebugPrint ("  FEA-ASL-ATIF-AFN2  Supported Notification Mask = 0x%X  Thermal State: State Id = 0x%X  Target Graphics Controller = 0x%X\n", CpmAtifSupportedNotificationMask, Arg0, Arg1, 0, 0, 0)
        If (And (CpmAtifSupportedNotificationMask, 0x04)) {
            Store (Arg0, Local0)
            Store (Local0, CpmSaveThermalStateStateId)
            Store (Arg1, Local0)
            Store (And (Local0, 0x03, Local0), CpmSaveThermalStateTargetGraphicsController)
            CreateBitField (CpmPendingSystemBIOSRequestBuffer, 0x02, CpmThermalStateChangeRequest)
            Store (One, CpmThermalStateChangeRequest)
            CpmDebugPrint ("    Notify (VGA, 0x%X)  Pending System BIOS Request Buffer = 0x%X\n", AtifNotifyCommandCode, CpmPendingSystemBIOSRequestBuffer, 0, 0, 0, 0)
            Notify (VGA, AtifNotifyCommandCode)
        }
    } // End of Method (AFN2, 2, Serialized)

    // Arg0: Forced Power State: State Id
    // Arg1: Forced Power State: Target Graphics Controller
    Method (AFN3, 2, Serialized) {
        CpmDebugPrint ("  FEA-ASL-ATIF-AFN3  Supported Notification Mask = 0x%X  Forced Power State: State Id = 0x%X  Target Graphics Controller = 0x%X\n", CpmAtifSupportedNotificationMask, Arg0, Arg1, 0, 0, 0)
        If (And (CpmAtifSupportedNotificationMask, 0x08)) {
            Store (Arg0, Local0)
            Store (Local0, CpmSaveForcedPowerStateStateId)
            Store (Arg1, Local0)
            Store (And (Local0, 0x03, Local0), CpmSaveForcedPowerStateTargetGraphicsController)
            CreateBitField (CpmPendingSystemBIOSRequestBuffer, 0x03, CpmForcedPowerStateChangeRequest)
            Store (One, CpmForcedPowerStateChangeRequest)
            CpmDebugPrint ("    Notify (VGA, 0x%X)  Pending System BIOS Request Buffer = 0x%X\n", AtifNotifyCommandCode, CpmPendingSystemBIOSRequestBuffer, 0, 0, 0, 0)
            Notify (VGA, AtifNotifyCommandCode)
        }
    } // End of Method (AFN3, 2, Serialized)

    // Arg0: System Power Source
    Method (AFN4, 1, Serialized) {
        CpmDebugPrint ("  FEA-ASL-ATIF-AFN4  Supported Notification Mask = 0x%X  System Power Source = 0x%X\n", CpmAtifSupportedNotificationMask, Arg0, 0, 0, 0, 0)
        If (And (CpmAtifSupportedNotificationMask, 0x10)) {
            Store (Arg0, Local0)
            Store (CpmSaveSystemPowerSource, Local1)
            Store (Local0, CpmSaveSystemPowerSource)
            If (LNotEqual (Local0, Local1)) {
                CreateBitField (CpmPendingSystemBIOSRequestBuffer, 0x04, CpmSystemPowerStateChangeRequest)
                Store (One, CpmSystemPowerStateChangeRequest)
                CpmDebugPrint ("    Notify (VGA, 0x%X)  Pending System BIOS Request Buffer = 0x%X\n", AtifNotifyCommandCode, CpmPendingSystemBIOSRequestBuffer, 0, 0, 0, 0)
                Notify (VGA, AtifNotifyCommandCode)
            }
        }
    } // End of Method (AFN4, 1, Serialized)

    Method (AFN5, 0, Serialized) {
        CpmDebugPrint ("  FEA-ASL-ATIF-AFN5  Supported Notification Mask = 0x%X\n", CpmAtifSupportedNotificationMask, 0, 0, 0, 0, 0)
        If (And (CpmAtifSupportedNotificationMask, 0x20)) {
            CreateBitField (CpmPendingSystemBIOSRequestBuffer, 0x05, CpmDisplayConfigurationChangeRequest)
            Store (One, CpmDisplayConfigurationChangeRequest)
            CpmDebugPrint ("    Notify (VGA, 0x%X)  Pending System BIOS Request Buffer = 0x%X\n", AtifNotifyCommandCode, CpmPendingSystemBIOSRequestBuffer, 0, 0, 0, 0)
            Notify (VGA, AtifNotifyCommandCode)
        }
    } // End of Method (AFN5, 0, Serialized)

    Method (AFN6, 0, Serialized) {
        CpmDebugPrint ("  FEA-ASL-ATIF-AFN6  Supported Notification Mask = 0x%X\n", CpmAtifSupportedNotificationMask, 0, 0, 0, 0, 0)
        If (And (CpmAtifSupportedNotificationMask, 0x40)) {
            // PowerXpress graphics switch toggle request
            // Set the request to pending state
            // Inform the display driver
            CreateBitField (CpmPendingSystemBIOSRequestBuffer, 6, CpmPowerXpressGraphicsSwitchToggleRequest)
            Store (One, CpmPowerXpressGraphicsSwitchToggleRequest)
            CpmDebugPrint ("    Notify (VGA, 0x%X)  Pending System BIOS Request Buffer = 0x%X\n", AtifNotifyCommandCode, CpmPendingSystemBIOSRequestBuffer, 0, 0, 0, 0)
            Notify (VGA, AtifNotifyCommandCode)
        }
    } // End of Method (AFN6, 0, Serialized)

    // Arg0: Panel Brightness: Backlight Level
    Method (AFN7, 1, Serialized) {
        CpmDebugPrint ("  FEA-ASL-ATIF-AFN7  Supported Notification Mask = 0x%X  Panel Brightness: Backlight Level = 0x%X\n", CpmAtifSupportedNotificationMask, Arg0, 0, 0, 0, 0)
        If (And (CpmAtifSupportedNotificationMask, 0x80)) {
            // if notification supported (BIT7)
            // Brightness level change request
            // Pending brightness level request
            CreateBitField (CpmPendingSystemBIOSRequestBuffer, 7, CpmPanelBrightnessLevelChangeRequest)
            Store (One, CpmPanelBrightnessLevelChangeRequest)

            CreateByteField (ATIB, 12, CpmPanelBrightnessBacklightLevel)  // Brightness Level
            Store (Arg0, CpmPanelBrightnessBacklightLevel)                // Brightness level
            CpmDebugPrint ("    Notify (VGA, 0x%X)  Pending System BIOS Request Buffer = 0x%X\n", AtifNotifyCommandCode, CpmPendingSystemBIOSRequestBuffer, 0, 0, 0, 0)
            Notify (VGA, AtifNotifyCommandCode)
        }
    } // End of Method (AFN7, 1, Serialized)

    Method (AFN8, 0, Serialized) {
        CpmDebugPrint ("  FEA-ASL-ATIF-AFN8  Supported Notification Mask = 0x%X\n", CpmAtifSupportedNotificationMask, 0, 0, 0, 0, 0)
        If (And (CpmAtifSupportedNotificationMask, 0x100)) {
            // if notification supported (BIT8)
            // Discrete GPU display connect state change request
            // Discrete GPU display connect state change request
            CreateBitField (CpmPendingSystemBIOSRequestBuffer, 8, CpmDgpuDisplayConnectStateChangeRequest)
            Store (One, CpmDgpuDisplayConnectStateChangeRequest)
            // CpmDebugPrint ("    Notify (VGA, 0x%X)  Pending System BIOS Request Buffer = 0x%X\n", AtifNotifyCommandCode, CpmPendingSystemBIOSRequestBuffer, 0, 0, 0, 0)
            // Move Notify (VGA, AtifNotifyCommandCode) from ATIF AFN8 () to General-Purpose Event \_GPE._Lxx in DisplayConnectEvent.asl.
        }
    } // End of Method (AFN8, 0, Serialized)

    // Arg0: Power Limit:   Target Graphics Controller (BYTE)
    //                      0 - Undefined, used on single graphics controller platforms.
    //                      1 - Integrated graphics controller, used on PX/HG enabled platforms.
    //                      2 - Discrete graphics controller, used on PX/HG enabled platforms.
    // Arg1: Power Limit:   Value (DWORD)
    //                      Bits  7-0: fraction of a Watt
    //                      Bits 31-8: Watts
    Method (AFNC, 2, Serialized) {
        CpmDebugPrint ("  FEA-ASL-ATIF-AFNC  Supported Notification Mask = 0x%X  Power Limit: Target Graphics Controller = 0x%X  Value = 0x%X\n", CpmAtifSupportedNotificationMask, Arg0, Arg1, 0, 0, 0)
        If (And (CpmAtifSupportedNotificationMask, 0x1000)) {
            // if notification supported (BIT12)
            And (Arg0, 0x03, Local0)
            Store (Local0, CpmSavePowerLimitTargetGraphicsController)
            And (Arg1, 0xFFFFFFFF, Local0)
            Store (Local0, CpmSavePowerLimitValue)
            CreateBitField (CpmPendingSystemBIOSRequestBuffer, 12, CpmPowerLimitRequest)  // Power limit request
            Store (One, CpmPowerLimitRequest)                                             // Power limit request
            CpmDebugPrint ("    Notify (VGA, 0x%X)  Pending System BIOS Request Buffer = 0x%X\n", AtifNotifyCommandCode, CpmPendingSystemBIOSRequestBuffer, 0, 0, 0, 0)
            Notify (VGA, AtifNotifyCommandCode)
        }
    } // End of Method (AFNC, 2, Serialized)
