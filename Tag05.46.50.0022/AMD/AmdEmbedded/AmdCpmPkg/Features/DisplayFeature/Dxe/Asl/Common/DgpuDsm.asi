  Method (_DSM, 0x4, Serialized) {
    Name (CpmDgpuDsmFunASupport, 0)
    Name (CpmDgpuDsmFunBSupport, 0)

    If (LEqual (Arg0, ToUUID("E5C937D0-3553-4D7A-9117-EA4D19C3434D"))) {
      Switch (ToInteger(Arg2)) {
        // Function 0: Query function, return based on revision
        Case (0) {
          // DSM Revision
          Name (CpmDgpuDsmBuffer, Buffer (2) {0x00, 0x00})
          CreateBitField (CpmDgpuDsmBuffer, 0x00, CpmDgpuDsmFunBit0)
          CreateBitField (CpmDgpuDsmBuffer, 0x05, CpmDgpuDsmFunBit5)
          CreateBitField (CpmDgpuDsmBuffer, 0x0A, CpmDgpuDsmFunBitA)
          CreateBitField (CpmDgpuDsmBuffer, 0x0B, CpmDgpuDsmFunBitB)
          If (LGreaterEqual (Arg1, 0x04)) {
            Store (0x01, CpmDgpuDsmFunBit0)
            Store (0x01, CpmDgpuDsmFunBit5)
            And (ShiftRight (CpmReadTable (CpmMainTable, Add (CpmDisplayFeature, 3)), 4), 1, CpmDgpuDsmFunASupport)     // BIT28: DgpuDsmFunASupport
            And (ShiftRight (CpmReadTable (CpmMainTable, Add (CpmDisplayFeature, 3)), 5), 1, CpmDgpuDsmFunBSupport)     // BIT29: DgpuDsmFunBSupport
            If (LEqual (CpmDgpuDsmFunASupport, 1)) {
              Store (0x01, CpmDgpuDsmFunBitA)
            }
            If (LEqual (CpmDgpuDsmFunBSupport, 1)) {
              Store (0x01, CpmDgpuDsmFunBitB)
            }
          } else {
            Store (0x01, CpmDgpuDsmFunBit0)
            Store (0x01, CpmDgpuDsmFunBit5)
          }
          Return (CpmDgpuDsmBuffer)
        }

        // Function 05h: Ignoring PCI Boot Configurations
        // Arg3: Integer.
        // Return:
        //    0h - No (The operating system shall not ignore the PCI configuration
        //         that firmware has done at boot time. However, the operating system
        //         is free to configure the devices in this hierarchy that have not
        //         been configured by the firmware. There may be a reduced level of
        //         hot plug capability support in this hierarchy due to resource
        //         constraints. This situation is the same as the legacy situation
        //         where this _DSM is not provided.)
        //    1h - Yes (The operating system may ignore the PCI configuration that
        //         the firmware has done at boot time, and reconfigure/rebalance the
        //         resources in the hierarchy.)
        Case (0x05) {
          Return (0x0)
        }

        // Function 0Ah: Request D3cold Aux Power Limit
        // Arg3: Integer. The value of the integer is the amount of power requested.
        // Return:
        //    0h - Denied.
        //    1h - Granted.  //AM4 is a desktop project, we don't know which power supply is connected, always return Granted.
        //    2h - No main power removal.
        //    11h - 1Fh - Retry.
        Case (0x0A) {
          Return (0x01)
        }

        // Function 0Bh: Add PERST# Assertion Delay
        // Arg3:  Integer. The value, in microseconds, of the delay needed between the PME_TO_Ack
        //        message receipt at the PCI Express Downstream Port that originated the PME_Turn_Off
        //        message, and the subsequent assertion of PERST# on the corresponding slot.
        // Return:
        //        Integer: If the request succeeded, it returns the value specified in Arg3. If the request failed
        //        (e.g., if the request in Arg3 is greater than 10ms), it returns the value specified in Arg3 in
        //        most recent successful request or 0 if there was no such request.
        Case (0x0B) {
          Store (ToInteger(Arg3), Local0)
          If (LLessEqual (Local0, 10000)) {
            Store (10000, \_SB.PCI0.PB2.CpmDgpuDsmFunBData)
          } Else {
            Store (10000, Local0)
          }
          Return (Local0)
        }

        // Other function no support
        default {
          Return (0x00)
        }
      } // End of Switch (ToInteger(Arg2))
    } Else {
      Return (Buffer (One) { 0x00 })
    }
  }

