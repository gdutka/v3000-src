[PcdsFeatureFlag]

#----------------------------------------------------------------------------
#- Start documentation of user configurable controls
### Set Doxy_path: "PCD-Sys.h"
#----------------------------------------------------------------------------

[PcdsFixedAtBuild]

  ### This token, when TRUE, will display the following Event Log contents
  ### at the end of the UEFI boot up sequence.
  ### Customer can use it to display info per their need. Not all of the error log will be
  ### displayed, just the items with the listed topics. Note: the console output
  ### must be enabled for the platform. The items displayed are:
  ###  - display PMU training error detail info.
  ###  - ABL_MEM_PMU_TRAIN_ERROR
  ###  - ABL_MEM_AGESA_MEMORY_TEST_ERROR
  ###  - ABL_MEM_ERROR_MIXED_ECC_AND_NON_ECC_DIMM_IN_SYSTEM
  ###  - ABL_MEM_ERROR_LRDIMM_MIXMFG
  ###  - ABL_CCD_BIST_FAILURE
  ### <p>When FALSE, no output is generated.
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdAgesaPrintEventLogToConsole|FALSE|BOOLEAN|0x0002000E


#----------------------------------------------------------------------------
#-  FCH Fixed PCDs
#-
### Set Doxy_path: "PCD-FCH.h"
#----------------------------------------------------------------------------

  ### @brief Base address for the SMBus controller.
  ###
  ### Allows the host BIOS to set the base IO address used for the SMBus 0 controller.
  ### The SMBus1 controller base address is at a fixed offset from the base0 address.
  ### The size of this block is defined in the Processor Programmers Reference (PPR).
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdAmdFchCfgSmbus0BaseAddress|0x0B00|UINT16|0x0002F001

  ### @brief Base Address for the SIO.
  ###
  ### This item sets the IO Base address for the SIO block of command registers.
  ### The size of this block depends on the SIO chosen.
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdAmdFchCfgSioPmeBaseAddress|0xE00|UINT16|0x0002F003

  ### @brief IO address for APCI EVT
  ###
  ### Allows the host BIOS to specify the IO address for the ACPI PM1 register
  ### blocks as defined by the ACPI spec.
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdAmdFchCfgAcpiPm1EvtBlkAddr|0x400|UINT16|0x0002F004

  ### @brief IO address for ACPI CNT
  ###
  ### Allows the host BIOS to specify the IO address for the ACPI PM1Cnt register
  ### blocks as defined by the ACPI spec.
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdAmdFchCfgAcpiPm1CntBlkAddr|0x404|UINT16|0x0002F005

  ### @brief IO address for ACPI TMR
  ###
  ###  Allows the host BIOS to specify the IO address for the ACPI PM Timer as
  ### defined by the ACPI spec.
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdAmdFchCfgAcpiPmTmrBlkAddr|0x408|UINT16|0x0002F006

  ### @brief IO address for ACPI CTL
  ###
  ### Allows the host BIOS to specify the IO address for the ACPI CPU Control
  ### block as defined by the ACPI spec.
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdAmdFchCfgCpuControlBlkAddr|0x410|UINT16|0x0002F007

  ### @brief IO address for the ACPI GPE
  ###
  ### Allows the host BIOS to specify the IO address for the ACPI GPE0 register
  ### block as defined by the ACPI spec.
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdAmdFchCfgAcpiGpe0BlkAddr|0x420|UINT16|0x0002F008

  ### @brief SMI cmd value
  ###
  ### This item defines the SMI command value sent by the host BIOS during the
  ### S3 resume sequence, to reinitialize the FCH registers. This must be issued
  ### before the platform driver restore function is started.
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdFchOemBeforePciRestoreSwSmi|0xD3|UINT8|0x0002F010

  ### @brief SMI cmd value
  ###
  ### This item defines the SMI command used by the host BIOS to signal the
  ### FCH driver that the platform driver has completed its restore function.
  ### This allows the FCH driver to perform some final FCH settings.
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdFchOemAfterPciRestoreSwSmi|0xD4|UINT8|0x0002F011

  ### @brief SMI cmd value
  ###
  ### Allows the host BIOS to set the SMI command value used by the OS to activate ACPI mode.
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdFchOemEnableAcpiSwSmi|0xA0|UINT8|0x0002F012

  ### @brief SMI cmd value
  ###
  ### Allows the host BIOS to set the SMI command value used by the OS to
  ### turn off ACPI mode.
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdFchOemDisableAcpiSwSmi|0xA1|UINT8|0x0002F013

  ### @brief SMI cmd value
  ###
  ###  SMI command for setting the lock mode in the SPI controller. This will
  ### effectively provide a write protection to the SPI Flash ROM; however,
  ### write access to secondary SPI devices will also be blocked.
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdFchOemSpiUnlockSwSmi|0xAA|UINT8|0x0002F014

  ### @brief  SMI cmd value
  ###
  ### SMI command used for releasing the SPI controller lock mode. All devices
  ### on the SPI bus will be writable.
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdFchOemSpiLockSwSmi|0xAB|UINT8|0x0002F015

  gEfiAmdAgesaPkgTokenSpaceGuid.PcdFchOemStartTimerSmi|0xBC|UINT8|0x0002F016
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdFchOemStopTimerSmi|0xBD|UINT8|0x0002F017

  ### @name IRQ_assignments
  ### IRQ assignments for the UART & I2C ports
  ### @{
  ### These controls allow the platform to specify which IRQs the devices
  ### should use. Between the UART and I2C ports, it is recommended that no two
  ### ports use the same IRQ. Control of which ports are enabled is handled
  ### by FchRTDeviceEnableMap.

  gEfiAmdAgesaPkgTokenSpaceGuid.PcdFchUart0Irq|0x03|UINT8|0x0002F01A
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdFchUart1Irq|0x04|UINT8|0x0002F01B
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdFchUart2Irq|0x03|UINT8|0x0002F01C
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdFchUart3Irq|0x04|UINT8|0x0002F01D
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdFchUart4Irq|0x0F|UINT8|0x0002F01E
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdFchI2c0Irq|0x0A|UINT8|0x0002F01F
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdFchI2c1Irq|0x0B|UINT8|0x0002F020
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdFchI2c2Irq|0x04|UINT8|0x0002F021
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdFchI2c3Irq|0x06|UINT8|0x0002F022
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdFchI2c4Irq|0x0E|UINT8|0x0002F023
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdFchI2c5Irq|0x0F|UINT8|0x0002F024
  ### @} end IRQ_assignments

  ### @brief  Force full Hard Reset for 'cold'
  ###
  ### This items selects the action to be taken when the system requests a 'cold reset'.
  ###  - False: Assert Reset signals only. This will be quicker.
  ###  - True:  place system in S5 state for 3 to 5 seconds. This causes
  ### power Good to de-assert. Return to operation will take longer.
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdFchFullHardReset|FALSE|BOOLEAN|0x0002F02A

#----------------------------------------------------------------------------
#-  CCX Fixed PCDs
#-
### Set Doxy_path: "PCD-CCX.h"
#----------------------------------------------------------------------------

  ### @brief Number of IO APICs in the system
  ### @details This element provides the number of IO APICs that are used on the
  ### motherboard. This is used by the software to appropriately assign APIC IDs
  ### to the processors, leaving room for the motherboard devices.
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdAmdNumberOfIoApics|3|UINT8|0x000CA000

  #Fabric

  ### @brief MMIO Reserved for Die0-RB0.
  ### @details This entry specifies an address in the below 4GB space that starts
  ### a reserved MMIO region. The space from this address to the 0xFEE0_0000
  ### address ('COMPAT' region) will be reserved for devices connected to Die0
  ### to use as MMIO space. This address should be at the end of, or above, the
  ### PCIe general allocation zone (Base + size).
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdAmdBottomMmioReservedForPrimaryRb|0xFE000000|UINT32|0x000CC100

  ### @brief Number of physical sockets.
  ### @details This item informs the SMBios generation code as to how many physical
  ### processor sockets exist in the system and therefore how many
  ### Type 4 SMBios records to produce.
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdAmdNumberOfPhysicalSocket|1|UINT8|0x000CC103

  ### @brief MMIO for non-PCI
  ### @details Every Root Bridge has a non-PCI MMIO pool for items such as the PSP or IOMMU.
  ### This PCD defines the size of that pool to be allocated below the 4G boundary.
  ### The default is 16MB per Root Bridge.
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdAmdMmioSizePerRbForNonPciDevice|0x1000000|UINT32|0x000CC104

  ### @brief MMIO for non-PCI above 4G
  ### @details Specifies the top address to be used for MMIO space allocations.
  ### No MMIO space will be used above this limit. Some devices have limits on the
  ### address space they are able to access. For example a device with a 40-bit
  ### address limitation can't use MMIO space above 1TeraByte (1T). By setting
  ### this PCD to 0x10000000000 (1T), MMIO space would not be allocated above 1T.
  ### This is applied per-RootBridge with a default of 518M per root bridge
  ### is to use all of the space above the end of physical memory.
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdAmdAbove4GMmioSizePerRbForNonPciDevice|0x20200000|UINT32|0x000CC105

