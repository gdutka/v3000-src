#-  DF Dynamic PCDs
### Set Doxy_path: "PCD-DF.h"
#----------------------------------------------------------------------------

  ### @cond (BIXBY || RV || ZP || FF3 || RN || BA || GN || RMB || RPL || SSP || PHX || RS)
  ### @brief Enable Data Fabric PState support
  ### @details This value controls whether AGESA will enable P-State support.
  ### P-states refers to performance states for a given Socket/die.
  ### This PCD is used to make run time decisions on P-state enablement.
  ### @li TRUE  - AGESA will enable Pstate support.
  ### @li FALSE - AGESA will disable Pstate support.
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdAmdFabricPstateSupport|TRUE|BOOLEAN|0x000DF000  # BR
  ### @endcond

  ### @cond (RV || ZP || FF3 || RN || BA || GN || RMB || RPL || SSP || PHX || RS)
  ### @brief Fabric ECC Scrub Redirection
  ### @details This value controls whether AGESA will enable ECC Scrub Redirection.
  ### @li TRUE  - Enable ECC Scrub Redirection.
  ### @li FALSE - Disable ECC Scrub Redirection.
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdAmdFabricEccScrubRedirection|TRUE|BOOLEAN|0x000DF001
  ### @endcond

  ### @cond (FF3 || RN || BA || GN || RMB || RPL || SSP)
  ### @brief Fabric ECC Scrub Poisoned.
  ### @details This value controls whether AGESA will enable ECC Scrub data poisoning.
  ### @li TRUE  - Enable ECC Scrub Data poisioning.
  ### @li FALSE - Disable ECC Scrub Data poisioning.
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdAmdFabricEccScrubPoisoned|TRUE|BOOLEAN|0x000DF002
  ### @endcond

  ### @cond (FF3 || RN || BA || GN || RMB || RPL || SSP)
  ### @brief Fabric ECC Scrub Redirection limit.
  ### @details This value controls whether AGESA will set ECC Scrub Redirection limit.
  ### Only works when either PcdAmdFabricEccScrubRedirection or PcdAmdFabricEccScrubPoisoned is TRUE
  ### @li 0 - Infinite
  ### @li 1 - 2.
  ### @li 2 - 4.
  ### @li 3 - 8.
  ### @li 0xFF - Auto
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdAmdFabricEccScrubRedirectionLimit|0x3|UINT8|0x000DF003
  ### @endcond

  ### @cond (FF3 || RN || BA || GN || RMB || RPL || SSP)
  ### @brief Fabric DRAM Scrub Time
  ### @details This value set the time for Fabric DRAM scrub.
  ### @li 0 - Disable
  ### @li 24 - 24 hours (default)
  ### @li 0xFF - Auto
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdAmdFabricDramScrubTime|0xFF|UINT8|0x000DF004
  ### @endcond

  ### @cond (FF3 || RN || BA || GN || RMB || RPL || SSP)
  ### @brief Fabric Watch Dog timer configuration
  ### @details This value set the value for the Fabric Watchdog timer.
  ### @li 0 - 1.31ms
  ### @li 1 - 1.28us
  ### @li 2 - 10ns
  ### @li 3 - Disabled
  ### @li 0xFF - Auto
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdAmdFabricWdtCfg|0xFF|UINT8|0x000DF005
  ### @endcond

  ### @cond (FF3 || RN || BA || GN || RMB || RPL || SSP)
  ### @brief Fabric Watch Dog timer control selection
  ### @details This value sets the Watch Dog timer control selection value
  ### @li 0: 31
  ### @li 1: 127
  ### @li 2: 255
  ### @li 3: 511
  ### @li 4: 1023
  ### @li 5: 2047
  ### @li 6: 4095
  ### @li 7: 16383
  ### @li 0xFF - Auto
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdAmdFabricWdtCntSel|0xFF|UINT8|0x000DF006
  ### @endcond

  ### @cond (FF3 || RN || BA || ZP || RMB || RPL)
  ### @brief Fabric Watch Dog timer control selection
