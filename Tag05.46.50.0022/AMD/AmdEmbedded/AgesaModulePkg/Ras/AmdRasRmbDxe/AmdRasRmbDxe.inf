[defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = AmdRasRmbDxe
  FILE_GUID                      = 5DA5F0F7-4209-42E2-956C-BE6792C64A37
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = AmdRasRmbDxeInit

[sources]
