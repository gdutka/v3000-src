[defines]

[defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = Cf9Reset
  FILE_GUID                      = 3F4592F4-D5DE-4C29-883E-63434BBE0B33
  MODULE_TYPE                    = DXE_RUNTIME_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = InitializeCf9Reset

[sources.common]
  Cf9Reset.c
  Cf9Reset.h

[LibraryClasses.common.DXE_DRIVER]
  BaseLib 
  UefiLib
  PrintLib
  IoLib
  FchBaseLib

[LibraryClasses]
  BaseMemoryLib
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  DebugLib
  UefiRuntimeServicesTableLib

[Guids]
  gEfiAmdAgesaSpecificWarmResetGuid

[Protocols]
  gEfiResetArchProtocolGuid      #PRODUCED


[Packages]
  MdePkg/MdePkg.dec
  AgesaPkg/AgesaPkg.dec
  AgesaModulePkg/AgesaModuleFchPkg.dec
  AgesaModulePkg/Fch/Keith/FchKeith.dec

[Pcd]
  gEfiAmdAgesaPkgTokenSpaceGuid.PcdFchFullHardReset

[Depex]
  gEfiCpuIo2ProtocolGuid  AND
  gAmdFchKeithDepexProtocolGuid


