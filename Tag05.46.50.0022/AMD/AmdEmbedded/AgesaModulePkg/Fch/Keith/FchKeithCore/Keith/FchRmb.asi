      Case (2)  { Store (0xE8, IOLO) Store (0x03, IOHI) Store (0xE8, IORL) Store (0x03, IORH) }
      Case (3)  { Store (0xF8, IOLO) Store (0x03, IOHI) Store (0xF8, IORL) Store (0x03, IORH) }
    }
    //
