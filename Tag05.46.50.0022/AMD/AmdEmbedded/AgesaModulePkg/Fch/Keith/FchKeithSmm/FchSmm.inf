  DebugLib
  SmmServicesTableLib
  UefiRuntimeServicesTableLib
  UefiBootServicesTableLib
  DevicePathLib
  MemoryAllocationLib
  NbioHandleLib
  NbioSmuV13Lib
  AmdPspMboxLibV2

  HobLib
  UefiLib

  PcdLib

[Pcd]
