  AgesaModulePkg/AgesaModuleDfPkg.dec
  AgesaModulePkg/AgesaModuleFchPkg.dec
  AgesaModulePkg/AgesaModuleNbioPkg.dec
  AgesaPkg/AgesaPkg.dec

[LibraryClasses]
  BaseLib
  PcdLib
  PeimEntryPoint
  PeiServicesLib
  AmdBaseLib
  AmdPspMboxLibV2
  AmdPspBaseLibV2
  AmdPspApobLib
  AmdErrorLogLib
  FchBaseLib
  AmdCapsuleLib
  HobLib
  AmdPspPsbFusingLib
