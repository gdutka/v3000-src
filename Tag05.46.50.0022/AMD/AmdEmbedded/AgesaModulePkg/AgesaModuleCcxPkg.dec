[PcdsDynamic]
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdCcxCfgApmEnable|TRUE|BOOLEAN|0x000CC001
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdCcxCfgCFOHEnable|TRUE|BOOLEAN|0x000CC002
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdAcpiPstateObjEnable|TRUE|BOOLEAN|0x000CC004
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdCpuWdtSeverity|0xFF|UINT8|0x000CC005                  # For VH, Control MSRC001_0074[CpuWdTmrCfgSeverity], 0xFF means leave it at reset value
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdApicMode|0xFF|UINT8|0x000CC006                        # For CB, Apic mode:
                                                                                                  #  0xFF (auto)
                                                                                                  #  0x00 (CompatibilityMode) - threads below 255 run in xAPIC with xAPIC ACPI structures and threads 255 & above run in x2 mode with x2 ACPI structures
                                                                                                  #  0x01 (xApicMode) - force legacy xApic mode (downcores if enabled threads are >= 255)
                                                                                                  #  0x02 (x2ApicMode) - force x2Apic mode independent of thread count
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdRedirectForReturnDis|0xFF|UINT8|0x000CC007            # MSR_C001_1029[14]
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdOpcacheCtrl|0xFF|UINT8|0x000CC008                     # MSR_C001_1021[5]
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdStreamingStoresCtrl|0xFF|UINT8|0x000CC009             # MSR_C001_1020[28]
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdCcxP0Setting|0x2|UINT8|0x000CC00A                     # 1- Custom; 2- Auto (For all)
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdCcxP0Fid|0xF|UINT8|0x000CC00B                         # FID (For ZP, RV)
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdCcxP0Did|0x8|UINT8|0x000CC00C                         # DID (For ZP, RV)
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdCcxP0Vid|0xFF|UINT8|0x000CC00D                        # VID (For all)
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdCcxP0Freq|0xFFFFFFFF|UINT32|0x000CC00E                # Frequency (For VH, PCO AM4)
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdSmmLock|TRUE|BOOLEAN|0x000CC00F                       # Set MSR_C001_0015[0][SmmLock]
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdCoreDisCcd0|0|UINT16|0x000CC010                       # CoreDis bit map for physical CCD0.  Set bit[x] = 1 could down logical core x#
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdCoreDisCcd1|0|UINT16|0x000CC011                       # CoreDis bit map for physical CCD1.  Set bit[x] = 1 could down logical core x#
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdCoreDisCcd2|0|UINT16|0x000CC012                       # CoreDis bit map for physical CCD2.  Set bit[x] = 1 could down logical core x#
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdCoreDisCcd3|0|UINT16|0x000CC013                       # CoreDis bit map for physical CCD3.  Set bit[x] = 1 could down logical core x#
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdCoreDisCcd4|0|UINT16|0x000CC014                       # CoreDis bit map for physical CCD4.  Set bit[x] = 1 could down logical core x#
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdCoreDisCcd5|0|UINT16|0x000CC015                       # CoreDis bit map for physical CCD5.  Set bit[x] = 1 could down logical core x#
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdCoreDisCcd6|0|UINT16|0x000CC016                       # CoreDis bit map for physical CCD6.  Set bit[x] = 1 could down logical core x#
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdCoreDisCcd7|0|UINT16|0x000CC017                       # CoreDis bit map for physical CCD7.  Set bit[x] = 1 could down logical core x#
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdCoreDisCcd8|0|UINT16|0x000CC018                       # CoreDis bit map for physical CCD8.  Set bit[x] = 1 could down logical core x#
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdCoreDisCcd9|0|UINT16|0x000CC019                       # CoreDis bit map for physical CCD9.  Set bit[x] = 1 could down logical core x#
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdCoreDisCcd10|0|UINT16|0x000CC01A                      # CoreDis bit map for physical CCD10. Set bit[x] = 1 could down logical core x#
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdCoreDisCcd11|0|UINT16|0x000CC01B                      # CoreDis bit map for physical CCD11. Set bit[x] = 1 could down logical core x#
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdGameMode|FALSE|BOOLEAN|0x000CC01C                     # CP. Game mode.
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdDownCoreSmtWarmResetStall|0x20000|UINT32|0x000CC01D   # PCO Microseconds to delay before warm reset request after downcore and SMT disable control
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdIbrsEn|FALSE|BOOLEAN|0x000CC01E                       # MTS. Enable Indirect Branch Prediction Speculation
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdCcxEnabledFeatures|0|UINT32|0x000CC01F                # Capabilities about current running processor
                                                                                                  #  Bit 0: LPI capable (For RN, CZN)
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdSvmLock|TRUE|BOOLEAN|0x000CC020                       # Set MSR_C001_0114[3]
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdSvmEnable|TRUE|BOOLEAN|0x000CC021                     # Clear MSR_C001_0114[4]
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdBranchSampling|FALSE|BOOLEAN|0x000CC022               # For MSR_C001_10DC[31] of GN Bx
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdVmplEnable|TRUE|BOOLEAN|0x000CC023                    # GN. Enable VMPL
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdCcxSingleBitErrLogging|FALSE|BOOLEAN|0x000CC024       # GN. Single bit transparent error logging
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdEnSpecStFill|TRUE|BOOLEAN|0x000CC025                  # For MSR_LS_CFG3[26][EnSpecStFill] (for GN)
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdEnableFSRM|FALSE|BOOLEAN|0x000CC026                   # Fast Short REP MOVSB (For Zen3 and Zen4)
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdEnableERMS|FALSE|BOOLEAN|0x000CC027                   # Enhanced REP MOVSB/STOSB (For Zen3 and Zen4)
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdEnableSvmAVIC|FALSE|BOOLEAN|0x000CC028                # GN. Enable SVM AVIC
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdIbsHardwareEn|FALSE|BOOLEAN|0x000CC029                # For core Cerberus B0, set MSR_C001_1020[54]
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdEnableRMSS|FALSE|BOOLEAN|0x000CC02A                   # REP-MOV/STOS Streaming (For Zen3 and Zen4)
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdPsdGrouping|0xFF|UINT8|0x000CC02B                     # GN. Switch the grouping of Pstate Dependencty (_PSD)

  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdCcxPxAutoSetting|0x2|UINT8|0x000CC02C                 # GN Pstate default 2- Auto
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdCcxPxAutoFreq|0xFFFFFFFF|UINT32|0x000CC02D            # GN Default Frequency
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdNewDownCoreSequence|FALSE|BOOLEAN|0x000CC02E          # 0 - Downcore in x86 AGESA; 1 - Downcore in ABL

  # RS
  ### Enable SVM x2AVIC.
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdEnableSvmX2AVIC|TRUE|BOOLEAN|0x000CC02F

  ### Enable AVX512.
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdCcxEnableAvx512|0xFF|UINT8|0x000CC030

