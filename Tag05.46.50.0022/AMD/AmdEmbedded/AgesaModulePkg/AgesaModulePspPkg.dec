[PcdsFeatureFlag]


[PcdsFixedAtBuild]


  #Switch to control PSP recovery flag detecting
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdPspRecoveryFlagDetectEnable|TRUE|BOOLEAN|0x00040009 #TRUE:  Enable
                                                                                          #FALSE: Disable

  #Switch to control if required to clear SMM lock on S3 exit
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdS3SmmLockClearEnable|TRUE|BOOLEAN|0x0004000A #TRUE:  Enable
                                                                                          #FALSE: Disable


  #page count to allocate SMM buffer to hold C2P message after bootdone. Smm buffer size = PcdAmdPspSmmBufferPages * EFI_PAGE_SIZE
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdPspSmmBufferPages|12|UINT32|0x00040052


  # Enable APCB with HMAC
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdApcbUseHmacChecksum|FALSE|BOOLEAN|0x00040053


  # Do not provide Apcb DXE services after SmmLock.
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdLockApcbDxeAfterSmmLock|FALSE|BOOLEAN|0x00040054


  # Valid if PcdLockApcbDxeAfterSmmLock is TRUE
  # It is for debug purpose. When PcdApcbUseHmacChecksum is TRUE and PcdLockApcbDxeAfterSmmLock is TRUE,
  # This PCD can reenable Apcb DXE services after SmmLock. It will transfer DXE access to SMM access.
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdTransferApcbDxeToSmmAfterSmmLock|FALSE|BOOLEAN|0x00040055


[PcdsDynamic]
  #Note: PcdAmdPspEnable switch to turn off all PSP driver execution, is for internal verification ONLY
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdPspEnable|TRUE|BOOLEAN|0x00040000 #TRUE:  Enable
                                                                              #FALSE: Disable
  # Record address of APCB shadow copy
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdApcbShadowAddress|0|UINT64|0x00040004

  ### @brief Record address of APCB variable struct address
  ### @details Record address of APCB variable struct address, and the default value must be 0.
  ### @li 0: default value
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdApcbVariableStructAddress|0|UINT64|0x00040005

  #Note: Switch between Absolute/Simple protocol for KVM
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdPspKvmMbox|FALSE|BOOLEAN|0x0004000F #TRUE:  Enable
                                                                          #FALSE: Disable

  #Note: to indicate system in PSP recovery mode or not
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdPspRecoveryDetected|FALSE|BOOLEAN|0x00040015 #TRUE:  Enable
                                                                                         #FALSE: Disable
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdFlashUpdateTempRuntimeBufferAddress|0|UINT64|0x00040016
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdPspNvramClearRequest|FALSE|BOOLEAN|0x00040017

  ### @brief Switch to turn off all Hsp AGESA code path execution
  ### @details When set to FALSE, turn off all Hsp AGESA code path execution.
  ### @li TRUE:  Enable
  ### @li FALSE: Disable
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdHspCoreEnable|TRUE|BOOLEAN|0x00040026

  #Note: HSP PCIe Agent BAR0
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdHspMmioBase|0|UINT32|0x00040027
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdHspBDF|0x2|UINT16|0x00040029                                  # HSP:      Bus[XX] Dev[0] Fn[2]    Bit[15:8] - Bus Number; Bit[7:3] - Device Number; Bit[2:0] - Function Number
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdHspUpBridgeBDF|0x43|UINT16|0x0004002A                         # UpBridge: Bus[00] Dev[8] Fn[3]    Bit[15:8] - Bus Number; Bit[7:3] - Device Number; Bit[2:0] - Function Number
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdAmdHspAcpiFenceEnable|TRUE|BOOLEAN|0x0004002B                       # FALSE: PCI Fence, TRUE: ACPI Fence

[PcdsFixedAtBuild, PcdsDynamic]
