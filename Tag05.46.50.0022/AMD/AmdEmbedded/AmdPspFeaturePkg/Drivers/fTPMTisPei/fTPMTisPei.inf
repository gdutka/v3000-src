[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = fTPMTisPei
  FILE_GUID                      = 11CDB71A-AA09-4b1b-BC58-F99838A4980D
  MODULE_TYPE                    = PEIM
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = PeimEntry

#
# The following information is for reference only and not required by the build tools.
#
#  VALID_ARCHITECTURES           = IA32 X64 IPF EBC
#

[Sources]
  fTPMTisPei.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  SecurityPkg/SecurityPkg.dec
  InsydeModulePkg/InsydeModulePkg.dec
  AgesaPkg/AgesaPkg.dec
  $(CHIPSET_PKG)/$(CHIPSET_PKG).dec
  AgesaModulePkg/AgesaCommonModulePkg.dec
  AgesaModulePkg/AgesaModulePspPkg.dec

[LibraryClasses]
  HobLib
  PeimEntryPoint
  PeiServicesLib
  BaseMemoryLib
  DebugLib
  PeiServicesTablePointerLib
  ChipsetConfigLib
  Tpm2CommandLib                                                # HSP EDKII Base prex86 Event Log.
  PcdLib

[Ppis]
  gPeiTpm2InterfacePpiGuid
  gAmdFtpmPpiGuid

[Guids]
  gEfiTpmDeviceSelectedGuid
  gEfiTpmDeviceInstanceTpm20FtpmGuid
  gTcgEvent2EntryHobGuid                                        ## SOMETIMES_CONSUMES  ## HOB

[Pcd]
