[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = InternalRuntimeCryptLib
  FILE_GUID                      = 5B535A58-B52C-456c-B0DD-D2FBA20F6041
  MODULE_TYPE                    = DXE_DRIVER
