[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = TcmDeviceLib
  FILE_GUID                      = 9E9BA8D4-1F84-4e9e-A04B-C32BD2A49996
  MODULE_TYPE                    = BASE
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = TcmDeviceLib

#
# The following information is for reference only and not required by the build tools.
