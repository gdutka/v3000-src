[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = TcmDxe
  FILE_GUID                      = F0D65400-8C8D-4c0a-B82A-0BBA4184632E
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
