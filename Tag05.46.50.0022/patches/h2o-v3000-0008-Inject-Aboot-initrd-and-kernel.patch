index d4e2b7f2..b3523419 100644
--- a/Insyde/InsydeModulePkg/Library/GenericBdsLib/BdsBootOption.c
+++ b/Insyde/InsydeModulePkg/Library/GenericBdsLib/BdsBootOption.c
@@ -1194,6 +1194,83 @@ Exit:
   }
 }
 
+/**
+  Create a device path to the Aboot file.
+
+  This device path must be freed with the FreePool () function.
+
+  @retval EFI_SUCCESS           The operation was successful.
+  @retval EFI_OUT_OF_RESOURCES  Memory allocation failed.
+  @retval Other                 Failed to locate the load image device path.
+
+**/
+EFI_STATUS
+GetAbootFileDevicePath (
+  OUT EFI_DEVICE_PATH_PROTOCOL **DevicePath
+  )
+{
+  EFI_LOADED_IMAGE_PROTOCOL         *LoadedImage;
+  MEDIA_FW_VOL_FILEPATH_DEVICE_PATH FileNode;
+  EFI_STATUS                        Status;
+
+  Status = gBS->HandleProtocol (
+                  gImageHandle,
+                  &gEfiLoadedImageProtocolGuid,
+                  (VOID **)&LoadedImage
+                  );
+
+  if (EFI_ERROR (Status)) {
+    *DevicePath = NULL;
+    return Status;
+  }
+
+  *DevicePath = DevicePathFromHandle (LoadedImage->DeviceHandle);
+  EfiInitializeFwVolDevicepathNode (&FileNode, &gAbootFileGuid);
+  *DevicePath = AppendDevicePathNode (*DevicePath, (EFI_DEVICE_PATH_PROTOCOL *) &FileNode);
+
+  if (*DevicePath == NULL) {
+    Status = EFI_OUT_OF_RESOURCES;
+  }
+
+  return Status;
+}
+
+/**
+  Enumerate the Aboot boot option.
+
+  @retval EFI_SUCCESS           The operation was successful, or Aboot was already present in the boot order.
+  @retval EFI_OUT_OF_RESOURCES  Memory allocation failed.
+  @retval Other                 Failed to locate the load image device path.
+
+**/
+EFI_STATUS
+EnumerateAbootBootOption (
+  VOID
+  )
+{
+  EFI_STATUS                        Status;
+  EFI_DEVICE_PATH_PROTOCOL          *DevicePath;
+
+  Status = GetAbootFileDevicePath (&DevicePath);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  if (IsAlreadyInBootOrder (DevicePath)) {
+    goto Exit;
+  }
+
+  //
+  // Create and register the Aboot boot option
+  //
+  Status = BdsLibRegisterNewOption (NULL, DevicePath, L"Aboot bootloader", L"BootOrder", NULL, 0);
+
+Exit:
+  FreePool (DevicePath);
+
+  return Status;
+}
+
