diff --git a/Insyde/InsydeModulePkg/Universal/BdsDxe/BdsEntry.c b/Insyde/InsydeModulePkg/Universal/BdsDxe/BdsEntry.c
index e9d3129a..840912c1 100644
--- a/Insyde/InsydeModulePkg/Universal/BdsDxe/BdsEntry.c
