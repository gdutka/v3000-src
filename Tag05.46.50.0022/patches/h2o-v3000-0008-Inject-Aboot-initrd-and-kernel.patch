    return TRUE;
 }
 
+/**
+  Internal function to find the Aboot boot option in the boot option list.
+
+  @param[out] BootLists    Pointer to boot list
+
+  @retval BootOption       The Aboot boot option was located successfully.
+  @return NULL             An error occurred.
+**/
+STATIC
+H2O_BDS_LOAD_OPTION *
+FindAbootBootOption (
+  LIST_ENTRY                    *BootLists
+  )
+{
+  EFI_STATUS                Status;
+  LIST_ENTRY                *Link;
+  H2O_BDS_LOAD_OPTION       *BootOption;
+  H2O_BDS_LOAD_OPTION       *ExpandedBootOption;
+  EFI_DEVICE_PATH_PROTOCOL  *AbootFileDevicePath;
+  UINTN                     AbootFileDevicePathSize;
+  EFI_DEVICE_PATH_PROTOCOL  *DevicePath;
+
+  if (BootLists == NULL) {
+    return NULL;
+  }
+  
+  Status = GetAbootFileDevicePath (&AbootFileDevicePath);
+  if (EFI_ERROR (Status)) {
+    return NULL;
+  }
+  AbootFileDevicePathSize = GetDevicePathSize (AbootFileDevicePath);
+
+  for (Link = GetFirstNode (BootLists); Link != BootLists; Link = GetNextNode (BootLists, Link)) {
+    BootOption = BDS_OPTION_FROM_LINK (Link);
+
+    // Skip inactive boot options
+    if (!IS_LOAD_OPTION_TYPE (BootOption->Attributes, LOAD_OPTION_ACTIVE)) {
+      continue;
+    }
+
+    // Obtain the boot option's device path
+    if (BootOption->Expanded && !IsListEmpty (&BootOption->ExpandedLoadOptions)) {
+      ExpandedBootOption = BDS_OPTION_FROM_LINK (BootOption->ExpandedLoadOptions.ForwardLink);
+      DevicePath = ExpandedBootOption->DevicePath;
+    } else {
+      DevicePath = BootOption->DevicePath;
+    }
+
+
+    // Skip boot options whose device path does not match the Aboot file path
+    if (GetDevicePathSize (DevicePath) != AbootFileDevicePathSize ||
+        CompareMem (DevicePath, AbootFileDevicePath, AbootFileDevicePathSize) != 0) {
+      continue;
+    }
+
+    FreePool (AbootFileDevicePath);
+    return BootOption;
+  }
+
+  FreePool (AbootFileDevicePath);
+  return NULL;
+}
+
 /**
  Dump boot option list.
 **/
@@ -1677,6 +1740,14 @@ BdsBootDeviceSelect (
   Link = GetFirstNode (BootLists);
   SystemConfigStatus = GetKernelConfiguration (&SystemConfiguration);
 
+  // ARISTA: Find the Aboot boot option and boot into that unconditionally
+  DEBUG_CODE (DumpBootOptionList (BootLists, BootOption););
+  BootOption = FindAbootBootOption (BootLists);
+  ASSERT (BootOption != NULL);
+  Status = gBdsServices->LaunchLoadOption (gBdsServices, BootOption, &ExitDataSize, &ExitData);
+  ASSERT (FALSE);
+  CpuDeadLoop();
+
   // Here we make the boot in a loop, every boot success will
   // return to the front page
   //
