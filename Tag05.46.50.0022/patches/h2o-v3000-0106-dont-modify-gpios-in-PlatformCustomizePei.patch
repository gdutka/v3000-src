 .../Oem/Fox/Pei/PlatformCustomizePei/PlatformCustomizePei.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/AMD/AmdEmbedded/AmdCpmPkg/Addendum/Oem/Fox/Pei/PlatformCustomizePei/PlatformCustomizePei.c b/AMD/AmdEmbedded/AmdCpmPkg/Addendum/Oem/Fox/Pei/PlatformCustomizePei/PlatformCustomizePei.c
