@@ -304,6 +304,7 @@ PlatformCustomizePeiEntryPoint (
   PcdSet32S   (PcdCpmPcieDevUnCorrectedErrorMask,     (UINT32)  AmdPbsConfiguration.AmdCpmPcieDevUnCorrErrMask);
