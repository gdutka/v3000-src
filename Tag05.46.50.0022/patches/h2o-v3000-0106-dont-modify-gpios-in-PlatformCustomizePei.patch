--- a/AMD/AmdEmbedded/AmdCpmPkg/Addendum/Oem/Fox/Pei/PlatformCustomizePei/PlatformCustomizePei.c
+++ b/AMD/AmdEmbedded/AmdCpmPkg/Addendum/Oem/Fox/Pei/PlatformCustomizePei/PlatformCustomizePei.c
@@ -277,7 +277,7 @@ PlatformCustomizePeiEntryPoint (
   EFI_STATUS                          Status;
   FABRIC_RESOURCE_FOR_EACH_RB        *pFabricResource;
   UINT32                              CpuidFamilyModelStepping;
-  UINT32                              Data;
