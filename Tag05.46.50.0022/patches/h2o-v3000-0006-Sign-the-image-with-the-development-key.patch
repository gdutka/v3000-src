 <!-- Image slot A BIOS DIR-->
-  <BIOS_DIR Level="2" Base="0x00445000" Size="0x00048000" SpiBlockSize="0x1000">
+  <BIOS_DIR Level="2" LevelType="A" Base="0x00445000" Size="0x00048000" SpiBlockSize="0x1000">
