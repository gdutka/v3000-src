From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: roberth <roberth@arista.com>
Date: Tue, 6 Feb 2024 17:50:49 -0600
Subject: [PATCH] Sign the image with the development key

This adds the necessary script to automatically sign the image with the
development key. No linux/bash compatible scripts are provided by AMD for this,
but there is a batch script
   AMD/AmdEmbedded/AgesaModulePkg/AMDTools/NewPspKit/BuildPspImageSign.bat
for Windows that was used as a reference.

The private key used is located at
   AMD/AmdEmbedded/AgesaModulePkg/AMDTools/NewPspKit/TestRtmPrivateKey.pem
and should be replaced before executing the build.

This should be enough to get the image to pass PSB test mode.
---
 .../AMDTools/NewPspKit/BuildPspImage.sh       |  5 ++
 .../NewPspKit/arista_gen_rtm_signature.sh     | 56 +++++++++++++++++++
 .../BIOSImageDirectory32M_DDR5.xml            | 14 ++---
 .../BIOSImageDirectory32M_DDR5_L2A.xml        |  2 +-
 Board/AMD/FoxBoardPkg/PspBuild.sh             | 11 +---
 5 files changed, 71 insertions(+), 17 deletions(-)
 create mode 100644 AMD/AmdEmbedded/AgesaModulePkg/AMDTools/NewPspKit/arista_gen_rtm_signature.sh

diff --git a/AMD/AmdEmbedded/AgesaModulePkg/AMDTools/NewPspKit/BuildPspImage.sh b/AMD/AmdEmbedded/AgesaModulePkg/AMDTools/NewPspKit/BuildPspImage.sh
index 14be5b74..82641080 100644
--- a/AMD/AmdEmbedded/AgesaModulePkg/AMDTools/NewPspKit/BuildPspImage.sh
+++ b/AMD/AmdEmbedded/AgesaModulePkg/AMDTools/NewPspKit/BuildPspImage.sh
@@ -55,6 +55,7 @@ InputBiosFile=$1
 RTM_FILE=$2
 PspDirectoryCfg=$3
 FINAL_BIOS=$4
+KEY_MODE=$5
 
 #Related PATH
 PSP_DIR_TOOL_PATH=$PSPKIT_PATH/PspDirectoryTool
@@ -86,6 +87,10 @@ this_command="python3 $BUILDPSPDIRECTORY bd $InputBiosFile $PspDirectoryCfg"
 echo "$this_command"
 eval $this_command || ERROR
 
+if [ "$KEY_MODE" == "TK" ]; then
+   echo "[Generate RTM Signature]"
+   ./arista_gen_rtm_signature.sh "$RTM_FILE" "$RTM_PRIVATE_KEY" sha384
+fi
 
 echo ""
 echo "[Finally build the Final BiosImage]"
diff --git a/AMD/AmdEmbedded/AgesaModulePkg/AMDTools/NewPspKit/arista_gen_rtm_signature.sh b/AMD/AmdEmbedded/AgesaModulePkg/AMDTools/NewPspKit/arista_gen_rtm_signature.sh
new file mode 100644
index 00000000..6e73b00d
--- /dev/null
+++ b/AMD/AmdEmbedded/AgesaModulePkg/AMDTools/NewPspKit/arista_gen_rtm_signature.sh
@@ -0,0 +1,56 @@
+#!/bin/bash
+# Copyright (c) 2024 Arista Networks, Inc.  All rights reserved.
+# Arista Networks, Inc. Confidential and Proprietary.
+
+# Adapted from AMD/AmdEmbedded/AgesaModulePkg/AMDTools/NewPspKit/BuildPspImageSign.bat
+
+set -e
+
+RTM_FILE="$1"
+RTM_PRIVATE_KEY="$2"
+SHATYPE="$3" # sha256 or sha384
+
+if [ "$SHATYPE" = "sha256" ]; then
+   RSA_PSS_SALTLEN=-2
+elif [ "$SHATYPE" = "sha384" ]; then
+   RSA_PSS_SALTLEN=-1
+else
+   echo "Unknown algorithm: $SHATYPE" >&2
+   exit 1
+fi
+
+# These specific file names are generated by AMD's tools
+BIOS_L2_DIR_FILE=Output/BiosDirHeaderL2.bin
+BIOS_L2_DIR_B_FILE=Output/BiosDirHeaderL2B.bin
+
+# Signature for single partition or partition A
+RTM_FILE_SIGNATURE=RTMSignature.bin
+# Signature for partition B (dual boot only)
+RTM_FILE_SIGNATURE_B=RTMSignatureB.bin
+
+sign_with_openssl() {
+   local signature="$1"
+   local data="$2"
+   local reverse_sig="$(mktemp)"
+   openssl dgst -binary -sign "$RTM_PRIVATE_KEY" -"$SHATYPE"                        \
+      -sigopt rsa_padding_mode:pss -sigopt rsa_pss_saltlen:"$RSA_PSS_SALTLEN"       \
+      -out "$reverse_sig" "$data"
+   # Signature needs to be stored in little-endian byte order
+   python -c 'import sys; sys.stdout.buffer.write(sys.stdin.buffer.read()[::-1])'   \
+      <"$reverse_sig" >"$signature"
+   rm -f "$reverse_sig"
+}
+
+PAYLOAD="$(mktemp)"
+
+cat "$RTM_FILE" "$BIOS_L2_DIR_FILE" >"$PAYLOAD"
+echo "Signing RTM+BIOS_DIR_L2"
+sign_with_openssl "$RTM_FILE_SIGNATURE" "$PAYLOAD"
+
+if [ -f "$BIOS_L2_DIR_B_FILE" ]; then
+   cat "$RTM_FILE" "$BIOS_L2_DIR_B_FILE" >"$PAYLOAD"
+   echo "Signing RTM+BIOS_DIR_L2B"
+   sign_with_openssl "$RTM_FILE_SIGNATURE_B" "$PAYLOAD"
+fi
+
+rm -f "$PAYLOAD"
