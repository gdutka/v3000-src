     <!-- Agesa PSP Customization Block (PSP Agesa variable) NVRAM (APCB)-->
     <IMAGE_ENTRY Type="0x60" Instance="0x00" File="APCB_FP7r2_Updatable.bin" Size="0x3000"/>
@@ -201,7 +201,7 @@
   </BIOS_DIR>
 
 <!-- Image slot B PSP DIR-->
-  <PSP_DIR Level="2" Base="0x0048D000" Size="0x00380000" SpiBlockSize="0x1000">
+  <PSP_DIR Level="2" LevelType="B" Base="0x0048D000" Size="0x00380000" SpiBlockSize="0x1000">
     <!-- AMD Public Key -->
     <IMAGE_ENTRY Type="0x00" File="TypeId0x00_RootKey_RMB.tkn"/>
     <!-- PSP Boot Loader firmware -->
@@ -306,14 +306,14 @@
   </PSP_DIR>
 
 <!-- Image slot B BIOS DIR-->
-  <BIOS_DIR Level="2" Base="0x0080D000" Size="0x00048000" SpiBlockSize="0x1000">
+  <BIOS_DIR Level="2" LevelType="B" Base="0x0080D000" Size="0x00048000" SpiBlockSize="0x1000">
     <!-- Refer to BIOS guide for detail requirement of each Type -->
     <!-- All definition is same as PSP_DIR except Destination -->
     <!-- Attribute Destination:(Optional)-->
     <!-- Destination: Used to specify the destination memory address PSP FW need copy to -->
     <IMAGE_ENTRY Type="0x05" File="TypeId0x05_RtmPubSigned_RMB.key"/>
     <!-- The RTMSignature.bin is NOT ready when generate Header with "BD" command, Use explicit "Size" to avoid open file fail  -->
-    <!-- <IMAGE_ENTRY Type="0x07" File="RTMSignature.bin" Size="0x100"/> -->
+    <IMAGE_ENTRY Type="0x07" File="RTMSignatureB.bin" Size="0x200"/>
 
     <!-- Agesa PSP Customization Block (PSP Agesa variable) NVRAM (APCB)-->
     <IMAGE_ENTRY Type="0x60" Instance="0x00" File="APCB_FP7r2_Updatable.bin" Size="0x3000"/>
@@ -365,4 +365,4 @@
