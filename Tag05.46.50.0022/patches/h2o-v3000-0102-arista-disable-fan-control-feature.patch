--- a/AMD/AmdEmbedded/AgesaModulePkg/Nbio/SMU/RMB/DXE/Smu13FeaturesEnable.h
+++ b/AMD/AmdEmbedded/AgesaModulePkg/Nbio/SMU/RMB/DXE/Smu13FeaturesEnable.h
@@ -24,7 +24,7 @@
 
 #define FP7_SMU_FEATURES_ENABLE_DEFAULT ( \
   (1 << (FEATURE_CCLK_DPM_BIT            %32)) | \
-  (1 << (FEATURE_FAN_CONTROLLER_BIT      %32)) | \
+  (0 << (FEATURE_FAN_CONTROLLER_BIT      %32)) | \
   (1 << (FEATURE_DATA_CALCULATION_BIT    %32)) | \
   (1 << (FEATURE_PPT_BIT                 %32)) | \
