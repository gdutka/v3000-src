 .../AgesaModulePkg/Nbio/SMU/RMB/DXE/Smu13FeaturesEnable.h       | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/AMD/AmdEmbedded/AgesaModulePkg/Nbio/SMU/RMB/DXE/Smu13FeaturesEnable.h b/AMD/AmdEmbedded/AgesaModulePkg/Nbio/SMU/RMB/DXE/Smu13FeaturesEnable.h
