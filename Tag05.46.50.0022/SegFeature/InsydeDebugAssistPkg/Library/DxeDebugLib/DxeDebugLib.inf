[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = DxeDebugLib
  FILE_GUID                      = A329B053-77D0-4dda-81D7-6E677644ECF6
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = DebugLib|DXE_CORE DXE_DRIVER SMM_CORE DXE_SMM_DRIVER
  
#
# The following information is for reference only and not required by the build tools.
#
#  VALID_ARCHITECTURES           = IA32 X64 IPF EBC
#

[Sources]
  DxeDebugLib.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  InsydeDebugAssistPkg/InsydeDebugAssistPkg.dec
  SegFeaturePkg/SegFeaturePkg.dec
  
[LibraryClasses]
  PcdLib
  ReportStatusCodeLib
  BaseMemoryLib
  BaseLib
  DebugPrintErrorLevelLib
  MemoryDataAnalysisLib
  
[Pcd]
  gEfiMdePkgTokenSpaceGuid.PcdDebugClearMemoryValue  ## SOMETIMES_CONSUMES
  gEfiMdePkgTokenSpaceGuid.PcdDebugPropertyMask      ## CONSUMES
  gEfiMdePkgTokenSpaceGuid.PcdFixedDebugPrintErrorLevel ## CONSUMES
  gH2ODebugAssistTokenSpaceGuid.PcdH2ODebugAssistAnalysisLength

[Guids]
  gEfiStatusCodeDataTypeDebugGuid    ## SOMETIMES_CONSUMES ## GUID

