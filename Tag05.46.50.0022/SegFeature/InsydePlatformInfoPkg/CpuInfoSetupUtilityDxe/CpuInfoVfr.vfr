#include <VfrCompatMacros.h>

#include "CpuInfoFormset.h"

formset
  guid      = H2O_CPU_INFO_FORMSET_GUID,
  title     = STRING_TOKEN (STR_CPU_INFO_FORMSET),
  help      = STRING_TOKEN (STR_CPU_INFO_FORMSET_HELP),
  classguid = VFR_GUID_FROM_PCD (PcdGetPtr (PcdH2OCpuInfoLinkToFormsetGuid)),

  //
  // Form H2O_CPU_INFO_FORM_ID
  //
  form
    formid = H2O_CPU_INFO_FORM_ID, title = STRING_TOKEN (STR_CPU_INFO_FORMSET);

    subtitle  text = STRING_TOKEN (STR_CPU_INFO_FORMSET);

    grayoutif  TRUE;
      text
        help = STRING_TOKEN (STR_BLANK_STRING),
        text = STRING_TOKEN (STR_NUMBER_OF_CPU_INSTALLED_STRING),
        flags  = INTERACTIVE,
        key    = H2O_CPU_INFO_TOTAL_CPU_QUESTION_ID;
    endif;

    label H2O_CPU_INFO_LABEL_START;
    label H2O_CPU_INFO_LABEL_END;

  endform;

endformset;

