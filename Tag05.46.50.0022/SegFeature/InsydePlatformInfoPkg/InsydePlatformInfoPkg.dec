  #
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OPciLookUpCapabilityIntnTableSupported|TRUE|BOOLEAN|0x00020004

[PcdsFixedAtBuild]
  ## Link To Formset GUID
  #    GUID("C1E0B01A-607E-4B75-B8BB-0631ECFAACF2") # Main
  #    GUID("C6D4769E-7F48-4D2A-98E9-87ADCCF35CCC") # Advance
  #    GUID("5204F764-DF25-48A2-B337-9EC122B85E0D") # Security
  #    GUID("A6712873-925F-46C6-90B4-A40F86A0917B") # Power
  #    GUID("2D068309-12AC-45AB-9600-9187513CCDD8") # Boot
  #    GUID("B6936426-FB04-4A7B-AA51-FD49397CDC01") # Exit
  #    ...                                          # ...
  #    GUID("XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX") # Other formset
  # @Prompt Show setup options at setup utility -> position
  # @PcdValueType GUID
  gInsydePlatformInfoTokenSpaceGuid.PcdH2ONvmeInfoLinkToFormsetGuid|{0}|VOID*|0x10000001
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OMemoryInfoLinkToFormsetGuid|{0}|VOID*|0x10000002
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OPciDeviceInfoLinkToFormsetGuid|{0}|VOID*|0x10000003
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OCpuInfoLinkToFormsetGuid|{0}|VOID*|0x10000004
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OSataDriveInfoLinkToFormsetGuid|{0}|VOID*|0x10000005
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OUsbViewerLinkToFormsetGuid|{0}|VOID*|0x10000006
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OSDEmmcInfoLinkToFormsetGuid|{0}|VOID*|0x10000007

  #
  #  Setting The Memory Detail Info Form Display Item and Sequence
  #  Number Define:
  #   (0)Device Locator
  #   (1)Bank Locator
  #   (2)Manufacture
  #   (3)Memory Type
  #   (4)DRAM Type
  #   (5)Serial Number
  #   (6)Part Number
  #   (7)Memory Size
  #   (8)Maximum Capable Memory Speed
  #   (9)Configured Memory Speed
  #   (10)Configured Voltage
  #
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OMemoryDetailDisplayList|{0}|VOID*|0x20000001
  #
  #  Setting The CPU Detail Info Form Display Item and Sequence
  #
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OCpuDetailDisplayList|{0}|VOID*|0x20000002
  #
  #  Setting The Memory Hidden Not Install Item Default Value
  #
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OHiddenNotInstalledMemory|FALSE|BOOLEAN|0x20000003
  
  #
  # Null-terminated ASCII string. The name of the Device Info attribute that
  # describes the display name of a device, controller, slot, etc.
  #
  # In addition to standard ASCII string values, InsydePlatformInfoPkg supports
  # string tokens to be used as display names. For example, the PCDs below set
  # the display names for a SATA port and an eMMC device.
  #
  # [PcdsDynamicExDefault]
  #   gH2ODeviceInfo2TokenSpaceGuid.PcdH2ODeviceInfoSata0Port1|{ \
  #     DEVICE_PATH("PciRoot(0x00)/Pci(0x08,0x01)/Pci(0x00,0x02)/Sata(0x01,0x00,0x00)"), \
  #     "name=SATA 0 Port 1" \  # Standard ASCII string as display name.
  #     }
  #   
  #   #
  #   # Workaround that creates an ASCII string without null character.
  #   #
  #   DEFINE NAME_EQ = 'n', 'a', 'm', 'e', '='
  #    
  #   #
  #   # String tokens are defined in .uni files, such as Project.uni.
  #   #
  #   gH2ODeviceInfo2TokenSpaceGuid.PcdH2ODeviceInfoEmmc0|{ \
  #     DEVICE_PATH("PciRoot(0x00)/Pci(0x1A,0x00)/eMMC(0x00)/Ctrl(0x00)"), \
  #     $(NAME_EQ), STRING_TOKEN(STR_DEVICE_NAME_EMMC_0), \
  #     "type=emmc" \
  #     }
  #
  gInsydePlatformInfoTokenSpaceGuid.PcdH2ODeviceInfoAttributeStr|{0}|VOID*|0x20000004

  #
  # Dummy PCD that ensures the StringsToIds table in AutoGen.c will always be
  # generated.
  #
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OPlatformInfoDummyStrToken|{0}|VOID*|0x20000006
  
  #
  # Setting the PCI/PCIe device item to skip in SCU
  #
  # Note:
  #   Setting the PCI/PCIe device skip table, Device defined in this pcd will not
  #   appear in SCU PCI/PCIe Information page, and it will only effect on SCU page.
  #   When defined VID & DID all of device with same id will be skip.
  #   If defined a Valid VID, and defined DID as 0xFFFF, all of device under this
  #   Vendor will be skip
  #
  # Defined Sample:
  #
  #    Vendor Id   |   Device Id    |
  # ===============|================|
  # UINT16 (0x1002), UINT16 (0xFFFF), \ #skip all device under vendor:0x1002
  # UINT16 (0x1022), UINT16 (0x15E3), \ #skip all device with VID:0x1022, DID:0x15E3
  #
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OPciSkipDeviceTable|{0}|VOID*|0x20000007

  #
  #  Setting The SD/eMMC Detail Info Form Display Item and Sequence
  #
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OSDEmmcDetailDisplayList|{0}|VOID*|0x2000000A

  #
  #  Setting The NVMe Detail Info Form Display Item and Sequence
  #
  gInsydePlatformInfoTokenSpaceGuid.PcdH2ONvmeDetailDisplayList|{0}|VOID*|0x2000000B

  #
  # Table for setting the display name for the BMC Channel
  #
  # Example:
  #------------------------------------------------------------------------
  #| Channel Number | DisplayName                                         |
  #------------------------------------------------------------------------
  # gInsydePlatformInfoTokenSpaceGuid.PcdH2OBmcInfoDisplayNameForChannel| { \
  #   UINT8(0x00),     L"Dedicated LAN Channel", \
  #   UINT8(0x01),     L"Shared LAN Channel" \
  # }
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OBmcInfoDisplayNameForChannel|{0}|VOID*|0x2001000B

  #
  # Table for setting the display capability id behavior
  #
  # Example:
  # ---------------------------------------------------------------------------
  # | IsPcieExtCapability        | CapabilityId        | DisplayControl       |
  # ---------------------------------------------------------------------------
  # | 0x00 = No (PCI Capability) | 0xXXXX = ID Value   | 0x00 = Default       |
  # | 0x01 = Yes                 |                     | 0x01 = Hide          |
  # | (PCIe Extended Capability) |                     | 0x02 = HideIntpnOnly |
  # ---------------------------------------------------------------------------
  # gInsydePlatformInfoTokenSpaceGuid.PcdH2OPciCapabilityDisplayControl| { \
  #   UINT8(0x00),                 UINT16(0x0010),       UINT8(0x02),      \ # PCI Capability (PCI Express)
  #   UINT8(0x01),                 UINT16(0x0001),       UINT8(0x01),      \ # PCIe Extended Capability (Advanced Error Reporting)
  #   UINT8(0x01),                 UINT16(0x000D),       UINT8(0x02),      \ # PCIe Extended Capability (Access Control Services)
  #   UINT8(0x00),                 UINT16(0x0009),       UINT8(0x01),      \ # PCI Capability (Vendor Specific)
  #   UINT8(0x00),                 UINT16(0x0011),       UINT8(0x00)       \ # PCI Capability (MSI-X)
  # }
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OPciCapabilityDisplayControl|{0}|VOID*|0x2001000C

