[PcdsFeatureFlag]
  #
  # The main feature switch, if that is disabled other feature will disable
  #
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OPlatformInfoSupported|TRUE|BOOLEAN|0x00000001
  #
  # The sub feature switch
  # Note : The PcdH2OSetupMemoryInfoSupported depend on PcdH2OMemoryDeviceInfoSupported = TRUE
  #
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OMemoryDeviceInfoSupported|TRUE|BOOLEAN|0x00000002
  #
  # The sub feature switch
  # Note : The PcdH2OSetupPciDeviceInfoSupported depend on PcdH2OPciLookupTableSupported = TRUE
  #
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OPciLookupTableSupported|TRUE|BOOLEAN|0x00000003
  #
  # The sub feature switch
  # Note : The PcdH2OSetupCpuInfoSupported depend on PcdH2OCpuDeviceInfoSupported = TRUE
  #
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OCpuDeviceInfoSupported|TRUE|BOOLEAN|0x00000004
  #
  # The sub feature switch
  # Note : The PcdH2OSetupSataDriveInfoSupported depend on PcdH2OSataDriveInfoSupported = TRUE
  #
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OSataDriveInfoSupported|TRUE|BOOLEAN|0x00000005
  #
  # The sub feature switch
  #
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OUsbTextLookupSupported|TRUE|BOOLEAN|0x00000006
  #
  # The sub feature switch
  #
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OPciSkipTableSupported|TRUE|BOOLEAN|0x00000007
  #
  # The sub feature switch
  # Note : The PcdH2OSetupNvmeInfoSupported depend on PcdH2ONvmeInfoSupported = TRUE
  #
  gInsydePlatformInfoTokenSpaceGuid.PcdH2ONvmeInfoSupported|TRUE|BOOLEAN|0x00000008
  #
  # The sub feature switch
  # Note : The PcdH2OSetupSDEmmcInfoSupported depend on PcdH2OSDEmmcInfoSupported = TRUE
  #
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OSDEmmcInfoSupported|TRUE|BOOLEAN|0x00000009
  #
  # The sub feature switch
  #
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OConsoleBootMessageSupported|TRUE|BOOLEAN|0x0000000A
  #
  # The sub feature switch
  #
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OPciDeviceInfoSupported|TRUE|BOOLEAN|0x0000000B

  #
  # The setup info switch
  #
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OSetupNvmeInfoSupported|TRUE|BOOLEAN|0x00010001
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OSetupMemoryInfoSupported|TRUE|BOOLEAN|0x00010002
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OSetupPciDeviceInfoSupported|TRUE|BOOLEAN|0x00010003
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OSetupCpuInfoSupported|TRUE|BOOLEAN|0x00010004
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OSetupSataDriveInfoSupported|TRUE|BOOLEAN|0x00010005
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OSetupUsbViewerSupported|TRUE|BOOLEAN|0x00010006
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OSetupSDEmmcInfoSupported|TRUE|BOOLEAN|0x00010007

  #
  # Customized PcieLookUpTable Size Pcds
  #
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OPciLookUpVendorIdTableSupported|TRUE|BOOLEAN|0x00020000
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OPciLookUpDeviceIdTableSupported|TRUE|BOOLEAN|0x00020001
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OPciLookUpClassCodeTableSupported|TRUE|BOOLEAN|0x00020002
  gInsydePlatformInfoTokenSpaceGuid.PcdH2OPciLookUpCapabilityIdTableSupported|TRUE|BOOLEAN|0x00020003

  #
