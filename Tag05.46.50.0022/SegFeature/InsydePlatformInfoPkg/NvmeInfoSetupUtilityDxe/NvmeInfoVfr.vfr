#include <VfrCompatMacros.h>

#include "NvmeInfoFormset.h"

formset
  guid      = H2O_NVME_INFO_FORMSET_GUID,
  title     = STRING_TOKEN (STR_NVME_INFO_FORMSET),
  help      = STRING_TOKEN (STR_NVME_INFO_FORMSET_HELP),
  classguid = VFR_GUID_FROM_PCD (PcdGetPtr (PcdH2ONvmeInfoLinkToFormsetGuid)),

  //
  // Form H2O_NVME_INFO_CONTROLLER_LIST_FORM_ID
  //
  form
    formid = H2O_NVME_INFO_CONTROLLER_LIST_FORM_ID,
    title = STRING_TOKEN (STR_NVME_INFO_FORMSET);

    label H2O_NVME_INFO_LABEL_START;
    label H2O_NVME_INFO_LABEL_END;

  endform;

  //
  // Form H2O_NVME_INFO_CONTROLLER_INFO_FORM_ID
  //
  form
    formid = H2O_NVME_INFO_CONTROLLER_INFO_FORM_ID,
    title = STRING_TOKEN (STR_NVME_DEVICE_FORM);

    label H2O_NVME_INFO_LABEL_START;
    label H2O_NVME_INFO_LABEL_END;

  endform;
endformset;
