[Defines]
  INF_VERSION                          = 0x00010005
  BASE_NAME                            = MemoryInfoSetupUtilityDxe
  FILE_GUID                            = 304003EA-7A75-4776-83D4-6B784B6E1900
  MODULE_TYPE                          = DXE_DRIVER
  VERSION_STRING                       = 1.0
  ENTRY_POINT                          = MemoryInfoEntry
  UNLOAD_IMAGE                         = MemoryInfoUnload

[Sources]
  MemoryInfoSetupUtilityDxe.c
  MemoryDetailDisplay.c
  MemoryInfoStr.uni
  MemoryInfoVfr.vfr

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  InsydeModulePkg/InsydeModulePkg.dec
  InsydePlatformInfoPkg/InsydePlatformInfoPkg.dec
  SegFeaturePkg/SegFeaturePkg.dec

[LibraryClasses]
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  UefiLib
  BaseLib
  BaseMemoryLib
  DevicePathLib
  MemoryAllocationLib
  HiiLib
  HiiExLib
  PrintLib
  DebugLib
  VariableLib
  MemoryDeviceInfoLib
  LanguageDataLib
  SetupVariableLib

[Guids]
  gH2OMemoryInfoFormsetGuid
  gH2OMemoryInfoSetupVarstoreGuid
  gEfiIfrTianoGuid

[Protocols]
  gEfiHiiConfigAccessProtocolGuid
  gEfiSetupUtilityApplicationProtocolGuid
  gH2OMemoryDeviceInfoProtocolGuid
