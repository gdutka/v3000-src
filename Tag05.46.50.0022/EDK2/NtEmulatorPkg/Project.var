         name=CstateLatencyControl4TimeUnit | (0x02)    # offset 0074 CstateLatencyControl4TimeUnit  
         name=CstateLatencyControl5TimeUnit | (0x02)    # offset 0075 CstateLatencyControl5TimeUnit                     
