[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = PlatformBdsLib
  FILE_GUID                      = 469184E8-FADA-41E4-8823-012CA19B40D4
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = PlatformBdsLib|DXE_DRIVER

#
# The following information is for reference only and not required by the build tools.
#
#  VALID_ARCHITECTURES           = ARM AARCH64
#

[Sources]
  PlatformBm.c
  PlatformBm.h
  QemuKernel.c
  BdsPlatform.c

[Packages]
  ArmVirtPkg/ArmVirtPkg.dec
  MdeModulePkg/MdeModulePkg.dec
  MdePkg/MdePkg.dec
  OvmfPkg/OvmfPkg.dec
  SecurityPkg/SecurityPkg.dec
  ShellPkg/ShellPkg.dec
  InsydeModulePkg/InsydeModulePkg.dec
  InsydeOemServicesPkg/InsydeOemServicesPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  BootLogoLib
  DebugLib
  DevicePathLib
  MemoryAllocationLib
  PcdLib
  PlatformBmPrintScLib
  QemuLoadImageLib
  ReportStatusCodeLib
  TpmPlatformHierarchyLib
  UefiBootManagerLib
  UefiBootServicesTableLib
  UefiLib
  UefiRuntimeServicesTableLib
  GenericBdsLib
  OemGraphicsLib
  H2OCpLib
  VariableLib
  DxeOemSvcKernelLib
  GenericUtilityLib

[FeaturePcd]
  gInsydeTokenSpaceGuid.PcdH2OBdsCpDisplayBeforeSupported

[FixedPcd]
  gEfiMdePkgTokenSpaceGuid.PcdUartDefaultBaudRate
  gEfiMdePkgTokenSpaceGuid.PcdUartDefaultDataBits
  gEfiMdePkgTokenSpaceGuid.PcdUartDefaultParity
  gEfiMdePkgTokenSpaceGuid.PcdUartDefaultStopBits

[Pcd]
  gArmVirtTokenSpaceGuid.PcdTerminalTypeGuidBuffer
#  gEfiMdePkgTokenSpaceGuid.PcdPlatformBootTimeOut
  gInsydeTokenSpaceGuid.PcdPlatformBootTimeOut

[Guids]
  gEfiEndOfDxeEventGroupGuid
  gEfiGlobalVariableGuid
  gRootBridgesConnectedEventGroupGuid
  gUefiShellFileGuid
  gH2OBdsCpDisplayBeforeGuid

[Protocols]
  gEfiFirmwareVolume2ProtocolGuid
  gEfiGraphicsOutputProtocolGuid
  gEfiPciRootBridgeIoProtocolGuid
  gVirtioDeviceProtocolGuid
  gEfiUgaSplashProtocolGuid
  gH2OBdsServicesProtocolGuid
  gEfiBootLogoProtocolGuid

[BuildOptions.common.EDKII]
  *_*_*_CC_FLAGS          = -Wno-unused-function

