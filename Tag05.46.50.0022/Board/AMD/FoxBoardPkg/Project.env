  DEFINE  EC_NAME                                 = DummyEcLib
  DEFINE  H2O_DDT_DEBUG_IO                        = Com

##################################################
# Chipset Switches Start
#
#[-start-220902-IB14740260-modify]#
  DEFINE  LEGACY_FREE_SUPPORT                     = YES
#[-end-220902-IB14740260-modify]#
#[-start-220208-IB14740208-modify]#
  DEFINE  REDUCED_HARDWARE_SUPPORT                = NO
#[-end-220208-IB14740208-modify]#
  DEFINE  NB_IOAPIC_SUPPORT                       = YES
#[-start-220208-IB14740208-modify]#
  DEFINE  MODERN_STANDBY_SUPPORT                  = NO
#[-end-220208-IB14740208-modify]#
  DEFINE  CRB_ONLY                                = YES
  DEFINE  XHCI_SUPPORT                            = NO
  DEFINE  MULTI_CONFIG_SUPPORT                    = NO
#[-start-220126-IB14740206-modify]#
  #
  # PCI MMIO range was E0000000h~EFFFFFFFh when the MAX_SUPPORTED_PCI_BUSES = 256
  # PCI MMIO range was F0000000h~F7FFFFFFh when the MAX_SUPPORTED_PCI_BUSES = 128
  # PCI MMIO range was F0000000h~F3FFFFFFh when the MAX_SUPPORTED_PCI_BUSES = 64
  #
#[-start-220513-IB14740240-modify]#
#[-start-220803-IB14740254-modify]#
#[-start-221104-IB14740270-modify]#
  DEFINE  MAX_SUPPORTED_PCI_BUSES                 = 256
#[-end-221104-IB14740270-modify]#
#[-end-220803-IB14740254-modify]#
#[-end-220513-IB14740240-modify]#
#[-end-220126-IB14740206-modify]#
  DEFINE  THUNDERBOLT_SUPPORT                     = NO
#[-start-220308-IB14740223-add]#
  DEFINE  ROM_ARMOR_DEFAULT_ENABLE                = NO
#[-end-220308-IB14740223-add]#
#[-start-240911-IB20840092-add]#
  #
  # Enable/Disable default supervisor password supported
  #
  DEFINE DEFAULT_SUPERVISOR_PW_SUPPORTED        = NO
  
  #
  # After Kernel 05.45.39, H2O Tools requires SCU password if secure boot is enabled.
  # Enabled/Disabled Auto set password if secure boot is enabled.
  #
  DEFINE SECURE_BOOT_DEFAULT_PW_SUPPORTED       = NO

  #
  # After Kernel 5.6, passwords have the following rules:
  #
  #   - 1 Uppercase Character
  #   - 1 Lowercase Character
  #   - 1 Digit
  #   - 1 Non-Alphanumeric Character
  #
  DEFINE DEFAULT_SUPERVISOR_PW_STRING           = 1q@W
#[-end-240911-IB20840092-add]#
#
# Chipset Switches End
##################################################
  DEFINE  VN_16M_AB_CFG                           = NO
  DEFINE  VN_32M_AB_COMBO_CFG                     = YES
  DEFINE  BOOT_FROM_ROM                           = NO
  DEFINE  BVM_SUPPORT                             = NO
  DEFINE  KVM_SUPPORT                             = NO  
  DEFINE  PSP_COMBO_SUPPORT                       = NO
  DEFINE  RTK_USBLAN_SUPPORT                      = NO
  DEFINE  SIMNOW_SERIAL_PORT_ITE                  = NO  # BE NOTED: We set legacy boot as default, in this boot mode, system would hangs at CSM if enable serial port debug function
                                                            #           so if you set this to YES, BIOS would set UEFI boot mode as default
  DEFINE  SIMNOW_SERIAL_PORT_SMSC                 = NO  # BE NOTED: We set legacy boot as default, in this boot mode, system would hangs at CSM if enable serial port debug function
                                                            #           so if you set this to YES, BIOS would set UEFI boot mode as default
  DEFINE  UNIFY_MESSAGE_SUPPORT                   = YES
  DEFINE  EMULATION_ONLY                          = NO  # EMULATION_ONLY = YES
                                                            #     1. Using emulation memory configuration
                                                            #     2. Disable LegacyUsbSupport	#LEGACY_FREE_SUPPORT=Yes
                                                            #     3. Remove EC support
                                                            #     4. Ps2 components just return EFI_UNSUPPORTED
                                                            #
                                                            # EMULATION_ONLY = NO
                                                            #     1. Keep Carrizo support
                                                            #     2. Using Gardenia board memory configuration
                                                            #     3. PcdMaxDimms = 3
                                                            #     4. Get SPD info from SMBUS
                                                            #     5. Enable LegacyUsbSupport
                                                            #     6. Keep EC support
                                                            #     7. Ps2 components run as normal
  DEFINE  USE_AGESA_DEBUGLIB                      = NO  # USE AGESA DEBUGLIB Instance for Platform DebugLib
  DEFINE  REDIRECT_SERIAL_MESSAGE_TO_PORT_80      = NO  # USE Platform PORT80 lib for Platform SerialPortLib
  DEFINE  PROMONTORY_SUPPORT                      = NO  # Token to control enable/disable Promontory
  DEFINE  SMM_ISOLATION_SUPPORT                   = YES # Token to control enable/disable Smm Isolation. Not support GCC build.
#[-start-221104-IB14740270-add]#
  #
  # PcdAmdPspS3WakeFromSmm must be set to FALSE when using SMMISO
  # doc# 56896, rev 1.03
  #
  DEFINE  SMM_ISOLATION_LEVEL30_SUPPORT           = YES # Token to control enable/disable 
  DEFINE  SMM_PROTECTION_TEST_SUPPORT             = NO  # Token to control enable/disable Smm Protection Test
#[-end-221104-IB14740270-add]#
  DEFINE  L2A_ONLY                                = NO
#[-start-220301-IB14740220-add]#
  DEFINE  SMMSUPV_SOURCE_BUILD                    = NO  # Not support GCC build
#[-end-220301-IB14740220-add]#
  DEFINE  LPDDR5                                  = NO
  DEFINE  BIOSNAME                                = Fox
  DEFINE  DP_TI_SELECT                            = NO
  DEFINE  DP_CY_SELECT                            = YES
  
