[FV.PEI_COMPACT]
  FvAlignment        = 128
  ERASE_POLARITY     = 1
  ERASE_POLARITY     = 1
  MEMORY_MAPPED      = TRUE
  STICKY_WRITE       = TRUE
  LOCK_CAP           = TRUE
  LOCK_STATUS        = TRUE
  WRITE_DISABLED_CAP = TRUE
  WRITE_ENABLED_CAP  = TRUE
  WRITE_STATUS       = TRUE
  WRITE_LOCK_CAP     = TRUE
  WRITE_LOCK_STATUS  = TRUE
  READ_DISABLED_CAP  = TRUE
  READ_ENABLED_CAP   = TRUE
  READ_STATUS        = TRUE
  READ_LOCK_CAP      = TRUE
  READ_LOCK_STATUS   = TRUE

  #
  # 1) BaseTools/Conf/PackageBase.fdf use "PE32 Align=32" settings for PEI / PEI_CORE
  #    According to PI Specification Vol. 3, 3.2.3 Firmware File,
  #    FFS only support 0, 8, 16, 128, 512, 1024, ... align
  #    It will cause the PEIM/PEI_CORE FFS alignment is 128, and th FV alignment will become to 128 alignment
  #    (check RECOVERYFV.Fv.txt in Build FV folder)
  #
  #    [Rule.Common.PEI_CORE]
  #    FILE PEI_CORE = $(NAMED_GUID)            {
  #      PE32       PE32     Align = 32       $(INF_OUTPUT)/$(MODULE_NAME).efi
  #      UI       STRING="$(MODULE_NAME)" Optional
  #      VERSION  STRING="$(INF_VERSION)" Optional BUILD_NUM=$(BUILD_NUMBER)
  #    }
  #
  # 2) When using GUIDED section to compress FV_IMAGE, the FV_IMAGE will been a RAW section to
  #    make FV_IMAGE is 128 alignment
  #    FV\Ffs\20bc8ac9-94d1-4208-ab28-5d673fd73487PEI_COMPACT\20bc8ac9-94d1-4208-ab28-5d673fd73487SEC1.guided.dummy
  #
  # 3) Therefore, CompressBios.bat will
  #    3.1) Split the dummy file to two file
  #         20bc8ac9-94d1-4208-ab28-5d673fd73487SEC1.guided.dummy.1 (PAD section; unncessary 0x80 bytes)
  #         20bc8ac9-94d1-4208-ab28-5d673fd73487SEC1.guided.dummy.2 (origin RECOVERYFV.FV)
  #    3.2) call CompressBios.exe to compress the 20bc8ac9-94d1-4208-ab28-5d673fd73487SEC1.guided.dummy.2
  #
#[-start-231129-IB14740308-remove]#
#  FILE RAW = 20bc8ac9-94d1-4208-ab28-5d673fd73487 {
#    SECTION GUIDED  991EFAC0-E260-416B-A4B8-3B153072B804 PROCESSING_REQUIRED = FALSE {  # AmdTools\CompressBios.bat
#      SECTION  ALIGN=128 FV_IMAGE = RECOVERYFV
#    }
#  }
#[-end-231129-IB14740308-remove]#

################################################################################
#
# START FIRMWARE VOLUME SECTIONS
#
################################################################################
[FV.PEIPLATFORMFV]
BlockSize          = 0x1000
FvAlignment        = 16
ERASE_POLARITY     = 1
MEMORY_MAPPED      = TRUE
STICKY_WRITE       = TRUE
LOCK_CAP           = TRUE
LOCK_STATUS        = TRUE
WRITE_DISABLED_CAP = TRUE
WRITE_ENABLED_CAP  = TRUE
WRITE_STATUS       = TRUE
WRITE_LOCK_CAP     = TRUE
WRITE_LOCK_STATUS  = TRUE
READ_DISABLED_CAP  = TRUE
READ_ENABLED_CAP   = TRUE
READ_STATUS        = TRUE
READ_LOCK_CAP      = TRUE
READ_LOCK_STATUS   = TRUE
[FV.RECOVERYFV]
FvBaseAddress = $(PEI_MEM_BASE)
NumBlocks     = $(RECOVERYFV_NUM_BLOCKS)

