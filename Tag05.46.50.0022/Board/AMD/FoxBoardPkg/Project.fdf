[Defines]
#
# Flash Layout definitions
#

DEFINE FLASH_16MB_OFFSET                                            = 0x01000000

DEFINE FLASH_18MB_OFFSET                                            = 0x01200000

!if $(VN_32M_AB_COMBO_CFG)  == YES
  DEFINE FLASH_AREA_BASE_ADDRESS                                    = 0xFE000000
  DEFINE FLASH_AREA_SIZE                                            = 0x02000000
!endif

!if $(L2A_ONLY)  == YES
  DEFINE FLASH_AREA_BASE_ADDRESS                                    = 0xFE000000
  DEFINE FLASH_AREA_SIZE                                            = 0x02000000
!endif

!if $(VN_16M_AB_CFG)  == YES
  DEFINE FLASH_AREA_BASE_ADDRESS                                    = 0xFF000000
  DEFINE FLASH_AREA_SIZE                                            = 0x01000000
!endif

DEFINE FLASH_REGION_FV_RECOVERY_OFFSET                              = 0x00000000
DEFINE FLASH_REGION_FV_RECOVERY_SIZE                                = 0x00300000

DEFINE FLASH_REGION_PEI_COMPRESSED_OFFESET                          = 0x006B0000

!if $(BOOT_FROM_ROM) == NO
  DEFINE FLASH_REGION_PEI_COMPRESSED_SIZE                           = 0x000E0000
!else
  DEFINE FLASH_REGION_PEI_COMPRESSED_SIZE                           = 0x00000000
!endif

!if $(L2A_ONLY) == YES
  DEFINE FLASH_REGION_PEI_COMPRESSED_SIZE                           = 0x00300000
!endif

DEFINE FLASH_BASE                                                   = $(FLASH_AREA_BASE_ADDRESS)
DEFINE FD_SIZE                                                      = $(FLASH_AREA_SIZE)

DEFINE BLOCK_SIZE                                                   = 0x00001000
DEFINE NUM_BLOCKS                                                   = $(FD_SIZE)/$(BLOCK_SIZE)
DEFINE BANK1_NUM_BLOCKS                                             = $(FLASH_AREA_SIZE)/$(BLOCK_SIZE)

!if $(L2A_ONLY) == YES
DEFINE PEI_MEM_BASE                                                 = 0xFFD00000
!else
!if $(BOOT_FROM_ROM) == YES
DEFINE PEI_MEM_BASE                                                 = $(PEI_FLASH_BASE)
!else
DEFINE PEI_MEM_BASE                                                 = 0x09B00000
!endif
!endif

DEFINE PEI_MEM_SIZE                                                 = 0x00300000
DEFINE PEI_BLOCK_SIZE                                               = 0x00001000
DEFINE PEI_NUM_BLOCKS                                               = $(PEI_MEM_SIZE)/$(PEI_BLOCK_SIZE)

!if $(MULTI_CONFIG_SUPPORT) == YES
  DEFINE FLASH_REGION_NV_COMMON_STORE_SUBREGION_MULTICONFIG_SIZE    = 0x00004000
!else
  DEFINE FLASH_REGION_NV_COMMON_STORE_SUBREGION_MULTICONFIG_SIZE    = 0x00000000
!endif

DEFINE RECOVERYFV_NUM_BLOCKS                                        = $(PEI_MEM_SIZE) / 0x10000

DEFINE FLASH_REGION_FVEC_OFFSET                                     = 0x00000000
DEFINE FLASH_REGION_FVEC_SIZE                                       = 0x00000200

# PSP SIG
DEFINE FLASH_REGION_FVSIG_OFFSET                                    = 0x00020000
DEFINE FLASH_REGION_FVSIG_SIZE                                      = 0x00001000

# PD TI, it should check with EC SIG offset 0x10, 0x18, 0x20, 0x28, 0x30, 0x38
DEFINE FLASH_REGION_PD_TI_0_OFFSET                                  = 0x00001000
DEFINE FLASH_REGION_PD_TI_0_SIZE                                    = 0x00008000
DEFINE FLASH_REGION_PD_TI_1_OFFSET                                  = 0x00009000
DEFINE FLASH_REGION_PD_TI_1_SIZE                                    = 0x00008000
DEFINE FLASH_REGION_PD_TI_2_OFFSET                                  = 0x00011000
DEFINE FLASH_REGION_PD_TI_2_SIZE                                    = 0x00008000
DEFINE FLASH_REGION_PD_TI_3_OFFSET                                  = 0x00021000
DEFINE FLASH_REGION_PD_TI_3_SIZE                                    = 0x00008000
DEFINE FLASH_REGION_PD_TI_4_OFFSET                                  = 0x00029000
DEFINE FLASH_REGION_PD_TI_4_SIZE                                    = 0x00008000
DEFINE FLASH_REGION_PD_TI_5_OFFSET                                  = 0x00031000
DEFINE FLASH_REGION_PD_TI_5_SIZE                                    = 0x00008000
DEFINE FLASH_REGION_PD_TI_6_OFFSET                                  = 0x00039000
DEFINE FLASH_REGION_PD_TI_6_SIZE                                    = 0x00008000
DEFINE FLASH_REGION_PD_TI_7_OFFSET                                  = 0x00041000
DEFINE FLASH_REGION_PD_TI_7_SIZE                                    = 0x00008000
DEFINE FLASH_REGION_PD_TI_8_OFFSET                                  = 0x00049000
DEFINE FLASH_REGION_PD_TI_8_SIZE                                    = 0x00008000
DEFINE FLASH_REGION_PD_TI_9_OFFSET                                  = 0x00051000
DEFINE FLASH_REGION_PD_TI_9_SIZE                                    = 0x00008000
DEFINE FLASH_REGION_PD_TI_10_OFFSET                                 = 0x00059000
DEFINE FLASH_REGION_PD_TI_10_SIZE                                   = 0x00008000
DEFINE FLASH_REGION_PD_TI_11_OFFSET                                 = 0x00061000
DEFINE FLASH_REGION_PD_TI_11_SIZE                                   = 0x00008000

# PD CY, it should check with EC SIG offset 0x40, 0x48, 0x50, 0x58, 0x60, 0x68
DEFINE FLASH_REGION_PD_CY_0_OFFSET                                  = 0x00001000
DEFINE FLASH_REGION_PD_CY_0_SIZE                                    = 0x00010000
DEFINE FLASH_REGION_PD_CY_1_OFFSET                                  = 0x00011000
DEFINE FLASH_REGION_PD_CY_1_SIZE                                    = 0x0000F000
DEFINE FLASH_REGION_PD_CY_2_OFFSET                                  = 0x00021000
DEFINE FLASH_REGION_PD_CY_2_SIZE                                    = 0x00010000
DEFINE FLASH_REGION_PD_CY_3_OFFSET                                  = 0x00031000
DEFINE FLASH_REGION_PD_CY_3_SIZE                                    = 0x00010000
DEFINE FLASH_REGION_PD_CY_4_OFFSET                                  = 0x00041000
DEFINE FLASH_REGION_PD_CY_4_SIZE                                    = 0x00010000
DEFINE FLASH_REGION_PD_CY_5_OFFSET                                  = 0x00051000
DEFINE FLASH_REGION_PD_CY_5_SIZE                                    = 0x00010000
DEFINE FLASH_REGION_PD_CY_6_OFFSET                                  = 0x00061000
DEFINE FLASH_REGION_PD_CY_6_SIZE                                    = 0x00010000

DEFINE FLASH_REGION_RETIMER_OFFSET                                  = 0x00071000
DEFINE FLASH_REGION_RETIMER_SIZE                                    = 0x00010000

# EC ROM, it should check with EC SIG offset 0x00
DEFINE FLASH_REGION_FVEC2_OFFSET                                    = 0x00081000
DEFINE FLASH_REGION_FVEC2_SIZE                                      = 0x00040000

DEFINE FLASH_REGION_PSPL1_OFFSET                                    = $(FLASH_REGION_FVEC2_OFFSET) + $(FLASH_REGION_FVEC2_SIZE)
DEFINE FLASH_REGION_PSPL1_SIZE                                      = 0x00001000

DEFINE FLASH_REGION_BACKUP_PSPL1_OFFSET                             = $(FLASH_REGION_PSPL1_OFFSET) + $(FLASH_REGION_PSPL1_SIZE)

DEFINE FLASH_REGION_SOLT_HEADER_1_OFFSET                            = $(FLASH_REGION_BACKUP_PSPL1_OFFSET) + $(FLASH_REGION_PSPL1_SIZE)
DEFINE FLASH_REGION_SOLT_HEADER_1_SIZE                              = 0x00001000

!if $(L2A_ONLY)  == NO
DEFINE FLASH_REGION_SOLT_HEADER_2_OFFSET                            = $(FLASH_REGION_SOLT_HEADER_1_OFFSET) + $(FLASH_REGION_SOLT_HEADER_1_SIZE)
DEFINE FLASH_REGION_SOLT_HEADER_2_SIZE                              = 0x00001000

DEFINE FLASH_REGION_PSPDIR_A_OFFSET                                 = $(FLASH_REGION_SOLT_HEADER_2_OFFSET) + $(FLASH_REGION_SOLT_HEADER_2_SIZE)
!else
DEFINE FLASH_REGION_PSPDIR_A_OFFSET                                 = $(FLASH_REGION_SOLT_HEADER_1_OFFSET) + $(FLASH_REGION_SOLT_HEADER_1_SIZE)
!endif
DEFINE FLASH_REGION_PSPDIR_A_SIZE                                   = 0x00380000

DEFINE FLASH_REGION_BIOSDIR_A_OFFSET                                = $(FLASH_REGION_PSPDIR_A_OFFSET)+$(FLASH_REGION_PSPDIR_A_SIZE)
DEFINE FLASH_REGION_BIOSDIR_A_SIZE                                  = 0x00048000

!if $(L2A_ONLY)  == NO
DEFINE FLASH_REGION_PSPDIR_B_OFFSET                                 = $(FLASH_REGION_BIOSDIR_A_OFFSET)+$(FLASH_REGION_BIOSDIR_A_SIZE)
DEFINE FLASH_REGION_PSPDIR_B_SIZE                                   = 0x00380000

DEFINE FLASH_REGION_BIOSDIR_B_OFFSET                                = $(FLASH_REGION_PSPDIR_B_OFFSET)+$(FLASH_REGION_PSPDIR_B_SIZE)
DEFINE FLASH_REGION_BIOSDIR_B_SIZE                                  = 0x00048000

DEFINE FLASH_REGION_PSP_NVRAM_OFFSET                                = $(FLASH_REGION_BIOSDIR_B_OFFSET)+$(FLASH_REGION_BIOSDIR_B_SIZE)
!else
DEFINE FLASH_REGION_PSP_NVRAM_OFFSET                                = $(FLASH_REGION_BIOSDIR_A_OFFSET)+$(FLASH_REGION_BIOSDIR_A_SIZE)
!endif

DEFINE FLASH_REGION_PSP_NVRAM_SIZE                                  = 0x00020000

DEFINE FLASH_REGION_PSP_RPMC_NVRAM_OFFSET                           = $(FLASH_REGION_PSP_NVRAM_OFFSET)+$(FLASH_REGION_PSP_NVRAM_SIZE)
DEFINE FLASH_REGION_PSP_RPMC_NVRAM_SIZE                             = 0x00040000

#[-start-231102-IB20840032-remove]#
# MPM Binaries Support
!if $(VN_16M_AB_CFG)  == YES
  DEFINE FLASH_REGION_MPM_86_SIZE                                   = 0x00000000
  DEFINE FLASH_REGION_FVWLAN_FW_SIZE                                = 0x00000000
!else
  DEFINE FLASH_REGION_MPM_86_SIZE                                   = 0x001EA000 ## 1.9MB
  DEFINE FLASH_REGION_FVWLAN_FW_SIZE                                = 0x001B4000 ## 1.7MB
!endif

#Instance 0 for A/B recovery
DEFINE FLASH_REGION_MPM_86_OFFSET                                   = $(FLASH_REGION_PSP_RPMC_NVRAM_OFFSET)+$(FLASH_REGION_PSP_RPMC_NVRAM_SIZE)
DEFINE FLASH_REGION_FVWLAN_FW_OFFSET                                = $(FLASH_REGION_MPM_86_OFFSET)+$(FLASH_REGION_MPM_86_SIZE)

#Instance 1 for A/B recovery
DEFINE FLASH_REGION_MPM_86_OFFSET_B                                 = $(FLASH_REGION_FVWLAN_FW_OFFSET)+$(FLASH_REGION_FVWLAN_FW_SIZE)
DEFINE FLASH_REGION_FVWLAN_FW_OFFSET_B                              = $(FLASH_REGION_MPM_86_OFFSET_B)+$(FLASH_REGION_MPM_86_SIZE)

DEFINE FLASH_REGION_MPM_87_PERSISTENT_OBJECT_OFFSET                 = $(FLASH_REGION_FVWLAN_FW_OFFSET_B)+$(FLASH_REGION_FVWLAN_FW_SIZE)
DEFINE FLASH_REGION_MPM_87_PERSISTENT_OBJECT_SIZE                   = 0x00040000
#[-end-231102-IB20840032-remove]#

#[-start-231102-IB20840032-modify]#
DEFINE FLASH_REGION_FVBVM_OFFSET                                    = $(FLASH_REGION_MPM_87_PERSISTENT_OBJECT_OFFSET)+$(FLASH_REGION_MPM_87_PERSISTENT_OBJECT_SIZE)
#[-end-231102-IB20840032-modify]#
!if $(BVM_SUPPORT) == YES
DEFINE FLASH_REGION_FVBVM_SIZE                                      = 0x00002000
!else
DEFINE FLASH_REGION_FVBVM_SIZE                                      = 0x00000000
!endif

!if $(VN_32M_AB_COMBO_CFG) == YES
DEFINE FLASH_REGION_PEI_FLASH_A_OFFSET                              = $(FLASH_18MB_OFFSET)
!else
DEFINE FLASH_REGION_PEI_FLASH_A_OFFSET                              = $(FLASH_REGION_FVBVM_OFFSET)+$(FLASH_REGION_FVBVM_SIZE)
!endif

!if $(L2A_ONLY)  == NO
DEFINE FLASH_REGION_PEI_FLASH_A_SIZE                                = $(FLASH_REGION_PEI_COMPRESSED_SIZE)

DEFINE FLASH_REGION_PEI_FLASH_B_OFFSET                              = $(FLASH_REGION_PEI_FLASH_A_OFFSET)+$(FLASH_REGION_PEI_FLASH_A_SIZE)
DEFINE FLASH_REGION_PEI_FLASH_B_SIZE                                = $(FLASH_REGION_PEI_COMPRESSED_SIZE)
!endif

#
#  1. To adjust FVMAIN space add new FVMAINRESERVE space.
#     The RESERVE space just to reduce FVMAIN space size, so that it's able to speed up Dxe IPL.
#     If FVMAIN size is not enough to build. You can adjust FLASH_REGION_FVMAIN_SIZE directly.
#
#  2. FULL_FVAMIN_UNSIGNED_SIZE includes FVMAIN, FVMAIN_RESERVE and FVUNSIGNED (OPTIONAL)
#     you need build BIOS and then wait PatchFdf done and then according to ProjectMod.fdf to
#     adjust this value to make sure the last region + last region size is equal to flash area size
#     ex: $(FLASH_REGION_FVMAIN_HASH_OFFSET) + $(FLASH_REGION_FVMAIN_HASH_SIZE) == $(FLASH_AREA_SIZE)
#
#  |               |      |               |
#  +---------------+      +---------------+
#  | FVMAIN        |      | FVMAIN        |
#  |               |      |               |
#  |               | ==>  |               |
#  |               |      +---------------+
#  |               |      | FVMAIN RESERVE|
#  |               |      |               |
#  +---------------+      +---------------+
#  | FVUNSIGNED    |      | FVUNSIGNED    |
#  | (OPTIONAL)    |      | (OPTIONAL)    |
#  +---------------+      +---------------+
#
#
#[-start-220125-IB14740205-modify]#
!if $(VN_32M_AB_COMBO_CFG) == YES
DEFINE FULL_FVAMIN_UNSIGNED_SIZE                                    = 0x00BC8000
!else
DEFINE FULL_FVAMIN_UNSIGNED_SIZE                                    = 0x00513000
!endif
#[-end-220125-IB14740205-modify]#

!if $(L2A_ONLY) == YES
#[-start-220125-IB14740205-modify]#
DEFINE FULL_FVAMIN_UNSIGNED_SIZE                                    = 0x00DE8000 - 0x160000
#[-end-220125-IB14740205-modify]#

DEFINE FLASH_REGION_FVMAIN_OFFSET                                   = $(FLASH_16MB_OFFSET)
DEFINE FLASH_REGION_FVMAIN_SIZE                                     = 0x00380000

!else
DEFINE FLASH_REGION_FVMAIN_OFFSET                                   = $(FLASH_REGION_PEI_FLASH_B_OFFSET)+$(FLASH_REGION_PEI_FLASH_B_SIZE)
!if $(VN_32M_AB_COMBO_CFG) == YES
DEFINE FLASH_REGION_FVMAIN_SIZE                                     = 0x00600000
!else
DEFINE FLASH_REGION_FVMAIN_SIZE                                     = 0x003A0000
!endif
!endif

DEFINE FLASH_REGION_FVMAINRESERVE_OFFSET                            = $(FLASH_REGION_FVMAIN_OFFSET)+$(FLASH_REGION_FVMAIN_SIZE)
DEFINE FLASH_REGION_FVMAINRESERVE_SIZE                              = $(FULL_FVAMIN_UNSIGNED_SIZE) - $(FLASH_REGION_FVMAIN_SIZE)

DEFINE FLASH_REGION_FVUNSIGNED_OFFSET                               = $(FLASH_REGION_FVMAINRESERVE_OFFSET) + $(FLASH_REGION_FVMAINRESERVE_SIZE)

!if $(UNSIGNED_FV_SUPPORT) == YES
#
# The region size is customized by the project owner.
# The default size is 64K.
# It also share with FVMAIN RESERVE space,
# so we need recalculate FVMAINRESERVE size and FVUNSIGED offset
#
DEFINE FLASH_REGION_FVUNSIGNED_SIZE                                 = 0x00010000
DEFINE FLASH_REGION_FVMAINRESERVE_SIZE                              = $(FLASH_REGION_FVMAINRESERVE_SIZE) - $(FLASH_REGION_FVUNSIGNED_SIZE)
DEFINE FLASH_REGION_FVUNSIGNED_OFFSET                               = $(FLASH_REGION_FVUNSIGNED_OFFSET)  - $(FLASH_REGION_FVUNSIGNED_SIZE)
!else
DEFINE FLASH_REGION_FVUNSIGNED_SIZE                                 = 0x00000000
!endif

DEFINE FLASH_REGION_NV_COMMON_STORE_SUBREGION_OEM_DMI_STORE_OFFSET  = $(FLASH_REGION_FVUNSIGNED_OFFSET)+$(FLASH_REGION_FVUNSIGNED_SIZE)
DEFINE FLASH_REGION_NV_COMMON_STORE_SUBREGION_OEM_DMI_STORE_SIZE    = 0x00001000

# FVUNSIGNED_TOTAL_SIZE for FVUNSIGNED contain multiple region
DEFINE FLASH_REGION_FVUNSIGNED_TOTAL_SIZE                           = $(FLASH_REGION_FVUNSIGNED_SIZE) + $(FLASH_REGION_NV_COMMON_STORE_SUBREGION_OEM_DMI_STORE_SIZE)

# Flash Region Layout Info (FDM)
DEFINE FLASH_REGION_FLASH_DEVICE_MAP_OFFSET                         = $(FLASH_REGION_NV_COMMON_STORE_SUBREGION_OEM_DMI_STORE_OFFSET)+$(FLASH_REGION_NV_COMMON_STORE_SUBREGION_OEM_DMI_STORE_SIZE)
DEFINE FLASH_REGION_FLASH_DEVICE_MAP_SIZE                           = 0x00002000

DEFINE FLASH_REGION_NV_COMMON_STORE_SUBREGION_MICROCODE_OFFSET      = $(FLASH_REGION_FLASH_DEVICE_MAP_OFFSET)+$(FLASH_REGION_FLASH_DEVICE_MAP_SIZE)
DEFINE FLASH_REGION_NV_COMMON_STORE_SUBREGION_MICROCODE_SIZE        = 0x00001000
DEFINE FLASH_REGION_NV_COMMON_STORE_SUBREGION_GPNVFV_OFFSET         = $(FLASH_REGION_NV_COMMON_STORE_SUBREGION_MICROCODE_OFFSET)+$(FLASH_REGION_NV_COMMON_STORE_SUBREGION_MICROCODE_SIZE)
DEFINE FLASH_REGION_NV_COMMON_STORE_SUBREGION_GPNVFV_SIZE           = 0x00001000
DEFINE FLASH_REGION_NV_COMMON_STORE_SUBREGION_NV_BVDT_OFFSET        = $(FLASH_REGION_NV_COMMON_STORE_SUBREGION_GPNVFV_OFFSET)+$(FLASH_REGION_NV_COMMON_STORE_SUBREGION_GPNVFV_SIZE)
DEFINE FLASH_REGION_NV_COMMON_STORE_SUBREGION_NV_BVDT_SIZE          = 0x00001000
DEFINE FLASH_REGION_NV_COMMON_STORE_SUBREGION_NV_MSDM_DATA_OFFSET   = $(FLASH_REGION_NV_COMMON_STORE_SUBREGION_NV_BVDT_OFFSET)+$(FLASH_REGION_NV_COMMON_STORE_SUBREGION_NV_BVDT_SIZE)
DEFINE FLASH_REGION_NV_COMMON_STORE_SUBREGION_NV_MSDM_DATA_SIZE     = 0x00001000

DEFINE FLASH_REGION_NVSTORAGE_SUBREGION_NV_VARIABLE_STORE_OFFSET    = $(FLASH_REGION_NV_COMMON_STORE_SUBREGION_NV_MSDM_DATA_OFFSET)+$(FLASH_REGION_NV_COMMON_STORE_SUBREGION_NV_MSDM_DATA_SIZE)
DEFINE FLASH_REGION_NVSTORAGE_SUBREGION_NV_VARIABLE_STORE_SIZE      = 0x00025000
DEFINE FLASH_REGION_NVSTORAGE_SUBREGION_NV_FTW_WORKING_OFFSET       = $(FLASH_REGION_NVSTORAGE_SUBREGION_NV_VARIABLE_STORE_OFFSET)+$(FLASH_REGION_NVSTORAGE_SUBREGION_NV_VARIABLE_STORE_SIZE)
DEFINE FLASH_REGION_NVSTORAGE_SUBREGION_NV_FTW_WORKING_SIZE         = 0x00001000
DEFINE FLASH_REGION_NVSTORAGE_SUBREGION_NV_FTW_SPARE_OFFSET         = $(FLASH_REGION_NVSTORAGE_SUBREGION_NV_FTW_WORKING_OFFSET)+$(FLASH_REGION_NVSTORAGE_SUBREGION_NV_FTW_WORKING_SIZE)
DEFINE FLASH_REGION_NVSTORAGE_SUBREGION_NV_FTW_SPARE_SIZE           = 0x00026000
DEFINE FLASH_REGION_NVSTORAGE_SUBREGION_NV_FACTORY_COPY_OFFSET      = $(FLASH_REGION_NVSTORAGE_SUBREGION_NV_FTW_SPARE_OFFSET)+$(FLASH_REGION_NVSTORAGE_SUBREGION_NV_FTW_SPARE_SIZE)
DEFINE FLASH_REGION_NVSTORAGE_SUBREGION_NV_FACTORY_COPY_SIZE        = 0x00004000

#
# WARNING:
# Preserve variable defaults region for variable defaults feature.
#
#[-start-220125-IB14740205-modify]#
DEFINE FLASH_REGION_FV_VARIABLE_DEFAULTS_OFFSET                     = $(FLASH_REGION_NVSTORAGE_SUBREGION_NV_FACTORY_COPY_OFFSET)+$(FLASH_REGION_NVSTORAGE_SUBREGION_NV_FACTORY_COPY_SIZE)
DEFINE FLASH_REGION_FV_VARIABLE_DEFAULTS_SIZE                       = 0x00020000
#[-end-220125-IB14740205-modify]#

DEFINE FLASH_REGION_FVMAIN_HASH_OFFSET                              = $(FLASH_REGION_FV_VARIABLE_DEFAULTS_OFFSET)+$(FLASH_REGION_FV_VARIABLE_DEFAULTS_SIZE)
DEFINE FLASH_REGION_FVMAIN_HASH_SIZE                                = 0x00001000

!if $(L2A_ONLY) == YES
DEFINE FLASH_REGION_PEI_FLASH_A_OFFSET                              = 0x1D00000
DEFINE FLASH_REGION_PEI_FLASH_A_SIZE                                = 0x300000
!endif

################################################################################
#
# FD Section
# The [FD] Section is made up of the definition statements and a
# description of what goes into  the Flash Device Image.  Each FD section
# defines one flash "device" image.  A flash device image may be one of
# the following: Removable media bootable image (like a boot floppy
# image,) an Option ROM image (that would be "flashed" into an add-in
# card,) a System "Flash"  image (that would be burned into a system's
# flash) or an Update ("Capsule") image that will be used to update and
# existing system flash.
#
################################################################################

[FD.Fox]
BaseAddress   = $(FLASH_BASE) | gChipsetPkgTokenSpaceGuid.PcdH2OFlashAreaMainBaseAddress     #The base address of the FLASH Device.
Size          = $(FD_SIZE) | gChipsetPkgTokenSpaceGuid.PcdH2OFlashAreaMainSize            #The size in bytes of the FLASH Device

SET gInsydeTokenSpaceGuid.PcdFlashAreaBaseAddress = $(FLASH_AREA_BASE_ADDRESS)
SET gInsydeTokenSpaceGuid.PcdFlashAreaSize        = $(FLASH_AREA_SIZE)

ErasePolarity = 1
BlockSize     = $(BLOCK_SIZE)
NumBlocks     = $(NUM_BLOCKS)                                                     # Size = NumBlocks x BlockSize
################################################################################
#
# Following are lists of FD Region layout which correspond to the locations of different
# images within the flash device.
#
# Regions must be defined in ascending order and may not overlap.
#
# A Layout Region start with a eight digit hex offset (leading "0x" required) followed by
# the pipe "|" character, followed by the size of the region, also in hex with the leading
# "0x" characters. Like:
# Offset|Size
# PcdOffsetCName|PcdSizeCName
# <Optional keyword "RegionType =  region-type-guid | region-id | attributes" >
# <FV, DATA, or FILE>
#
################################################################################
SET gChipsetPkgTokenSpaceGuid.PcdH2OFlashAreaPeiBaseAddress  = $(PEI_MEM_BASE)
SET gChipsetPkgTokenSpaceGuid.PcdH2OFlashAreaPeiSize         = $(PEI_MEM_SIZE)
SET gChipsetPkgTokenSpaceGuid.PcdH2OBootFirmwareVolumeBase   = $(PEI_MEM_BASE)
SET gChipsetPkgTokenSpaceGuid.PcdH2OBootFirmwareVolumeSize   = $(PEI_MEM_SIZE)


#
# A/B Recovery
#
SET gAmdCpmPkgTokenSpaceGuid.PcdCpmBIOSPointAddressL2A       = $(FLASH_REGION_PSPDIR_A_SIZE)
#[-start-240202-IB20840046-modify]#
SET gAmdCpmPkgTokenSpaceGuid.PcdCpmPEIPointAddressL2A        = $(FLASH_REGION_PEI_FLASH_A_OFFSET)
#[-end-240202-IB20840046-modify]#
SET gAmdCpmPkgTokenSpaceGuid.PcdCpmPSPNVDataL2A              = $(FLASH_REGION_PSP_NVRAM_OFFSET)
!if $(L2A_ONLY)  == NO
SET gAmdCpmPkgTokenSpaceGuid.PcdCpmBIOSPointAddressL2B       = $(FLASH_REGION_PSPDIR_B_SIZE)
#[-start-240202-IB20840046-modify]#
SET gAmdCpmPkgTokenSpaceGuid.PcdCpmPEIPointAddressL2B        = $(FLASH_REGION_PEI_FLASH_B_OFFSET)
#[-end-240202-IB20840046-modify]#
SET gAmdCpmPkgTokenSpaceGuid.PcdCpmPSPNVDataL2B              = $(FLASH_REGION_PSP_NVRAM_OFFSET)
!endif



!if $(DP_TI_SELECT) == YES
#
# PD TI 0 - 11 with New EcSig_Ti.bin
#
$(FLASH_REGION_FVEC_OFFSET)|$(FLASH_REGION_FVEC_SIZE)
gChipsetPkgTokenSpaceGuid.PcdH2OFlashFvEcBase|gChipsetPkgTokenSpaceGuid.PcdH2OFlashFvEcSize
RegionType = gH2OFlashMapRegionEcGuid
